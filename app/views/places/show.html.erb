<!-- app/views/places/show.html.erb -->
<div class="w-full max-w-6xl mx-auto">
  
  <!-- Header with back link -->
  <div class="mb-6">
    <%= link_to root_path, class: "inline-flex items-center text-blue-600 hover:text-blue-800 transition-colors" do %>
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      Back to Places Overview
    <% end %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-6">
      
      <!-- Place Header -->
      <div class="bg-white rounded-lg shadow-lg p-6">
        <div class="flex items-start justify-between mb-4">
          <div class="flex-1">
            <h1 class="text-3xl font-bold text-gray-900 mb-2">
              <%= @place.name.present? ? @place.name : "Place ##{@place.id}" %>
            </h1>
            
            <% if @place.rating.present? %>
              <div class="flex items-center space-x-3 mb-3">
                <div class="flex items-center">
                  <div class="text-yellow-400 text-lg">
                    <% @place.rating.round.times do %>★<% end %>
                    <% (5 - @place.rating.round).times do %>☆<% end %>
                  </div>
                  <span class="ml-2 text-lg font-semibold text-gray-700">
                    <%= number_with_precision(@place.rating, precision: 1) %>
                  </span>
                </div>
                <% if @place.user_ratings_total.present? %>
                  <span class="text-gray-500">
                    (<%= @place.user_ratings_total %> reviews)
                  </span>
                <% end %>
              </div>
            <% end %>
            
            <% if @place.types.present? %>
              <div class="flex flex-wrap gap-2 mb-4">
                <% @place.types.each do |type| %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                    <%= type.humanize %>
                  </span>
                <% end %>
              </div>
            <% end %>
            
            <% if @distance.present? %>
              <div class="inline-flex items-center px-3 py-2 bg-green-100 text-green-800 rounded-full">
                <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                </svg>
                <%= format_distance(@distance) %> from your location
              </div>
            <% end %>
          </div>
          
          <% if @place.price_level.present? %>
            <div class="text-right">
              <div class="text-sm text-gray-500 mb-1">Price Level</div>
              <div class="text-lg">
                <% @place.price_level.times do %>💰<% end %>
                <% (4 - @place.price_level).times do %>💸<% end %>
              </div>
            </div>
          <% end %>
        </div>
        
        <% if @place.editorial_summary.present? %>
          <div class="border-t pt-4">
            <p class="text-gray-700 leading-relaxed"><%= @place.editorial_summary %></p>
          </div>
        <% end %>
      </div>

      <!-- Map -->
      <div class="bg-white rounded-lg shadow-lg overflow-hidden">
        <div id="place-map" class="w-full h-80"></div>
      </div>

      <!-- Details -->
      <div class="bg-white rounded-lg shadow-lg p-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">Details</h2>
        
        <div class="space-y-4">
          <% if @place.formatted_address.present? %>
            <div class="flex items-start space-x-3">
              <svg class="w-5 h-5 text-gray-400 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
              </svg>
              <div>
                <div class="text-sm font-medium text-gray-900">Address</div>
                <div class="text-gray-700"><%= @place.formatted_address %></div>
              </div>
            </div>
          <% end %>

          <% if @place.formatted_phone_number.present? %>
            <div class="flex items-start space-x-3">
              <svg class="w-5 h-5 text-gray-400 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
              </svg>
              <div>
                <div class="text-sm font-medium text-gray-900">Phone</div>
                <div class="text-gray-700">
                  <a href="tel:<%= @place.formatted_phone_number %>" class="text-blue-600 hover:underline">
                    <%= @place.formatted_phone_number %>
                  </a>
                </div>
              </div>
            </div>
          <% end %>

          <% if @place.website.present? %>
            <div class="flex items-start space-x-3">
              <svg class="w-5 h-5 text-gray-400 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4.083 9h1.946c.089-1.546.383-2.97.837-4.118A6.004 6.004 0 004.083 9zM10 2a8 8 0 100 16 8 8 0 000-16zm0 2c-.076 0-.232.032-.465.262-.238.234-.497.623-.737 1.182-.389.907-.673 2.142-.766 3.556h3.936c-.093-1.414-.377-2.649-.766-3.556-.24-.559-.5-.948-.737-1.182C10.232 4.032 10.076 4 10 4zm3.971 5c-.089-1.546-.383-2.97-.837-4.118A6.004 6.004 0 0115.917 9h-1.946zm-2.003 2H8.032c.093 1.414.377 2.649.766 3.556.24.559.5.948.737 1.182.233.23.389.262.465.262.076 0 .232-.032.465-.262.238-.234.498-.623.737-1.182.389-.907.673-2.142.766-3.556zm1.166 4.118c.454-1.147.748-2.572.837-4.118h1.946a6.004 6.004 0 01-2.783 4.118zm-6.268 0C6.412 13.97 6.118 12.546 6.03 11H4.083a6.004 6.004 0 002.783 4.118z" clip-rule="evenodd"></path>
              </svg>
              <div>
                <div class="text-sm font-medium text-gray-900">Website</div>
                <div class="text-gray-700">
                  <a href="<%= @place.website %>" target="_blank" rel="noopener" class="text-blue-600 hover:underline">
                    Visit Website ↗
                  </a>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Opening Hours -->
      <% if @place.opening_hours.present? %>
        <div class="bg-white rounded-lg shadow-lg p-6">
          <h2 class="text-xl font-semibold text-gray-900 mb-4">Opening Hours</h2>
          
          <% if @place.opening_hours['weekday_text'].present? %>
            <div class="space-y-2">
              <% @place.opening_hours['weekday_text'].each do |hours| %>
                <div class="flex justify-between items-center py-1 border-b border-gray-100 last:border-b-0">
                  <span class="text-gray-700"><%= hours %></span>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Sidebar -->
    <div class="lg:col-span-1 space-y-6">
      
      <!-- Quick Actions -->
      <div class="bg-white rounded-lg shadow-lg p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Quick Actions</h3>
        <div class="space-y-3">
          
          <% if @place.formatted_phone_number.present? %>
            <a href="tel:<%= @place.formatted_phone_number %>" 
               class="w-full flex items-center justify-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-green-600 hover:bg-green-700 transition-colors">
              <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
              </svg>
              Call Now
            </a>
          <% end %>

          <% if @place.url.present? %>
            <a href="<%= @place.url %>" target="_blank" rel="noopener"
               class="w-full flex items-center justify-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors">
              <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
              </svg>
              View on Google Maps ↗
            </a>
          <% end %>
        </div>
      </div>

      <!-- Coordinates -->
      <div class="bg-white rounded-lg shadow-lg p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Location</h3>
        <div class="space-y-2 text-sm">
          <div>
            <span class="font-medium text-gray-700">Latitude:</span>
            <span class="text-gray-600 font-mono"><%= number_with_precision(@place.lat, precision: 6) %></span>
          </div>
          <div>
            <span class="font-medium text-gray-700">Longitude:</span>
            <span class="text-gray-600 font-mono"><%= number_with_precision(@place.lng, precision: 6) %></span>
          </div>
        </div>
      </div>

      <!-- Business Status -->
      <% if @place.business_status.present? %>
        <div class="bg-white rounded-lg shadow-lg p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Status</h3>
          <div class="flex items-center space-x-2">
            <% if @place.business_status == 'OPERATIONAL' %>
              <div class="w-3 h-3 bg-green-400 rounded-full"></div>
              <span class="text-green-800 font-medium">Operational</span>
            <% elsif @place.business_status == 'CLOSED_TEMPORARILY' %>
              <div class="w-3 h-3 bg-yellow-400 rounded-full"></div>
              <span class="text-yellow-800 font-medium">Temporarily Closed</span>
            <% elsif @place.business_status == 'CLOSED_PERMANENTLY' %>
              <div class="w-3 h-3 bg-red-400 rounded-full"></div>
              <span class="text-red-800 font-medium">Permanently Closed</span>
            <% else %>
              <div class="w-3 h-3 bg-gray-400 rounded-full"></div>
              <span class="text-gray-800 font-medium"><%= @place.business_status.humanize %></span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Google Maps for single place -->
<script>
  function initPlaceMap() {
    const place = {
      lat: <%= @place.lat %>,
      lng: <%= @place.lng %>,
      name: <%= raw @place.name.present? ? @place.name.to_json : "\"Place ##{@place.id}\"" %>
    };

    const map = new google.maps.Map(document.getElementById('place-map'), {
      zoom: 15,
      center: { lat: place.lat, lng: place.lng },
      mapTypeId: google.maps.MapTypeId.ROADMAP<% if ENV['GOOGLE_MAPS_MAP_ID'].present? %>,
      mapId: '<%= ENV['GOOGLE_MAPS_MAP_ID'] %>'
      <% end %>
    });

    // Create place marker - use advanced markers if Map ID is available, otherwise legacy markers
    <% if ENV['GOOGLE_MAPS_MAP_ID'].present? %>
    const placePin = new google.maps.marker.PinElement({
      background: '#2563eb',
      borderColor: '#ffffff',
      glyphColor: '#ffffff',
      glyph: '🏫',
      scale: 1.3
    });
    
    const marker = new google.maps.marker.AdvancedMarkerElement({
      position: { lat: place.lat, lng: place.lng },
      map: map,
      title: place.name,
      content: placePin.element
    });
    <% else %>
    const marker = new google.maps.Marker({
      position: { lat: place.lat, lng: place.lng },
      map: map,
      title: place.name,
      icon: {
        url: 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(`
          <svg width="32" height="32" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
            <circle cx="16" cy="16" r="16" fill="#2563eb" stroke="white" stroke-width="2"/>
            <text x="16" y="21" text-anchor="middle" font-size="16" fill="white">🏫</text>
          </svg>
        `),
        scaledSize: new google.maps.Size(32, 32),
        anchor: new google.maps.Point(16, 16)
      }
    });
    <% end %>

    const infoWindow = new google.maps.InfoWindow({
      content: `
        <div class="p-3 text-center">
          <h4 class="font-bold text-lg text-blue-600 mb-2">${place.name}</h4>
          <% if @place.formatted_address.present? %>
            <p class="text-sm text-gray-700"><%= j @place.formatted_address %></p>
          <% end %>
        </div>
      `
    });

    marker.addListener('click', function() {
      infoWindow.open(map, marker);
    });
  }

  // Initialize map when Google Maps API loads
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof google !== 'undefined' && google.maps) {
      initPlaceMap();
    } else {
      // Load Google Maps API if not already loaded
      const script = document.createElement('script');
      script.src = 'https://maps.googleapis.com/maps/api/js?key=<%= ENV['GOOGLE_PLACES_API_KEY'] %>&callback=initPlaceMap&libraries=geometry,places<%= ENV['GOOGLE_MAPS_MAP_ID'].present? ? ',marker' : '' %>&loading=async';
      script.async = true;
      script.defer = true;
      document.head.appendChild(script);
    }
  });
</script>
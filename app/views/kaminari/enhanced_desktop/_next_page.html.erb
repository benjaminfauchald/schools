<%#
  Enhanced Desktop Next Page Link
%>

<%= link_to url, 
      class: "relative inline-flex items-center px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0 transition-colors duration-200 hover:text-gray-600 #{'rounded-r-md' unless total_pages > 5 && current_page < total_pages}",
      title: "Next page",
      'aria-label': "Go to next page, page #{current_page + 1}",
      remote: remote do %>
  <span class="sr-only">Next</span>
  <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
  </svg>
<% end %>
<%#
  Enhanced Mobile Paginator Theme
  Simplified navigation optimized for mobile devices
%>

<%= paginator.render do %>
  <div class="flex items-center justify-between">
    <!-- Previous Button -->
    <% if current_page > 1 %>
      <%= prev_page_tag %>
    <% else %>
      <span class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-300 cursor-not-allowed">
        <svg class="h-4 w-4 mr-1" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" />
        </svg>
        Previous
      </span>
    <% end %>

    <!-- Current Page Info -->
    <div class="flex items-center space-x-2">
      <div class="text-sm font-medium text-gray-900 bg-blue-50 px-3 py-1 rounded-full border border-blue-200">
        <%= current_page %> / <%= total_pages %>
      </div>
    </div>

    <!-- Next Button -->
    <% if current_page < total_pages %>
      <%= next_page_tag %>
    <% else %>
      <span class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-300 cursor-not-allowed">
        Next
        <svg class="h-4 w-4 ml-1" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
        </svg>
      </span>
    <% end %>
  </div>

  <!-- Mobile Page Selector (only show if more than 5 pages) -->
  <% if total_pages > 5 %>
    <div class="mt-3 flex justify-center">
      <select 
        class="rounded-md border-gray-300 text-sm focus:border-blue-500 focus:ring-blue-500"
        onchange="window.location.href = this.value"
        aria-label="Select page"
      >
        <% (1..total_pages).each do |page_num| %>
          <option 
            value="<%= url_for(request.query_parameters.merge(page: page_num)) %>" 
            <%= 'selected' if page_num == current_page %>
          >
            Page <%= page_num %><%= " (current)" if page_num == current_page %>
          </option>
        <% end %>
      </select>
    </div>
  <% end %>
<% end %>
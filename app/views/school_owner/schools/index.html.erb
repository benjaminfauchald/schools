<% content_for :title, "My Schools" %>

<div class="max-w-6xl mx-auto">
  <!-- Header -->
  <div class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">My Schools</h1>
      <p class="mt-1 text-sm text-gray-600">Manage the schools you have claimed and edit their information</p>
    </div>
    
    <%= link_to school_owner_dashboard_index_path, 
        class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z"></path>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H10a2 2 0 01-2-2V5z"></path>
      </svg>
      Dashboard
    <% end %>
  </div>

  <% if @schools.any? %>
    <!-- Schools Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @schools.each do |school| %>
        <div class="bg-white border border-gray-200 rounded-lg overflow-hidden hover:border-gray-300 transition-colors">
          <!-- School Header -->
          <div class="p-6 pb-4">
            <h3 class="text-lg font-medium text-gray-900 mb-2"><%= school.name %></h3>
            <p class="text-sm text-gray-600 line-clamp-3">
              <%= school.about.present? ? truncate(school.about, length: 120) : "No about information provided" %>
            </p>
          </div>

          <!-- School Details -->
          <div class="px-6 pb-4">
            <div class="space-y-2">
              <% if school.display_address.present? %>
                <div class="flex items-start">
                  <svg class="w-4 h-4 text-gray-400 mt-0.5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                  <span class="text-xs text-gray-600 line-clamp-2"><%= school.display_address %></span>
                </div>
              <% end %>
              
              <% if school.display_phone.present? %>
                <div class="flex items-center">
                  <svg class="w-4 h-4 text-gray-400 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                  </svg>
                  <span class="text-xs text-gray-600"><%= school.display_phone %></span>
                </div>
              <% end %>
              
              <% if school.display_website.present? %>
                <div class="flex items-center">
                  <svg class="w-4 h-4 text-gray-400 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
                  </svg>
                  <a href="<%= school.display_website %>" target="_blank" class="text-xs text-blue-600 hover:text-blue-800 truncate">
                    <%= school.display_website.gsub(/^https?:\/\//, '') %>
                  </a>
                </div>
              <% end %>
            </div>
          </div>

          <!-- School Features -->
          <% features = [] %>
          <% features << "Boarding" if school.boarding %>
          <% features << "Bus Service" if school.school_bus %>
          
          <% # Check for additional features in text fields %>
          <% if school.about.present? %>
            <% about_text = school.about.downcase %>
            <% features << "International" if about_text.include?("international") %>
            <% features << "Bilingual" if about_text.include?("bilingual") || about_text.include?("bi-lingual") %>
            <% features << "Special Needs" if about_text.include?("special needs") || about_text.include?("inclusive") %>
          <% end %>
          
          <% # Check language support notes %>
          <% if school.language_support_notes.present? %>
            <% lang_notes = school.language_support_notes.downcase %>
            <% features << "Language Support" if !features.include?("Language Support") %>
          <% end %>
          
          <% if features.any? %>
            <div class="px-6 pb-4">
              <div class="flex flex-wrap gap-1">
                <% features.take(3).each do |feature| %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                    <%= feature %>
                  </span>
                <% end %>
                <% if features.length > 3 %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                    +<%= features.length - 3 %> more
                  </span>
                <% end %>
              </div>
            </div>
          <% end %>

          <!-- Actions -->
          <div class="px-6 pb-6 pt-2">
            <div class="flex space-x-3">
              <%= link_to school_owner_school_path(school.id), 
                  class: "flex-1 inline-flex items-center justify-center px-3 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" do %>
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                </svg>
                View
              <% end %>
              
              <%= link_to edit_school_owner_school_path(school.id), 
                  class: "flex-1 inline-flex items-center justify-center px-3 py-2 border border-transparent rounded-md text-sm font-medium text-white bg-blue-600 hover:bg-blue-700" do %>
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
                Edit
              <% end %>
            </div>
          </div>

          <!-- Quick Stats Footer -->
          <div class="bg-gray-50 px-6 py-3 border-t border-gray-200">
            <div class="flex items-center justify-between text-xs text-gray-500">
              <span>Updated <%= time_ago_in_words(school.updated_at) %> ago</span>
              <%= link_to school_path(id: school.id), target: "_blank", 
                  class: "inline-flex items-center text-blue-600 hover:text-blue-800" do %>
                Public Page
                <svg class="w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                </svg>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="text-center py-12">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
      </svg>
      <h3 class="mt-2 text-sm font-medium text-gray-900">No schools yet</h3>
      <p class="mt-1 text-sm text-gray-500">You haven't claimed any schools yet. Start by finding your school and submitting a claim.</p>
      <div class="mt-6">
        <%= link_to root_path, 
            class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          Find Schools to Claim
        <% end %>
      </div>
    </div>
  <% end %>
</div>
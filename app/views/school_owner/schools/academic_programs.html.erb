<% content_for :title, "Academic Programs - #{@school.name}" %>

<div class="max-w-6xl mx-auto">
  <!-- Header -->
  <div class="mb-6">
    <%= link_to school_owner_school_path(@school), class: "inline-flex items-center text-blue-600 hover:text-blue-800 mb-4" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      Back to School Overview
    <% end %>
    
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Academic Programs</h1>
        <p class="mt-1 text-sm text-gray-600">Curriculum, accreditations, and educational offerings for <%= @school.name %></p>
      </div>
      
      <div class="flex space-x-3">
        <%= link_to school_owner_school_path(@school), 
            class: "inline-flex items-center px-3 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
          </svg>
          View School
        <% end %>
        
        <%= link_to facilities_school_owner_school_path(@school), 
            class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
          </svg>
          Manage Facilities
        <% end %>
      </div>
    </div>
  </div>

  <!-- Form -->
  <%= form_with url: update_academic_programs_school_owner_school_path(@school), method: :patch, local: true, class: "space-y-8" do |form| %>
    
    <!-- Error Messages -->
    <% if @school.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-red-800">Please fix the following errors:</h3>
            <div class="mt-2 text-sm text-red-700">
              <ul class="list-disc space-y-1 pl-5">
                <% @school.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Curriculum Programs -->
    <div class="bg-white border border-gray-200 rounded-lg p-6">
      <div class="flex items-center mb-6">
        <svg class="w-6 h-6 text-blue-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
        </svg>
        <div>
          <h2 class="text-lg font-medium text-gray-900">Curriculum Programs</h2>
          <p class="text-sm text-gray-600">Educational frameworks and curricula offered at your school</p>
        </div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% current_curriculum = @school.curricula.pluck(:slug) %>
        <% @vocabularies[:curriculum].each do |term| %>
          <div class="relative flex items-start">
            <div class="flex items-center h-5">
              <%= check_box_tag "curriculum[]", term.slug, current_curriculum.include?(term.slug), 
                  class: "h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500" %>
            </div>
            <div class="ml-3 text-sm">
              <%= label_tag "curriculum_#{term.slug}", term.label, class: "font-medium text-gray-700" %>
              <% if term.description.present? %>
                <p class="text-gray-500"><%= term.description %></p>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Accreditations -->
    <div class="bg-white border border-gray-200 rounded-lg p-6">
      <div class="flex items-center mb-6">
        <svg class="w-6 h-6 text-green-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <div>
          <h2 class="text-lg font-medium text-gray-900">Accreditations</h2>
          <p class="text-sm text-gray-600">Official certifications and recognitions your school holds</p>
        </div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% current_accreditations = @school.accreditations.pluck(:slug) %>
        <% @vocabularies[:accreditation].each do |term| %>
          <div class="relative flex items-start">
            <div class="flex items-center h-5">
              <%= check_box_tag "accreditation[]", term.slug, current_accreditations.include?(term.slug), 
                  class: "h-4 w-4 text-green-600 border-gray-300 rounded focus:ring-green-500" %>
            </div>
            <div class="ml-3 text-sm">
              <%= label_tag "accreditation_#{term.slug}", term.label, class: "font-medium text-gray-700" %>
              <% if term.description.present? %>
                <p class="text-gray-500"><%= term.description %></p>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Languages -->
    <div class="bg-white border border-gray-200 rounded-lg p-6">
      <div class="flex items-center mb-6">
        <svg class="w-6 h-6 text-purple-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"></path>
        </svg>
        <div>
          <h2 class="text-lg font-medium text-gray-900">Languages</h2>
          <p class="text-sm text-gray-600">Languages of instruction and support programs</p>
        </div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% current_languages = @school.languages.pluck(:slug) %>
        <% @vocabularies[:language].each do |term| %>
          <div class="relative flex items-start">
            <div class="flex items-center h-5">
              <%= check_box_tag "language[]", term.slug, current_languages.include?(term.slug), 
                  class: "h-4 w-4 text-purple-600 border-gray-300 rounded focus:ring-purple-500" %>
            </div>
            <div class="ml-3 text-sm">
              <%= label_tag "language_#{term.slug}", term.label, class: "font-medium text-gray-700" %>
              <% if term.description.present? %>
                <p class="text-gray-500"><%= term.description %></p>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Special Programs -->
    <div class="bg-white border border-gray-200 rounded-lg p-6">
      <div class="flex items-center mb-6">
        <svg class="w-6 h-6 text-yellow-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
        </svg>
        <div>
          <h2 class="text-lg font-medium text-gray-900">Special Programs</h2>
          <p class="text-sm text-gray-600">Additional support and enrichment programs</p>
        </div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% current_programs = @school.programs.pluck(:slug) %>
        <% @vocabularies[:program].each do |term| %>
          <div class="relative flex items-start">
            <div class="flex items-center h-5">
              <%= check_box_tag "program[]", term.slug, current_programs.include?(term.slug), 
                  class: "h-4 w-4 text-yellow-600 border-gray-300 rounded focus:ring-yellow-500" %>
            </div>
            <div class="ml-3 text-sm">
              <%= label_tag "program_#{term.slug}", term.label, class: "font-medium text-gray-700" %>
              <% if term.description.present? %>
                <p class="text-gray-500"><%= term.description %></p>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Form Actions -->
    <div class="bg-white border border-gray-200 rounded-lg p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600">
            Changes will be visible to parents and students immediately on your school's public page.
          </p>
          <p class="text-xs text-gray-500 mt-1">
            Select all programs and services that accurately represent your school's offerings.
          </p>
        </div>
        
        <div class="flex space-x-3">
          <%= link_to school_owner_school_path(@school), 
              class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" do %>
            Cancel
          <% end %>
          
          <%= form.submit "Save Academic Programs", 
              class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
        </div>
      </div>
    </div>

  <% end %>
</div>
                             data-photo-visibility-school-id-value="<%= @school.id %>">
                          
                          <!-- Photo Image -->
                          <% photo_reference = photo.is_a?(Hash) ? photo['photo_reference'] : photo.try(:photo_reference) %>
                          <% if photo_reference.present? %>
                            <% photo_url = "/api/v1/photos/proxy?photo_reference=#{CGI.escape(photo_reference)}&max_width=400&t=#{Time.current.to_i}" %>

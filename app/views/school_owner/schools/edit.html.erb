                      <% @school.place.photos.each do |photo| %>
                        <% photo_key = @school.send(:generate_photo_key, photo) %>
                        <% is_visible = @school.photo_visible?(photo) %>
                        <div class="relative aspect-square bg-gray-100 rounded-lg overflow-hidden photo-toggle-container cursor-pointer group"
                             data-photo-key="<%= photo_key %>"
                             data-visible="<%= is_visible %>"
                             data-controller="photo-visibility"
                             data-action="click->photo-visibility#toggle"
                             data-photo-visibility-school-id-value="<%= @school.id %>">
                          
                          <!-- Photo Image -->
                          <% if photo.is_a?(Hash) && photo['photo_reference'] %>
                            <%= image_tag "https://maps.googleapis.com/maps/api/place/photo?maxwidth=400&photoreference=#{photo['photo_reference']}&key=#{ENV['GOOGLE_PLACES_API_KEY']}", 
                                alt: "#{@school.name} photo",
                                class: "w-full h-full object-cover transition-all duration-200 #{'opacity-50' unless is_visible}",
                                loading: "lazy" %>
                          <% elsif photo.respond_to?(:url) %>
                            <%= image_tag photo.url, 
                                alt: "#{@school.name} photo",
                                class: "w-full h-full object-cover transition-all duration-200 #{'opacity-50' unless is_visible}",

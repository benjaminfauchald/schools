<% content_for :title, "Edit #{@school.name}" %>

<div class="max-w-4xl mx-auto">
  <!-- Header -->
  <div class="mb-6">
    <%= link_to school_owner_school_path(@school), class: "inline-flex items-center text-blue-600 hover:text-blue-800 mb-4" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      Back to School
    <% end %>
    
    <h1 class="text-2xl font-bold text-gray-900">Edit School Information</h1>
    <p class="mt-1 text-sm text-gray-600">Update your school's information to help parents and students find you.</p>
  </div>

  <!-- Form -->
  <%= form_with model: [@school], url: school_owner_school_path(@school), method: :patch, local: true, class: "space-y-6" do |form| %>
    
    <!-- Error Messages -->
    <% if @school.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-red-800">Please fix the following errors:</h3>
            <div class="mt-2 text-sm text-red-700">
              <ul class="list-disc space-y-1 pl-5">
                <% @school.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Basic Information -->
    <div class="bg-white border border-gray-200 rounded-lg p-6">
      <h2 class="text-lg font-medium text-gray-900 mb-4">Basic Information</h2>
      
      <div class="grid grid-cols-1 gap-6">
        <div>
          <%= form.label :name, "School Name", class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :name, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          <p class="mt-1 text-xs text-gray-500">The official name of your school</p>
        </div>
        
        <div>
          <%= form.label :description, "Description", class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_area :description, rows: 4, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          <p class="mt-1 text-xs text-gray-500">Tell parents and students about your school's mission, values, and what makes you unique</p>
        </div>
      </div>
    </div>

    <!-- Contact Information -->
    <div class="bg-white border border-gray-200 rounded-lg p-6">
      <h2 class="text-lg font-medium text-gray-900 mb-4">Contact Information</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= form.label :website_url, "Website URL", class: "block text-sm font-medium text-gray-700" %>
          <%= form.url_field :website_url, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm", placeholder: "https://www.yourschool.com" %>
          <p class="mt-1 text-xs text-gray-500">Your school's official website</p>
        </div>
        
        <div>
          <%= form.label :phone, "Phone Number", class: "block text-sm font-medium text-gray-700" %>
          <%= form.telephone_field :phone, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm", placeholder: "+66 2 123 4567" %>
          <p class="mt-1 text-xs text-gray-500">Main contact phone number</p>
        </div>
        
        <div class="md:col-span-2">
          <%= form.label :email, "Email Address", class: "block text-sm font-medium text-gray-700" %>
          <%= form.email_field :email, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm", placeholder: "info@yourschool.com" %>
          <p class="mt-1 text-xs text-gray-500">Main contact email address</p>
        </div>
      </div>
    </div>

    <!-- Address -->
    <div class="bg-white border border-gray-200 rounded-lg p-6">
      <h2 class="text-lg font-medium text-gray-900 mb-4">Address</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="md:col-span-2">
          <%= form.label :address_street, "Street Address", class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :address_street, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          <p class="mt-1 text-xs text-gray-500">Street number, street name, building name</p>
        </div>
        
        <div>
          <%= form.label :address_district, "District", class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :address_district, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          <p class="mt-1 text-xs text-gray-500">District (เขต)</p>
        </div>
        
        <div>
          <%= form.label :address_subdistrict, "Subdistrict", class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :address_subdistrict, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          <p class="mt-1 text-xs text-gray-500">Subdistrict (แขวง)</p>
        </div>
        
        <div>
          <%= form.label :address_province, "Province", class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :address_province, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          <p class="mt-1 text-xs text-gray-500">Province (จังหวัด)</p>
        </div>
        
        <div>
          <%= form.label :address_postal_code, "Postal Code", class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :address_postal_code, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          <p class="mt-1 text-xs text-gray-500">5-digit postal code</p>
        </div>
      </div>
    </div>

    <!-- Social Media -->
    <div class="bg-white border border-gray-200 rounded-lg p-6">
      <h2 class="text-lg font-medium text-gray-900 mb-4">Social Media</h2>
      <p class="text-sm text-gray-600 mb-6">Help parents connect with your school on social media</p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= form.label :facebook_url, "Facebook Page", class: "block text-sm font-medium text-gray-700" %>
          <%= form.url_field :facebook_url, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm", placeholder: "https://www.facebook.com/yourschool" %>
        </div>
        
        <div>
          <%= form.label :instagram_url, "Instagram Account", class: "block text-sm font-medium text-gray-700" %>
          <%= form.url_field :instagram_url, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm", placeholder: "https://www.instagram.com/yourschool" %>
        </div>
        
        <div>
          <%= form.label :twitter_url, "Twitter/X Account", class: "block text-sm font-medium text-gray-700" %>
          <%= form.url_field :twitter_url, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm", placeholder: "https://twitter.com/yourschool" %>
        </div>
        
        <div>
          <%= form.label :youtube_url, "YouTube Channel", class: "block text-sm font-medium text-gray-700" %>
          <%= form.url_field :youtube_url, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm", placeholder: "https://www.youtube.com/c/yourschool" %>
        </div>
      </div>
    </div>

    <!-- School Features -->
    <div class="bg-white border border-gray-200 rounded-lg p-6">
      <h2 class="text-lg font-medium text-gray-900 mb-4">School Features</h2>
      <p class="text-sm text-gray-600 mb-6">Check all features that apply to your school</p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="flex items-start">
          <div class="flex items-center h-5">
            <%= form.check_box :boarding, class: "h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500" %>
          </div>
          <div class="ml-3">
            <%= form.label :boarding, "Boarding Available", class: "text-sm font-medium text-gray-700" %>
            <p class="text-xs text-gray-500">Students can live on campus</p>
          </div>
        </div>
        
        <div class="flex items-start">
          <div class="flex items-center h-5">
            <%= form.check_box :school_bus, class: "h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500" %>
          </div>
          <div class="ml-3">
            <%= form.label :school_bus, "School Bus Service", class: "text-sm font-medium text-gray-700" %>
            <p class="text-xs text-gray-500">Transportation provided</p>
          </div>
        </div>
        
        <div class="flex items-start">
          <div class="flex items-center h-5">
            <%= form.check_box :international, class: "h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500" %>
          </div>
          <div class="ml-3">
            <%= form.label :international, "International Curriculum", class: "text-sm font-medium text-gray-700" %>
            <p class="text-xs text-gray-500">International programs available</p>
          </div>
        </div>
        
        <div class="flex items-start">
          <div class="flex items-center h-5">
            <%= form.check_box :bilingual, class: "h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500" %>
          </div>
          <div class="ml-3">
            <%= form.label :bilingual, "Bilingual Program", class: "text-sm font-medium text-gray-700" %>
            <p class="text-xs text-gray-500">Multiple language instruction</p>
          </div>
        </div>
        
        <div class="flex items-start md:col-span-2">
          <div class="flex items-center h-5">
            <%= form.check_box :special_needs, class: "h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500" %>
          </div>
          <div class="ml-3">
            <%= form.label :special_needs, "Special Needs Support", class: "text-sm font-medium text-gray-700" %>
            <p class="text-xs text-gray-500">Programs for students with special learning needs</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Form Actions -->
    <div class="bg-white border border-gray-200 rounded-lg p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600">
            Changes will be visible to parents and students on your school's public page immediately.
          </p>
        </div>
        
        <div class="flex space-x-3">
          <%= link_to school_owner_school_path(@school), 
              class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" do %>
            Cancel
          <% end %>
          
          <%= form.submit "Save Changes", 
              class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
        </div>
      </div>
    </div>

  <% end %>
</div>
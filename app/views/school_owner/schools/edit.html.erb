                              multiple: true, 
                              accept: "image/*",
                              class: "sr-only",
                              id: "photos",
                              data: { 
                                "photo-upload-target" => "input",
                                "action" => "change->photo-upload#handleFiles"
                              } %>
                        </label>
                        <p class="mt-2 text-xs text-gray-500">
                          or drag and drop photos here
                        </p>
                      </div>
                      
                      <p class="text-xs text-gray-500 mt-2">
                        PNG, JPG, WEBP up to 5MB each. Maximum 10 photos.
                      </p>
                    </div>
                    
                    <!-- Preview Area -->
                    <div data-photo-upload-target="preview" class="mt-6 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 hidden">
                      <!-- Previews will be inserted here by JavaScript -->
                    </div>
                  </div>
                  
                  <!-- Uploaded Photos Display -->
                  <% if false && @school.respond_to?(:photos) && @school.photos.any? %>
                    <div class="mt-8">
                      <h4 class="text-md font-medium text-gray-900 mb-4">Your Uploaded Photos</h4>
                      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                        <% @school.photos.each do |photo| %>
                          <div class="relative aspect-square bg-gray-100 rounded-lg overflow-hidden group">
                            <% if photo.respond_to?(:variant) %>
                              <%= image_tag photo.variant(resize_to_limit: [300, 300]), 
                                  alt: "#{@school.name} uploaded photo",
                                  class: "w-full h-full object-cover" %>
                            <% else %>
                              <div class="w-full h-full flex items-center justify-center bg-gray-200">
                                <span class="text-gray-400 text-sm">Photo format not supported</span>
                              </div>
                            <% end %>
                            
                            <!-- Delete button -->
                            <%= button_to "×", 
                                delete_photo_school_owner_school_path(@school, photo_id: photo.id), 
                                method: :delete,
                                class: "absolute top-2 right-2 w-6 h-6 bg-red-500 text-white rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity text-sm font-bold hover:bg-red-600",
                                title: "Delete photo",
                                data: { 
                                  confirm: "Are you sure you want to delete this photo?"
                                } %>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>

              <!-- Videos Section (only show if YouTube URL is present) -->
              <% if @school.has_youtube_channel? %>
                <div data-school-form-navigation-target="section" 
                     data-section="videos" 
                     class="hidden bg-white border border-gray-200 rounded-lg p-6"
                     data-controller="youtube-videos"
                     data-youtube-videos-school-id-value="<%= @school.id %>"
                     data-youtube-videos-fetch-url-value="<%= fetch_videos_school_owner_school_path(@school) %>"
                     data-youtube-videos-toggle-url-value="<%= toggle_video_visibility_school_owner_school_path(@school) %>"
                     data-youtube-videos-transcript-url-value="<%= extract_transcript_school_owner_school_path(@school, ':video_id') %>"
                     data-youtube-videos-transcript-status-url-value="<%= transcript_status_school_owner_school_path(@school, ':video_id') %>">
                  
                  <div class="flex items-center mb-6">
                    <svg class="w-6 h-6 text-red-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                    </svg>
                    <div>
                      <h2 class="text-lg font-medium text-gray-900">YouTube Videos</h2>
                      <p class="text-sm text-gray-600">Manage which videos from your YouTube channel are shown on your school page</p>
                    </div>
                  </div>

                  <!-- YouTube Channel Info -->
                  <div class="mb-6 p-4 bg-gray-50 rounded-lg">
                    <div class="flex items-center justify-between">
                      <div>
                        <h3 class="text-sm font-medium text-gray-900">Connected YouTube Channel</h3>
                        <p class="text-sm text-gray-600 mt-1"><%= @school.youtube_url %></p>
                      </div>
                      <a href="<%= @school.youtube_url %>" 
                         target="_blank"
                         class="inline-flex items-center px-3 py-1.5 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                        <svg class="w-4 h-4 mr-1.5 text-red-600" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                        </svg>
                        &nbsp;View Channel
                      </a>
                    </div>
                  </div>

                  <!-- Loading State -->
                  <div data-youtube-videos-target="loadingState" class="hidden">
                    <div class="flex items-center justify-center py-12">
                      <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-red-600"></div>
                      <span class="ml-3 text-gray-600">Loading videos from YouTube...</span>
                    </div>
                  </div>

                  <!-- Error State -->
                  <div data-youtube-videos-target="errorState" class="hidden">
                    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
                      <div class="flex">
                        <div class="flex-shrink-0">
                          <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                          </svg>
                        </div>
                        <div class="ml-3">
                          <h3 class="text-sm font-medium text-red-800">Failed to load videos</h3>
                          <div class="mt-2 text-sm text-red-700">
                            <p class="error-message">An error occurred while fetching videos from YouTube.</p>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Empty State -->
                  <div data-youtube-videos-target="emptyState" class="hidden">
                    <div class="text-center py-12">
                      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                      </svg>
                      <h3 class="mt-2 text-sm font-medium text-gray-900">No videos found</h3>
                      <p class="mt-1 text-sm text-gray-500">Your YouTube channel doesn't have any videos yet, or they may be private.</p>
                    </div>
                  </div>

                  <!-- Videos Grid -->
                  <div data-youtube-videos-target="videosContainer" class="hidden">
                    <div class="mb-4 flex items-center justify-between">
                      <p class="text-sm text-gray-600">Click on videos to show or hide them on your public school page.</p>
                      <div class="text-xs text-gray-500">
                        <span class="inline-flex items-center px-2 py-1 rounded-full bg-green-100 text-green-800 mr-2">
                          <span class="w-2 h-2 bg-green-600 rounded-full mr-1"></span>
                          Visible
                        </span>
                        <span class="inline-flex items-center px-2 py-1 rounded-full bg-red-100 text-red-800">
                          <span class="w-2 h-2 bg-red-600 rounded-full mr-1"></span>
                          Hidden
                        </span>
                      </div>
                    </div>
                    
                    <!-- Videos will be populated here by JavaScript -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" data-youtube-videos-target="videoGrid">
                      <!-- Video cards will be inserted here -->
                    </div>
                  </div>

                  <!-- Help Text -->
                  <div class="mt-6 p-4 bg-blue-50 border border-blue-200 rounded-lg">
                    <div class="flex">
                      <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-blue-400" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                        </svg>
                      </div>
                      <div class="ml-3">
                        <h3 class="text-sm font-medium text-blue-800">How video visibility works</h3>
                        <div class="mt-2 text-sm text-blue-700">
                          <ul class="list-disc space-y-1 pl-4">
                            <li>Videos are visible by default when first loaded</li>
                            <li>Hidden videos won't appear on your public school page</li>
                            <li>Visitors can still access hidden videos directly on YouTube</li>
                            <li>Video data is cached for 30 minutes for better performance</li>
                          </ul>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>

              <!-- Pages Section -->
              <div data-school-form-navigation-target="section" 
                   data-section="pages" 
                   class="hidden bg-white border border-gray-200 rounded-lg p-6"
                   data-controller="page-management">
                <div class="flex items-center justify-between mb-6">
                  <div class="flex items-center">
                    <svg class="w-6 h-6 text-blue-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                    <div>
                      <h2 class="text-lg font-medium text-gray-900">School Pages</h2>
                      <p class="text-sm text-gray-600">Create blog posts and informational pages for your school</p>
                    </div>
                  </div>
                  <button type="button" 
                          id="create-new-page-btn"
                          class="inline-flex items-center px-3 py-1.5 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                    <svg class="-ml-1 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                    </svg>
                    Create New Page
                  </button>
                </div>

                <!-- Tone of Voice Setting -->
                <div class="mb-6 bg-gray-50 rounded-lg p-4">
                  <label for="tone_of_voice" class="block text-sm font-medium text-gray-700 mb-2">
                    Tone of Voice for Generated Content
                  </label>
                  <%= select_tag "school[tone_of_voice]", 
                      options_for_select([
                        ["Professional and Formal", "professional"],
                        ["Warm and Welcoming", "warm"],
                        ["Modern and Dynamic", "modern"],
                        ["Academic and Scholarly", "academic"],
                        ["Friendly and Approachable", "friendly"]
                      ], @school.preferences&.dig("tone_of_voice") || "professional"),
                      class: "block w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
                  <p class="mt-1 text-xs text-gray-500">
                    This setting will be used when generating AI content for your pages
                  </p>
                </div>

                <!-- Pages List -->
                <div class="space-y-4">
                  <% if @school.pages.any? %>
                    <% @school.pages.order(created_at: :desc).each do |page| %>
                      <div class="border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow">
                        <div class="flex items-start justify-between">
                          <div class="flex-1 min-w-0">
                            <h3 class="text-lg font-medium text-gray-900 truncate">
                              <%= page.title %>
                            </h3>
                            <p class="text-sm text-gray-500 mt-1">
                              <%= truncate(page.meta_description || strip_tags(page.content.to_s), length: 150) %>
                            </p>
                            <div class="mt-2 flex items-center space-x-4 text-xs text-gray-500">
                              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full <%= page.status == 'published' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
                                <%= page.status.capitalize %>
                              </span>
                              <span>Type: <%= page.page_type.humanize %></span>
                              <span>Created <%= time_ago_in_words(page.created_at) %> ago</span>
                            </div>
                          </div>
                          <div class="ml-4 flex-shrink-0 flex space-x-2">
                            <button type="button" 
                                    class="edit-page-btn text-blue-600 hover:text-blue-800"
                                    data-page-id="<%= page.id %>"
                                    data-page-title="<%= page.title %>"
                                    data-page-description="<%= page.meta_description %>"
                                    data-page-content="<%= page.content.body.to_html if page.content.present? %>"
                                    data-page-status="<%= page.status %>"
                                    data-page-type="<%= page.page_type %>">
                              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                              </svg>
                            </button>
                            <%= link_to school_page_path(@school, page), class: "text-gray-400 hover:text-gray-600" do %>
                              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                              </svg>
                            <% end %>
                            <%= button_to school_owner_school_page_path(@school, page), 
                                method: :delete,
                                class: "text-red-600 hover:text-red-800",
                                data: { confirm: "Are you sure you want to delete this page?" } do %>
                              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                              </svg>
                            <% end %>
                          </div>
                        </div>
                      </div>
                    <% end %>
                  <% else %>
                    <div class="text-center py-12 bg-gray-50 rounded-lg">
                      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                      </svg>
                      <h3 class="mt-2 text-sm font-medium text-gray-900">No pages yet</h3>
                      <p class="mt-1 text-sm text-gray-500">Get started by creating your first page.</p>
                    </div>
                  <% end %>
                </div>
              </div>

              <!-- Data Import Section -->
              <div data-school-form-navigation-target="section" 
                   data-section="data-import" 
                   class="hidden bg-white border border-gray-200 rounded-lg p-6"
                   data-controller="data-import"
                   data-data-import-school-id-value="<%= @school.id %>">
                <div class="flex items-center mb-6">
                  <svg class="w-6 h-6 text-purple-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"></path>
                  </svg>
                  <div>
                    <h2 class="text-lg font-medium text-gray-900">Data Import</h2>
                    <p class="text-sm text-gray-600">Import content from your website and social media accounts</p>
                  </div>
                </div>

                <!-- Import Sources List -->
                <div class="space-y-4">
                  <!-- Website Import -->
                  <% if @school.website_url.present? %>
                    <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg hover:shadow-sm transition-shadow">
                      <div class="flex items-center space-x-3">
                        <div class="flex-shrink-0">
                          <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9v-9m0-9v9"></path>
                          </svg>
                        </div>
                        <div class="min-w-0 flex-1">
                          <p class="text-sm font-medium text-gray-900">Website</p>
                          <p class="text-sm text-gray-500 truncate"><%= @school.website_url %></p>
                          <% if @school.website_crawled_at.present? %>
                            <p class="text-xs text-gray-400">
                              Last imported: <%= time_ago_in_words(@school.website_crawled_at) %> ago
                              <% if @school.website_crawling_status == 'completed' %>
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800 ml-2">
                                  Success
                                </span>
                              <% elsif @school.website_crawling_status == 'failed' %>
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800 ml-2">
                                  Failed
                                </span>
                              <% end %>
                            </p>
                          <% else %>
                            <p class="text-xs text-gray-400">Never imported</p>
                          <% end %>
                        </div>
                      </div>
                      <div class="flex-shrink-0">
                        <button type="button" 
                                data-action="click->data-import#importWebsite"
                                data-data-import-url-value="<%= @school.website_url %>"
                                class="inline-flex items-center px-3 py-2 border border-transparent text-sm leading-4 font-medium rounded-md text-white bg-purple-600 hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 disabled:opacity-50 disabled:cursor-not-allowed">
                          <svg class="-ml-0.5 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                          </svg>
                          Import
                        </button>
                      </div>
                    </div>
                  <% end %>

                  <!-- Facebook Import -->
                  <% if @school.facebook_url.present? %>
                    <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg opacity-50">
                      <div class="flex items-center space-x-3">
                        <div class="flex-shrink-0">
                          <svg class="w-6 h-6 text-blue-700" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                          </svg>
                        </div>
                        <div class="min-w-0 flex-1">
                          <p class="text-sm font-medium text-gray-900">Facebook</p>
                          <p class="text-sm text-gray-500 truncate"><%= @school.facebook_url %></p>
                          <p class="text-xs text-gray-400">Coming soon</p>
                        </div>
                      </div>
                      <div class="flex-shrink-0">
                        <button type="button" 
                                disabled
                                class="inline-flex items-center px-3 py-2 border border-gray-300 text-sm leading-4 font-medium rounded-md text-gray-500 bg-gray-100 cursor-not-allowed">
                          <svg class="-ml-0.5 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                          </svg>
                          Coming Soon
                        </button>
                      </div>
                    </div>
                  <% end %>

                  <!-- Instagram Import -->
                  <% if @school.instagram_url.present? %>
                    <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg opacity-50">
                      <div class="flex items-center space-x-3">
                        <div class="flex-shrink-0">
                          <svg class="w-6 h-6 text-pink-600" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                          </svg>
                        </div>
                        <div class="min-w-0 flex-1">
                          <p class="text-sm font-medium text-gray-900">Instagram</p>
                          <p class="text-sm text-gray-500 truncate"><%= @school.instagram_url %></p>
                          <p class="text-xs text-gray-400">Coming soon</p>
                        </div>
                      </div>
                      <div class="flex-shrink-0">
                        <button type="button" 
                                disabled
                                class="inline-flex items-center px-3 py-2 border border-gray-300 text-sm leading-4 font-medium rounded-md text-gray-500 bg-gray-100 cursor-not-allowed">
                          <svg class="-ml-0.5 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                          </svg>
                          Coming Soon
                        </button>
                      </div>
                    </div>
                  <% end %>

                  <!-- YouTube Import -->
                  <% if @school.youtube_url.present? %>
                    <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg opacity-50">
                      <div class="flex items-center space-x-3">
                        <div class="flex-shrink-0">
                          <svg class="w-6 h-6 text-red-600" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                          </svg>
                        </div>
                        <div class="min-w-0 flex-1">
                          <p class="text-sm font-medium text-gray-900">YouTube</p>
                          <p class="text-sm text-gray-500 truncate"><%= @school.youtube_url %></p>
                          <p class="text-xs text-gray-400">Coming soon</p>
                        </div>
                      </div>
                      <div class="flex-shrink-0">
                        <button type="button" 
                                disabled
                                class="inline-flex items-center px-3 py-2 border border-gray-300 text-sm leading-4 font-medium rounded-md text-gray-500 bg-gray-100 cursor-not-allowed">
                          <svg class="-ml-0.5 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                          </svg>
                          Coming Soon
                        </button>
                      </div>
                    </div>
                  <% end %>

                  <!-- LinkedIn Import -->
                  <% if @school.linkedin_url.present? %>
                    <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg opacity-50">
                      <div class="flex items-center space-x-3">
                        <div class="flex-shrink-0">
                          <svg class="w-6 h-6 text-blue-800" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                          </svg>
                        </div>
                        <div class="min-w-0 flex-1">
                          <p class="text-sm font-medium text-gray-900">LinkedIn</p>
                          <p class="text-sm text-gray-500 truncate"><%= @school.linkedin_url %></p>
                          <p class="text-xs text-gray-400">Coming soon</p>
                        </div>
                      </div>
                      <div class="flex-shrink-0">
                        <button type="button" 
                                disabled
                                class="inline-flex items-center px-3 py-2 border border-gray-300 text-sm leading-4 font-medium rounded-md text-gray-500 bg-gray-100 cursor-not-allowed">
                          <svg class="-ml-0.5 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                          </svg>
                          Coming Soon
                        </button>
                      </div>
                    </div>
                  <% end %>

                  <!-- Twitter Import -->
                  <% if @school.twitter_url.present? %>
                    <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg opacity-50">
                      <div class="flex items-center space-x-3">
                        <div class="flex-shrink-0">
                          <svg class="w-6 h-6 text-blue-400" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                          </svg>
                        </div>
                        <div class="min-w-0 flex-1">
                          <p class="text-sm font-medium text-gray-900">Twitter</p>
                          <p class="text-sm text-gray-500 truncate"><%= @school.twitter_url %></p>
                          <p class="text-xs text-gray-400">Coming soon</p>
                        </div>
                      </div>
                      <div class="flex-shrink-0">
                        <button type="button" 
                                disabled
                                class="inline-flex items-center px-3 py-2 border border-gray-300 text-sm leading-4 font-medium rounded-md text-gray-500 bg-gray-100 cursor-not-allowed">
                          <svg class="-ml-0.5 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                          </svg>
                          Coming Soon
                        </button>
                      </div>
                    </div>
                  <% end %>

                  <!-- No Sources Message -->
                  <% unless @school.website_url.present? || @school.facebook_url.present? || @school.instagram_url.present? || @school.youtube_url.present? || @school.linkedin_url.present? || @school.twitter_url.present? %>
                    <div class="text-center py-12 bg-gray-50 rounded-lg">
                      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"></path>
                      </svg>
                      <h3 class="mt-2 text-sm font-medium text-gray-900">No data sources available</h3>
                      <p class="mt-1 text-sm text-gray-500">
                        Add your website URL and social media links in the 
                        <a href="#contact-information" 
                           data-action="click->school-form-navigation#navigateToSection"
                           class="text-blue-600 hover:text-blue-800">Contact Information</a> and 
                        <a href="#social-media" 
                           data-action="click->school-form-navigation#navigateToSection"
                           class="text-blue-600 hover:text-blue-800">Social Media</a> sections to enable data import.
                      </p>
                    </div>
                  <% end %>
                </div>

                <!-- Import Status Modal -->
                <div data-data-import-target="statusModal" class="fixed inset-0 z-50 hidden overflow-y-auto" style="z-index: 9999;" aria-labelledby="modal-title" role="dialog" aria-modal="true">
                  <div class="flex items-center justify-center min-h-screen pt-16 px-4 pb-20 text-center sm:pt-20">
                    <div class="fixed inset-0 bg-black bg-opacity-50 transition-opacity" aria-hidden="true"></div>
                    <div class="relative inline-block bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:max-w-lg sm:w-full mx-auto">
                      <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                        <div class="sm:flex sm:items-start">
                          <div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-purple-100 sm:mx-0 sm:h-10 sm:w-10">
                            <svg class="h-6 w-6 text-purple-600 animate-spin" data-data-import-target="loadingIcon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                            </svg>
                            <svg class="h-6 w-6 text-green-600 hidden" data-data-import-target="successIcon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            <svg class="h-6 w-6 text-red-600 hidden" data-data-import-target="errorIcon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                          </div>
                          <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
                            <h3 class="text-lg leading-6 font-medium text-gray-900" data-data-import-target="modalTitle">
                              Importing Data...
                            </h3>
                            <div class="mt-2">
                              <p class="text-sm text-gray-500" data-data-import-target="modalMessage">
                                Please wait while we import data from your website. This may take a few minutes.
                              </p>
                            </div>
                          </div>
                        </div>
                      </div>
                      <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
                        <button type="button" 
                                data-action="click->data-import#closeModal"
                                data-data-import-target="closeButton"
                                class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm disabled:opacity-50 disabled:cursor-not-allowed"
                                disabled>
                          Close
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Page Editor Modal -->
              <div id="page-editor-modal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
                <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
                  <!-- Background overlay -->
                  <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true"></div>
                  
                  <!-- Modal panel -->
                  <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-4xl sm:w-full">
                    <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                      <div class="flex items-center justify-between mb-4">
                        <h3 class="text-lg leading-6 font-medium text-gray-900" id="modal-title">
                          Create New Page
                        </h3>
                        <button type="button" id="close-page-modal" class="text-gray-400 hover:text-gray-500">
                          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                          </svg>
                        </button>
                      </div>
                      
                      <!-- Page Form -->
                      <%= form_tag school_owner_school_pages_path(@school), 
                          id: "page-form",
                          method: :post,
                          class: "space-y-6" do %>
                        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                        <%= hidden_field_tag :page_id, "", id: "page-id" %>
                        
                        <div>
                          <label for="page-title-input" class="block text-sm font-medium text-gray-700">Title</label>
                          <%= text_field_tag "page[title]", "", 
                              id: "page-title-input",
                              class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm",
                              placeholder: "Enter page title" %>
                        </div>
                        
                        <div>
                          <label for="page-description-input" class="block text-sm font-medium text-gray-700">Meta Description</label>
                          <%= text_area_tag "page[meta_description]", "",
                              id: "page-description-input",
                              rows: 2,
                              class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm",
                              placeholder: "Brief description for search engines (optional)" %>
                        </div>
                        
                        <div>
                          <div class="flex items-center justify-between mb-2">
                            <label for="page-content-input" class="block text-sm font-medium text-gray-700">Content</label>
                            <button type="button" 
                                    id="generate-article-btn"
                                    class="inline-flex items-center px-3 py-1 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                              <svg class="-ml-0.5 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                              </svg>
                              Generate with AI
                            </button>
                          </div>
                          
                          <!-- Quill Editor Container -->
                          <div class="quill-container">
                            <input id="page-content-hidden" type="hidden" name="page[content]">
                            <div id="page-content-input" 
                                 class="min-h-[300px] border border-gray-300 rounded-md"
                                 data-placeholder="Write your page content here..."></div>
                          </div>
                        </div>
                        
                        <div class="grid grid-cols-2 gap-4">
                          <div>
                            <label for="page-status-input" class="block text-sm font-medium text-gray-700">Status</label>
                            <%= select_tag "page[status]", 
                                options_for_select([
                                  ["Draft", "draft"],
                                  ["Published", "published"]
                                ], "draft"),
                                id: "page-status-input",
                                class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
                          </div>
                          
                          <div>
                            <label for="page-type-input" class="block text-sm font-medium text-gray-700">Page Type</label>
                            <%= select_tag "page[page_type]", 
                                options_for_select([
                                  ["Blog Post", "blog_post"],
                                  ["News", "news"],
                                  ["Event", "event"],
                                  ["Information", "information"]
                                ], "blog_post"),
                                id: "page-type-input",
                                class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
                          </div>
                        </div>
                        
                        <div class="flex justify-end space-x-3 pt-4 border-t">
                          <button type="button" 
                                  id="cancel-page-btn"
                                  class="inline-flex justify-center py-2 px-4 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                            Cancel
                          </button>
                          <button type="submit" 
                                  class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                            Save Page
                          </button>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>

                        <!-- Form Actions (visible in all sections) -->
              <div class="bg-white border border-gray-200 rounded-lg p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600">
            Changes will be visible to parents and students on your school's public page immediately.
          </p>
          <p class="text-xs text-gray-500 mt-1">
            This includes basic information, academic programs, campus facilities, and photos.
          </p>
        </div>
        
        <div class="flex space-x-3">
          <%= link_to school_owner_school_path(@school), 
              class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" do %>
            Cancel
          <% end %>
          
          <%= form.submit "Save School Information", 
              data: { "school-form-target" => "submitButton" },
              class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 disabled:opacity-50 disabled:cursor-not-allowed" %>
                </div>
                </div>
              </div>

            <% end %>
          </div>
                </div>
                </div>
              </div>
  </div>
</div>
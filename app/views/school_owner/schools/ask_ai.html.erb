<% content_for :title, "Ask AI - #{@school.name}" %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Header -->
  <div class="mb-8">
    <nav class="flex items-center space-x-2 text-sm text-gray-500 mb-4">
      <%= link_to school_owner_schools_path, class: "hover:text-blue-600" do %>
        <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        Back to Schools
      <% end %>
      <span>/</span>
      <%= link_to @school.name, edit_school_owner_school_path(@school), class: "hover:text-blue-600" %>
      <span>/</span>
      <span class="text-gray-900">Ask AI</span>
    </nav>

    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 flex items-center">
          <svg class="w-8 h-8 text-blue-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Ask AI
        </h1>
        <p class="text-gray-600 mt-1">Ask questions about your school using AI powered by your video transcripts and documents</p>
      </div>
    </div>
  </div>

  <!-- Content Statistics Panel -->
  <div class="bg-blue-50 border border-blue-200 rounded-lg p-6 mb-8">
    <div class="flex items-start">
      <div class="flex-shrink-0">
        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <div class="ml-3 flex-1">
        <h3 class="text-sm font-medium text-blue-800">Available Content for AI Queries</h3>
        <div class="mt-2 text-sm text-blue-700">
          <% if @content_stats[:ready_for_ai] %>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div class="flex items-center">
                <svg class="w-4 h-4 text-green-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span><strong><%= @content_stats[:transcripts][:with_embeddings] %></strong> Video Transcripts</span>
              </div>
              <div class="flex items-center">
                <svg class="w-4 h-4 text-green-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span><strong><%= @content_stats[:documents][:with_embeddings] %></strong> Documents</span>
              </div>
              <div class="flex items-center">
                <svg class="w-4 h-4 text-green-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span><strong><%= @content_stats[:segments][:with_embeddings] %></strong> Video Segments</span>
              </div>
            </div>
            <p class="mt-2"><strong><%= @content_stats[:total_searchable_items] %></strong> total items available for AI search</p>
          <% else %>
            <div class="flex items-center text-amber-700">
              <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
              </svg>
              <span>No content ready for AI queries yet. Please upload and process video transcripts or documents first.</span>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- AI Chat Interface -->
  <div class="bg-white border border-gray-200 rounded-lg shadow-sm"
       data-controller="ask-ai"
       data-ask-ai-school-id-value="<%= @school.id %>"
       data-ask-ai-ask-url-value="<%= ask_ai_school_owner_school_path(@school) %>">
    
    <!-- Chat Messages Container -->
    <div class="h-96 overflow-y-auto p-6 border-b border-gray-200" 
         data-ask-ai-target="messagesContainer">
      
      <!-- Welcome Message -->
      <div class="flex items-start mb-6">
        <div class="flex-shrink-0">
          <div class="w-8 h-8 bg-blue-600 rounded-full flex items-center justify-center">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z" clip-rule="evenodd"></path>
            </svg>
          </div>
        </div>
        <div class="ml-3 flex-1">
          <div class="bg-gray-50 rounded-lg p-4">
            <div class="text-sm text-gray-600 mb-2">
              <span class="font-medium text-blue-600">AI Assistant</span>
            </div>
            <div class="text-gray-900">
              <p>Hello! I'm here to help answer questions about <%= @school.name %>. I can search through your video transcripts and documents to provide accurate information.</p>
              <% if @content_stats[:ready_for_ai] %>
                <p class="mt-2">Try asking me about:</p>
                <ul class="mt-1 text-sm text-gray-600 list-disc list-inside">
                  <li>Your school's programs and curriculum</li>
                  <li>Facilities and campus features</li>
                  <li>Admission requirements and process</li>
                  <li>School policies and procedures</li>
                  <li>Any topic covered in your videos or documents</li>
                </ul>
              <% else %>
                <p class="mt-2 text-amber-600">⚠️ Please process some video transcripts or upload documents first to enable AI queries.</p>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Dynamic messages will be inserted here -->
      <div data-ask-ai-target="messages"></div>
      
      <!-- Loading indicator (hidden by default) -->
      <div class="flex items-start mb-6 hidden" data-ask-ai-target="loadingMessage">
        <div class="flex-shrink-0">
          <div class="w-8 h-8 bg-blue-600 rounded-full flex items-center justify-center">
            <svg class="w-4 h-4 text-white animate-spin" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </div>
        </div>
        <div class="ml-3 flex-1">
          <div class="bg-gray-50 rounded-lg p-4">
            <div class="text-sm text-gray-600 mb-2">
              <span class="font-medium text-blue-600">AI Assistant</span>
            </div>
            <div class="text-gray-600">
              <div class="flex items-center">
                <div class="flex space-x-1">
                  <div class="w-2 h-2 bg-blue-400 rounded-full animate-bounce"></div>
                  <div class="w-2 h-2 bg-blue-400 rounded-full animate-bounce" style="animation-delay: 0.1s;"></div>
                  <div class="w-2 h-2 bg-blue-400 rounded-full animate-bounce" style="animation-delay: 0.2s;"></div>
                </div>
                <span class="ml-2 text-sm">Searching through your content...</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Input Area -->
    <div class="p-6">
      <form data-ask-ai-target="questionForm" data-action="submit->ask-ai#askQuestion">
        <div class="flex space-x-4">
          <div class="flex-1">
            <label for="question" class="sr-only">Ask a question</label>
            <input type="text" 
                   name="question" 
                   id="question"
                   data-ask-ai-target="questionInput"
                   class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
                   placeholder="Ask me anything about your school..."
                   <% unless @content_stats[:ready_for_ai] %>disabled<% end %>>
          </div>
          <button type="submit"
                  data-ask-ai-target="submitButton"
                  class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 disabled:opacity-50 disabled:cursor-not-allowed"
                  <% unless @content_stats[:ready_for_ai] %>disabled<% end %>>
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
            </svg>
            Ask AI
          </button>
        </div>
        
        <% unless @content_stats[:ready_for_ai] %>
          <p class="mt-2 text-sm text-gray-500">
            AI queries are disabled until you have processed content. 
            <%= link_to "Upload videos", edit_school_owner_school_path(@school, anchor: 'videos'), class: "text-blue-600 hover:text-blue-800" %> 
            or documents to get started.
          </p>
        <% end %>
      </form>
      
      <!-- Example Questions -->
      <% if @content_stats[:ready_for_ai] %>
        <div class="mt-4">
          <p class="text-xs text-gray-500 mb-2">Try these example questions:</p>
          <div class="flex flex-wrap gap-2">
            <button type="button" 
                    data-action="click->ask-ai#useExample"
                    data-question="What programs do you offer?"
                    class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700 hover:bg-gray-200">
              What programs do you offer?
            </button>
            <button type="button" 
                    data-action="click->ask-ai#useExample"
                    data-question="What facilities does the school have?"
                    class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700 hover:bg-gray-200">
              What facilities does the school have?
            </button>
            <button type="button" 
                    data-action="click->ask-ai#useExample"
                    data-question="How can I apply for admission?"
                    class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700 hover:bg-gray-200">
              How can I apply for admission?
            </button>
            <button type="button" 
                    data-action="click->ask-ai#useExample"
                    data-question="What makes this school unique?"
                    class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700 hover:bg-gray-200">
              What makes this school unique?
            </button>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Usage Tips -->
  <div class="mt-8 bg-gray-50 rounded-lg p-6">
    <h3 class="text-sm font-medium text-gray-900 mb-3">Tips for Better Results</h3>
    <ul class="text-sm text-gray-600 space-y-1">
      <li class="flex items-start">
        <svg class="w-4 h-4 text-green-500 mt-0.5 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
        </svg>
        Ask specific questions about topics covered in your videos and documents
      </li>
      <li class="flex items-start">
        <svg class="w-4 h-4 text-green-500 mt-0.5 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
        </svg>
        The AI will cite specific video segments and documents as sources
      </li>
      <li class="flex items-start">
        <svg class="w-4 h-4 text-green-500 mt-0.5 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
        </svg>
        Upload more video transcripts and documents for more comprehensive answers
      </li>
      <li class="flex items-start">
        <svg class="w-4 h-4 text-green-500 mt-0.5 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
        </svg>
        Responses are based only on your school's content - no external information is used
      </li>
    </ul>
  </div>
</div>
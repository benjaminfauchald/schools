<% content_for :title, "Ask AI - #{@school.name}" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" data-controller="ai-chat" 
     data-ai-chat-school-id-value="<%= @school.id %>"
     data-ai-chat-conversation-id-value="<%= @conversation&.id %>"
     data-ai-chat-messages-url-value="<%= ai_chat_message_school_owner_school_path(@school) %>"
     data-ai-chat-suggestions-url-value="<%= ai_suggestions_school_owner_school_path(@school) %>"
     data-ai-chat-analysis-url-value="<%= ai_analysis_school_owner_school_path(@school) %>"
     data-ai-chat-existing-sources-value="[]">

  <!-- Header -->
  <div class="bg-white shadow-sm rounded-lg mb-6 p-4 sm:p-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center space-x-4">
        <div class="bg-blue-100 rounded-full p-3">
          <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-4l-4 4z"></path>
          </svg>
        </div>
        <div>
          <h1 class="text-2xl font-bold text-gray-900">Ask AI about <%= @school.name %></h1>
          <p class="text-gray-600">Get insights about your school data, ask questions, and discover improvement opportunities</p>
        </div>
      </div>
      
      <div class="flex items-center space-x-4">
        <!-- Profile Completeness Score -->
        <div class="bg-gray-50 rounded-lg p-4 text-center">
          <div class="text-2xl font-bold text-blue-600" data-ai-chat-target="completenessScore">
            <%= @completeness_score %>%
          </div>
          <div class="text-sm text-gray-500">Profile Complete</div>
        </div>
        
        <!-- Source Count Display -->
        <div class="bg-gray-50 rounded-lg p-4 text-center" data-ai-chat-target="sourceCount">
          <div class="text-lg font-bold text-green-600" data-ai-chat-target="sourceCountNumber">Loading...</div>
          <div class="text-sm text-gray-500">Sources Available</div>
        </div>
        
        <!-- Analysis Button -->
        <button type="button" 
                class="bg-purple-600 text-white px-4 py-2 rounded-md hover:bg-purple-700 transition-colors"
                data-action="click->ai-chat#runAnalysis"
                data-ai-chat-target="analysisButton">
          <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
          </svg>
          Analyze Data
        </button>
      </div>
    </div>
  </div>

  <!-- 3-Column Grid Layout -->
  <div class="grid grid-cols-12 gap-6">
    
    <!-- Left Column: Suggested Questions + Quick Actions -->
    <div class="col-span-12 lg:col-span-3">
      <div class="bg-white shadow-sm rounded-lg p-6 sticky top-6">
        <!-- Suggested Questions -->
        <div class="mb-8">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Suggested Questions</h3>
          
          <div class="space-y-3" data-ai-chat-target="suggestedQuestions">
            <% if @suggested_questions&.any? %>
              <% @suggested_questions.each do |question| %>
                <button
                  type="button"
                  class="w-full text-left p-3 bg-gray-50 hover:bg-blue-50 rounded-lg text-sm transition-colors border border-gray-200 hover:border-blue-200"
                  data-action="click->ai-chat#sendSuggestedQuestion"
                  data-message="<%= question[:text] %>">
                  <div class="flex items-start">
                    <svg class="w-4 h-4 text-blue-500 mr-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span class="text-gray-700"><%= question[:text] %></span>
                  </div>
                </button>
              <% end %>
            <% end %>
          </div>
          
          <button
            type="button"
            class="w-full mt-4 text-blue-600 hover:text-blue-800 text-sm font-medium flex items-center justify-center py-2"
            data-action="click->ai-chat#refreshSuggestions">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
            </svg>
            Refresh Suggestions
          </button>
        </div>
        
        <!-- Quick Actions -->
        <div>
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Quick Actions</h3>
          
          <div class="space-y-3">
            <button
              type="button"
              class="w-full flex items-center p-4 bg-purple-50 hover:bg-purple-100 rounded-lg text-sm transition-colors border border-purple-200"
              data-action="click->ai-chat#runAnalysis">
              <svg class="w-5 h-5 text-purple-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
              </svg>
              <div class="text-left">
                <div class="font-medium text-purple-900">Analyze Profile</div>
                <div class="text-purple-700 text-xs">Get improvement suggestions</div>
              </div>
            </button>
            
            <button
              type="button"
              class="w-full flex items-center p-4 bg-green-50 hover:bg-green-100 rounded-lg text-sm transition-colors border border-green-200"
              data-action="click->ai-chat#sendSuggestedQuestion"
              data-message="What information am I missing that would improve my school's visibility?">
              <svg class="w-5 h-5 text-green-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <div class="text-left">
                <div class="font-medium text-green-900">Check Missing Data</div>
                <div class="text-green-700 text-xs">Find gaps in your profile</div>
              </div>
            </button>
            
            <button
              type="button"
              class="w-full flex items-center p-4 bg-blue-50 hover:bg-blue-100 rounded-lg text-sm transition-colors border border-blue-200"
              data-action="click->ai-chat#sendSuggestedQuestion"
              data-message="How does my school compare to other international schools?">
              <svg class="w-5 h-5 text-blue-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
              </svg>
              <div class="text-left">
                <div class="font-medium text-blue-900">Compare Schools</div>
                <div class="text-blue-700 text-xs">Competitive analysis</div>
              </div>
            </button>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Center Column: Chat Messages -->
    <div class="col-span-12 lg:col-span-6">
      <!-- Message Input Area at Top (White Background) -->
      <div class="bg-white rounded-t-lg shadow-sm p-4 border-b border-gray-200">
        <form data-action="submit->ai-chat#sendMessage">
          <div class="flex space-x-3">
            <div class="flex-1">
              <textarea
                data-ai-chat-target="messageInput"
                placeholder="Ask me anything about your school..."
                class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-none text-sm"
                rows="2"
                data-action="keydown->ai-chat#handleKeydown"></textarea>
            </div>
            <button
              type="submit"
              data-ai-chat-target="sendButton"
              class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors disabled:bg-gray-400 disabled:cursor-not-allowed flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
              </svg>
            </button>
          </div>
        </form>
      </div>
      
      <!-- Chat Messages Area (Light Gray Background with Scrollbar) -->
      <div class="bg-gray-50 rounded-b-lg shadow-sm">
        <!-- Messages Container with Fixed Height and Scroll -->
        <div class="h-[600px] p-6 overflow-y-auto" data-ai-chat-target="messagesContainer">
          <div class="space-y-6">
            <!-- Loading indicator at top -->
            <div class="flex items-start space-x-3 hidden" data-ai-chat-target="loadingMessage">
              <div class="bg-blue-100 rounded-full p-2 flex-shrink-0">
                <svg class="w-5 h-5 text-blue-600 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                </svg>
              </div>
              <div class="flex-1">
                <div class="bg-white rounded-lg p-4 shadow-sm">
                  <div class="text-sm text-gray-600">AI is thinking...</div>
                </div>
              </div>
            </div>
            
            <!-- Existing Messages - NEWEST FIRST (reverse order) -->
            <% @messages.reverse.each do |message| %>
              <% if message.user_message? %>
                <!-- User Question -->
                <div class="flex items-start space-x-3 flex-row-reverse space-x-reverse">
                  <div class="bg-blue-600 rounded-full p-2 flex-shrink-0">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                  </div>
                  <div class="flex-1">
                    <div class="bg-white rounded-lg p-4 shadow-sm">
                      <div class="text-gray-800 text-sm"><%= message.content %></div>
                      <div class="text-xs text-gray-500 mt-2"><%= message.age_display %></div>
                    </div>
                  </div>
                </div>
              <% else %>
                <!-- AI Answer -->
                <div class="flex items-start space-x-3">
                  <div class="bg-blue-100 rounded-full p-2 flex-shrink-0">
                    <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                  </div>
                  <div class="flex-1">
                    <div class="bg-white rounded-lg p-4 shadow-sm">
                      <div class="text-gray-600 text-sm" data-ai-chat-target="messageContent"><%= raw message.content %></div>
                      
                      <!-- Source References -->
                      <% if message.has_sources? %>
                        <div class="mt-3 pt-3 border-t border-gray-200">
                          <div class="text-xs text-blue-600 font-medium mb-2">Sources:</div>
                          <% message.formatted_sources.first(2).each do |source| %>
                            <div class="text-xs text-gray-600 mb-1">
                              <%= source['icon'] %> <%= source['type'] %>: <%= source['title'] %>
                            </div>
                          <% end %>
                        </div>
                      <% end %>
                      
                      <div class="text-xs text-gray-500 mt-2"><%= message.age_display %></div>
                    </div>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Right Column: Sources Sidebar -->
    <div class="col-span-12 lg:col-span-3">
      <div class="bg-white shadow-sm rounded-lg p-6 sticky top-6">
        <div data-ai-chat-target="sourcesSidebar">
          <h3 class="text-sm font-semibold text-gray-900 mb-3 flex items-center">
            <svg class="w-4 h-4 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            Sources Used
          </h3>
          
          <div class="text-xs text-gray-500 italic">
            Sources will appear here as the AI references them in responses.
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Safe JSON data passing -->
<script type="application/json" id="ai-chat-existing-sources">
<%= (@messages.flat_map(&:formatted_sources) || []).to_json.html_safe %>
</script>
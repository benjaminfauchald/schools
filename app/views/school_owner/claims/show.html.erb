<% content_for :title, "Claim Details - #{@claim.school.name}" %>

<div class="max-w-4xl mx-auto">
  <!-- Header -->
  <div class="mb-6">
    <%= link_to school_owner_claims_path, class: "inline-flex items-center text-blue-600 hover:text-blue-800 mb-4" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      Back to Claims
    <% end %>
    
    <h1 class="text-2xl font-bold text-gray-900">School Claim Details</h1>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Content -->
    <div class="lg:col-span-2">
      <!-- Claim Status Card -->
      <div class="bg-white border border-gray-200 rounded-lg p-6 mb-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-medium text-gray-900">Claim Status</h2>
          <% case @claim.status %>
          <% when 'pending' %>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">
              <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
              </svg>
              Pending Review
            </span>
          <% when 'approved' %>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
              <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              Approved
            </span>
          <% when 'rejected' %>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
              <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
              </svg>
              Rejected
            </span>
          <% end %>
        </div>

        <% if @claim.pending? %>
          <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
            <p class="text-sm text-yellow-800">
              <strong>Your claim is being reviewed.</strong> 
              Our team will verify your evidence and respond within 3-5 business days.
              You submitted this claim <%= time_ago_in_words(@claim.created_at) %> ago.
            </p>
          </div>
        <% elsif @claim.approved? %>
          <div class="bg-green-50 border border-green-200 rounded-lg p-4">
            <p class="text-sm text-green-800">
              <strong>Congratulations!</strong> Your claim has been approved. 
              You can now manage this school's information.
            </p>
            <div class="mt-3">
              <%= link_to "Manage School", school_owner_school_path(@claim.school), 
                  class: "inline-flex items-center px-3 py-1 border border-transparent text-sm font-medium rounded-md text-green-700 bg-green-100 hover:bg-green-200" %>
            </div>
          </div>
        <% elsif @claim.rejected? %>
          <div class="bg-red-50 border border-red-200 rounded-lg p-4">
            <p class="text-sm text-red-800">
              <strong>Claim Rejected.</strong> 
              <% if @claim.admin_notes.present? %>
                Our review found the following issues:
              <% else %>
                Please contact support if you have questions about this decision.
              <% end %>
            </p>
          </div>
        <% end %>
      </div>

      <!-- Evidence & Notes -->
      <div class="bg-white border border-gray-200 rounded-lg p-6">
        <h3 class="text-lg font-medium text-gray-900 mb-4">Claim Details</h3>
        
        <div class="space-y-4">
          <!-- Evidence URL -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Evidence Documentation</label>
            <% if @claim.evidence_url.present? %>
              <a href="<%= @claim.evidence_url %>" target="_blank" 
                 class="inline-flex items-center text-blue-600 hover:text-blue-800 text-sm">
                <%= @claim.evidence_url %>
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                </svg>
              </a>
            <% else %>
              <span class="text-gray-500 text-sm">No evidence URL provided</span>
            <% end %>
          </div>

          <!-- Notes -->
          <% if @claim.notes.present? %>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Your Notes</label>
              <div class="bg-gray-50 rounded-lg p-3">
                <p class="text-sm text-gray-700 whitespace-pre-wrap"><%= @claim.notes %></p>
              </div>
            </div>
          <% end %>

          <!-- Admin Notes (if rejected) -->
          <% if @claim.admin_notes.present? %>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Admin Response</label>
              <div class="bg-red-50 border border-red-200 rounded-lg p-3">
                <p class="text-sm text-red-700 whitespace-pre-wrap"><%= @claim.admin_notes %></p>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="lg:col-span-1">
      <!-- School Info -->
      <div class="bg-white border border-gray-200 rounded-lg p-6 mb-6">
        <h3 class="text-lg font-medium text-gray-900 mb-4">School Information</h3>
        
        <div class="space-y-3">
          <div>
            <h4 class="text-sm font-medium text-gray-700"><%= @claim.school.name %></h4>
            <p class="text-sm text-gray-600"><%= @claim.school.display_address %></p>
          </div>
          
          <% if @claim.school.display_phone.present? %>
            <div>
              <span class="text-sm text-gray-500">Phone: </span>
              <span class="text-sm text-gray-900"><%= @claim.school.display_phone %></span>
            </div>
          <% end %>
          
          <% if @claim.school.display_website.present? %>
            <div>
              <span class="text-sm text-gray-500">Website: </span>
              <a href="<%= @claim.school.display_website %>" target="_blank" 
                 class="text-sm text-blue-600 hover:text-blue-800">
                <%= @claim.school.display_website %>
              </a>
            </div>
          <% end %>
        </div>

        <div class="mt-4 pt-4 border-t border-gray-200">
          <%= link_to "View Public Page", school_path(@claim.school), target: "_blank",
              class: "inline-flex items-center text-blue-600 hover:text-blue-800 text-sm" %>
        </div>
      </div>

      <!-- Claim Timeline -->
      <div class="bg-white border border-gray-200 rounded-lg p-6">
        <h3 class="text-lg font-medium text-gray-900 mb-4">Timeline</h3>
        
        <div class="space-y-3">
          <div class="flex items-start">
            <div class="flex-shrink-0 w-2 h-2 bg-blue-400 rounded-full mt-2"></div>
            <div class="ml-3">
              <p class="text-sm text-gray-900">Claim submitted</p>
              <p class="text-xs text-gray-500"><%= @claim.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
            </div>
          </div>
          
          <% if @claim.approved? || @claim.rejected? %>
            <div class="flex items-start">
              <div class="flex-shrink-0 w-2 h-2 bg-<%= @claim.approved? ? 'green' : 'red' %>-400 rounded-full mt-2"></div>
              <div class="ml-3">
                <p class="text-sm text-gray-900">Claim <%= @claim.status %></p>
                <p class="text-xs text-gray-500"><%= @claim.updated_at.strftime("%B %d, %Y at %I:%M %p") %></p>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="w-full">
  
  <!-- Navigation -->
  <div class="mb-6">
    <%= link_to school_path(@school), class: "inline-flex items-center text-blue-600 hover:text-blue-800 transition-colors" do %>
      <%= heroicon('arrow-left', css_class: 'w-4 h-4 mr-2') %>
      Back to <%= @school.name %>
    <% end %>
  </div>

  <!-- Header -->
  <header class="mb-8">
    <div class="mb-4">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
        About Us
      </span>
    </div>
    
    <h1 class="text-4xl font-bold text-black mb-4">
      About <%= @school.name %>
    </h1>
  </header>

  <!-- Basic School Information -->
  <main class="prose prose-lg max-w-none">
    <div class="bg-white rounded-lg shadow-sm border p-8 space-y-6">
      
      <!-- School Overview -->
      <section>
        <h2 class="text-2xl font-semibold text-black mb-4">School Overview</h2>
        
        <% if @school.about.present? %>
          <div class="text-gray-700 mb-4">
            <%= simple_format(@school.about) %>
          </div>
        <% end %>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-gray-700">
          <% if @school.founded_year.present? %>
            <div>
              <strong>Founded:</strong> <%= @school.founded_year %>
            </div>
          <% end %>
          
          <% if @school.ownership.present? %>
            <div>
              <strong>Type:</strong> <%= @school.ownership.humanize %>
            </div>
          <% end %>
          
          <% if @school.boarding %>
            <div>
              <strong>Boarding:</strong> Available
            </div>
          <% end %>
          
          <% if @school.school_bus %>
            <div>
              <strong>Transportation:</strong> School bus available
            </div>
          <% end %>
        </div>
      </section>

      <!-- Academic Information -->
      <% if @school.school_grade_offering %>
        <section>
          <h2 class="text-2xl font-semibold text-black mb-4">Academic Programs</h2>
          
          <div class="text-gray-700">
            <% offering = @school.school_grade_offering %>
            
            <% if offering.grades.present? %>
              <div class="mb-3">
                <strong>Grade Levels:</strong> <%= offering.grades %>
              </div>
            <% end %>
            
            <% if offering.min_age && offering.max_age %>
              <div class="mb-3">
                <strong>Age Range:</strong> <%= offering.min_age.to_i %>-<%= offering.max_age.to_i %> years
              </div>
            <% end %>
            
            <% if offering.notes.present? %>
              <div class="mb-3">
                <strong>Additional Information:</strong> <%= offering.notes %>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>

      <!-- Curricula and Programs -->
      <% curricula = @school.curricula.pluck(:label) %>
      <% if curricula.any? %>
        <section>
          <h2 class="text-2xl font-semibold text-black mb-4">Curriculum</h2>
          <div class="text-gray-700">
            <ul class="list-disc list-inside">
              <% curricula.each do |curriculum| %>
                <li><%= curriculum %></li>
              <% end %>
            </ul>
          </div>
        </section>
      <% end %>

      <!-- Languages -->
      <% languages = @school.languages.pluck(:label) %>
      <% if languages.any? %>
        <section>
          <h2 class="text-2xl font-semibold text-black mb-4">Languages</h2>
          <div class="text-gray-700">
            <ul class="list-disc list-inside">
              <% languages.each do |language| %>
                <li><%= language %></li>
              <% end %>
            </ul>
          </div>
        </section>
      <% end %>

      <!-- Facilities -->
      <% facilities = @school.facilities.pluck(:label) %>
      <% if facilities.any? %>
        <section>
          <h2 class="text-2xl font-semibold text-black mb-4">Facilities</h2>
          <div class="text-gray-700">
            <ul class="list-disc list-inside space-y-1">
              <% facilities.each do |facility| %>
                <li><%= facility %></li>
              <% end %>
            </ul>
          </div>
        </section>
      <% end %>

      <!-- Accreditations -->
      <% accreditations = @school.accreditations.pluck(:label) %>
      <% if accreditations.any? %>
        <section>
          <h2 class="text-2xl font-semibold text-black mb-4">Accreditations</h2>
          <div class="text-gray-700">
            <ul class="list-disc list-inside">
              <% accreditations.each do |accreditation| %>
                <li><%= accreditation %></li>
              <% end %>
            </ul>
          </div>
        </section>
      <% end %>

      <!-- Contact Information -->
      <section>
        <h2 class="text-2xl font-semibold text-black mb-4">Contact Information</h2>
        
        <div class="text-gray-700 space-y-2">
          <% if @school.display_address.present? %>
            <div>
              <strong>Address:</strong> <%= @school.display_address %>
            </div>
          <% end %>
          
          <% if @school.display_phone.present? %>
            <div>
              <strong>Phone:</strong> 
              <a href="tel:<%= @school.display_phone.gsub(/\D/, '') %>" class="text-blue-600 hover:text-blue-800">
                <%= @school.display_phone %>
              </a>
            </div>
          <% end %>
          
          <% if @school.email.present? %>
            <div>
              <strong>Email:</strong> 
              <a href="mailto:<%= @school.email %>" class="text-blue-600 hover:text-blue-800">
                <%= @school.email %>
              </a>
            </div>
          <% end %>
          
          <% if @school.display_website.present? %>
            <div>
              <strong>Website:</strong> 
              <a href="<%= @school.display_website %>" target="_blank" class="text-blue-600 hover:text-blue-800">
                <%= @school.display_website.gsub(%r{^https?://(www\.)?}, '') %>
              </a>
            </div>
          <% end %>
        </div>
      </section>

      <!-- Call to Action -->
      <section class="bg-blue-50 p-6 rounded-lg">
        <h3 class="text-xl font-semibold text-black mb-3">Interested in Learning More?</h3>
        <p class="text-gray-700 mb-4">
          We welcome prospective students and families to learn more about our school community.
        </p>
        <div class="flex flex-wrap gap-4">
          <% if @school.display_phone.present? %>
            <a href="tel:<%= @school.display_phone.gsub(/\D/, '') %>" 
               class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
              <%= heroicon('phone', css_class: 'w-4 h-4 mr-2') %>
              Call Us
            </a>
          <% end %>
          
          <% if @school.display_website.present? %>
            <a href="<%= @school.display_website %>" target="_blank"
               class="inline-flex items-center px-4 py-2 border border-blue-600 text-blue-600 rounded-lg hover:bg-blue-50 transition-colors">
              <%= heroicon('external-link', css_class: 'w-4 h-4 mr-2') %>
              Visit Website
            </a>
          <% end %>
        </div>
      </section>

    </div>
  </main>

</div>
<!-- Footer -->
<br>
<footer class="bg-gray-50 border-t border-gray-200 mt-auto">
  <!-- Breathing room above footer -->
  <br>
  <div class="pt-12 pb-8">
    <div class="container mx-auto px-5">
      <div class="flex flex-col md:flex-row items-center justify-between">
        <!-- Left side - Links -->
        <div class="flex flex-wrap items-center space-x-6 mb-4 md:mb-0">
          <%= link_to terms_of_service_path, class: "text-gray-600 hover:text-gray-900 font-medium transition-colors text-sm" do %>
            Terms of Service
          <% end %>
          
          <span class="text-gray-300">•</span>
          
          <%= link_to privacy_policy_path, class: "text-gray-600 hover:text-gray-900 font-medium transition-colors text-sm" do %>
            Privacy Policy
          <% end %>
        </div>
        
        <!-- Right side - Copyright -->
        <div class="text-gray-500 text-sm">
          © <%= Date.current.year %> Schools Listing. All rights reserved.
        </div>
        
      </div>
    </div>
  </div>
</footer>
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  
  <!-- Homepage -->
  <url>
    <loc><%= root_url %></loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
    <lastmod><%= Date.current.iso8601 %></lastmod>
  </url>
  
  <!-- School listings -->
  <url>
    <loc><%= root_url %></loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
    <lastmod><%= Date.current.iso8601 %></lastmod>
  </url>
  
  <!-- Individual School Pages -->
  <% @schools.find_each do |school| %>
    <url>
      <loc><%= school_url(id: school.id) %></loc>
      <changefreq>weekly</changefreq>
      <priority>0.8</priority>
      <lastmod><%= (school.updated_at || Date.current).iso8601 %></lastmod>
    </url>
  <% end %>
  
  <!-- School Pages (about, programs, etc.) -->
  <% @pages.find_each do |page| %>
    <url>
      <loc><%= school_page_url(page.school, page) %></loc>
      <changefreq>monthly</changefreq>
      <priority>0.6</priority>
      <lastmod><%= (page.updated_at || Date.current).iso8601 %></lastmod>
    </url>
  <% end %>
  
  <!-- Static Pages -->
  <url>
    <loc><%= terms_of_service_url %></loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
    <lastmod><%= Date.current.iso8601 %></lastmod>
  </url>
  
  <url>
    <loc><%= privacy_policy_url %></loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
    <lastmod><%= Date.current.iso8601 %></lastmod>
  </url>
  
</urlset>
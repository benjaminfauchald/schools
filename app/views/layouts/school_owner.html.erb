<!DOCTYPE html>
<html>
  <head>
    <title>School Owner Dashboard - <%= content_for?(:title) ? yield(:title) : "Bangkok School Directory" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    
    <!-- TinyMCE JavaScript -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tinymce/6.8.2/tinymce.min.js"></script>
    
    <!-- Custom styles for TinyMCE editor -->
    <style>
      /* TinyMCE will naturally inherit Tailwind classes since they're not scoped */
      .tox-tinymce {
        border-radius: 0.375rem;
        border: 1px solid #d1d5db;
      }
    </style>
    
    <%= javascript_importmap_tags %>
    
    <!-- Flowbite CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.3.0/flowbite.min.css" rel="stylesheet" />
  </head>

  <body class="bg-gray-50">
    <!-- Navigation -->
    <nav class="bg-white border-b border-gray-200 sticky top-0 z-40" data-controller="layout-navigation">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex items-center">
            <%= link_to school_owner_dashboard_index_path, class: "flex items-center space-x-2" do %>
              <span class="font-bold text-xl text-blue-600">School Owner&nbsp;</span>
            <% end %>
            <% if content_for?(:school_name) %>
              <span class="text-xl font-medium text-gray-900"> / <%= yield(:school_name) %></span>
            <% end %>
          </div>
          
          <!-- Navigation Links (Desktop) -->
          <div class="hidden md:flex items-center space-x-8 ml-auto">
            <%= link_to "Dashboard", school_owner_dashboard_index_path, 
                class: "text-gray-700 hover:text-blue-600 px-3 py-2 text-sm font-medium" %>
            <%= link_to "My Schools", school_owner_schools_path, 
                class: "text-gray-700 hover:text-blue-600 px-3 py-2 text-sm font-medium" %>
          </div>
          
          <!-- User Menu & Mobile Hamburger -->
          <div class="flex items-center space-x-4">
            <!-- Hamburger Menu Button (Mobile) -->
            <button type="button" 
                    class="md:hidden inline-flex items-center justify-center p-2 rounded-md text-gray-400 hover:text-gray-500 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-blue-500"
                    data-action="click->layout-navigation#toggleMobileMenu">
              <span class="sr-only">Open main menu</span>
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </button>
            
            <!-- User Dropdown -->
            <div class="relative">
              <button type="button" class="flex items-center space-x-2 text-gray-700 hover:text-blue-600" 
                      data-dropdown-toggle="user-dropdown">
                <span class="text-sm"><%= current_user.display_name %></span>
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                </svg>
              </button>
              
              <div id="user-dropdown" class="hidden absolute right-0 mt-2 w-48 bg-white border border-gray-200 rounded-md shadow-lg z-50">
                <div class="py-1">
                  <%= link_to "View Public Site", root_path, 
                      class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
                  <hr class="my-1">
                  <%= link_to "Sign Out", destroy_user_session_path, method: :delete,
                      class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Mobile Menu -->
      <div data-layout-navigation-target="mobileMenu" class="md:hidden hidden">
        <div class="px-2 pt-2 pb-3 space-y-1 bg-white border-b border-gray-200">
          <%= link_to "Dashboard", school_owner_dashboard_index_path, 
              class: "text-gray-700 hover:text-blue-600 hover:bg-gray-50 block px-3 py-2 rounded-md text-base font-medium",
              data: { action: "click->layout-navigation#closeMobileMenu" } %>
          <%= link_to "My Schools", school_owner_schools_path, 
              class: "text-gray-700 hover:text-blue-600 hover:bg-gray-50 block px-3 py-2 rounded-md text-base font-medium",
              data: { action: "click->layout-navigation#closeMobileMenu" } %>
        </div>
      </div>
    </nav>

    <!-- Flash Messages -->
    <% if notice %>
      <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded mb-4 mx-4 mt-4">
        <%= notice %>
      </div>
    <% end %>
    
    <% if alert %>
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded mb-4 mx-4 mt-4">
        <%= alert %>
      </div>
    <% end %>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
      <%= yield %>
    </main>

    <!-- Flowbite JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.3.0/flowbite.min.js"></script>
  </body>
</html>
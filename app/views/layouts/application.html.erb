<!DOCTYPE html>
<html lang="en" data-rails-env="<%= Rails.env %>">
  <head>
    <title><%= content_for(:title) || "Schools" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <%# Google Maps API Key for centralized loading %>
    <meta name="google-maps-api-key" content="<%= Rails.application.credentials.dig(:google_maps, :api_key) || ENV['GOOGLE_PLACES_API_KEY'] || '' %>">
    
    <%# Debug mode for JavaScript console logging %>
    <meta name="debug-mode" content="<%= ENV['DEBUG_MODE'] == 'on' ? 'true' : 'false' %>">

    <%= yield :head %>
    
    <!-- Facebook JavaScript SDK -->
    <script>
      window.fbAsyncInit = function() {
        console.log('🔵 Facebook SDK: fbAsyncInit called');
        console.log('🔵 Facebook SDK: Current URL:', window.location.href);
        console.log('🔵 Facebook SDK: Protocol:', window.location.protocol);
        console.log('🔵 Facebook SDK: Hostname:', window.location.hostname);
        
        // Only initialize Facebook SDK if we have HTTPS or in development with mock
        const isHTTPS = window.location.protocol === 'https:';
        const isDevelopment = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
        const isAllowedDomain = window.location.hostname === 'listing.connectica.no' || window.location.hostname === 'connectica.no';
        
        console.log('🔵 Facebook SDK: isHTTPS:', isHTTPS);
        console.log('🔵 Facebook SDK: isDevelopment:', isDevelopment);
        console.log('🔵 Facebook SDK: isAllowedDomain:', isAllowedDomain);
        console.log('🔵 Facebook SDK: App ID:', '<%= ENV['FACEBOOK_APP_ID'] %>');
        
        if (!isHTTPS && !isDevelopment) {
          console.error('❌ Facebook SDK requires HTTPS in production');
          return;
        }
        
        try {
          FB.init({
            appId      : '<%= ENV['FACEBOOK_APP_ID'] %>',
            cookie     : true,
            xfbml      : true,
            version    : 'v18.0',
            status     : true,
            oauth      : true
          });
          
          console.log('✅ Facebook SDK: FB.init() completed successfully');
          
          FB.AppEvents.logPageView();
          console.log('✅ Facebook SDK: Page view logged');
        } catch (error) {
          console.error('❌ Facebook SDK: FB.init() failed:', error);
        }
        
        // Check if user just logged out (cookie set by server)
        const justLoggedOut = document.cookie.includes('facebook_logout=true');
        
        if (justLoggedOut) {
          console.log('🔵 Facebook SDK: User just logged out, skipping auto-login');
          // Don't check login status or auto-sync if user just logged out
          // Clear the logout cookie
          document.cookie = 'facebook_logout=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
        } else if (isHTTPS || isDevelopment || isAllowedDomain) {
          // Only check login status if we have HTTPS or in development AND user didn't just logout
          console.log('🔵 Facebook SDK: Checking login status...');
          try {
            FB.getLoginStatus(function(response) {
              console.log('✅ Facebook SDK: Login status received:', response);
              statusChangeCallback(response);
            }, true); // Force fresh status check
          } catch (error) {
            console.error('❌ Facebook SDK: getLoginStatus failed:', error);
          }
        } else {
          console.warn('⚠️ Facebook SDK: Skipping login status check - HTTPS required');
        }
      };

      // Handle Facebook login status changes
      function statusChangeCallback(response) {
        console.log('🔵 Facebook SDK: Status callback triggered');
        console.log('🔵 Facebook SDK: Response status:', response.status);
        console.log('🔵 Facebook SDK: Full response:', JSON.stringify(response, null, 2));
        
        // Check if user just logged out
        const justLoggedOut = document.cookie.includes('facebook_logout=true');
        if (justLoggedOut) {
          console.log('🔵 Facebook SDK: Ignoring status callback - user just logged out');
          return; // Don't process status if user just logged out
        }
        
        if (response.status === 'connected') {
          // User is logged into Facebook and your app
          console.log('✅ Facebook SDK: User is connected to Facebook and your app');
          console.log('🔵 Facebook SDK: Auth response:', response.authResponse);
          handleFacebookConnected(response.authResponse);
        } else if (response.status === 'not_authorized') {
          // User is logged into Facebook but not your app
          console.warn('⚠️ Facebook SDK: User is logged into Facebook but not authorized for your app');
        } else if (response.status === 'unknown') {
          // Cannot determine if user is logged into Facebook
          console.warn('⚠️ Facebook SDK: Cannot determine Facebook login status');
        } else {
          // User is not logged into Facebook
          console.log('🔵 Facebook SDK: User is not logged into Facebook');
        }
      }
      
      // Handle when user is connected to Facebook
      function handleFacebookConnected(authResponse) {
        console.log('🔵 Facebook SDK: handleFacebookConnected called');
        
        // Check again if user just logged out
        const justLoggedOut = document.cookie.includes('facebook_logout=true');
        if (justLoggedOut) {
          console.log('🔵 Facebook SDK: Not auto-syncing - user just logged out');
          return; // Don't auto-sync if user just logged out
        }
        console.log('🔵 Facebook SDK: Auth response:', authResponse);
        
        // Get user's profile information
        FB.api('/me', {fields: 'name,email,picture'}, function(response) {
          console.log('🔵 Facebook SDK: FB.api /me response:', response);
          
          if (response.error) {
            console.error('❌ Facebook SDK: FB.api error:', response.error);
            return;
          }
          
          // Send this info to Rails backend to sync with session
          fetch('/users/auth/facebook/sync_status', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
            },
            body: JSON.stringify({
              facebook_user_id: authResponse.userID,
              access_token: authResponse.accessToken,
              name: response.name,
              email: response.email,
              picture_url: response.picture ? response.picture.data.url : null
            })
          }).then(response => response.json())
            .then(data => {
              if (data.success) {
                console.log('Facebook status synced with Rails backend');
                
                // Check if there's a pending contact form to restore
                const pendingContactForm = sessionStorage.getItem('pendingContactForm');
                const pendingModalContactForm = sessionStorage.getItem('pendingModalContactForm');
                
                if (pendingContactForm || pendingModalContactForm) {
                  // Refresh the page to update authentication status and restore forms
                  window.location.reload();
                } else {
                  // Just refresh navigation to show profile picture
                  const navElement = document.querySelector('[data-controller*="navigation"]');
                  if (navElement) {
                    window.location.reload();
                  }
                }
              }
            })
            .catch(error => {
              console.error('Error syncing Facebook status:', error);
            });
        });
      }
      
      // Function to trigger Facebook login
      function loginWithFacebook() {
        const isHTTPS = window.location.protocol === 'https:';
        const isDevelopment = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
        
        if (!isHTTPS && !isDevelopment) {
          console.log('Facebook login requires HTTPS in production');
          alert('Facebook login requires a secure connection (HTTPS). Please contact support.');
          return;
        }
        
        try {
          FB.login(function(response) {
            if (response.authResponse) {
              console.log('Facebook login successful');
              statusChangeCallback(response);
            } else {
              console.log('Facebook login cancelled or failed');
            }
          }, {scope: 'email,public_profile'});
        } catch (error) {
          console.error('Facebook login failed:', error);
          alert('Facebook login is not available. Please try again later or contact support.');
        }
      }
      
      // Make loginWithFacebook available globally
      window.loginWithFacebook = loginWithFacebook;

      // Load Facebook SDK
      console.log('🔵 Facebook SDK: Starting SDK load...');
      (function(d, s, id){
         var js, fjs = d.getElementsByTagName(s)[0];
         if (d.getElementById(id)) {
           console.warn('⚠️ Facebook SDK: Script already exists with id:', id);
           return;
         }
         js = d.createElement(s); 
         js.id = id;
         js.src = "https://connect.facebook.net/en_US/sdk.js";
         
         // Add load event listeners
         js.onload = function() {
           console.log('✅ Facebook SDK: Script loaded successfully from:', js.src);
           console.log('🔵 Facebook SDK: typeof FB =', typeof FB);
           if (typeof FB !== 'undefined') {
             console.log('✅ Facebook SDK: FB object is available');
           } else {
             console.error('❌ Facebook SDK: FB object is NOT available after script load');
           }
         };
         
         js.onerror = function(error) {
           console.error('❌ Facebook SDK: Failed to load script:', error);
           console.error('❌ Facebook SDK: Script URL was:', js.src);
         };
         
         console.log('🔵 Facebook SDK: Inserting script tag with src:', js.src);
         fjs.parentNode.insertBefore(js, fjs);
       }(document, 'script', 'facebook-jssdk'));
    </script>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    
    <!-- Action Text / Trix Editor CSS -->
    <link rel="stylesheet" type="text/css" href="https://unpkg.com/trix@2.1.15/dist/trix.css">
    
    <!-- Quill.js JavaScript (must load before importmap) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.7/quill.min.js"></script>
    
    <%= javascript_importmap_tags %>
    
	<!-- Flowbite CSS -->
	<link href="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.2.1/flowbite.min.css" rel="stylesheet" />
	<!-- Quill.js CSS -->
	<link href="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.7/quill.snow.min.css" rel="stylesheet" />
	
	<!-- Flowbite JS (before closing </body> tag) -->
	<script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.2.1/flowbite.min.js"></script>

    <%= Sentry.get_trace_propagation_meta.html_safe %>
  </head>

  <body data-locale="<%= I18n.locale %>" class="min-h-screen flex flex-col">
    <!-- Location check (redirects to onboarding if needed) -->
    <% unless controller_name == 'onboarding' %>
      <% location_attrs = { data: { controller: "location" } } %>
      <% location_attrs[:data][:puppeteer_location] = session[:puppeteer_location].to_json if session[:puppeteer_location] %>
      <%= tag.div(**location_attrs) %>
    <% end %>

    <!-- Navigation Bar -->
    <%= render 'shared/navigation' unless controller.class.module_parent_name == 'Admin' %>

    <!-- Flash Messages -->
    <% if notice %>
      <div class="container mx-auto mt-6 px-5">
        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded mb-4">
          <%= notice %>
        </div>
      </div>
    <% end %>
    
    <% if alert %>
      <div class="container mx-auto mt-6 px-5">
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded mb-4">
          <%= alert %>
        </div>
      </div>
    <% end %>

    <!-- Main Content Area -->
    <main class="container mx-auto mt-6 px-5 flex flex-1">
      <%= yield %>
    </main>

    <!-- Footer - Always at bottom -->
    <%= render 'shared/footer' unless controller.class.module_parent_name == 'Admin' %>
    
    <!-- Handle Facebook logout if flag is set -->
    <% if flash[:facebook_logout] %>
      <script>
        document.addEventListener('DOMContentLoaded', function() {
          if (typeof FB !== 'undefined') {
            FB.getLoginStatus(function(response) {
              if (response.status === 'connected') {
                // User is still logged into Facebook, log them out
                FB.logout(function(response) {
                  console.log('User has been logged out from Facebook');
                });
              }
            });
          }
        });
      </script>
    <% end %>
  </body>
</html>
<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Schools" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    
    <!-- Action Text / Trix Editor CSS -->
    <link rel="stylesheet" type="text/css" href="https://unpkg.com/trix@2.1.15/dist/trix.css">
    
    <!-- Quill.js JavaScript (must load before importmap) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.7/quill.min.js"></script>
    
    <%= javascript_importmap_tags %>
    
	<!-- Flowbite CSS -->
	<link href="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.2.1/flowbite.min.css" rel="stylesheet" />
	<!-- Quill.js CSS -->
	<link href="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.7/quill.snow.min.css" rel="stylesheet" />
	
	<!-- Flowbite JS (before closing </body> tag) -->
	<script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.2.1/flowbite.min.js"></script>

  </head>

  <body>
    <!-- Location check (redirects to onboarding if needed) -->
    <div data-controller="location" <%= raw session[:puppeteer_location] ? "data-puppeteer-location='#{session[:puppeteer_location].to_json}'" : '' %>></div>

    <!-- Navigation Bar -->
    <%= render 'shared/navigation' unless controller.class.module_parent_name == 'Admin' %>

    <main class="container mx-auto mt-6 px-5 flex">
      <%= yield %>
    </main>
  </body>
</html>
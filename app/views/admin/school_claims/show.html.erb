<% content_for :title, "School Claim: #{@school_claim.school.name}" %>

<!-- Main Content -->
<div class="w-full py-8 px-4 sm:px-6 lg:px-8">
  <div class="space-y-8">
    <!-- Page Header with Inline Stats -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
      <div class="px-6 py-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6">
          <div>
            <h1 class="text-3xl font-bold text-gray-900"><%= @school_claim.school.name %></h1>
            <p class="mt-2 text-sm text-gray-600">School ownership claim details and management</p>
          </div>
          <div class="mt-4 sm:mt-0 flex space-x-3">
            <%= link_to edit_admin_school_claim_path(@school_claim), 
                class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
              </svg>
              Edit Claim
            <% end %>
            <%= link_to admin_school_claims_path, 
                class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
              </svg>
              Back to Claims
            <% end %>
          </div>
        </div>
        
        <!-- Inline Statistics -->
        <div class="flex flex-wrap items-center gap-6 text-sm">
          <!-- Status -->
          <div class="flex items-center">
            <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center mr-3">
              <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
              </svg>
            </div>
            <div>
              <span class="font-semibold text-gray-900"><%= @school_claim.status.humanize %></span>
              <span class="text-gray-500">Status</span>
            </div>
          </div>

          <!-- Claimant -->
          <div class="flex items-center">
            <div class="w-2 h-2 bg-purple-500 rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium"><%= @school_claim.user.email %></span>
            <span class="text-gray-500 ml-1">Claimant</span>
          </div>

          <!-- Submitted Date -->
          <div class="flex items-center">
            <div class="w-2 h-2 bg-orange-500 rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium"><%= @school_claim.created_at.strftime("%b %d, %Y") %></span>
            <span class="text-gray-500 ml-1">Submitted</span>
          </div>

          <!-- Evidence Status -->
          <div class="flex items-center">
            <div class="w-2 h-2 <%= @school_claim.evidence_url.present? ? 'bg-green-500' : 'bg-gray-400' %> rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium"><%= @school_claim.evidence_url.present? ? "Evidence Provided" : "No Evidence" %></span>
            <span class="text-gray-500 ml-1">Documentation</span>
          </div>

          <!-- Time Since -->
          <div class="flex items-center">
            <svg class="w-4 h-4 text-gray-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span class="text-gray-900 font-medium"><%= time_ago_in_words(@school_claim.created_at) %></span>
            <span class="text-gray-500 ml-1">ago</span>
          </div>

          <!-- Status Badge -->
          <% case @school_claim.status %>
          <% when 'pending' %>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">
              <svg class="w-2 h-2 mr-1.5 fill-current" viewBox="0 0 8 8">
                <circle cx="4" cy="4" r="3"/>
              </svg>
              Pending Review
            </span>
          <% when 'approved' %>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
              <svg class="w-2 h-2 mr-1.5 fill-current" viewBox="0 0 8 8">
                <circle cx="4" cy="4" r="3"/>
              </svg>
              Approved
            </span>
          <% when 'rejected' %>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
              <svg class="w-2 h-2 mr-1.5 fill-current" viewBox="0 0 8 8">
                <circle cx="4" cy="4" r="3"/>
              </svg>
              Rejected
            </span>
          <% when 'revoked' %>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-800">
              <svg class="w-2 h-2 mr-1.5 fill-current" viewBox="0 0 8 8">
                <circle cx="4" cy="4" r="3"/>
              </svg>
              Revoked
            </span>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Claim Details -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
      <div class="px-6 py-4 border-b border-gray-200">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="text-lg font-semibold text-gray-900">Claim Information</h3>
            <p class="mt-1 text-sm text-gray-600">
              Review claim details and supporting evidence
            </p>
          </div>
        </div>
      </div>
      
      <div class="px-6 py-6">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- School -->
          <div>
            <dt class="text-sm font-medium text-gray-500 mb-2">School</dt>
            <dd class="text-lg font-medium text-gray-900">
              <%= link_to @school_claim.school.name, admin_school_path(@school_claim.school), 
                  class: "text-blue-600 hover:text-blue-700" %>
            </dd>
            <% if @school_claim.school.respond_to?(:display_address) && @school_claim.school.display_address.present? %>
              <dd class="text-sm text-gray-600"><%= @school_claim.school.display_address %></dd>
            <% end %>
          </div>

          <!-- Claimant -->
          <div>
            <dt class="text-sm font-medium text-gray-500 mb-2">Claimant</dt>
            <dd class="text-sm font-medium text-gray-900">
              <%= link_to @school_claim.user.email, admin_user_path(@school_claim.user), 
                  class: "text-blue-600 hover:text-blue-700" %>
            </dd>
            <dd class="text-sm text-gray-600">
              <%= @school_claim.user.role.humanize if @school_claim.user.respond_to?(:role) %>
            </dd>
          </div>

          <!-- Submitted -->
          <div>
            <dt class="text-sm font-medium text-gray-500 mb-2">Submitted</dt>
            <dd class="text-sm font-medium text-gray-900">
              <%= @school_claim.created_at.strftime("%B %d, %Y") %>
            </dd>
            <dd class="text-sm text-gray-600">
              <%= time_ago_in_words(@school_claim.created_at) %> ago
            </dd>
          </div>

          <!-- Evidence -->
          <div>
            <dt class="text-sm font-medium text-gray-500 mb-2">Evidence</dt>
            <% if @school_claim.evidence_url.present? %>
              <dd class="text-sm font-medium text-gray-900">
                <%= link_to @school_claim.evidence_url, 
                    target: "_blank", 
                    class: "inline-flex items-center text-blue-600 hover:text-blue-700" do %>
                  <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                  View Evidence
                <% end %>
              </dd>
            <% else %>
              <dd class="text-sm text-gray-400 italic">No evidence provided</dd>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Admin Notes History -->
    <% if @school_claim.admin_notes.present? || @school_claim.rejected? || @school_claim.revoked? %>
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-semibold text-gray-900">Admin Notes & History</h3>
          <p class="mt-1 text-sm text-gray-600">Administrative notes and decision history</p>
        </div>
        <div class="px-6 py-6">
          <div class="space-y-4">
            <% if @school_claim.admin_notes.present? %>
              <div class="p-4 bg-blue-50 border border-blue-200 rounded-lg">
                <div class="text-sm font-medium text-blue-800 mb-1">Admin Notes</div>
                <div class="text-sm text-blue-700"><%= simple_format(@school_claim.admin_notes) %></div>
              </div>
            <% end %>

            <% if @school_claim.revoked? && @school_claim.revocation_reason.present? %>
              <div class="p-4 bg-gray-50 border border-gray-200 rounded-lg">
                <div class="text-sm font-medium text-gray-800 mb-1">Revocation Reason</div>
                <div class="text-sm text-gray-700"><%= simple_format(@school_claim.revocation_reason) %></div>
                <% if @school_claim.respond_to?(:revoked_at) && @school_claim.revoked_at.present? %>
                  <div class="text-xs text-gray-500 mt-2">
                    Revoked <%= @school_claim.revoked_at.strftime("%B %d, %Y at %I:%M %p") %>
                    <% if @school_claim.respond_to?(:revoked_by) && @school_claim.revoked_by.present? %>
                      by <%= @school_claim.revoked_by %>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Actions and Management -->
    <% if @school_claim.pending? %>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Approval Action -->
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
          <div class="px-6 py-4 border-b border-gray-200">
            <div class="flex items-center">
              <div class="flex-shrink-0 w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center">
                <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <h3 class="ml-3 text-lg font-semibold text-gray-900">Approve Claim</h3>
            </div>
          </div>
          <div class="px-6 py-6">
            <%= form_with url: approve_admin_school_claim_path(@school_claim), method: :patch, local: true, class: "space-y-4" do |f| %>
              <div>
                <%= f.label :admin_notes, "Admin Notes (optional)", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= f.text_area :admin_notes, 
                    placeholder: "Add notes about the approval decision...",
                    rows: 3,
                    class: "block w-full px-3 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500 rounded-lg" %>
              </div>
              
              <div>
                <%= f.submit "Approve Claim", 
                    onclick: "return confirm('Are you sure you want to approve this claim? This will grant the user management access to the school.')",
                    class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors" %>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Rejection Action -->
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
          <div class="px-6 py-4 border-b border-gray-200">
            <div class="flex items-center">
              <div class="flex-shrink-0 w-8 h-8 bg-red-100 rounded-lg flex items-center justify-center">
                <svg class="w-4 h-4 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
              </div>
              <h3 class="ml-3 text-lg font-semibold text-gray-900">Reject Claim</h3>
            </div>
          </div>
          <div class="px-6 py-6">
            <%= form_with url: reject_admin_school_claim_path(@school_claim), method: :patch, local: true, class: "space-y-4" do |f| %>
              <div>
                <%= f.label :admin_notes, "Rejection Reason (required)", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= f.text_area :admin_notes, 
                    placeholder: "Please provide a clear reason for rejection...",
                    rows: 3,
                    required: true,
                    class: "block w-full px-3 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 rounded-lg" %>
                <div class="text-xs text-gray-500 mt-1">This reason will be visible to the user.</div>
              </div>
              
              <div>
                <%= f.submit "Reject Claim", 
                    onclick: "return confirm('Are you sure you want to reject this claim? The user will be notified of this decision.')",
                    class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>

    <% elsif @school_claim.approved? && @school_claim.respond_to?(:active?) && @school_claim.active? %>
      <!-- Revoke Action for Active Claims -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-4 border-b border-gray-200">
          <div class="flex items-center">
            <div class="flex-shrink-0 w-8 h-8 bg-gray-100 rounded-lg flex items-center justify-center">
              <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728L5.636 5.636m12.728 12.728L18.364 5.636M5.636 18.364l12.728-12.728"/>
              </svg>
            </div>
            <h3 class="ml-3 text-lg font-semibold text-gray-900">Revoke Access</h3>
          </div>
        </div>
        <div class="px-6 py-6">
          <div class="mb-4 p-3 bg-amber-50 border border-amber-200 rounded-lg">
            <div class="text-sm text-amber-700">
              <strong>Warning:</strong> Revoking this claim will remove the user's management access to the school and make it available for new claims.
            </div>
          </div>

          <%= form_with url: revoke_admin_school_claim_path(@school_claim), method: :patch, local: true, class: "space-y-4" do |f| %>
            <div>
              <%= f.label :revocation_reason, "Revocation Reason (required)", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= f.text_area :revocation_reason, 
                  placeholder: "Please provide a reason for revocation (e.g., 'User left employment', 'Incorrect approval')...",
                  rows: 3,
                  required: true,
                  class: "block w-full px-3 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:border-gray-500 rounded-lg" %>
            </div>
            
            <div>
              <%= f.submit "Revoke Access", 
                  onclick: "return confirm('Are you sure you want to revoke this claim? The school will become available for new claims and the user will lose management access.')",
                  class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-gray-600 hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors" %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Quick Links -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-semibold text-gray-900">Quick Links</h3>
        <p class="mt-1 text-sm text-gray-600">Related records and external views</p>
      </div>
      <div class="px-6 py-6">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <%= link_to admin_school_path(@school_claim.school),
              class: "inline-flex items-center justify-center py-2.5 px-4 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
            View School
          <% end %>

          <%= link_to admin_user_path(@school_claim.user),
              class: "inline-flex items-center justify-center py-2.5 px-4 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            View User
          <% end %>

          <%= link_to school_path(@school_claim.school), target: "_blank",
              class: "inline-flex items-center justify-center py-2.5 px-4 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
            Public Page
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
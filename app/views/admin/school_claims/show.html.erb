<% content_for :title, "School Claim Details" %>


<!-- Main Content -->
  <div class="mx-auto py-8 px-6 sm:px-8 lg:px-12 max-w-none">
    <div class="space-y-8">
      <!-- Breadcrumb -->
      <nav class="flex" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <li class="inline-flex items-center">
            <%= link_to admin_root_path, class: "inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600" do %>
              <svg class="w-3 h-3 mr-2.5" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20">
                <path d="m19.707 9.293-2-2-7-7a1 1 0 0 0-1.414 0l-7 7-2 2a1 1 0 0 0 1.414 1.414L2 10.414V18a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-7.586l.293.293a1 1 0 0 0 1.414-1.414Z"/>
              </svg>
              Admin Dashboard
            <% end %>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
              </svg>
              <%= link_to "School Claims", admin_school_claims_path, class: "ml-1 text-sm font-medium text-gray-700 hover:text-blue-600 md:ml-2" %>
            </div>
          </li>
          <li aria-current="page">
            <div class="flex items-center">
              <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
              </svg>
              <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2">Claim Details</span>
            </div>
          </li>
        </ol>
      </nav>

      <!-- Page Header -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-6">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h1 class="text-3xl font-bold text-gray-900">School Claim Details</h1>
              <p class="mt-2 text-sm text-gray-600">Review and manage school ownership claim</p>
            </div>
            <div class="mt-4 sm:mt-0 flex items-center space-x-3">
              <!-- Status Badge -->
              <% case page.resource.status %>
              <% when 'pending' %>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">
                  <svg class="w-2 h-2 mr-1.5 fill-current" viewBox="0 0 8 8">
                    <circle cx="4" cy="4" r="3"/>
                  </svg>
                  Pending Review
                </span>
              <% when 'approved' %>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                  <svg class="w-2 h-2 mr-1.5 fill-current" viewBox="0 0 8 8">
                    <circle cx="4" cy="4" r="3"/>
                  </svg>
                  Approved
                </span>
              <% when 'rejected' %>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
                  <svg class="w-2 h-2 mr-1.5 fill-current" viewBox="0 0 8 8">
                    <circle cx="4" cy="4" r="3"/>
                  </svg>
                  Rejected
                </span>
              <% when 'revoked' %>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-800">
                  <svg class="w-2 h-2 mr-1.5 fill-current" viewBox="0 0 8 8">
                    <circle cx="4" cy="4" r="3"/>
                  </svg>
                  Revoked
                </span>
              <% end %>
              
              <%= link_to admin_school_claims_path,
                  class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                Back to Claims
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Content Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Left Column - Claim Details -->
        <div class="lg:col-span-2 space-y-6">
          <!-- Claim Information -->
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <div class="flex items-center mb-6">
                <div class="flex-shrink-0 w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                  </svg>
                </div>
                <h2 class="ml-4 text-xl font-semibold text-gray-900">Claim Information</h2>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- School -->
                <div class="space-y-3">
                  <div>
                    <div class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">SCHOOL</div>
                    <div class="text-base font-semibold text-gray-900">
                      <%= link_to page.resource.school.name, admin_school_path(page.resource.school), 
                          class: "text-blue-600 hover:text-blue-700" %>
                    </div>
                    <% if page.resource.school.respond_to?(:display_address) && page.resource.school.display_address.present? %>
                      <div class="text-sm text-gray-600"><%= page.resource.school.display_address %></div>
                    <% end %>
                  </div>
                </div>

                <!-- User -->
                <div class="space-y-3">
                  <div>
                    <div class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">CLAIMANT</div>
                    <div class="text-base font-semibold text-gray-900">
                      <%= link_to page.resource.user.email, admin_user_path(page.resource.user), 
                          class: "text-blue-600 hover:text-blue-700" %>
                    </div>
                    <div class="text-sm text-gray-600">
                      Role: <%= page.resource.user.role.humanize if page.resource.user.respond_to?(:role) %>
                    </div>
                  </div>
                </div>

                <!-- Submitted Date -->
                <div class="space-y-3">
                  <div>
                    <div class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">SUBMITTED</div>
                    <div class="text-base text-gray-900">
                      <%= page.resource.created_at.strftime("%B %d, %Y at %I:%M %p") %>
                    </div>
                    <div class="text-sm text-gray-600">
                      <%= time_ago_in_words(page.resource.created_at) %> ago
                      <% if page.resource.respond_to?(:stale?) && page.resource.stale? %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-orange-100 text-orange-800 ml-2">
                          ⚠️ Stale (>30 days)
                        </span>
                      <% end %>
                    </div>
                  </div>
                </div>

                <!-- Evidence -->
                <div class="space-y-3">
                  <div>
                    <div class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">EVIDENCE</div>
                    <% if page.resource.evidence_url.present? %>
                      <div class="text-base">
                        <%= link_to page.resource.evidence_url, page.resource.evidence_url, target: "_blank",
                            class: "inline-flex items-center text-blue-600 hover:text-blue-700 font-medium" do %>
                          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                          </svg>
                          View Evidence
                        <% end %>
                      </div>
                      <div class="text-sm text-gray-600">Opens in new tab</div>
                    <% else %>
                      <div class="text-base text-gray-400 italic">No evidence provided</div>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Admin Notes History -->
          <% if page.resource.admin_notes.present? || page.resource.rejected? || page.resource.revoked? %>
            <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
              <div class="px-6 py-6">
                <div class="flex items-center mb-6">
                  <div class="flex-shrink-0 w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center">
                    <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                  </div>
                  <h2 class="ml-4 text-xl font-semibold text-gray-900">Admin Notes & History</h2>
                </div>

                <div class="space-y-4">
                  <% if page.resource.admin_notes.present? %>
                    <div class="p-4 bg-blue-50 border border-blue-200 rounded-lg">
                      <div class="text-sm font-medium text-blue-800 mb-1">Admin Notes</div>
                      <div class="text-sm text-blue-700"><%= page.resource.admin_notes %></div>
                    </div>
                  <% end %>

                  <% if page.resource.revoked? && page.resource.revocation_reason.present? %>
                    <div class="p-4 bg-gray-50 border border-gray-200 rounded-lg">
                      <div class="text-sm font-medium text-gray-800 mb-1">Revocation Reason</div>
                      <div class="text-sm text-gray-700"><%= page.resource.revocation_reason %></div>
                      <% if page.resource.respond_to?(:revoked_at) && page.resource.revoked_at.present? %>
                        <div class="text-xs text-gray-500 mt-2">
                          Revoked <%= page.resource.revoked_at.strftime("%B %d, %Y at %I:%M %p") %>
                          <% if page.resource.respond_to?(:revoked_by) && page.resource.revoked_by.present? %>
                            by <%= page.resource.revoked_by %>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Right Column - Actions -->
        <div class="lg:col-span-1 space-y-6">
          <!-- Pending Actions -->
          <% if page.resource.pending? %>
            <!-- Approval Action -->
            <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
              <div class="px-6 py-6">
                <div class="flex items-center mb-6">
                  <div class="flex-shrink-0 w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                    <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <h3 class="ml-4 text-lg font-semibold text-gray-900">Approve Claim</h3>
                </div>

                <%= form_with url: approve_admin_school_claim_path(page.resource), method: :patch, local: true, class: "space-y-4" do |f| %>
                  <div>
                    <%= f.label :admin_notes, "Admin Notes (optional)", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <%= f.text_area :admin_notes, 
                        placeholder: "Add notes about the approval decision...",
                        rows: 3,
                        class: "block w-full px-3 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500 rounded-lg" %>
                  </div>
                  
                  <div>
                    <%= f.submit "✓ Approve Claim", 
                        onclick: "return confirm('Are you sure you want to approve this claim? This will grant the user management access to the school.')",
                        class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors" %>
                  </div>
                <% end %>
              </div>
            </div>

            <!-- Rejection Action -->
            <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
              <div class="px-6 py-6">
                <div class="flex items-center mb-6">
                  <div class="flex-shrink-0 w-10 h-10 bg-red-100 rounded-full flex items-center justify-center">
                    <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                  </div>
                  <h3 class="ml-4 text-lg font-semibold text-gray-900">Reject Claim</h3>
                </div>

                <%= form_with url: reject_admin_school_claim_path(page.resource), method: :patch, local: true, class: "space-y-4" do |f| %>
                  <div>
                    <%= f.label :admin_notes, "Rejection Reason (required)", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <%= f.text_area :admin_notes, 
                        placeholder: "Please provide a clear reason for rejection...",
                        rows: 3,
                        required: true,
                        class: "block w-full px-3 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 rounded-lg" %>
                    <div class="text-xs text-gray-500 mt-1">This reason will be visible to the user.</div>
                  </div>
                  
                  <div>
                    <%= f.submit "✗ Reject Claim", 
                        onclick: "return confirm('Are you sure you want to reject this claim? The user will be notified of this decision.')",
                        class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors" %>
                  </div>
                <% end %>
              </div>
            </div>

          <% elsif page.resource.approved? && page.resource.respond_to?(:active?) && page.resource.active? %>
            <!-- Revoke Action for Active Claims -->
            <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
              <div class="px-6 py-6">
                <div class="flex items-center mb-6">
                  <div class="flex-shrink-0 w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center">
                    <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728L5.636 5.636m12.728 12.728L18.364 5.636M5.636 18.364l12.728-12.728"/>
                    </svg>
                  </div>
                  <h3 class="ml-4 text-lg font-semibold text-gray-900">Revoke Access</h3>
                </div>

                <div class="mb-4 p-3 bg-amber-50 border border-amber-200 rounded-lg">
                  <div class="text-sm text-amber-700">
                    <strong>Warning:</strong> Revoking this claim will remove the user's management access to the school and make it available for new claims.
                  </div>
                </div>

                <%= form_with url: revoke_admin_school_claim_path(page.resource), method: :patch, local: true, class: "space-y-4" do |f| %>
                  <div>
                    <%= f.label :revocation_reason, "Revocation Reason (required)", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <%= f.text_area :revocation_reason, 
                        placeholder: "Please provide a reason for revocation (e.g., 'User left employment', 'Incorrect approval')...",
                        rows: 3,
                        required: true,
                        class: "block w-full px-3 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:border-gray-500 rounded-lg" %>
                  </div>
                  
                  <div>
                    <%= f.submit "🚫 Revoke Access", 
                        onclick: "return confirm('Are you sure you want to revoke this claim? The school will become available for new claims and the user will lose management access.')",
                        class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-gray-600 hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors" %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>

          <!-- Status Summary -->
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <div class="flex items-center mb-6">
                <div class="flex-shrink-0 w-10 h-10 bg-indigo-100 rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <h3 class="ml-4 text-lg font-semibold text-gray-900">Claim Status</h3>
              </div>

              <div class="space-y-3">
                <% if page.resource.approved? %>
                  <div class="flex items-center justify-between p-3 bg-green-50 border border-green-200 rounded-lg">
                    <div class="text-sm font-medium text-green-800">✓ Claim Approved</div>
                    <% if page.resource.respond_to?(:active?) %>
                      <div class="text-xs text-green-600">
                        <%= page.resource.active? ? "Active" : "Revoked" %>
                      </div>
                    <% end %>
                  </div>
                <% elsif page.resource.rejected? %>
                  <div class="flex items-center justify-between p-3 bg-red-50 border border-red-200 rounded-lg">
                    <div class="text-sm font-medium text-red-800">✗ Claim Rejected</div>
                  </div>
                <% elsif page.resource.pending? %>
                  <div class="flex items-center justify-between p-3 bg-yellow-50 border border-yellow-200 rounded-lg">
                    <div class="text-sm font-medium text-yellow-800">⏳ Awaiting Review</div>
                    <% if page.resource.respond_to?(:days_pending) %>
                      <div class="text-xs text-yellow-600">
                        <%= pluralize(page.resource.days_pending.to_i, 'day') %> pending
                      </div>
                    <% end %>
                  </div>
                <% end %>

                <% if page.resource.respond_to?(:updated_at) %>
                  <div class="text-xs text-gray-500">
                    Last updated <%= time_ago_in_words(page.resource.updated_at) %> ago
                  </div>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Quick Links -->
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <div class="flex items-center mb-6">
                <div class="flex-shrink-0 w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                  </svg>
                </div>
                <h3 class="ml-4 text-lg font-semibold text-gray-900">Quick Links</h3>
              </div>

              <div class="space-y-3">
                <%= link_to admin_school_path(page.resource.school),
                    class: "w-full flex items-center justify-center py-2.5 px-4 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                  </svg>
                  View School Details
                <% end %>

                <%= link_to admin_user_path(page.resource.user),
                    class: "w-full flex items-center justify-center py-2.5 px-4 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                  </svg>
                  View User Profile
                <% end %>

                <%= link_to school_path(page.resource.school), target: "_blank",
                    class: "w-full flex items-center justify-center py-2.5 px-4 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                  View Public Page
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
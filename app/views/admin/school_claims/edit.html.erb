<% content_for :title, "Edit School Claim ##{@school_claim.id}" %>

<% layout = "application" %>

<!-- Main Content -->
<div class="w-full py-8">
  <div class="space-y-8 px-4 sm:px-6 lg:px-8">
    <!-- Breadcrumb -->
    <nav class="flex" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
          <%= link_to admin_root_path, class: "inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600" do %>
            <svg class="w-3 h-3 mr-2.5" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20">
              <path d="m19.707 9.293-2-2-7-7a1 1 0 0 0-1.414 0l-7 7-2 2a1 1 0 0 0 1.414 1.414L2 10.414V18a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-7.586l.293.293a1 1 0 0 0 1.414-1.414Z"/>
            </svg>
            Admin Dashboard
          <% end %>
        </li>
        <li>
          <div class="flex items-center">
            <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" fill="none" viewBox="0 0 6 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
            </svg>
            <%= link_to "School Claims", admin_school_claims_path, class: "ml-1 text-sm font-medium text-gray-700 hover:text-blue-600 md:ml-2" %>
          </div>
        </li>
        <li>
          <div class="flex items-center">
            <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" fill="none" viewBox="0 0 6 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
            </svg>
            <%= link_to "Claim ##{@school_claim.id}", admin_school_claim_path(id: @school_claim.id), class: "ml-1 text-sm font-medium text-gray-700 hover:text-blue-600 md:ml-2" %>
          </div>
        </li>
        <li aria-current="page">
          <div class="flex items-center">
            <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" fill="none" viewBox="0 0 6 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
            </svg>
            <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2">Edit</span>
          </div>
        </li>
      </ol>
    </nav>

    <!-- Page Header -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
      <div class="px-6 py-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h1 class="text-3xl font-bold text-gray-900">Edit School Claim #<%= @school_claim.id %></h1>
            <p class="mt-2 text-sm text-gray-600">Modify school ownership claim details</p>
          </div>
          <div class="flex items-center space-x-3 mt-4 sm:mt-0">
            <!-- Status Badge -->
            <% case @school_claim.status %>
            <% when 'pending' %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">
                <svg class="w-2 h-2 mr-1.5 fill-current" viewBox="0 0 8 8">
                  <circle cx="4" cy="4" r="3"/>
                </svg>
                Pending Review
              </span>
            <% when 'approved' %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                <svg class="w-2 h-2 mr-1.5 fill-current" viewBox="0 0 8 8">
                  <circle cx="4" cy="4" r="3"/>
                </svg>
                Approved
              </span>
            <% when 'rejected' %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
                <svg class="w-2 h-2 mr-1.5 fill-current" viewBox="0 0 8 8">
                  <circle cx="4" cy="4" r="3"/>
                </svg>
                Rejected
              </span>
            <% when 'revoked' %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-800">
                <svg class="w-2 h-2 mr-1.5 fill-current" viewBox="0 0 8 8">
                  <circle cx="4" cy="4" r="3"/>
                </svg>
                Revoked
              </span>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Current Claim Info -->
    <div class="bg-blue-50 border border-blue-200 rounded-xl p-6">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-blue-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-blue-800">Current Claim Information</h3>
          <div class="mt-2 text-sm text-blue-700">
            <p><strong>School:</strong> <%= @school_claim.school.name %></p>
            <p><strong>Claimant:</strong> <%= @school_claim.user.email %></p>
            <p><strong>Submitted:</strong> <%= @school_claim.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
            <% if @school_claim.evidence_url.present? %>
              <p><strong>Evidence:</strong> 
                <%= link_to "View Evidence", @school_claim.evidence_url, target: "_blank", class: "text-blue-600 underline hover:text-blue-700" %>
              </p>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Form -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
      <div class="px-6 py-6">
        <%= form_with model: [:admin, @school_claim], local: true, class: "space-y-6" do |form| %>
          <% if @school_claim.errors.any? %>
            <div class="p-4 bg-red-50 border border-red-200 rounded-lg">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <div class="ml-3">
                  <h3 class="text-sm font-medium text-red-800">There were <%= pluralize(@school_claim.errors.count, "error") %> with your submission:</h3>
                  <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
                    <% @school_claim.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          <% end %>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- School Selection -->
            <div>
              <%= form.label :school_id, "School", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.select :school_id, 
                  options_for_select([['Select a school...', '']] + @schools.map { |s| [s.name, s.id] }, @school_claim.school_id),
                  {},
                  { 
                    class: "block w-full pl-3 pr-10 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg",
                    required: true
                  } %>
              <p class="mt-1 text-sm text-gray-500">Select the school this claim is for</p>
            </div>

            <!-- User Selection -->
            <div>
              <%= form.label :user_id, "User/Claimant", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.select :user_id, 
                  options_for_select([['Select a user...', '']] + @users.map { |u| [u.email, u.id] }, @school_claim.user_id),
                  {},
                  { 
                    class: "block w-full pl-3 pr-10 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg",
                    required: true
                  } %>
              <p class="mt-1 text-sm text-gray-500">Select the user making this claim</p>
            </div>

            <!-- Status -->
            <div>
              <%= form.label :status, "Status", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.select :status, 
                  options_for_select([
                    ['Pending Review', 'pending'],
                    ['Approved', 'approved'],
                    ['Rejected', 'rejected'],
                    ['Revoked', 'revoked']
                  ], @school_claim.status),
                  {},
                  { 
                    class: "block w-full pl-3 pr-10 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg"
                  } %>
              <p class="mt-1 text-sm text-gray-500">Current status of this claim</p>
            </div>

            <!-- Evidence URL -->
            <div>
              <%= form.label :evidence_url, "Evidence URL", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.url_field :evidence_url, 
                  placeholder: "https://example.com/evidence-document.pdf",
                  class: "block w-full px-3 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" %>
              <p class="mt-1 text-sm text-gray-500">URL to supporting documentation (optional)</p>
            </div>
          </div>

          <!-- Admin Notes -->
          <div>
            <%= form.label :admin_notes, "Admin Notes", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.text_area :admin_notes, 
                placeholder: "Add any administrative notes about this claim...",
                rows: 4,
                class: "block w-full px-3 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" %>
            <p class="mt-1 text-sm text-gray-500">Internal notes for administrative use</p>
          </div>

          <!-- Revocation Reason (only if status is revoked) -->
          <div id="revocation-reason-field" <%= 'style="display: none;"'.html_safe unless @school_claim.status == 'revoked' %>>
            <%= form.label :revocation_reason, "Revocation Reason", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.text_area :revocation_reason, 
                placeholder: "Reason for revoking this claim...",
                rows: 3,
                class: "block w-full px-3 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" %>
            <p class="mt-1 text-sm text-gray-500">Required when status is set to revoked</p>
          </div>

          <!-- Action Buttons -->
          <div class="flex items-center justify-end space-x-3 pt-6 border-t border-gray-200">
            <%= link_to admin_school_claim_path(id: @school_claim.id),
                class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
              </svg>
              Cancel
            <% end %>
            
            <%= form.submit "Update School Claim",
                class: "inline-flex items-center px-6 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Danger Zone -->
    <div class="bg-white border border-red-200 rounded-xl shadow-sm">
      <div class="px-6 py-6">
        <div class="flex items-center mb-4">
          <div class="flex-shrink-0">
            <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.732-.833-2.5 0L4.268 16.5c-.77.833.192 2.5 1.732 2.5z"/>
            </svg>
          </div>
          <h3 class="ml-2 text-lg font-medium text-red-900">Danger Zone</h3>
        </div>
        <p class="text-sm text-red-700 mb-4">Permanently delete this school claim. This action cannot be undone.</p>
        
        <%= link_to admin_school_claim_path(id: @school_claim.id),
            method: :delete,
            data: { 
              confirm: "Are you sure you want to delete this school claim? This action cannot be undone.\n\nClaim ID: #{@school_claim.id}\nSchool: #{@school_claim.school.name}\nUser: #{@school_claim.user.email}" 
            },
            class: "inline-flex items-center px-4 py-2 border border-red-300 text-sm font-medium rounded-lg text-red-700 bg-red-50 hover:bg-red-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
          </svg>
          Delete School Claim
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
// Show/hide revocation reason field based on status
document.addEventListener('DOMContentLoaded', function() {
  const statusSelect = document.getElementById('school_claim_status');
  const revocationField = document.getElementById('revocation-reason-field');
  
  function toggleRevocationField() {
    if (statusSelect.value === 'revoked') {
      revocationField.style.display = 'block';
    } else {
      revocationField.style.display = 'none';
    }
  }
  
  statusSelect.addEventListener('change', toggleRevocationField);
  toggleRevocationField(); // Check initial state
});
</script>
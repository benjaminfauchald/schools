<% content_for :title, "Taggings Management" %>

<!-- Main Content -->
<div class="w-full py-8">
  <div class="space-y-8 px-4 sm:px-6 lg:px-8">
    <!-- Page Header -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
      <div class="px-6 py-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6">
          <div>
            <h1 class="text-3xl font-bold text-gray-900">Taggings Management</h1>
            <p class="mt-2 text-sm text-gray-600">Manage relationships between schools and taxonomy terms</p>
          </div>
          <div class="mt-4 sm:mt-0 flex space-x-3">
            <%= link_to new_admin_tagging_path, 
                class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
              </svg>
              Add New Tagging
            <% end %>
          </div>
        </div>
        
        <!-- Inline Statistics -->
        <div class="flex flex-wrap items-center gap-6 text-sm">
          <!-- Total Taggings -->
          <div class="flex items-center">
            <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center mr-3">
              <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
              </svg>
            </div>
            <div>
              <span class="font-semibold text-gray-900"><%= number_with_delimiter(@total_taggings || 0) %></span>
              <span class="text-gray-500">Total Taggings</span>
            </div>
          </div>

          <!-- Valid Taggings -->
          <div class="flex items-center">
            <div class="w-2 h-2 bg-green-500 rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium"><%= number_with_delimiter(@valid_taggings || 0) %></span>
            <span class="text-gray-500 ml-1">Currently Valid</span>
          </div>

          <!-- Expired Taggings -->
          <div class="flex items-center">
            <div class="w-2 h-2 bg-red-500 rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium"><%= number_with_delimiter(@expired_taggings || 0) %></span>
            <span class="text-gray-500 ml-1">Expired</span>
          </div>

          <!-- Active Contexts -->
          <% if @contexts.present? %>
            <div class="flex items-center">
              <div class="w-2 h-2 bg-purple-500 rounded-full mr-2"></div>
              <span class="text-gray-900 font-medium"><%= @contexts.count %> contexts</span>
              <span class="text-gray-500 ml-1">Available</span>
            </div>
          <% end %>

          <!-- Taggable Types -->
          <% if @taggable_types.present? %>
            <div class="flex items-center">
              <div class="w-2 h-2 bg-orange-500 rounded-full mr-2"></div>
              <span class="text-gray-900 font-medium"><%= @taggable_types.count %> types</span>
              <span class="text-gray-500 ml-1">Taggable</span>
            </div>
          <% end %>

          <!-- Validity Status -->
          <% if @total_taggings && @total_taggings > 0 %>
            <div class="flex items-center">
              <svg class="w-4 h-4 text-gray-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
              </svg>
              <span class="text-gray-900 font-medium"><%= ((@valid_taggings.to_f / @total_taggings) * 100).round(1) %>% valid</span>
              <span class="text-gray-500 ml-1">Health</span>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Search and Filters -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
      <div class="px-6 py-6">
        <%= form_with url: admin_taggings_path, method: :get, local: true, class: "space-y-4 sm:space-y-0 sm:flex sm:items-end sm:space-x-4" do |form| %>
          <div class="flex-1">
            <%= form.label :search, "Search", class: "block text-sm font-medium text-gray-700" %>
            <%= form.text_field :search, 
                value: params[:search], 
                placeholder: "Search by term name, context, or notes...",
                class: "mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm rounded-md" %>
          </div>
          
          <div class="flex-1">
            <%= form.label :context, "Context", class: "block text-sm font-medium text-gray-700" %>
            <%= form.select :context, 
                options_for_select([['All Contexts', '']] + @contexts.map { |c| [c.humanize, c] }, params[:context]), 
                {},
                { class: "mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm rounded-md" } %>
          </div>
          
          <div class="flex-1">
            <%= form.label :validity, "Validity", class: "block text-sm font-medium text-gray-700" %>
            <%= form.select :validity, 
                options_for_select([
                  ['All Validity', ''],
                  ['Currently Valid', 'valid'],
                  ['Expired', 'expired'],
                  ['Expiring Soon (30 days)', 'expiring_soon']
                ], params[:validity]), 
                {},
                { class: "mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm rounded-md" } %>
          </div>
          
          <div class="flex-1">
            <%= form.label :taggable_type, "Type", class: "block text-sm font-medium text-gray-700" %>
            <%= form.select :taggable_type, 
                options_for_select([['All Types', '']] + @taggable_types.map { |t| [t.humanize, t] }, params[:taggable_type]), 
                {},
                { class: "mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm rounded-md" } %>
          </div>
          
          <div>
            <%= form.submit "Filter", 
                class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Taggings Table -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
        <h3 class="text-lg font-medium text-gray-900">Taggings List</h3>
        <p class="mt-1 text-sm text-gray-600">Showing <%= @taggings&.count || 0 %> taggings</p>
      </div>
      
      <% if @taggings.any? %>
        <div class="overflow-x-auto">
          <table class="w-full min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Term & Context
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Tagged Item
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Validity
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Notes
                </th>
                <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Actions
                </th>
              </tr>
            </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @taggings.each do |tagging| %>
                  <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-6 py-4">
                      <div class="text-sm font-medium text-gray-900"><%= tagging.term.label %></div>
                      <div class="text-sm text-gray-500"><%= tagging.context.humanize %></div>
                    </td>
                    <td class="px-6 py-4">
                      <div class="text-sm font-medium text-gray-900">
                        <%= tagging.taggable_type.constantize.model_name.human %>
                      </div>
                      <div class="text-sm text-gray-500">
                        <% if tagging.taggable.respond_to?(:name) %>
                          <%= link_to truncate(tagging.taggable.name, length: 40), 
                              polymorphic_path([:admin, tagging.taggable]), 
                              class: "text-blue-600 hover:text-blue-700" %>
                        <% else %>
                          ID: <%= tagging.taggable_id %>
                        <% end %>
                      </div>
                    </td>
                    <td class="px-6 py-4">
                      <% if tagging.valid_from || tagging.valid_to %>
                        <% if tagging.currently_valid? %>
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                            <svg class="w-2 h-2 mr-1 fill-current" viewBox="0 0 8 8">
                              <circle cx="4" cy="4" r="3"/>
                            </svg>
                            Valid
                          </span>
                        <% elsif tagging.valid_to && tagging.valid_to < Date.current %>
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                            <svg class="w-2 h-2 mr-1 fill-current" viewBox="0 0 8 8">
                              <circle cx="4" cy="4" r="3"/>
                            </svg>
                            Expired
                          </span>
                        <% elsif tagging.valid_to && tagging.valid_to <= Date.current + 30.days %>
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                            <svg class="w-2 h-2 mr-1 fill-current" viewBox="0 0 8 8">
                              <circle cx="4" cy="4" r="3"/>
                            </svg>
                            Expiring Soon
                          </span>
                        <% else %>
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                            <svg class="w-2 h-2 mr-1 fill-current" viewBox="0 0 8 8">
                              <circle cx="4" cy="4" r="3"/>
                            </svg>
                            Valid
                          </span>
                        <% end %>
                        <% if tagging.valid_from || tagging.valid_to %>
                          <div class="text-xs text-gray-500 mt-1">
                            <% if tagging.valid_from %>
                              <%= tagging.valid_from.strftime("%m/%d/%Y") %>
                            <% end %>
                            <% if tagging.valid_to %>
                              <% if tagging.valid_from %> - <% end %><%= tagging.valid_to.strftime("%m/%d/%Y") %>
                            <% end %>
                          </div>
                        <% end %>
                      <% else %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                          <svg class="w-2 h-2 mr-1 fill-current" viewBox="0 0 8 8">
                            <circle cx="4" cy="4" r="3"/>
                          </svg>
                          Permanent
                        </span>
                      <% end %>
                    </td>
                    <td class="px-6 py-4">
                      <% if tagging.notes.present? %>
                        <div class="text-sm text-gray-900">
                          <%= truncate(tagging.notes, length: 100) %>
                        </div>
                      <% else %>
                        <span class="text-sm text-gray-400 italic">No notes</span>
                      <% end %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                      <div class="flex items-center justify-end space-x-2">
                        <%= link_to admin_tagging_path(tagging), 
                            class: "inline-flex items-center px-2.5 py-1.5 border border-gray-300 shadow-sm text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
                          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                          </svg>
                          View
                        <% end %>
                        
                        <%= link_to edit_admin_tagging_path(tagging), 
                            class: "inline-flex items-center px-2.5 py-1.5 border border-gray-300 shadow-sm text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
                          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                          </svg>
                          Edit
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          
          <!-- Results Info -->
          <div class="bg-white px-4 py-3 border-t border-gray-200 sm:px-6">
            <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
              <div>
                <p class="text-sm text-gray-700">
                  Showing <span class="font-medium"><%= @taggings.count %></span> taggings
                </p>
              </div>
              <% if @taggings.respond_to?(:total_pages) && @taggings.total_pages > 1 %>
                <div>
                  <%= paginate @taggings, theme: 'twitter_bootstrap_4' %>
                </div>
              <% end %>
            </div>
          </div>
        <% else %>
          <div class="text-center py-12">
            <div class="mx-auto h-24 w-24 text-gray-400 mb-4">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
              </svg>
            </div>
            <h3 class="mt-2 text-lg font-medium text-gray-900">No taggings found</h3>
            <p class="mt-2 text-sm text-gray-500 max-w-sm mx-auto">
              <% if params[:search].present? || params[:context].present? || params[:validity].present? || params[:taggable_type].present? %>
                Try adjusting your filters to see more results. You can change the search criteria above.
              <% else %>
                No taggings have been created yet. When relationships between schools and taxonomy terms are established, they will appear here.
              <% end %>
            </p>
            <% if params[:search].present? || params[:context].present? || params[:validity].present? || params[:taggable_type].present? %>
              <div class="mt-6">
                <%= link_to admin_taggings_path, class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                  </svg>
                  Clear Filters
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
  </div>
</div>
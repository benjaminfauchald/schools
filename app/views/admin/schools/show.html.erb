<% content_for :title, "School Details - #{@school.name}" %>

<div class="w-full py-8 px-4 sm:px-6 lg:px-8">
  <div class="space-y-8">
    <!-- Page Header -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
      <div class="px-6 py-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6">
          <div>
            <%= link_to admin_schools_path, class: "inline-flex items-center text-blue-600 hover:text-blue-800 mb-4" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
              Back to Schools
            <% end %>
            
            <h1 class="text-3xl font-bold text-gray-900"><%= @school.name %></h1>
            <p class="mt-2 text-sm text-gray-600">View and manage school information and claims</p>
            
            <% if @approved_claims.any? %>
              <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800 mt-2">
                Claimed
              </span>
            <% end %>
          </div>
          
          <div class="mt-4 sm:mt-0 flex space-x-3">
            <%= link_to school_path(@school), target: "_blank", 
                class: "inline-flex items-center px-3 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
              </svg>
              View Public Page
            <% end %>
            
            <%= link_to edit_admin_school_path(@school), 
                class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
              Edit School
            <% end %>
          </div>
        </div>
        
        <!-- Inline Statistics -->
        <div class="flex flex-wrap items-center gap-6 text-sm">
          <!-- Total Claims -->
          <div class="flex items-center">
            <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center mr-3">
              <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
            </div>
            <div>
              <span class="font-semibold text-gray-900"><%= @school.school_claims.count %></span>
              <span class="text-gray-500">Total Claims</span>
            </div>
          </div>

          <!-- Approved Claims -->
          <div class="flex items-center">
            <div class="w-2 h-2 bg-green-500 rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium"><%= @approved_claims.count %></span>
            <span class="text-gray-500 ml-1">Approved</span>
          </div>

          <!-- Pending Claims -->
          <div class="flex items-center">
            <div class="w-2 h-2 bg-yellow-500 rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium"><%= @pending_claims.count %></span>
            <span class="text-gray-500 ml-1">Pending</span>
          </div>

          <!-- School Status -->
          <div class="flex items-center">
            <div class="w-2 h-2 bg-indigo-500 rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium"><%= @school.ownership&.titleize || 'Unknown' %></span>
            <span class="text-gray-500 ml-1">Ownership</span>
          </div>

          <!-- Created Date -->
          <div class="flex items-center">
            <div class="w-2 h-2 bg-gray-500 rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium"><%= @school.created_at.strftime("%B %Y") %></span>
            <span class="text-gray-500 ml-1">Created</span>
          </div>
        </div>
      </div>
    </div>

    <!-- School Information -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
      <div class="px-6 py-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-6">School Information</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700">School Name</label>
            <p class="mt-1 text-sm text-gray-900"><%= @school.name %></p>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700">School ID</label>
            <p class="mt-1 text-sm text-gray-900"><%= @school.id %></p>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700">Founded</label>
            <p class="mt-1 text-sm text-gray-900">
              <%= @school.founded_year.presence || "Not specified" %>
            </p>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700">Avg Class Size</label>
            <p class="mt-1 text-sm text-gray-900">
              <%= @school.avg_class_size.present? ? "#{@school.avg_class_size} students" : "Not specified" %>
            </p>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700">Student-Teacher Ratio</label>
            <p class="mt-1 text-sm text-gray-900">
              <%= @school.student_teacher_ratio.presence || "Not specified" %>
            </p>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700">Features</label>
            <p class="mt-1 text-sm text-gray-900">
              <% features = [] %>
              <% features << "Boarding" if @school.boarding? %>
              <% features << "School Bus" if @school.school_bus? %>
              <%= features.any? ? features.join(", ") : "No special features listed" %>
            </p>
          </div>
        </div>
        
        <% if @school.about.present? %>
          <div class="mt-6 pt-6 border-t border-gray-200">
            <label class="block text-sm font-medium text-gray-700 mb-2">About the School</label>
            <p class="text-sm text-gray-900 whitespace-pre-wrap"><%= @school.about %></p>
          </div>
        <% end %>
        </div>
      </div>
    </div>

    <!-- Contact Information -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
      <div class="px-6 py-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-6">Contact Information</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700">Phone</label>
            <% if @school.phone.present? %>
              <a href="tel:<%= @school.phone %>" class="mt-1 text-sm text-blue-600 hover:text-blue-800">
                <%= @school.phone %>
              </a>
            <% else %>
              <p class="mt-1 text-sm text-gray-500">Not provided</p>
            <% end %>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700">Website</label>
            <% if @school.website_url.present? %>
              <a href="<%= @school.website_url %>" target="_blank" 
                 class="mt-1 inline-flex items-center text-blue-600 hover:text-blue-800 text-sm">
                Visit Website
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                </svg>
              </a>
            <% else %>
              <p class="mt-1 text-sm text-gray-500">Not provided</p>
            <% end %>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700">Email</label>
            <% if @school.email.present? %>
              <a href="mailto:<%= @school.email %>" class="mt-1 text-sm text-blue-600 hover:text-blue-800">
                <%= @school.email %>
              </a>
            <% else %>
              <p class="mt-1 text-sm text-gray-500">Not provided</p>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Address -->
    <% if @school.address_line_1.present? || @school.district.present? || @school.province.present? %>
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-6">
          <h2 class="text-xl font-semibold text-gray-900 mb-6">Address</h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700">Address Line 1</label>
              <p class="mt-1 text-sm text-gray-900"><%= @school.address_line_1.presence || "Not provided" %></p>
            </div>
            
            <div>
              <label class="block text-sm font-medium text-gray-700">Address Line 2</label>
              <p class="mt-1 text-sm text-gray-900"><%= @school.address_line_2.presence || "Not provided" %></p>
            </div>
            
            <div>
              <label class="block text-sm font-medium text-gray-700">District</label>
              <p class="mt-1 text-sm text-gray-900"><%= @school.district.presence || "Not provided" %></p>
            </div>
            
            <div>
              <label class="block text-sm font-medium text-gray-700">Province</label>
              <p class="mt-1 text-sm text-gray-900"><%= @school.province.presence || "Not provided" %></p>
            </div>
            
            <div>
              <label class="block text-sm font-medium text-gray-700">Postal Code</label>
              <p class="mt-1 text-sm text-gray-900"><%= @school.postcode.presence || "Not provided" %></p>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <!-- School Claims -->
    <% if @recent_claims.any? %>
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-6">
          <h2 class="text-xl font-semibold text-gray-900 mb-6">School Claims</h2>
          
          <div class="space-y-4">
            <% @recent_claims.each do |claim| %>
              <div class="border border-gray-200 rounded-lg p-4">
                <div class="flex items-center justify-between">
                  <div class="flex-1">
                    <div class="flex items-center space-x-3">
                      <span class="text-sm font-medium text-gray-900">
                        <%= claim.user.email %>
                      </span>
                      <% case claim.status %>
                      <% when 'pending' %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                          Pending
                        </span>
                      <% when 'approved' %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                          Approved
                        </span>
                      <% when 'rejected' %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                          Rejected
                        </span>
                      <% end %>
                    </div>
                    <div class="mt-1 text-sm text-gray-500">
                      Submitted <%= time_ago_in_words(claim.created_at) %> ago
                    </div>
                  </div>
                  <div class="flex-shrink-0">
                    <%= link_to admin_school_claim_path(claim),
                        class: "inline-flex items-center px-3 py-1.5 border border-gray-300 shadow-sm text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50" do %>
                      View Claim
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
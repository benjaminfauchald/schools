<% content_for :title, "School Details - #{@school.name}" %>


<!-- Main Content -->
  <div class="mx-auto py-8 px-6 sm:px-8 lg:px-12 max-w-none">
    <div class="space-y-8">
      <!-- Breadcrumb -->
      <nav class="flex" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <li class="inline-flex items-center">
            <%= link_to admin_root_path, class: "inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600" do %>
              <svg class="w-3 h-3 mr-2.5" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20">
                <path d="m19.707 9.293-2-2-7-7a1 1 0 0 0-1.414 0l-7 7-2 2a1 1 0 0 0 1.414 1.414L2 10.414V18a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-7.586l.293.293a1 1 0 0 0 1.414-1.414Z"/>
              </svg>
              Admin Dashboard
            <% end %>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
              </svg>
              <%= link_to "Schools", admin_schools_path, class: "ml-1 text-sm font-medium text-gray-700 hover:text-blue-600 md:ml-2" %>
            </div>
          </li>
          <li aria-current="page">
            <div class="flex items-center">
              <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
              </svg>
              <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2">School Details</span>
            </div>
          </li>
        </ol>
      </nav>

      <!-- Page Header -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-6">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <div class="w-16 h-16 bg-gray-200 rounded-full flex items-center justify-center">
                  <svg class="w-8 h-8 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                  </svg>
                </div>
              </div>
              <div class="ml-4">
                <h1 class="text-3xl font-bold text-gray-900"><%= @school.name %></h1>
                <div class="mt-1 flex items-center space-x-4">
                  <!-- Ownership Badge -->
                  <% case @school.ownership %>
                  <% when 'public' %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-purple-100 text-purple-800">
                      <svg class="w-2 h-2 mr-1.5 fill-current" viewBox="0 0 8 8">
                        <circle cx="4" cy="4" r="3"/>
                      </svg>
                      Public School
                    </span>
                  <% when 'private' %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-indigo-100 text-indigo-800">
                      <svg class="w-2 h-2 mr-1.5 fill-current" viewBox="0 0 8 8">
                        <circle cx="4" cy="4" r="3"/>
                      </svg>
                      Private School
                    </span>
                  <% end %>
                  
                  <!-- Status Badge -->
                  <% case @school.status %>
                  <% when 'active' %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                      <svg class="w-2 h-2 mr-1.5 fill-current" viewBox="0 0 8 8">
                        <circle cx="4" cy="4" r="3"/>
                      </svg>
                      Active
                    </span>
                  <% when 'inactive' %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
                      <svg class="w-2 h-2 mr-1.5 fill-current" viewBox="0 0 8 8">
                        <circle cx="4" cy="4" r="3"/>
                      </svg>
                      Inactive
                    </span>
                  <% when 'pending' %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">
                      <svg class="w-2 h-2 mr-1.5 fill-current" viewBox="0 0 8 8">
                        <circle cx="4" cy="4" r="3"/>
                      </svg>
                      Pending
                    </span>
                  <% end %>

                  <!-- Claimed Badge -->
                  <% if @approved_claims.any? %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-emerald-100 text-emerald-800">
                      <svg class="w-2 h-2 mr-1.5 fill-current" viewBox="0 0 8 8">
                        <circle cx="4" cy="4" r="3"/>
                      </svg>
                      Claimed
                    </span>
                  <% end %>
                </div>
              </div>
            </div>
            <div class="mt-4 sm:mt-0 flex items-center space-x-3">
              <%= link_to edit_admin_school_path(@school),
                  class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
                Edit School
              <% end %>
              
              <%= link_to school_path(@school), target: "_blank",
                  class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
                View Public Page
              <% end %>
              
              <%= link_to admin_schools_path,
                  class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                Back to Schools
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Content Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Left Column - School Details -->
        <div class="lg:col-span-2 space-y-6">
          <!-- Basic Information -->
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <div class="flex items-center mb-6">
                <div class="flex-shrink-0 w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <h2 class="ml-4 text-xl font-semibold text-gray-900">School Information</h2>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- School Name -->
                <div class="space-y-3">
                  <div>
                    <div class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">SCHOOL NAME</div>
                    <div class="text-base font-semibold text-gray-900"><%= @school.name %></div>
                  </div>
                </div>

                <!-- School ID -->
                <div class="space-y-3">
                  <div>
                    <div class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">SCHOOL ID</div>
                    <div class="text-base text-gray-900"><%= @school.id %></div>
                  </div>
                </div>

                <!-- Founded Year -->
                <div class="space-y-3">
                  <div>
                    <div class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">FOUNDED</div>
                    <div class="text-base text-gray-900">
                      <% if @school.founded_year.present? %>
                        <%= @school.founded_year %>
                      <% else %>
                        <span class="text-gray-400 italic">Not specified</span>
                      <% end %>
                    </div>
                  </div>
                </div>

                <!-- Average Class Size -->
                <div class="space-y-3">
                  <div>
                    <div class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">AVG CLASS SIZE</div>
                    <div class="text-base text-gray-900">
                      <% if @school.avg_class_size.present? %>
                        <%= @school.avg_class_size %> students
                      <% else %>
                        <span class="text-gray-400 italic">Not specified</span>
                      <% end %>
                    </div>
                  </div>
                </div>

                <!-- Student Teacher Ratio -->
                <div class="space-y-3">
                  <div>
                    <div class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">STUDENT-TEACHER RATIO</div>
                    <div class="text-base text-gray-900">
                      <% if @school.student_teacher_ratio.present? %>
                        <%= @school.student_teacher_ratio %>
                      <% else %>
                        <span class="text-gray-400 italic">Not specified</span>
                      <% end %>
                    </div>
                  </div>
                </div>

                <!-- Additional Features -->
                <div class="space-y-3">
                  <div>
                    <div class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">FEATURES</div>
                    <div class="flex flex-wrap gap-2">
                      <% if @school.boarding? %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                          Boarding
                        </span>
                      <% end %>
                      <% if @school.school_bus? %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                          School Bus
                        </span>
                      <% end %>
                      <% if !@school.boarding? && !@school.school_bus? %>
                        <span class="text-gray-400 italic">No special features listed</span>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Address Information -->
          <% if @school.address_line_1.present? || @school.district.present? || @school.province.present? %>
            <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
              <div class="px-6 py-6">
                <div class="flex items-center mb-6">
                  <div class="flex-shrink-0 w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                    <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                  </div>
                  <h2 class="ml-4 text-xl font-semibold text-gray-900">Address & Location</h2>
                </div>

                <div class="space-y-4">
                  <% if @school.address_line_1.present? %>
                    <div>
                      <div class="text-sm font-medium text-gray-900">
                        <%= @school.address_line_1 %>
                        <% if @school.address_line_2.present? %>
                          <br><%= @school.address_line_2 %>
                        <% end %>
                      </div>
                    </div>
                  <% end %>

                  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
                    <% if @school.district.present? %>
                      <div>
                        <span class="font-medium text-gray-500">District:</span>
                        <span class="text-gray-900"><%= @school.district %></span>
                      </div>
                    <% end %>
                    <% if @school.province.present? %>
                      <div>
                        <span class="font-medium text-gray-500">Province:</span>
                        <span class="text-gray-900"><%= @school.province %></span>
                      </div>
                    <% end %>
                    <% if @school.postcode.present? %>
                      <div>
                        <span class="font-medium text-gray-500">Postcode:</span>
                        <span class="text-gray-900"><%= @school.postcode %></span>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <!-- About Section -->
          <% if @school.about.present? %>
            <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
              <div class="px-6 py-6">
                <div class="flex items-center mb-6">
                  <div class="flex-shrink-0 w-10 h-10 bg-indigo-100 rounded-full flex items-center justify-center">
                    <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                  </div>
                  <h2 class="ml-4 text-xl font-semibold text-gray-900">About the School</h2>
                </div>

                <div class="text-gray-700 leading-relaxed">
                  <%= simple_format(@school.about) %>
                </div>
              </div>
            </div>
          <% end %>

          <!-- School Claims -->
          <% if @recent_claims.any? %>
            <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
              <div class="px-6 py-6">
                <div class="flex items-center mb-6">
                  <div class="flex-shrink-0 w-10 h-10 bg-orange-100 rounded-full flex items-center justify-center">
                    <svg class="w-5 h-5 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                    </svg>
                  </div>
                  <h2 class="ml-4 text-xl font-semibold text-gray-900">School Claims</h2>
                </div>

                <div class="space-y-4">
                  <% @recent_claims.each do |claim| %>
                    <div class="border border-gray-200 rounded-lg p-4">
                      <div class="flex items-center justify-between">
                        <div class="flex-1">
                          <div class="flex items-center space-x-3">
                            <h3 class="text-base font-medium text-gray-900">
                              <%= link_to claim.user.email, admin_user_path(claim.user), 
                                  class: "text-blue-600 hover:text-blue-700" %>
                            </h3>
                            <% case claim.status %>
                            <% when 'pending' %>
                              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                Pending
                              </span>
                            <% when 'approved' %>
                              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                Approved
                              </span>
                            <% when 'rejected' %>
                              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                Rejected
                              </span>
                            <% when 'revoked' %>
                              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                Revoked
                              </span>
                            <% end %>
                          </div>
                          <div class="mt-1 text-sm text-gray-500">
                            Submitted <%= time_ago_in_words(claim.created_at) %> ago
                          </div>
                        </div>
                        <div class="flex-shrink-0">
                          <%= link_to admin_school_claim_path(claim),
                              class: "inline-flex items-center px-3 py-1.5 border border-gray-300 shadow-sm text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
                            <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                            </svg>
                            View Claim
                          <% end %>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>

                <% if @school.school_claims.count > 5 %>
                  <div class="mt-6 text-center">
                    <%= link_to admin_school_claims_path(search: @school.name),
                        class: "inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" do %>
                      View All <%= @school.school_claims.count %> Claims
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Right Column - Actions & Statistics -->
        <div class="lg:col-span-1 space-y-6">
          <!-- School Actions -->
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <div class="flex items-center mb-6">
                <div class="flex-shrink-0 w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                  </svg>
                </div>
                <h3 class="ml-4 text-lg font-semibold text-gray-900">Actions</h3>
              </div>

              <div class="space-y-3">
                <%= link_to edit_admin_school_path(@school),
                    class: "w-full flex items-center justify-center py-2.5 px-4 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                  </svg>
                  Edit School
                <% end %>

                <%= link_to school_path(@school), target: "_blank",
                    class: "w-full flex items-center justify-center py-2.5 px-4 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                  View Public Page
                <% end %>

                <% if @school.email.present? %>
                  <%= mail_to @school.email,
                      class: "w-full flex items-center justify-center py-2.5 px-4 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                    Send Email
                  <% end %>
                <% end %>

                <% unless @school.school_claims.any? %>
                  <%= link_to admin_school_path(@school), method: :delete,
                      data: { confirm: "Are you sure you want to delete this school? This action cannot be undone." },
                      class: "w-full flex items-center justify-center py-2.5 px-4 border border-red-300 rounded-lg shadow-sm text-sm font-medium text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors" do %>
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                    Delete School
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Contact Information -->
          <% if @school.phone.present? || @school.email.present? || @school.website_url.present? %>
            <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
              <div class="px-6 py-6">
                <div class="flex items-center mb-6">
                  <div class="flex-shrink-0 w-10 h-10 bg-emerald-100 rounded-full flex items-center justify-center">
                    <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                  </div>
                  <h3 class="ml-4 text-lg font-semibold text-gray-900">Contact Information</h3>
                </div>

                <div class="space-y-3">
                  <% if @school.phone.present? %>
                    <div class="flex items-center justify-between p-3 bg-blue-50 border border-blue-200 rounded-lg">
                      <div class="text-sm font-medium text-blue-800">Phone</div>
                      <div class="text-sm text-blue-600">
                        <%= link_to @school.phone, "tel:#{@school.phone}", class: "hover:text-blue-700" %>
                      </div>
                    </div>
                  <% end %>

                  <% if @school.email.present? %>
                    <div class="flex items-center justify-between p-3 bg-green-50 border border-green-200 rounded-lg">
                      <div class="text-sm font-medium text-green-800">Email</div>
                      <div class="text-sm text-green-600">
                        <%= link_to @school.email, "mailto:#{@school.email}", class: "hover:text-green-700" %>
                      </div>
                    </div>
                  <% end %>

                  <% if @school.website_url.present? %>
                    <div class="flex items-center justify-between p-3 bg-purple-50 border border-purple-200 rounded-lg">
                      <div class="text-sm font-medium text-purple-800">Website</div>
                      <div class="text-sm text-purple-600">
                        <%= link_to "Visit Website", @school.website_url, target: "_blank", class: "hover:text-purple-700" %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>

          <!-- School Statistics -->
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <div class="flex items-center mb-6">
                <div class="flex-shrink-0 w-10 h-10 bg-yellow-100 rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                  </svg>
                </div>
                <h3 class="ml-4 text-lg font-semibold text-gray-900">Statistics</h3>
              </div>

              <div class="space-y-3">
                <div class="flex items-center justify-between p-3 bg-blue-50 border border-blue-200 rounded-lg">
                  <div class="text-sm font-medium text-blue-800">Total Claims</div>
                  <div class="text-sm text-blue-600">
                    <%= @school.school_claims.count %>
                  </div>
                </div>

                <div class="flex items-center justify-between p-3 bg-green-50 border border-green-200 rounded-lg">
                  <div class="text-sm font-medium text-green-800">Approved Claims</div>
                  <div class="text-sm text-green-600">
                    <%= @approved_claims.count %>
                  </div>
                </div>

                <div class="flex items-center justify-between p-3 bg-yellow-50 border border-yellow-200 rounded-lg">
                  <div class="text-sm font-medium text-yellow-800">Pending Claims</div>
                  <div class="text-sm text-yellow-600">
                    <%= @pending_claims.count %>
                  </div>
                </div>

                <div class="text-xs text-gray-500 mt-4">
                  Created <%= @school.created_at.strftime("%B %Y") %>
                </div>
              </div>
            </div>
          </div>

          <!-- Quick Links -->
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <div class="flex items-center mb-6">
                <div class="flex-shrink-0 w-10 h-10 bg-teal-100 rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                  </svg>
                </div>
                <h3 class="ml-4 text-lg font-semibold text-gray-900">Quick Links</h3>
              </div>

              <div class="space-y-3">
                <% if @school.school_claims.any? %>
                  <%= link_to admin_school_claims_path(search: @school.name),
                      class: "w-full flex items-center justify-center py-2.5 px-4 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                    </svg>
                    View All Claims
                  <% end %>
                <% end %>

                <%= link_to admin_schools_path,
                    class: "w-full flex items-center justify-center py-2.5 px-4 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                  </svg>
                  Back to Schools
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
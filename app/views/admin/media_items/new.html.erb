<% content_for :title, "Add New Media Item" %>

<!-- Main Content -->
<div class="w-full py-8">
  <div class="space-y-8 px-4 sm:px-6 lg:px-8">
    <!-- Page Header -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
      <div class="px-6 py-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6">
          <div>
            <h1 class="text-3xl font-bold text-gray-900">Add New Media Item</h1>
            <p class="mt-2 text-sm text-gray-600">Upload photos, documents, videos, and other media for places</p>
          </div>
          <div class="mt-4 sm:mt-0 flex space-x-3">
            <%= link_to admin_media_items_path, 
                class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
              </svg>
              Back to Media Items
            <% end %>
          </div>
        </div>
        
        <!-- Inline Statistics -->
        <div class="flex flex-wrap items-center gap-6 text-sm">
          <!-- Media Item Icon -->
          <div class="flex items-center">
            <div class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center mr-3">
              <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <span class="font-semibold text-gray-900">Media Item</span>
              <span class="text-gray-500">New Upload</span>
            </div>
          </div>

          <!-- Available Types -->
          <div class="flex items-center">
            <div class="w-2 h-2 bg-green-500 rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium">8 Types</span>
            <span class="text-gray-500 ml-1">Available</span>
          </div>

          <!-- Required Fields -->
          <div class="flex items-center">
            <div class="w-2 h-2 bg-red-500 rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium">Required</span>
            <span class="text-gray-500 ml-1">Place & URL</span>
          </div>

          <!-- Sort Order -->
          <div class="flex items-center">
            <div class="w-2 h-2 bg-blue-500 rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium">Sort Order</span>
            <span class="text-gray-500 ml-1">Display Priority</span>
          </div>

          <!-- Form Status -->
          <div class="flex items-center">
            <svg class="w-4 h-4 text-gray-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <span class="text-gray-900 font-medium">Upload Ready</span>
            <span class="text-gray-500 ml-1">Form Active</span>
          </div>
        </div>
      </div>
    </div>

      <!-- Form -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-6">
          <%= form_with model: [:admin, @media_item], local: true, multipart: true, class: "space-y-6" do |form| %>
            <% if @media_item.errors.any? %>
              <div class="bg-red-50 border border-red-200 rounded-lg p-4">
                <div class="flex">
                  <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                    </svg>
                  </div>
                  <div class="ml-3">
                    <h3 class="text-sm font-medium text-red-800">
                      <%= pluralize(@media_item.errors.count, "error") %> prohibited this media item from being saved:
                    </h3>
                    <div class="mt-2 text-sm text-red-700">
                      <ul class="list-disc pl-5 space-y-1">
                        <% @media_item.errors.full_messages.each do |message| %>
                          <li><%= message %></li>
                        <% end %>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>

            <!-- Basic Information -->
            <div class="space-y-6">
              <div>
                <h3 class="text-lg font-medium text-gray-900 mb-4">Basic Information</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <!-- Place -->
                  <div class="md:col-span-2">
                    <%= form.label :place_id, "Place", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <%= form.select :place_id,
                        options_for_select([['Select a place...', '']] + @places.map { |p| [p.name, p.id] }),
                        {},
                        { class: "block w-full pl-3 pr-10 py-3 text-base border border-gray-300 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-purple-500 rounded-lg" } %>
                  </div>

                  <!-- Kind -->
                  <div>
                    <%= form.label :kind, "Media Type", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <%= form.select :kind,
                        options_for_select([
                          ['Logo', 'logo'],
                          ['Photo', 'photo'],
                          ['Brochure', 'brochure'],
                          ['Fee Schedule PDF', 'fee_schedule_pdf'],
                          ['Video', 'video'],
                          ['Virtual Tour', 'virtual_tour'],
                          ['Menu', 'menu'],
                          ['Floor Plan', 'floor_plan']
                        ]),
                        { prompt: 'Select media type...' },
                        { class: "block w-full pl-3 pr-10 py-3 text-base border border-gray-300 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-purple-500 rounded-lg" } %>
                  </div>

                  <!-- Source -->
                  <div>
                    <%= form.label :source, "Source", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <%= form.select :source,
                        options_for_select([
                          ['Admin Upload', 'admin_upload'],
                          ['Google Places', 'google_places'],
                          ['School Upload', 'school_upload']
                        ], 'admin_upload'),
                        {},
                        { class: "block w-full pl-3 pr-10 py-3 text-base border border-gray-300 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-purple-500 rounded-lg" } %>
                    <p class="mt-1 text-xs text-gray-500">How this media was added to the system</p>
                  </div>

                  <!-- Sort Order -->
                  <div>
                    <%= form.label :sort_order, "Sort Order", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <%= form.number_field :sort_order,
                        min: 0, value: @media_item.sort_order || 0,
                        class: "block w-full px-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 text-sm",
                        placeholder: "0" %>
                    <p class="mt-1 text-xs text-gray-500">Lower numbers appear first</p>
                  </div>

                  <!-- File Upload or URL -->
                  <div class="md:col-span-2">
                    <%= form.label :file, "File Upload", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <div class="flex items-center justify-center w-full">
                      <label for="media_item_file" class="flex flex-col items-center justify-center w-full h-40 border-2 border-gray-300 border-dashed rounded-lg cursor-pointer bg-gray-50 hover:bg-gray-100 hover:border-gray-400 transition-all duration-200">
                        <div class="flex flex-col items-center justify-center pt-5 pb-6">
                          <svg class="w-8 h-8 mb-4 text-gray-500" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 16">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 13h3a3 3 0 0 0 0-6h-.025A5.56 5.56 0 0 0 16 6.5 5.5 5.5 0 0 0 5.207 5.021C5.137 5.017 5.071 5 5 5a4 4 0 0 0 0 8h2.167M10 15V6m0 0L8 8m2-2 2 2"/>
                          </svg>
                          <p class="mb-2 text-sm text-gray-500"><span class="font-semibold">Click to upload</span> or drag and drop</p>
                          <p class="text-xs text-gray-500">Images, videos, PDFs, or documents</p>
                          <p class="text-xs text-gray-400 mt-1">Max file size: 50MB</p>
                        </div>
                        <%= form.file_field :file,
                            id: "media_item_file",
                            accept: "image/*,video/*,.pdf,.doc,.docx",
                            class: "hidden" %>
                      </label>
                    </div>
                    <div id="file-info" class="hidden mt-3 p-3 bg-blue-50 border border-blue-200 rounded-lg">
                      <div class="flex items-center">
                        <svg class="w-4 h-4 text-blue-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M4 4a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"/>
                        </svg>
                        <span id="file-name" class="text-sm text-blue-700 font-medium"></span>
                        <button type="button" id="remove-file" class="ml-auto text-blue-600 hover:text-blue-800 text-sm font-medium">Remove</button>
                      </div>
                    </div>
                    <p class="mt-2 text-xs text-gray-500">Upload a file directly (optional - you can use URL instead)</p>
                  </div>
                  
                  <!-- URL -->
                  <div class="md:col-span-2">
                    <%= form.label :url, "Media URL", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <%= form.url_field :url,
                        class: "block w-full px-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 text-sm",
                        placeholder: "https://example.com/media/image.jpg" %>
                    <p class="mt-1 text-xs text-gray-500">Direct URL to the media file (required if no file uploaded)</p>
                  </div>

                  <!-- Alt Text -->
                  <div class="md:col-span-2">
                    <%= form.label :alt_text, "Alt Text / Description", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <%= form.text_area :alt_text,
                        rows: 3,
                        class: "block w-full px-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 text-sm",
                        placeholder: "Describe the media content for accessibility and SEO" %>
                    <p class="mt-1 text-xs text-gray-500">Optional. If not provided, a default description will be generated.</p>
                  </div>
                </div>
              </div>

              <!-- Media Type Guidance -->
              <div class="bg-purple-50 border border-purple-200 rounded-lg p-4">
                <div class="flex">
                  <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-purple-400" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                    </svg>
                  </div>
                  <div class="ml-3">
                    <h3 class="text-sm font-medium text-purple-800">Media Type Guide</h3>
                    <div class="mt-2 text-sm text-purple-700">
                      <ul class="list-disc pl-5 space-y-1">
                        <li><strong>Logo:</strong> Official logo or brand image</li>
                        <li><strong>Campus Photo:</strong> Photos of facilities, classrooms, outdoor areas</li>
                        <li><strong>Brochure:</strong> Marketing materials, informational documents</li>
                        <li><strong>Fee Schedule PDF:</strong> Pricing and fee information documents</li>
                        <li><strong>Video/Virtual Tour:</strong> Video content showing the place</li>
                        <li><strong>Menu:</strong> Food service menus (for cafeterias, restaurants)</li>
                        <li><strong>Floor Plan:</strong> Building layout and room arrangements</li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Form Actions -->
            <div class="flex items-center justify-between pt-6 border-t border-gray-200">
              <div class="flex items-center space-x-4">
                <%= link_to admin_media_items_path, 
                    class: "inline-flex justify-center py-3 px-6 border border-gray-300 shadow-sm text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                  Cancel
                <% end %>
              </div>
              <div class="flex items-center space-x-4">
                <%= form.submit "Create Media Item", 
                    class: "inline-flex justify-center py-3 px-6 border border-transparent shadow-sm text-sm font-medium rounded-lg text-white bg-purple-600 hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 transition-colors" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const fileInput = document.getElementById('media_item_file');
  const fileInfo = document.getElementById('file-info');
  const fileName = document.getElementById('file-name');
  const removeFileBtn = document.getElementById('remove-file');
  const uploadArea = fileInput.closest('label');

  // Handle file selection
  fileInput.addEventListener('change', function(e) {
    const file = e.target.files[0];
    if (file) {
      fileName.textContent = file.name + ' (' + (file.size / 1024 / 1024).toFixed(1) + ' MB)';
      fileInfo.classList.remove('hidden');
      uploadArea.classList.add('border-blue-400', 'bg-blue-50');
      uploadArea.classList.remove('border-gray-300', 'bg-gray-50');
    }
  });

  // Handle file removal
  removeFileBtn.addEventListener('click', function() {
    fileInput.value = '';
    fileInfo.classList.add('hidden');
    uploadArea.classList.remove('border-blue-400', 'bg-blue-50');
    uploadArea.classList.add('border-gray-300', 'bg-gray-50');
  });

  // Handle drag and drop
  uploadArea.addEventListener('dragover', function(e) {
    e.preventDefault();
    uploadArea.classList.add('border-blue-400', 'bg-blue-100');
  });

  uploadArea.addEventListener('dragleave', function(e) {
    e.preventDefault();
    if (!fileInput.files[0]) {
      uploadArea.classList.remove('border-blue-400', 'bg-blue-100');
      uploadArea.classList.add('border-gray-300', 'bg-gray-50');
    }
  });

  uploadArea.addEventListener('drop', function(e) {
    e.preventDefault();
    const files = e.dataTransfer.files;
    if (files.length > 0) {
      fileInput.files = files;
      const event = new Event('change', { bubbles: true });
      fileInput.dispatchEvent(event);
    }
  });
});
</script>
<% content_for :title, "Media Item Details" %>

<!-- Main Content -->
<div class="w-full py-8">
  <div class="space-y-8 px-4 sm:px-6 lg:px-8">

      <!-- Page Header -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-6">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6">
            <div>
              <h1 class="text-3xl font-bold text-gray-900">
                <%= @media_item.alt_text.presence || "Media Item ##{@media_item.id}" %>
              </h1>
              <p class="mt-2 text-sm text-gray-600">View and manage media item details and associated information</p>
            </div>
            <div class="mt-4 sm:mt-0 flex space-x-3">
              <%= link_to edit_admin_media_item_path(@media_item), 
                  class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors" do %>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
                Edit Media Item
              <% end %>
              <%= link_to admin_media_items_path, 
                  class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors" do %>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"/>
                </svg>
                Back to Media Items
              <% end %>
            </div>
          </div>
          
          <!-- Inline Media Information -->
          <div class="flex flex-wrap items-center gap-6 text-sm">
            <!-- Media Type -->
            <div class="flex items-center">
              <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center mr-3">
                <% if @media_item.image? %>
                  <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                <% elsif @media_item.video? %>
                  <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                  </svg>
                <% else %>
                  <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                  </svg>
                <% end %>
              </div>
              <div>
                <span class="font-semibold text-gray-900"><%= @media_item.kind_display %></span>
                <span class="text-gray-500">Media Type</span>
              </div>
            </div>

            <!-- File Extension -->
            <% if @media_item.file_extension.present? %>
              <div class="flex items-center">
                <div class="w-2 h-2 bg-green-500 rounded-full mr-2"></div>
                <span class="text-gray-900 font-medium">.<%= @media_item.file_extension.upcase %></span>
                <span class="text-gray-500 ml-1">Extension</span>
              </div>
            <% end %>

            <!-- URL Status -->
            <div class="flex items-center">
              <div class="w-2 h-2 <%= @media_item.url_accessible? ? 'bg-green-500' : 'bg-red-500' %> rounded-full mr-2"></div>
              <span class="text-gray-900 font-medium"><%= @media_item.url_accessible? ? 'Valid URL' : 'Invalid URL' %></span>
              <span class="text-gray-500 ml-1">Status</span>
            </div>

            <!-- Sort Order -->
            <div class="flex items-center">
              <div class="w-8 h-8 bg-indigo-100 rounded-lg flex items-center justify-center mr-3">
                <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"/>
                </svg>
              </div>
              <div>
                <span class="font-semibold text-gray-900"><%= @media_item.sort_order || 0 %></span>
                <span class="text-gray-500">Sort Order</span>
              </div>
            </div>

            <!-- Created Date -->
            <div class="flex items-center">
              <div class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center mr-3">
                <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <span class="font-semibold text-gray-900"><%= time_ago_in_words(@media_item.created_at) %> ago</span>
                <span class="text-gray-500">Created</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Left Column -->
        <div class="space-y-8">
          <!-- Media Preview -->
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <h3 class="text-lg font-medium text-gray-900 mb-6">Media Preview</h3>
              
              <div class="bg-gray-50 rounded-lg p-6 text-center">
                <% if @media_item.image? %>
                  <div class="max-w-lg mx-auto">
                    <img src="<%= @media_item.url %>" alt="<%= @media_item.display_alt_text %>" 
                         class="w-full h-auto rounded-lg shadow-md"
                         onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                    <div class="hidden p-8 text-gray-400">
                      <svg class="w-16 h-16 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                      </svg>
                      <p class="text-lg">Image could not be loaded</p>
                    </div>
                  </div>
                <% elsif @media_item.video? %>
                  <div class="p-12 text-purple-500">
                    <svg class="w-20 h-20 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                    </svg>
                    <p class="text-lg font-medium text-gray-900 mb-2"><%= @media_item.kind_display %></p>
                    <p class="text-sm text-gray-600">Click "Open Media" to view the video content</p>
                  </div>
                <% else %>
                  <div class="p-12 text-gray-500">
                    <svg class="w-20 h-20 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                    <p class="text-lg font-medium text-gray-900 mb-2"><%= @media_item.kind_display %></p>
                    <p class="text-sm text-gray-600">Click "Open Media" to view or download the document</p>
                  </div>
                <% end %>
                
                <div class="mt-6">
                  <%= link_to @media_item.url, target: "_blank",
                      class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                    </svg>
                    Open Media
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <!-- Media Information -->
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <h3 class="text-lg font-medium text-gray-900 mb-6">Media Information</h3>
              
              <dl class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <dt class="text-sm font-medium text-gray-500 mb-2">Media Type</dt>
                  <dd class="text-sm text-gray-900">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                      <%= @media_item.kind_display %>
                    </span>
                  </dd>
                </div>
                
                <div>
                  <dt class="text-sm font-medium text-gray-500 mb-2">Sort Order</dt>
                  <dd class="text-sm text-gray-900">
                    <%= @media_item.sort_order || 0 %>
                  </dd>
                </div>
                
                <div>
                  <dt class="text-sm font-medium text-gray-500 mb-2">Alt Text / Description</dt>
                  <dd class="text-sm text-gray-900">
                    <% if @media_item.alt_text.present? %>
                      <%= @media_item.alt_text %>
                    <% else %>
                      <span class="text-gray-400 italic">Auto-generated: <%= @media_item.display_alt_text %></span>
                    <% end %>
                  </dd>
                </div>
                
                <div>
                  <dt class="text-sm font-medium text-gray-500 mb-2">File Extension</dt>
                  <dd class="text-sm text-gray-900">
                    <% if @media_item.file_extension.present? %>
                      .<%= @media_item.file_extension.upcase %>
                    <% else %>
                      <span class="text-gray-400">Not detected</span>
                    <% end %>
                  </dd>
                </div>
              </dl>
            </div>
          </div>

          <!-- URL Information -->
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <h3 class="text-lg font-medium text-gray-900 mb-6">URL Information</h3>
              
              <div class="space-y-4">
                <div>
                  <dt class="text-sm font-medium text-gray-500 mb-2">Full URL</dt>
                  <dd class="text-sm text-gray-900 bg-gray-50 p-3 rounded-lg font-mono break-all">
                    <%= @media_item.url %>
                  </dd>
                </div>
                
                <div class="flex items-center justify-between">
                  <div>
                    <dt class="text-sm font-medium text-gray-500">URL Status</dt>
                    <dd class="text-sm text-gray-900">
                      <% if @media_item.url_accessible? %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                          <svg class="w-2 h-2 mr-1 fill-current" viewBox="0 0 8 8">
                            <circle cx="4" cy="4" r="3"/>
                          </svg>
                          Valid Format
                        </span>
                      <% else %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                          <svg class="w-2 h-2 mr-1 fill-current" viewBox="0 0 8 8">
                            <circle cx="4" cy="4" r="3"/>
                          </svg>
                          Invalid Format
                        </span>
                      <% end %>
                    </dd>
                  </div>
                  
                  <div class="flex space-x-2">
                    <%= link_to @media_item.url, target: "_blank",
                        class: "inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
                      <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                      </svg>
                      Open
                    <% end %>
                    
                    <button onclick="navigator.clipboard.writeText('<%= j(@media_item.url) %>')" 
                            class="inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                      <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                      </svg>
                      Copy
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Associated Place -->
          <% if @media_item.place %>
            <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
              <div class="px-6 py-6">
                <h3 class="text-lg font-medium text-gray-900 mb-6">Associated Place</h3>
                
                <div class="flex items-start">
                  <div class="flex-shrink-0 w-20 h-20 mr-8">
                    <div class="w-20 h-20 bg-gray-200 rounded-full flex items-center justify-center">
                      <svg class="w-10 h-10 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                      </svg>
                    </div>
                  </div>
                  <div class="flex-1 space-y-3">
                    <h4 class="text-lg font-medium text-gray-900">
                      <%= link_to (@media_item.place.name.presence || "Unnamed Place"), admin_place_path(@media_item.place), class: "text-blue-600 hover:text-blue-700" %>
                    </h4>
                    
                    <% if @media_item.place.formatted_address.present? %>
                      <p class="text-sm text-gray-600">
                        <%= @media_item.place.formatted_address %>
                      </p>
                    <% end %>
                    
                    <div class="flex flex-wrap items-center gap-4 text-sm text-gray-500">
                      <span class="flex items-center space-x-1">
                        <span class="font-medium">ID:</span>
                        <span><%= @media_item.place_id %></span>
                      </span>
                      
                      <% if @media_item.place.rating.present? %>
                        <span class="flex items-center space-x-1">
                          <span class="text-yellow-400">⭐</span>
                          <span><%= @media_item.place.rating %>/5</span>
                        </span>
                      <% end %>
                      
                      <% if @media_item.place.lat.present? && @media_item.place.lng.present? %>
                        <span class="flex items-center space-x-1">
                          <span>📍</span>
                          <span><%= @media_item.place.lat.round(6) %>, <%= @media_item.place.lng.round(6) %></span>
                        </span>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Right Column -->
        <div class="space-y-8">
          <!-- Quick Actions -->
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <h3 class="text-lg font-medium text-gray-900 mb-4">Quick Actions</h3>
              <div class="space-y-3">
                <%= link_to @media_item.url, target: "_blank",
                    class: "w-full inline-flex justify-center items-center px-4 py-2 border border-blue-300 text-sm font-medium rounded-lg text-blue-700 bg-blue-50 hover:bg-blue-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                  Open Media
                <% end %>
                
                <button onclick="navigator.clipboard.writeText('<%= j(@media_item.url) %>')" 
                        class="w-full inline-flex justify-center items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                  </svg>
                  Copy URL
                </button>
                
                <hr class="border-gray-200">
                
                <%= button_to admin_media_item_path(@media_item),
                    method: :delete,
                    data: { 
                      confirm: "Are you sure you want to delete this media item? This action cannot be undone.",
                      turbo_method: :delete,
                      turbo_confirm: "Are you sure you want to delete this media item? This action cannot be undone."
                    },
                    class: "w-full inline-flex justify-center items-center px-4 py-2 border border-red-300 text-sm font-medium rounded-lg text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                  </svg>
                  Delete Media Item
                <% end %>
              </div>
            </div>
          </div>

          <!-- Technical Info -->
          <div class="bg-gray-50 border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <h3 class="text-lg font-medium text-gray-900 mb-4">Technical Information</h3>
              <dl class="space-y-3">
                <div>
                  <dt class="text-sm font-medium text-gray-500">Record ID</dt>
                  <dd class="text-sm font-mono text-gray-900">
                    <%= @media_item.id %>
                  </dd>
                </div>
                
                <div>
                  <dt class="text-sm font-medium text-gray-500">Created</dt>
                  <dd class="text-sm text-gray-900">
                    <%= @media_item.created_at.strftime("%B %d, %Y at %I:%M %p") %>
                  </dd>
                </div>
                
                <div>
                  <dt class="text-sm font-medium text-gray-500">Last Updated</dt>
                  <dd class="text-sm text-gray-900">
                    <%= @media_item.updated_at.strftime("%B %d, %Y at %I:%M %p") %>
                  </dd>
                </div>
                
                <div>
                  <dt class="text-sm font-medium text-gray-500">Media Category</dt>
                  <dd class="text-sm text-gray-900">
                    <% if @media_item.image? %>
                      📷 Image
                    <% elsif @media_item.video? %>
                      🎥 Video
                    <% elsif @media_item.document? %>
                      📄 Document
                    <% else %>
                      📎 Other
                    <% end %>
                  </dd>
                </div>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
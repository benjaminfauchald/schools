<% content_for :title, "Media Item Details" %>


<!-- Main Content -->
  <div class="mx-auto py-8 px-6 sm:px-8 lg:px-12 max-w-7xl">
    <div class="space-y-8">
      <!-- Breadcrumb -->
      <nav class="flex" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <li class="inline-flex items-center">
            <%= link_to admin_root_path, class: "inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600" do %>
              <svg class="w-3 h-3 mr-2.5" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20">
                <path d="m19.707 9.293-2-2-7-7a1 1 0 0 0-1.414 0l-7 7-2 2a1 1 0 0 0 1.414 1.414L2 10.414V18a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-7.586l.293.293a1 1 0 0 0 1.414-1.414Z"/>
              </svg>
              Admin Dashboard
            <% end %>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
              </svg>
              <%= link_to "Media Items", admin_media_items_path, class: "ml-1 text-sm font-medium text-gray-700 hover:text-blue-600 md:ml-2" %>
            </div>
          </li>
          <li aria-current="page">
            <div class="flex items-center">
              <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
              </svg>
              <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2">Media Item Details</span>
            </div>
          </li>
        </ol>
      </nav>

      <!-- Page Header -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-6">
          <div class="flex items-center justify-between">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <div class="w-16 h-16 bg-gray-200 rounded-xl flex items-center justify-center overflow-hidden">
                  <% if @media_item.image? %>
                    <img src="<%= @media_item.url %>" alt="<%= @media_item.display_alt_text %>" 
                         class="w-full h-full object-cover"
                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                    <div class="hidden w-full h-full items-center justify-center text-gray-400" style="display: none;">
                      <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                      </svg>
                    </div>
                  <% elsif @media_item.video? %>
                    <svg class="w-10 h-10 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                    </svg>
                  <% else %>
                    <svg class="w-10 h-10 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                  <% end %>
                </div>
              </div>
              <div class="ml-4">
                <h1 class="text-3xl font-bold text-gray-900">
                  <%= @media_item.alt_text.presence || "Media Item ##{@media_item.id}" %>
                </h1>
                <div class="mt-1 flex items-center space-x-4">
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
                    <%= @media_item.kind_display %>
                  </span>
                  <% if @media_item.file_extension.present? %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-800">
                      .<%= @media_item.file_extension.upcase %>
                    </span>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-8">
          <!-- Media Preview -->
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <h3 class="text-lg font-medium text-gray-900 mb-6">Media Preview</h3>
              
              <div class="bg-gray-50 rounded-lg p-6 text-center">
                <% if @media_item.image? %>
                  <div class="max-w-lg mx-auto">
                    <img src="<%= @media_item.url %>" alt="<%= @media_item.display_alt_text %>" 
                         class="w-full h-auto rounded-lg shadow-md"
                         onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                    <div class="hidden p-8 text-gray-400">
                      <svg class="w-16 h-16 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                      </svg>
                      <p class="text-lg">Image could not be loaded</p>
                    </div>
                  </div>
                <% elsif @media_item.video? %>
                  <div class="p-12 text-purple-500">
                    <svg class="w-20 h-20 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                    </svg>
                    <p class="text-lg font-medium text-gray-900 mb-2"><%= @media_item.kind_display %></p>
                    <p class="text-sm text-gray-600">Click "Open Media" to view the video content</p>
                  </div>
                <% else %>
                  <div class="p-12 text-yellow-500">
                    <svg class="w-20 h-20 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                    <p class="text-lg font-medium text-gray-900 mb-2"><%= @media_item.kind_display %></p>
                    <p class="text-sm text-gray-600">Click "Open Media" to view or download the document</p>
                  </div>
                <% end %>
                
                <div class="mt-6">
                  <%= link_to @media_item.url, target: "_blank",
                      class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                    </svg>
                    Open Media
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <!-- Media Information -->
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <h3 class="text-lg font-medium text-gray-900 mb-6">Media Information</h3>
              
              <dl class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <dt class="text-sm font-medium text-gray-500 mb-2">Media Type</dt>
                  <dd class="text-sm text-gray-900">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                      <%= @media_item.kind_display %>
                    </span>
                  </dd>
                </div>
                
                <div>
                  <dt class="text-sm font-medium text-gray-500 mb-2">Sort Order</dt>
                  <dd class="text-sm text-gray-900">
                    <%= @media_item.sort_order || 0 %>
                  </dd>
                </div>
                
                <div>
                  <dt class="text-sm font-medium text-gray-500 mb-2">Alt Text / Description</dt>
                  <dd class="text-sm text-gray-900">
                    <% if @media_item.alt_text.present? %>
                      <%= @media_item.alt_text %>
                    <% else %>
                      <span class="text-gray-400 italic">Auto-generated: <%= @media_item.display_alt_text %></span>
                    <% end %>
                  </dd>
                </div>
                
                <div>
                  <dt class="text-sm font-medium text-gray-500 mb-2">File Extension</dt>
                  <dd class="text-sm text-gray-900">
                    <% if @media_item.file_extension.present? %>
                      .<%= @media_item.file_extension.upcase %>
                    <% else %>
                      <span class="text-gray-400">Not detected</span>
                    <% end %>
                  </dd>
                </div>
              </dl>
            </div>
          </div>

          <!-- URL Information -->
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <h3 class="text-lg font-medium text-gray-900 mb-6">URL Information</h3>
              
              <div class="space-y-4">
                <div>
                  <dt class="text-sm font-medium text-gray-500 mb-2">Full URL</dt>
                  <dd class="text-sm text-gray-900 bg-gray-50 p-3 rounded-lg font-mono break-all">
                    <%= @media_item.url %>
                  </dd>
                </div>
                
                <div class="flex items-center justify-between">
                  <div>
                    <dt class="text-sm font-medium text-gray-500">URL Status</dt>
                    <dd class="text-sm text-gray-900">
                      <% if @media_item.url_accessible? %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                          <svg class="w-2 h-2 mr-1 fill-current" viewBox="0 0 8 8">
                            <circle cx="4" cy="4" r="3"/>
                          </svg>
                          Valid Format
                        </span>
                      <% else %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                          <svg class="w-2 h-2 mr-1 fill-current" viewBox="0 0 8 8">
                            <circle cx="4" cy="4" r="3"/>
                          </svg>
                          Invalid Format
                        </span>
                      <% end %>
                    </dd>
                  </div>
                  
                  <div class="flex space-x-2">
                    <%= link_to @media_item.url, target: "_blank",
                        class: "inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
                      <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                      </svg>
                      Open
                    <% end %>
                    
                    <button onclick="navigator.clipboard.writeText('<%= j(@media_item.url) %>')" 
                            class="inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                      <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                      </svg>
                      Copy
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Associated Place -->
          <% if @media_item.place %>
            <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
              <div class="px-6 py-6">
                <h3 class="text-lg font-medium text-gray-900 mb-6">Associated Place</h3>
                
                <div class="flex items-start">
                  <div class="flex-shrink-0 w-12 h-12">
                    <div class="w-12 h-12 bg-gray-200 rounded-full flex items-center justify-center">
                      <svg class="w-6 h-6 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                      </svg>
                    </div>
                  </div>
                  <div class="ml-4 flex-1">
                    <h4 class="text-lg font-medium text-gray-900">
                      <%= link_to (@media_item.place.name.presence || "Unnamed Place"), admin_place_path(@media_item.place), class: "text-blue-600 hover:text-blue-700" %>
                    </h4>
                    
                    <% if @media_item.place.formatted_address.present? %>
                      <p class="mt-1 text-sm text-gray-600">
                        <%= @media_item.place.formatted_address %>
                      </p>
                    <% end %>
                    
                    <div class="mt-2 flex items-center space-x-4 text-sm text-gray-500">
                      <span>ID: <%= @media_item.place_id %></span>
                      
                      <% if @media_item.place.rating.present? %>
                        <span>⭐ <%= @media_item.place.rating %>/5</span>
                      <% end %>
                      
                      <% if @media_item.place.lat.present? && @media_item.place.lng.present? %>
                        <span>📍 <%= @media_item.place.lat.round(6) %>, <%= @media_item.place.lng.round(6) %></span>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Sidebar -->
        <div class="space-y-8">
          <!-- Actions -->
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <h3 class="text-lg font-medium text-gray-900 mb-4">Actions</h3>
              <div class="space-y-3">
                <%= link_to edit_admin_media_item_path(@media_item),
                    class: "w-full inline-flex justify-center items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                  </svg>
                  Edit Media Item
                <% end %>
                
                <%= link_to admin_media_items_path,
                    class: "w-full inline-flex justify-center items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"/>
                  </svg>
                  Back to Media Items
                <% end %>
                
                <hr class="border-gray-200">
                
                <%= link_to admin_media_item_path(@media_item),
                    method: :delete,
                    data: { confirm: "Are you sure you want to delete this media item?" },
                    class: "w-full inline-flex justify-center items-center px-4 py-2 border border-red-300 text-sm font-medium rounded-lg text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                  </svg>
                  Delete Media Item
                <% end %>
              </div>
            </div>
          </div>

          <!-- Technical Info -->
          <div class="bg-gray-50 border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <h3 class="text-lg font-medium text-gray-900 mb-4">Technical Information</h3>
              <dl class="space-y-3">
                <div>
                  <dt class="text-sm font-medium text-gray-500">Record ID</dt>
                  <dd class="text-sm font-mono text-gray-900">
                    <%= @media_item.id %>
                  </dd>
                </div>
                
                <div>
                  <dt class="text-sm font-medium text-gray-500">Created</dt>
                  <dd class="text-sm text-gray-900">
                    <%= @media_item.created_at.strftime("%B %d, %Y at %I:%M %p") %>
                  </dd>
                </div>
                
                <div>
                  <dt class="text-sm font-medium text-gray-500">Last Updated</dt>
                  <dd class="text-sm text-gray-900">
                    <%= @media_item.updated_at.strftime("%B %d, %Y at %I:%M %p") %>
                  </dd>
                </div>
                
                <div>
                  <dt class="text-sm font-medium text-gray-500">Media Category</dt>
                  <dd class="text-sm text-gray-900">
                    <% if @media_item.image? %>
                      📷 Image
                    <% elsif @media_item.video? %>
                      🎥 Video
                    <% elsif @media_item.document? %>
                      📄 Document
                    <% else %>
                      📎 Other
                    <% end %>
                  </dd>
                </div>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
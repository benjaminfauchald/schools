<% content_for :title, "Media Items Management" %>


<!-- Main Content -->
  <div class="w-full py-8 px-4 sm:px-6 lg:px-8">
    <div class="space-y-8">
      <!-- Page Header with Inline Stats -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-6">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6">
            <div>
              <h1 class="text-3xl font-bold text-gray-900">Media Items Management</h1>
              <p class="mt-2 text-sm text-gray-600">Manage photos, videos, documents, and other media assets</p>
            </div>
            <div class="mt-4 sm:mt-0">
              <%= link_to new_admin_media_item_path, 
                  class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors" do %>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                </svg>
                Add New Media Item
              <% end %>
            </div>
          </div>
          
          <!-- Inline Statistics -->
          <div class="flex flex-wrap items-center gap-6 text-sm">
            <!-- Total Media Items -->
            <div class="flex items-center">
              <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center mr-3">
                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                </svg>
              </div>
              <div>
                <span class="font-semibold text-gray-900"><%= number_with_delimiter(@total_media_items || 0) %></span>
                <span class="text-gray-500">Total Items</span>
              </div>
            </div>

            <!-- Type Breakdown -->
            <div class="flex items-center">
              <div class="w-2 h-2 bg-green-500 rounded-full mr-2"></div>
              <span class="text-gray-900 font-medium"><%= number_with_delimiter(@total_images || 0) %></span>
              <span class="text-gray-500 ml-1">Images</span>
            </div>

            <div class="flex items-center">
              <div class="w-2 h-2 bg-yellow-500 rounded-full mr-2"></div>
              <span class="text-gray-900 font-medium"><%= number_with_delimiter(@total_documents || 0) %></span>
              <span class="text-gray-500 ml-1">Documents</span>
            </div>

            <div class="flex items-center">
              <div class="w-2 h-2 bg-purple-500 rounded-full mr-2"></div>
              <span class="text-gray-900 font-medium"><%= number_with_delimiter(@total_videos || 0) %></span>
              <span class="text-gray-500 ml-1">Videos</span>
            </div>

            <!-- Additional Stats -->
            <div class="flex items-center">
              <div class="w-8 h-8 bg-indigo-100 rounded-lg flex items-center justify-center mr-3">
                <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <span class="font-semibold text-gray-900"><%= number_with_delimiter(@places_with_media || 0) %></span>
                <span class="text-gray-500">Places with Media</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Search and Filters Section -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-6">
          <%= form_with url: admin_media_items_path, method: :get, local: true, class: "space-y-4" do |f| %>
            <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
              <div>
                <%= f.label :search, "Search", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= f.text_field :search, 
                    value: params[:search], 
                    placeholder: "Search by place, alt text, or URL...",
                    class: "block w-full pl-3 pr-10 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" %>
              </div>
              
              <div>
                <%= f.label :kind, "Media Type", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= f.select :kind, 
                    options_for_select([
                      ['All Types', ''],
                      ['Logo', 'logo'],
                      ['Photo', 'photo'],
                      ['Brochure', 'brochure'],
                      ['Fee Schedule', 'fee_schedule_pdf'],
                      ['Video', 'video'],
                      ['Virtual Tour', 'virtual_tour'],
                      ['Menu', 'menu'],
                      ['Floor Plan', 'floor_plan']
                    ], params[:kind]),
                    {},
                    { class: "block w-full pl-3 pr-10 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" } %>
              </div>

              <div>
                <%= f.label :place_id, "Place", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= f.select :place_id, 
                    options_for_select([['All Places', '']] + @popular_places.map { |id, name| [name, id] }, params[:place_id]),
                    {},
                    { class: "block w-full pl-3 pr-10 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" } %>
              </div>
              
              <div>
                <%= f.label :source, "Source", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= f.select :source, 
                    options_for_select([
                      ['All Sources', ''],
                      ['Google Places', 'google_places'],
                      ['School Upload', 'school_upload'],
                      ['Admin Upload', 'admin_upload']
                    ], params[:source]),
                    {},
                    { class: "block w-full pl-3 pr-10 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" } %>
              </div>
              
              <div class="flex items-end">
                <%= f.submit "Search", 
                    class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Media Items List -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
          <h3 class="text-lg font-medium text-gray-900">Media Items</h3>
        </div>
        
        <% if @media_items.any? %>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Preview
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Media Info
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Place
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Type & Source
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Created
                  </th>
                  <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Actions
                  </th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @media_items.each do |media_item| %>
                  <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-6 py-4">
                      <div class="flex items-center justify-center w-16 h-16 bg-gray-100 rounded-lg overflow-hidden">
                        <% if media_item.image? %>
                          <% image_src = media_item.uploaded? ? media_item.thumbnail_url(size: 64) : media_item.url %>
                          <img src="<%= image_src %>" alt="<%= media_item.display_alt_text %>" 
                               class="w-full h-full object-cover"
                               onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                          <div class="hidden w-full h-full items-center justify-center text-gray-400" style="display: none;">
                            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                          </div>
                        <% elsif media_item.video? %>
                          <div class="w-full h-full flex items-center justify-center text-purple-500">
                            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                            </svg>
                          </div>
                        <% else %>
                          <div class="w-full h-full flex items-center justify-center text-yellow-500">
                            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                            </svg>
                          </div>
                        <% end %>
                      </div>
                    </td>
                    <td class="px-6 py-4">
                      <div>
                        <div class="text-sm font-medium text-gray-900">
                          <%= link_to (media_item.alt_text.presence || "Media Item ##{media_item.id}"), admin_media_item_path(id: media_item.id), class: "text-blue-600 hover:text-blue-700" %>
                        </div>
                        <div class="text-sm text-gray-500 truncate max-w-xs">
                          <%= link_to media_item.url, media_item.url, target: "_blank", class: "text-blue-500 hover:text-blue-700" %>
                        </div>
                        <% if media_item.file_extension.present? %>
                          <div class="text-xs text-gray-400 uppercase">
                            .<%= media_item.file_extension %>
                          </div>
                        <% end %>
                      </div>
                    </td>
                    <td class="px-6 py-4">
                      <% if media_item.place %>
                        <div class="text-sm font-medium text-gray-900">
                          <%= link_to (media_item.place.name.presence || "Unnamed Place"), admin_place_path(id: media_item.place.id), class: "text-blue-600 hover:text-blue-700" %>
                        </div>
                        <div class="text-xs text-gray-500">ID: <%= media_item.place_id %></div>
                      <% else %>
                        <span class="text-gray-400">No place assigned</span>
                      <% end %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                          <%= media_item.kind_display %>
                        </span>
                        <div class="text-xs text-gray-500 mt-1">
                          Sort: <%= media_item.sort_order || 0 %>
                        </div>
                        <% if media_item.source.present? %>
                          <div class="mt-1">
                            <% source_color = case media_item.source
                                              when 'google_places' then 'bg-green-100 text-green-800'
                                              when 'school_upload' then 'bg-blue-100 text-blue-800'
                                              when 'admin_upload' then 'bg-purple-100 text-purple-800'
                                              else 'bg-gray-100 text-gray-800'
                                              end %>
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= source_color %>">
                              <%= media_item.source.humanize %>
                            </span>
                          </div>
                        <% end %>
                      </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="text-sm text-gray-900">
                        <%= media_item.created_at.strftime("%m/%d/%Y") %>
                      </div>
                      <div class="text-sm text-gray-500">
                        <%= media_item.created_at.strftime("%I:%M %p") %>
                      </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                      <div class="flex items-center justify-end space-x-2">
                        <%= link_to media_item.url, target: "_blank",
                            class: "inline-flex items-center px-2.5 py-1.5 border border-gray-300 shadow-sm text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
                          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                          </svg>
                          Open
                        <% end %>
                        
                        <%= link_to admin_media_item_path(id: media_item.id),
                            class: "inline-flex items-center px-2.5 py-1.5 border border-gray-300 shadow-sm text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
                          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                          </svg>
                          View
                        <% end %>
                        
                        <%= link_to edit_admin_media_item_path(id: media_item.id),
                            class: "inline-flex items-center px-2.5 py-1.5 border border-gray-300 shadow-sm text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
                          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                          </svg>
                          Edit
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          
          <!-- Results Info -->
          <div class="bg-white px-4 py-3 border-t border-gray-200 sm:px-6">
            <div class="flex-1 flex justify-between sm:hidden">
              <p class="text-sm text-gray-700">
                Showing <%= @media_items.count %> of <%= @total_media_items %> media items
              </p>
            </div>
            <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
              <div>
                <p class="text-sm text-gray-700">
                  Showing <span class="font-medium"><%= @media_items.count %></span> media items
                  <% if @media_items.count < @total_media_items %>
                    (limited to first 50 results - use search to narrow down)
                  <% end %>
                </p>
              </div>
            </div>
          </div>
        <% else %>
          <div class="text-center py-12">
            <div class="mx-auto h-24 w-24 text-gray-400 mb-4">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
              </svg>
            </div>
            <h3 class="mt-2 text-lg font-medium text-gray-900">No media items found</h3>
            <p class="mt-2 text-sm text-gray-500 max-w-sm mx-auto">
              <% if params[:search].present? || params[:kind].present? || params[:place_id].present? %>
                Try adjusting your search criteria or filters to see more results.
              <% else %>
                No media items have been uploaded yet. Add the first media item to get started.
              <% end %>
            </p>
            <div class="mt-6">
              <%= link_to new_admin_media_item_path, 
                  class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                </svg>
                Add First Media Item
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
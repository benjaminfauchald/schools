<% content_for :title, "Media Item: #{@media_item.place.name rescue 'Edit Media Item'}" %>

<!-- Main Content -->
<div class="w-full py-8 px-4 sm:px-6 lg:px-8">
  <div class="space-y-8">
    <!-- Page Header with Inline Stats -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
      <div class="px-6 py-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6">
          <div>
            <h1 class="text-3xl font-bold text-gray-900">Edit Media Item</h1>
            <p class="mt-2 text-sm text-gray-600">Update media content and settings for places</p>
          </div>
          <div class="mt-4 sm:mt-0 flex space-x-3">
            <%= link_to admin_media_item_path(@media_item), 
                class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
              </svg>
              View Item
            <% end %>
            <%= link_to admin_media_items_path, 
                class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
              </svg>
              Back to Media Items
            <% end %>
          </div>
        </div>
        
        <!-- Inline Statistics -->
        <div class="flex flex-wrap items-center gap-6 text-sm">
          <!-- Media Type -->
          <div class="flex items-center">
            <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center mr-3">
              <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <span class="font-semibold text-gray-900"><%= @media_item.kind&.humanize || "Unknown Type" %></span>
              <span class="text-gray-500">Type</span>
            </div>
          </div>

          <!-- Place -->
          <div class="flex items-center">
            <div class="w-2 h-2 bg-purple-500 rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium"><%= @media_item.place&.name || "No Place" %></span>
            <span class="text-gray-500 ml-1">Location</span>
          </div>

          <!-- Sort Order -->
          <div class="flex items-center">
            <div class="w-2 h-2 bg-orange-500 rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium"><%= @media_item.sort_order || 0 %></span>
            <span class="text-gray-500 ml-1">Sort Order</span>
          </div>

          <!-- URL Status -->
          <div class="flex items-center">
            <div class="w-2 h-2 <%= @media_item.url.present? ? 'bg-green-500' : 'bg-red-500' %> rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium"><%= @media_item.url.present? ? "URL Set" : "No URL" %></span>
            <span class="text-gray-500 ml-1">Media URL</span>
          </div>

          <!-- Alt Text Status -->
          <div class="flex items-center">
            <div class="w-2 h-2 <%= @media_item.alt_text.present? ? 'bg-green-500' : 'bg-gray-400' %> rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium"><%= @media_item.alt_text.present? ? "Alt Text Set" : "No Alt Text" %></span>
            <span class="text-gray-500 ml-1">Accessibility</span>
          </div>

          <!-- Last Updated -->
          <div class="flex items-center">
            <svg class="w-4 h-4 text-gray-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span class="text-gray-900 font-medium"><%= @media_item.updated_at&.strftime("%b %d, %Y") || "Unknown" %></span>
            <span class="text-gray-500 ml-1">Updated</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Error Messages -->
    <% if @media_item.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-xl shadow-sm p-6">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
            </svg>
          </div>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-red-800">
              <%= pluralize(@media_item.errors.count, "error") %> prohibited this media item from being saved:
            </h3>
            <div class="mt-2 text-sm text-red-700">
              <ul class="list-disc pl-5 space-y-1">
                <% @media_item.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <%= form_with model: [:admin, @media_item], local: true do |form| %>
      <!-- Basic Information -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-semibold text-gray-900">Basic Information</h3>
          <p class="mt-1 text-sm text-gray-600">Configure place association and media type</p>
        </div>
        <div class="px-6 py-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <%= form.label :place_id, "Place", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.select :place_id, 
                  options_from_collection_for_select(@places, :id, :name, @media_item.place_id), 
                  { prompt: "Select a place..." },
                  { class: "block w-full pl-3 pr-10 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" } %>
            </div>

            <div>
              <%= form.label :kind, "Media Type", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.select :kind, 
                  options_for_select([
                    ['Logo', 'logo'],
                    ['Campus Photo', 'campus_photo'],
                    ['Brochure', 'brochure'],
                    ['Fee Schedule PDF', 'fee_schedule_pdf'],
                    ['Video', 'video'],
                    ['Virtual Tour', 'virtual_tour'],
                    ['Menu', 'menu'],
                    ['Floor Plan', 'floor_plan']
                  ], @media_item.kind), 
                  { prompt: "Select media type..." },
                  { class: "block w-full pl-3 pr-10 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" } %>
            </div>
          </div>
        </div>
      </div>

      <!-- Media Content -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-semibold text-gray-900">Media Content</h3>
          <p class="mt-1 text-sm text-gray-600">Specify the media URL and descriptive information</p>
        </div>
        <div class="px-6 py-6">
          <div class="grid grid-cols-1 gap-6">
            <div>
              <%= form.label :url, "Media URL", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.url_field :url, 
                  class: "block w-full px-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm",
                  placeholder: "https://example.com/media/image.jpg" %>
              <p class="mt-2 text-sm text-gray-500">Direct URL to the media file (image, video, or document)</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <%= form.label :alt_text, "Alt Text / Description", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= form.text_area :alt_text, 
                    rows: 3,
                    class: "block w-full px-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm",
                    placeholder: "Describe the media content for accessibility..." %>
                <p class="mt-2 text-sm text-gray-500">Optional description for accessibility and SEO. If left blank, will be auto-generated.</p>
              </div>

              <div>
                <%= form.label :sort_order, "Sort Order", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= form.number_field :sort_order, 
                    min: 0,
                    class: "block w-full px-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm",
                    placeholder: "0" %>
                <p class="mt-2 text-sm text-gray-500">Lower numbers appear first. Default is 0.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Media Preview -->
      <% if @media_item.url.present? %>
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
          <div class="px-6 py-4 border-b border-gray-200">
            <h3 class="text-lg font-semibold text-gray-900">Current Media Preview</h3>
            <p class="mt-1 text-sm text-gray-600">Preview of the current media content</p>
          </div>
          <div class="px-6 py-6">
            <div class="flex items-start space-x-4 p-4 bg-gray-50 border border-gray-200 rounded-lg">
              <div class="flex-shrink-0">
                <% if @media_item.respond_to?(:image?) && @media_item.image? %>
                  <div class="w-16 h-16 bg-blue-100 rounded-lg flex items-center justify-center">
                    <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                  </div>
                <% elsif @media_item.respond_to?(:video?) && @media_item.video? %>
                  <div class="w-16 h-16 bg-red-100 rounded-lg flex items-center justify-center">
                    <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                    </svg>
                  </div>
                <% else %>
                  <div class="w-16 h-16 bg-gray-100 rounded-lg flex items-center justify-center">
                    <svg class="w-8 h-8 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                  </div>
                <% end %>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-gray-900"><%= @media_item.kind&.humanize || "Media Item" %></p>
                <p class="text-sm text-gray-500 truncate"><%= @media_item.url %></p>
                <% if @media_item.alt_text.present? %>
                  <p class="text-sm text-gray-600 mt-1"><%= @media_item.alt_text %></p>
                <% end %>
              </div>
              <div class="flex-shrink-0">
                <%= link_to @media_item.url, target: "_blank", 
                    class: "inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                  View Media
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Information Panel -->
      <div class="bg-blue-50 border border-blue-200 rounded-xl shadow-sm">
        <div class="px-6 py-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-blue-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-blue-800">About Media Items</h3>
              <div class="mt-1 text-sm text-blue-700">
                <p>Media items help showcase facilities and provide information. Use descriptive alt text for accessibility.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Form Actions -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-6">
          <div class="flex items-center justify-end space-x-4 pt-6 border-t border-gray-200">
            <%= link_to admin_media_items_path, 
                class: "inline-flex justify-center py-3 px-6 border border-gray-300 shadow-sm text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors" do %>
              Cancel
            <% end %>
            <%= form.submit "Update Media Item", 
                class: "inline-flex justify-center py-3 px-6 border border-gray-300 shadow-sm text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
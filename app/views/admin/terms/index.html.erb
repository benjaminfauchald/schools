<% content_for :title, "Terms Management" %>


<!-- Main Content -->
  <div class="mx-auto py-8 px-6 sm:px-8 lg:px-12 max-w-none">
    <div class="space-y-8">
      <!-- Page Header -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-6">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h1 class="text-3xl font-bold text-gray-900">Terms Management</h1>
              <p class="mt-2 text-sm text-gray-600">Manage taxonomy terms and categories for schools and places</p>
            </div>
            <div class="mt-4 sm:mt-0 flex space-x-3">
              <%= link_to admin_vocabularies_path, 
                  class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                </svg>
                Manage Vocabularies
              <% end %>
              <%= link_to new_admin_term_path, 
                  class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                </svg>
                Add New Term
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Statistics Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-6">
        <!-- Total Terms -->
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
          <div class="px-6 py-6">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                  <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                  </svg>
                </div>
              </div>
              <div class="ml-4">
                <h3 class="text-sm font-medium text-gray-500">Total Terms</h3>
                <p class="text-2xl font-bold text-gray-900"><%= number_with_delimiter(@total_terms) %></p>
              </div>
            </div>
          </div>
        </div>

        <!-- Active Terms -->
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
          <div class="px-6 py-6">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
                  <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
              </div>
              <div class="ml-4">
                <h3 class="text-sm font-medium text-gray-500">Active</h3>
                <p class="text-2xl font-bold text-gray-900"><%= number_with_delimiter(@active_terms) %></p>
                <% if @total_terms > 0 %>
                  <p class="text-xs text-gray-500"><%= ((@active_terms.to_f / @total_terms) * 100).round(1) %>% active</p>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <!-- Root Terms -->
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
          <div class="px-6 py-6">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <div class="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center">
                  <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
                  </svg>
                </div>
              </div>
              <div class="ml-4">
                <h3 class="text-sm font-medium text-gray-500">Root Terms</h3>
                <p class="text-2xl font-bold text-gray-900"><%= number_with_delimiter(@root_terms) %></p>
                <p class="text-xs text-gray-500">Top-level</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Terms with Children -->
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
          <div class="px-6 py-6">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <div class="w-12 h-12 bg-yellow-100 rounded-full flex items-center justify-center">
                  <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                  </svg>
                </div>
              </div>
              <div class="ml-4">
                <h3 class="text-sm font-medium text-gray-500">With Children</h3>
                <p class="text-2xl font-bold text-gray-900"><%= number_with_delimiter(@terms_with_children) %></p>
                <p class="text-xs text-gray-500">Hierarchical</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Vocabularies -->
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
          <div class="px-6 py-6">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <div class="w-12 h-12 bg-indigo-100 rounded-full flex items-center justify-center">
                  <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                  </svg>
                </div>
              </div>
              <div class="ml-4">
                <h3 class="text-sm font-medium text-gray-500">Vocabularies</h3>
                <p class="text-2xl font-bold text-gray-900"><%= number_with_delimiter(@vocabularies_count) %></p>
                <p class="text-xs text-gray-500">Categories</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Terms in Use -->
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
          <div class="px-6 py-6">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <div class="w-12 h-12 bg-orange-100 rounded-full flex items-center justify-center">
                  <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                  </svg>
                </div>
              </div>
              <div class="ml-4">
                <h3 class="text-sm font-medium text-gray-500">In Use</h3>
                <p class="text-2xl font-bold text-gray-900"><%= number_with_delimiter(@usage_count) %></p>
                <p class="text-xs text-gray-500">Tagged</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Search and Filters Section -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-6">
          <%= form_with url: admin_terms_path, method: :get, local: true, class: "space-y-4" do |f| %>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
              <div>
                <%= f.label :search, "Search", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= f.text_field :search, 
                    value: params[:search], 
                    placeholder: "Search by label or slug...",
                    class: "block w-full pl-3 pr-10 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" %>
              </div>
              
              <div>
                <%= f.label :vocabulary_id, "Vocabulary", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= f.select :vocabulary_id, 
                    options_for_select([['All Vocabularies', '']] + @vocabularies.map { |v| [v.label, v.id] }, params[:vocabulary_id]),
                    {},
                    { class: "block w-full pl-3 pr-10 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" } %>
              </div>

              <div>
                <%= f.label :status, "Status", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= f.select :status, 
                    options_for_select([
                      ['All Terms', ''],
                      ['Active Only', 'active'],
                      ['Inactive Only', 'inactive'],
                      ['Root Terms', 'root'],
                      ['Child Terms', 'children']
                    ], params[:status]),
                    {},
                    { class: "block w-full pl-3 pr-10 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" } %>
              </div>
              
              <div class="flex items-end">
                <%= f.submit "Search", 
                    class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Terms List -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
          <h3 class="text-lg font-medium text-gray-900">Terms</h3>
        </div>
        
        <% if @terms.any? %>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Term
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Vocabulary
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Hierarchy
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Status & Usage
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Children
                  </th>
                  <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Actions
                  </th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @terms.each do |term| %>
                  <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-6 py-4">
                      <div class="flex items-center">
                        <div class="flex-shrink-0 w-10 h-10">
                          <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                            <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                            </svg>
                          </div>
                        </div>
                        <div class="ml-4">
                          <div class="text-sm font-medium text-gray-900">
                            <%= link_to term.label, admin_term_path(term), class: "text-blue-600 hover:text-blue-700" %>
                          </div>
                          <div class="text-sm text-gray-500">
                            <span class="font-mono"><%= term.slug %></span>
                          </div>
                          <% if term.description.present? %>
                            <div class="text-xs text-gray-400 mt-1">
                              <%= truncate(term.description, length: 60) %>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    </td>
                    <td class="px-6 py-4">
                      <% if term.vocabulary %>
                        <div class="text-sm text-gray-900">
                          <%= link_to term.vocabulary.label, admin_vocabulary_path(term.vocabulary), class: "text-blue-600 hover:text-blue-700" %>
                        </div>
                        <div class="text-xs text-gray-500">
                          <%= term.vocabulary.code %>
                        </div>
                      <% else %>
                        <span class="text-gray-400">No vocabulary</span>
                      <% end %>
                    </td>
                    <td class="px-6 py-4">
                      <% if term.parent %>
                        <div class="text-sm text-gray-900">
                          <%= link_to term.parent.label, admin_term_path(term.parent), class: "text-blue-600 hover:text-blue-700" %>
                        </div>
                        <div class="text-xs text-gray-500">
                          ↳ Child term
                        </div>
                      <% else %>
                        <div class="text-sm text-gray-900">
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                            <svg class="w-2 h-2 mr-1 fill-current" viewBox="0 0 8 8">
                              <circle cx="4" cy="4" r="3"/>
                            </svg>
                            Root
                          </span>
                        </div>
                      <% end %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="flex flex-col space-y-1">
                        <% if term.is_active? %>
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                            <svg class="w-2 h-2 mr-1 fill-current" viewBox="0 0 8 8">
                              <circle cx="4" cy="4" r="3"/>
                            </svg>
                            Active
                          </span>
                        <% else %>
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                            <svg class="w-2 h-2 mr-1 fill-current" viewBox="0 0 8 8">
                              <circle cx="4" cy="4" r="3"/>
                            </svg>
                            Inactive
                          </span>
                        <% end %>
                        <% if term.taggings.any? %>
                          <span class="text-xs text-gray-500">
                            <%= pluralize(term.taggings.count, 'usage') %>
                          </span>
                        <% end %>
                      </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <% if term.children.any? %>
                        <div class="text-sm text-gray-900">
                          <%= pluralize(term.children.count, 'child') %>
                        </div>
                        <div class="text-xs text-gray-500">
                          <% active_children = term.children.active.count %>
                          <% if active_children > 0 %>
                            <%= active_children %> active
                          <% else %>
                            No active
                          <% end %>
                        </div>
                      <% else %>
                        <span class="text-xs text-gray-400">No children</span>
                      <% end %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                      <div class="flex items-center justify-end space-x-2">
                        <%= link_to admin_term_path(term),
                            class: "inline-flex items-center px-2.5 py-1.5 border border-gray-300 shadow-sm text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
                          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                          </svg>
                          View
                        <% end %>
                        
                        <%= link_to edit_admin_term_path(term),
                            class: "inline-flex items-center px-2.5 py-1.5 border border-gray-300 shadow-sm text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
                          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                          </svg>
                          Edit
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          
          <!-- Results Info -->
          <div class="bg-white px-4 py-3 border-t border-gray-200 sm:px-6">
            <div class="flex-1 flex justify-between sm:hidden">
              <p class="text-sm text-gray-700">
                Showing <%= @terms.count %> of <%= @total_terms %> terms
              </p>
            </div>
            <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
              <div>
                <p class="text-sm text-gray-700">
                  Showing <span class="font-medium"><%= @terms.count %></span> terms
                  <% if @terms.count < @total_terms %>
                    (limited to first 50 results - use search to narrow down)
                  <% end %>
                </p>
              </div>
            </div>
          </div>
        <% else %>
          <div class="text-center py-12">
            <div class="mx-auto h-24 w-24 text-gray-400 mb-4">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
              </svg>
            </div>
            <h3 class="mt-2 text-lg font-medium text-gray-900">No terms found</h3>
            <p class="mt-2 text-sm text-gray-500 max-w-sm mx-auto">
              <% if params[:search].present? || params[:vocabulary_id].present? || params[:status].present? %>
                Try adjusting your search criteria or filters to see more results.
              <% else %>
                No terms have been created yet. Add the first term to get started.
              <% end %>
            </p>
            <div class="mt-6">
              <%= link_to new_admin_term_path, 
                  class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                </svg>
                Add First Term
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
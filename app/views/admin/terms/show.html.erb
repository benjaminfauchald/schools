<% content_for :title, "Term Details - #{@term.label}" %>


<!-- Main Content -->
  <div class="mx-auto py-8 px-6 sm:px-8 lg:px-12 max-w-7xl">
    <div class="space-y-8">
      <!-- Breadcrumb -->
      <nav class="flex" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <li class="inline-flex items-center">
            <%= link_to admin_root_path, class: "inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600" do %>
              <svg class="w-3 h-3 mr-2.5" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20">
                <path d="m19.707 9.293-2-2-7-7a1 1 0 0 0-1.414 0l-7 7-2 2a1 1 0 0 0 1.414 1.414L2 10.414V18a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-7.586l.293.293a1 1 0 0 0 1.414-1.414Z"/>
              </svg>
              Admin Dashboard
            <% end %>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
              </svg>
              <%= link_to "Terms", admin_terms_path, class: "ml-1 text-sm font-medium text-gray-700 hover:text-blue-600 md:ml-2" %>
            </div>
          </li>
          <% if @term.vocabulary %>
            <li>
              <div class="flex items-center">
                <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" fill="none" viewBox="0 0 6 10">
                  <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
                </svg>
                <%= link_to @term.vocabulary.label, admin_vocabulary_path(@term.vocabulary), class: "ml-1 text-sm font-medium text-gray-700 hover:text-blue-600 md:ml-2" %>
              </div>
            </li>
          <% end %>
          <li aria-current="page">
            <div class="flex items-center">
              <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
              </svg>
              <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2"><%= @term.label %></span>
            </div>
          </li>
        </ol>
      </nav>

      <!-- Term Hierarchy Breadcrumb -->
      <% if @breadcrumbs.length > 1 %>
        <div class="bg-blue-50 border border-blue-200 rounded-xl p-4">
          <div class="flex items-center">
            <svg class="w-5 h-5 text-blue-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
            </svg>
            <span class="text-sm font-medium text-blue-900 mr-3">Hierarchy:</span>
            <nav class="flex" aria-label="Term Hierarchy">
              <ol class="inline-flex items-center space-x-1 md:space-x-2">
                <% @breadcrumbs.each_with_index do |breadcrumb_term, index| %>
                  <% if index == @breadcrumbs.length - 1 %>
                    <li aria-current="page">
                      <span class="text-sm font-medium text-blue-800"><%= breadcrumb_term.label %></span>
                    </li>
                  <% else %>
                    <li>
                      <%= link_to breadcrumb_term.label, admin_term_path(breadcrumb_term), class: "text-sm font-medium text-blue-600 hover:text-blue-800" %>
                    </li>
                    <li>
                      <svg class="w-3 h-3 text-blue-400 mx-1" fill="none" viewBox="0 0 6 10">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
                      </svg>
                    </li>
                  <% end %>
                <% end %>
              </ol>
            </nav>
          </div>
        </div>
      <% end %>

      <!-- Page Header -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-6">
          <div class="flex items-center justify-between">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center">
                  <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                  </svg>
                </div>
              </div>
              <div class="ml-4">
                <h1 class="text-3xl font-bold text-gray-900"><%= @term.label %></h1>
                <div class="mt-1 flex items-center space-x-4">
                  <!-- Status Badge -->
                  <% if @term.is_active? %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                      <svg class="w-2 h-2 mr-1.5 fill-current" viewBox="0 0 8 8">
                        <circle cx="4" cy="4" r="3"/>
                      </svg>
                      Active
                    </span>
                  <% else %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
                      <svg class="w-2 h-2 mr-1.5 fill-current" viewBox="0 0 8 8">
                        <circle cx="4" cy="4" r="3"/>
                      </svg>
                      Inactive
                    </span>
                  <% end %>

                  <!-- Hierarchy Badge -->
                  <% if @term.parent %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
                      ↳ Child Term
                    </span>
                  <% else %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-purple-100 text-purple-800">
                      <svg class="w-2 h-2 mr-1.5 fill-current" viewBox="0 0 8 8">
                        <circle cx="4" cy="4" r="3"/>
                      </svg>
                      Root Term
                    </span>
                  <% end %>

                  <!-- Usage Badge -->
                  <% if @term.taggings.any? %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-orange-100 text-orange-800">
                      <%= pluralize(@term.taggings.count, 'usage') %>
                    </span>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-8">
          <!-- Term Information -->
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <h3 class="text-lg font-medium text-gray-900 mb-6">Term Information</h3>
              
              <dl class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <dt class="text-sm font-medium text-gray-500 mb-2">Label</dt>
                  <dd class="text-lg font-medium text-gray-900">
                    <%= @term.label %>
                  </dd>
                </div>
                
                <div>
                  <dt class="text-sm font-medium text-gray-500 mb-2">Slug</dt>
                  <dd class="text-sm font-mono text-gray-900 bg-gray-50 px-3 py-2 rounded">
                    <%= @term.slug %>
                  </dd>
                </div>
                
                <div class="md:col-span-2">
                  <dt class="text-sm font-medium text-gray-500 mb-2">Description</dt>
                  <dd class="text-sm text-gray-900">
                    <% if @term.description.present? %>
                      <%= simple_format(@term.description, class: "mb-0") %>
                    <% else %>
                      <span class="text-gray-400 italic">No description provided</span>
                    <% end %>
                  </dd>
                </div>
                
                <div>
                  <dt class="text-sm font-medium text-gray-500 mb-2">Full Hierarchy Path</dt>
                  <dd class="text-sm text-gray-900">
                    <%= @term.full_label %>
                  </dd>
                </div>
                
                <div>
                  <dt class="text-sm font-medium text-gray-500 mb-2">Usage Count</dt>
                  <dd class="text-sm text-gray-900">
                    <% if @term.taggings.any? %>
                      <%= pluralize(@term.taggings.count, 'school') %> using this term
                    <% else %>
                      <span class="text-gray-400">Not currently in use</span>
                    <% end %>
                  </dd>
                </div>
              </dl>
            </div>
          </div>

          <!-- Vocabulary Information -->
          <% if @term.vocabulary %>
            <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
              <div class="px-6 py-6">
                <h3 class="text-lg font-medium text-gray-900 mb-6">Vocabulary</h3>
                
                <div class="flex items-start">
                  <div class="flex-shrink-0 w-12 h-12">
                    <div class="w-12 h-12 bg-indigo-100 rounded-full flex items-center justify-center">
                      <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                      </svg>
                    </div>
                  </div>
                  <div class="ml-4 flex-1">
                    <h4 class="text-lg font-medium text-gray-900">
                      <%= link_to @term.vocabulary.label, admin_vocabulary_path(@term.vocabulary), class: "text-blue-600 hover:text-blue-700" %>
                    </h4>
                    <p class="mt-1 text-sm text-gray-600">
                      Code: <span class="font-mono"><%= @term.vocabulary.code %></span>
                    </p>
                    <div class="mt-2 text-sm text-gray-500">
                      <%= pluralize(@term.vocabulary.terms.count, 'term') %> in this vocabulary
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <!-- Parent Term -->
          <% if @term.parent %>
            <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
              <div class="px-6 py-6">
                <h3 class="text-lg font-medium text-gray-900 mb-6">Parent Term</h3>
                
                <div class="flex items-start">
                  <div class="flex-shrink-0 w-12 h-12">
                    <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                      <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 11l5-5m0 0l5 5m-5-5v12"/>
                      </svg>
                    </div>
                  </div>
                  <div class="ml-4 flex-1">
                    <h4 class="text-lg font-medium text-gray-900">
                      <%= link_to @term.parent.label, admin_term_path(@term.parent), class: "text-blue-600 hover:text-blue-700" %>
                    </h4>
                    <p class="mt-1 text-sm text-gray-600">
                      <%= @term.parent.description.presence || "No description" %>
                    </p>
                    <div class="mt-2 text-sm text-gray-500">
                      <span class="font-mono"><%= @term.parent.slug %></span>
                      <% if @term.parent.taggings.any? %>
                        • <%= pluralize(@term.parent.taggings.count, 'usage') %>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <!-- Child Terms -->
          <% if @term.children.any? %>
            <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
              <div class="px-6 py-6">
                <h3 class="text-lg font-medium text-gray-900 mb-6">Child Terms</h3>
                
                <div class="space-y-4">
                  <% @term.children.includes(:taggings).each do |child| %>
                    <div class="flex items-start p-4 bg-gray-50 rounded-lg">
                      <div class="flex-shrink-0 w-10 h-10">
                        <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                          <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 13l3 3 7-7"/>
                          </svg>
                        </div>
                      </div>
                      <div class="ml-3 flex-1">
                        <div class="flex items-center justify-between">
                          <h4 class="text-sm font-medium text-gray-900">
                            <%= link_to child.label, admin_term_path(child), class: "text-blue-600 hover:text-blue-700" %>
                          </h4>
                          <div class="flex items-center space-x-2">
                            <% if child.is_active? %>
                              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
                                Active
                              </span>
                            <% else %>
                              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800">
                                Inactive
                              </span>
                            <% end %>
                            <% if child.taggings.any? %>
                              <span class="text-xs text-gray-500">
                                <%= pluralize(child.taggings.count, 'usage') %>
                              </span>
                            <% end %>
                          </div>
                        </div>
                        <p class="mt-1 text-xs text-gray-500 font-mono"><%= child.slug %></p>
                        <% if child.description.present? %>
                          <p class="mt-2 text-sm text-gray-600"><%= truncate(child.description, length: 100) %></p>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>

          <!-- Metadata -->
          <% if @term.metadata.present? %>
            <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
              <div class="px-6 py-6">
                <h3 class="text-lg font-medium text-gray-900 mb-6">Metadata</h3>
                
                <div class="bg-gray-50 rounded-lg p-4">
                  <pre class="text-sm text-gray-900 whitespace-pre-wrap"><%= JSON.pretty_generate(JSON.parse(@term.metadata)) %></pre>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Sidebar -->
        <div class="space-y-8">
          <!-- Actions -->
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <h3 class="text-lg font-medium text-gray-900 mb-4">Actions</h3>
              <div class="space-y-3">
                <%= link_to edit_admin_term_path(@term),
                    class: "w-full inline-flex justify-center items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                  </svg>
                  Edit Term
                <% end %>
                
                <%= link_to admin_terms_path,
                    class: "w-full inline-flex justify-center items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"/>
                  </svg>
                  Back to Terms
                <% end %>
                
                <% if @term.vocabulary %>
                  <%= link_to admin_vocabulary_path(@term.vocabulary),
                      class: "w-full inline-flex justify-center items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                    </svg>
                    View Vocabulary
                  <% end %>
                <% end %>
                
                <hr class="border-gray-200">
                
                <%= link_to admin_term_path(@term),
                    method: :delete,
                    data: { confirm: "Are you sure you want to delete this term?#{@term.children.any? ? ' This term has child terms.' : ''}#{@term.taggings.any? ? ' This term is currently in use.' : ''}" },
                    class: "w-full inline-flex justify-center items-center px-4 py-2 border border-red-300 text-sm font-medium rounded-lg text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                  </svg>
                  Delete Term
                <% end %>
              </div>
            </div>
          </div>

          <!-- Statistics -->
          <div class="bg-gray-50 border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <h3 class="text-lg font-medium text-gray-900 mb-4">Statistics</h3>
              <dl class="space-y-3">
                <div>
                  <dt class="text-sm font-medium text-gray-500">Record ID</dt>
                  <dd class="text-sm font-mono text-gray-900">
                    <%= @term.id %>
                  </dd>
                </div>
                
                <div>
                  <dt class="text-sm font-medium text-gray-500">Created</dt>
                  <dd class="text-sm text-gray-900">
                    <%= @term.created_at.strftime("%B %d, %Y at %I:%M %p") %>
                  </dd>
                </div>
                
                <div>
                  <dt class="text-sm font-medium text-gray-500">Last Updated</dt>
                  <dd class="text-sm text-gray-900">
                    <%= @term.updated_at.strftime("%B %d, %Y at %I:%M %p") %>
                  </dd>
                </div>
                
                <div>
                  <dt class="text-sm font-medium text-gray-500">Child Terms</dt>
                  <dd class="text-sm text-gray-900">
                    <%= pluralize(@term.children.count, 'child term') %>
                  </dd>
                </div>
                
                <div>
                  <dt class="text-sm font-medium text-gray-500">Current Usage</dt>
                  <dd class="text-sm text-gray-900">
                    <%= pluralize(@term.taggings.count, 'school') %>
                  </dd>
                </div>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
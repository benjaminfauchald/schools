<% content_for :title, "Term Details - #{@term.label}" %>

<!-- Main Content -->
<div class="w-full py-8 px-4 sm:px-6 lg:px-8">
  <div class="space-y-8">
    <!-- Page Header with Inline Stats -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
      <div class="px-6 py-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6">
          <div>
            <h1 class="text-3xl font-bold text-gray-900"><%= @term.label %></h1>
            <p class="mt-2 text-sm text-gray-600"><%= @term.description.presence || "Term definition and metadata" %></p>
          </div>
          <div class="mt-4 sm:mt-0 flex space-x-3">
            <%= link_to edit_admin_term_path(@term), 
                class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
              </svg>
              Edit Term
            <% end %>
            <%= link_to admin_terms_path, 
                class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"/>
              </svg>
              Back to Terms
            <% end %>
          </div>
        </div>
        
        <!-- Inline Statistics -->
        <div class="flex flex-wrap items-center gap-6 text-sm">
          <!-- Slug -->
          <div class="flex items-center">
            <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center mr-3">
              <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
              </svg>
            </div>
            <div>
              <span class="font-semibold text-gray-900"><%= @term.slug %></span>
              <span class="text-gray-500">Slug</span>
            </div>
          </div>

          <!-- Status -->
          <div class="flex items-center">
            <% if @term.is_active? %>
              <div class="w-2 h-2 bg-green-500 rounded-full mr-2"></div>
              <span class="text-gray-900 font-medium">Active</span>
            <% else %>
              <div class="w-2 h-2 bg-red-500 rounded-full mr-2"></div>
              <span class="text-gray-900 font-medium">Inactive</span>
            <% end %>
            <span class="text-gray-500 ml-1">Status</span>
          </div>

          <!-- Usage Count -->
          <div class="flex items-center">
            <div class="w-2 h-2 <%= @term.taggings.any? ? 'bg-orange-500' : 'bg-gray-400' %> rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium"><%= number_with_delimiter(@term.taggings.count) %></span>
            <span class="text-gray-500 ml-1">Usages</span>
          </div>

          <!-- Child Terms -->
          <div class="flex items-center">
            <div class="w-2 h-2 bg-purple-500 rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium"><%= number_with_delimiter(@term.children.count) %></span>
            <span class="text-gray-500 ml-1">Child Terms</span>
          </div>

          <!-- Vocabulary -->
          <% if @term.vocabulary %>
            <div class="flex items-center">
              <svg class="w-4 h-4 text-indigo-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
              </svg>
              <span class="text-gray-900 font-medium"><%= @term.vocabulary.label %></span>
              <span class="text-gray-500 ml-1">Vocabulary</span>
            </div>
          <% end %>

          <!-- Hierarchy Status -->
          <div class="flex items-center">
            <% if @term.parent %>
              <svg class="w-4 h-4 text-blue-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
              </svg>
              <span class="text-gray-900 font-medium">Child Term</span>
            <% else %>
              <svg class="w-4 h-4 text-purple-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
              </svg>
              <span class="text-gray-900 font-medium">Root Term</span>
            <% end %>
            <span class="text-gray-500 ml-1">Type</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Term Hierarchy Breadcrumb -->
    <% if @breadcrumbs.length > 1 %>
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-4">
        <div class="flex items-center">
          <svg class="w-5 h-5 text-blue-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
          </svg>
          <span class="text-sm font-medium text-blue-900 mr-3">Hierarchy:</span>
          <nav class="flex" aria-label="Term Hierarchy">
            <ol class="inline-flex items-center space-x-1 md:space-x-2">
              <% @breadcrumbs.each_with_index do |breadcrumb_term, index| %>
                <% if index == @breadcrumbs.length - 1 %>
                  <li aria-current="page">
                    <span class="text-sm font-medium text-blue-800"><%= breadcrumb_term.label %></span>
                  </li>
                <% else %>
                  <li>
                    <%= link_to breadcrumb_term.label, admin_term_path(breadcrumb_term), class: "text-sm font-medium text-blue-600 hover:text-blue-800" %>
                  </li>
                  <li>
                    <svg class="w-3 h-3 text-blue-400 mx-1" fill="none" viewBox="0 0 6 10">
                      <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
                    </svg>
                  </li>
                <% end %>
              <% end %>
            </ol>
          </nav>
        </div>
      </div>
    <% end %>
    <!-- Term Information -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
      <div class="px-6 py-6">
        <h3 class="text-lg font-medium text-gray-900 mb-6">Term Information</h3>
        
        <dl class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div>
            <dt class="text-sm font-medium text-gray-500 mb-2">Label</dt>
            <dd class="text-lg font-medium text-gray-900">
              <%= @term.label %>
            </dd>
          </div>
          
          <div>
            <dt class="text-sm font-medium text-gray-500 mb-2">Slug</dt>
            <dd class="text-sm font-mono text-gray-900 bg-gray-50 px-3 py-2 rounded">
              <%= @term.slug %>
            </dd>
          </div>
          
          <div>
            <dt class="text-sm font-medium text-gray-500 mb-2">Full Hierarchy Path</dt>
            <dd class="text-sm text-gray-900">
              <%= @term.full_label %>
            </dd>
          </div>
          
          <div class="md:col-span-2 lg:col-span-3">
            <dt class="text-sm font-medium text-gray-500 mb-2">Description</dt>
            <dd class="text-sm text-gray-900">
              <% if @term.description.present? %>
                <%= simple_format(@term.description, class: "mb-0") %>
              <% else %>
                <span class="text-gray-400 italic">No description provided</span>
              <% end %>
            </dd>
          </div>
        </dl>
      </div>
    </div>

          <!-- Vocabulary Information -->
          <% if @term.vocabulary %>
            <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
              <div class="px-6 py-6">
                <h3 class="text-lg font-medium text-gray-900 mb-6">Vocabulary</h3>
                
                <div class="flex items-start">
                  <div class="flex-shrink-0 w-12 h-12">
                    <div class="w-12 h-12 bg-indigo-100 rounded-full flex items-center justify-center">
                      <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                      </svg>
                    </div>
                  </div>
                  <div class="ml-4 flex-1">
                    <h4 class="text-lg font-medium text-gray-900">
                      <%= link_to @term.vocabulary.label, admin_vocabulary_path(@term.vocabulary), class: "text-blue-600 hover:text-blue-700" %>
                    </h4>
                    <p class="mt-1 text-sm text-gray-600">
                      Code: <span class="font-mono"><%= @term.vocabulary.code %></span>
                    </p>
                    <div class="mt-2 text-sm text-gray-500">
                      <%= pluralize(@term.vocabulary.terms.count, 'term') %> in this vocabulary
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <!-- Parent Term -->
          <% if @term.parent %>
            <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
              <div class="px-6 py-6">
                <h3 class="text-lg font-medium text-gray-900 mb-6">Parent Term</h3>
                
                <div class="flex items-start">
                  <div class="flex-shrink-0 w-12 h-12">
                    <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                      <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 11l5-5m0 0l5 5m-5-5v12"/>
                      </svg>
                    </div>
                  </div>
                  <div class="ml-4 flex-1">
                    <h4 class="text-lg font-medium text-gray-900">
                      <%= link_to @term.parent.label, admin_term_path(@term.parent), class: "text-blue-600 hover:text-blue-700" %>
                    </h4>
                    <p class="mt-1 text-sm text-gray-600">
                      <%= @term.parent.description.presence || "No description" %>
                    </p>
                    <div class="mt-2 text-sm text-gray-500">
                      <span class="font-mono"><%= @term.parent.slug %></span>
                      <% if @term.parent.taggings.any? %>
                        • <%= pluralize(@term.parent.taggings.count, 'usage') %>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <!-- Child Terms -->
          <% if @term.children.any? %>
            <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
              <div class="px-6 py-6">
                <h3 class="text-lg font-medium text-gray-900 mb-6">Child Terms</h3>
                
                <div class="space-y-4">
                  <% @term.children.includes(:taggings).each do |child| %>
                    <div class="flex items-start p-4 bg-gray-50 rounded-lg">
                      <div class="flex-shrink-0 w-10 h-10">
                        <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                          <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 13l3 3 7-7"/>
                          </svg>
                        </div>
                      </div>
                      <div class="ml-3 flex-1">
                        <div class="flex items-center justify-between">
                          <h4 class="text-sm font-medium text-gray-900">
                            <%= link_to child.label, admin_term_path(child), class: "text-blue-600 hover:text-blue-700" %>
                          </h4>
                          <div class="flex items-center space-x-2">
                            <% if child.is_active? %>
                              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
                                Active
                              </span>
                            <% else %>
                              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800">
                                Inactive
                              </span>
                            <% end %>
                            <% if child.taggings.any? %>
                              <span class="text-xs text-gray-500">
                                <%= pluralize(child.taggings.count, 'usage') %>
                              </span>
                            <% end %>
                          </div>
                        </div>
                        <p class="mt-1 text-xs text-gray-500 font-mono"><%= child.slug %></p>
                        <% if child.description.present? %>
                          <p class="mt-2 text-sm text-gray-600"><%= truncate(child.description, length: 100) %></p>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>

          <!-- Metadata -->
          <% if @term.metadata.present? %>
            <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
              <div class="px-6 py-6">
                <h3 class="text-lg font-medium text-gray-900 mb-6">Metadata</h3>
                
                <div class="bg-gray-50 rounded-lg p-4">
                  <pre class="text-sm text-gray-900 whitespace-pre-wrap"><%= JSON.pretty_generate(@term.metadata) %></pre>
                </div>
              </div>
            </div>
          <% end %>
    </div>
  </div>
</div>
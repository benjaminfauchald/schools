<% content_for :title, "Inquiry from #{@inquiry.name}" %>

<!-- Main Content -->
<div class="w-full py-8 px-4 sm:px-6 lg:px-8">
  <div class="space-y-8">
    <!-- Page Header with Inline Stats -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
      <div class="px-6 py-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6">
          <div>
            <h1 class="text-3xl font-bold text-gray-900">Inquiry from <%= @inquiry.name %></h1>
            <p class="mt-2 text-sm text-gray-600">Received <%= time_ago_in_words(@inquiry.created_at) %> ago for <%= @inquiry.school.name %></p>
          </div>
          <div class="mt-4 sm:mt-0 flex space-x-3">
            <%= mail_to @inquiry.email, "Send Email", 
                subject: "Re: Inquiry about #{@inquiry.school.name}",
                class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              Send Email
            <% end %>
            <%= link_to admin_inquiries_path, 
                class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
              </svg>
              Back to Inquiries
            <% end %>
          </div>
        </div>
        
        <!-- Inline Statistics -->
        <div class="flex flex-wrap items-center gap-6 text-sm">
          <!-- Contact Name -->
          <div class="flex items-center">
            <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center mr-3">
              <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
            </div>
            <div>
              <span class="font-semibold text-gray-900"><%= @inquiry.name %></span>
              <span class="text-gray-500">Contact</span>
            </div>
          </div>

          <!-- Status -->
          <div class="flex items-center">
            <% if @inquiry.status_new? %>
              <div class="w-2 h-2 bg-red-500 rounded-full mr-2"></div>
              <span class="text-gray-900 font-medium">New</span>
            <% elsif @inquiry.status_read? %>
              <div class="w-2 h-2 bg-yellow-500 rounded-full mr-2"></div>
              <span class="text-gray-900 font-medium">Read</span>
            <% elsif @inquiry.status_responded? %>
              <div class="w-2 h-2 bg-green-500 rounded-full mr-2"></div>
              <span class="text-gray-900 font-medium">Responded</span>
            <% else %>
              <div class="w-2 h-2 bg-gray-500 rounded-full mr-2"></div>
              <span class="text-gray-900 font-medium"><%= @inquiry.status.humanize %></span>
            <% end %>
            <span class="text-gray-500 ml-1">Status</span>
          </div>

          <!-- Children Count -->
          <div class="flex items-center">
            <svg class="w-4 h-4 text-blue-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
            <span class="text-gray-900 font-medium"><%= pluralize(@inquiry.children_count, 'child') %></span>
            <span class="text-gray-500 ml-1">Applicant</span>
          </div>

          <!-- Lead Source -->
          <div class="flex items-center">
            <svg class="w-4 h-4 text-orange-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
            </svg>
            <span class="text-gray-900 font-medium"><%= @inquiry.lead_source %></span>
            <span class="text-gray-500 ml-1">Lead Source</span>
          </div>

          <!-- School -->
          <div class="flex items-center">
            <svg class="w-4 h-4 text-indigo-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
            <span class="text-gray-900 font-medium"><%= @inquiry.school.name %></span>
            <span class="text-gray-500 ml-1">School</span>
          </div>

          <!-- Admin Notice -->
          <div class="flex items-center">
            <svg class="w-4 h-4 text-yellow-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>
            </svg>
            <span class="text-gray-900 font-medium">Status changes affect school owners</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Contact Information -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
      <div class="px-6 py-6">
        <h3 class="text-lg font-medium text-gray-900 mb-6">Contact Information</h3>
        
        <dl class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div>
            <dt class="text-sm font-medium text-gray-500 mb-2">Name</dt>
            <dd class="text-lg font-medium text-gray-900">
              <%= @inquiry.name %>
            </dd>
          </div>
          
          <div>
            <dt class="text-sm font-medium text-gray-500 mb-2">Email</dt>
            <dd class="text-sm">
              <%= mail_to @inquiry.email, @inquiry.email, class: "text-blue-600 hover:text-blue-700 font-medium" %>
            </dd>
          </div>
          
          <div>
            <dt class="text-sm font-medium text-gray-500 mb-2">Phone</dt>
            <dd class="text-sm">
              <% if @inquiry.phone.present? %>
                <%= link_to @inquiry.phone, "tel:#{@inquiry.phone}", class: "text-blue-600 hover:text-blue-700 font-medium" %>
              <% else %>
                <span class="text-gray-400 italic">Not provided</span>
              <% end %>
            </dd>
          </div>
          
          <div>
            <dt class="text-sm font-medium text-gray-500 mb-2">Children</dt>
            <dd class="text-sm text-gray-900 font-medium">
              <%= pluralize(@inquiry.children_count, 'child') %>
            </dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- Message Content -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
      <div class="px-6 py-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Message</h3>
        <div class="text-gray-700 leading-relaxed prose max-w-none">
          <%= simple_format(@inquiry.message) %>
        </div>
      </div>
    </div>

    <!-- School Information -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
      <div class="px-6 py-6">
        <div class="flex items-center justify-between mb-6">
          <h3 class="text-lg font-semibold text-gray-900">School Information</h3>
          <div class="flex space-x-3">
            <%= link_to admin_school_path(@inquiry.school), 
                class: "inline-flex items-center px-3 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-lg hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 transition-colors" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              Admin View
            <% end %>
            
            <%= link_to school_path(@inquiry.school), target: "_blank", 
                class: "inline-flex items-center px-3 py-2 text-sm font-medium text-gray-900 bg-white border border-gray-200 rounded-lg hover:bg-gray-100 hover:text-blue-700 focus:ring-4 focus:ring-gray-200 transition-colors" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
              Public Page
            <% end %>
          </div>
        </div>
        
        <div>
          <h4 class="text-base font-semibold text-gray-900"><%= @inquiry.school.name %></h4>
          <p class="text-sm text-gray-600 mt-1"><%= @inquiry.school.display_address %></p>
        </div>
      </div>
    </div>

    <!-- Status Management -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
      <div class="px-6 py-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-6">Update Status</h3>
        
        <%= form_with model: @inquiry, url: admin_inquiry_path(@inquiry), method: :patch, local: true, class: "space-y-4" do |form| %>
          <div>
            <%= form.label :status, "Status", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.select :status, 
                           options_for_select([
                             ['New', 'new'],
                             ['Read', 'read'],
                             ['Responded', 'responded'],
                             ['Closed', 'closed']
                           ], @inquiry.status), 
                           {}, 
                           { class: "block w-full pl-3 pr-10 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" } %>
          </div>
          
          <div>
            <%= form.submit "Update Status", 
                class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
<% content_for :title, "Inquiry from #{@inquiry.name}" %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title">Inquiry from <%= @inquiry.name %></h1>
  <p class="main-content__page-subtitle">Received <%= time_ago_in_words(@inquiry.created_at) %> ago for <%= @inquiry.school.name %></p>
</header>

<section class="main-content__body">
  <!-- Breadcrumb -->
  <div class="breadcrumb">
    <%= link_to "Dashboard", admin_root_path %> →
    <%= link_to "Inquiries", admin_inquiries_path %> →
    Inquiry from <%= @inquiry.name %>
  </div>

  <!-- Main Content -->
  <div class="inquiry-details">
    <div class="main-section">
      <!-- Status Header -->
      <div class="inquiry-status-header">
        <% if @inquiry.status_new? %>
          <span class="status-badge status-badge--new">New</span>
        <% elsif @inquiry.status_read? %>
          <span class="status-badge status-badge--read">Read</span>
        <% elsif @inquiry.status_responded? %>
          <span class="status-badge status-badge--responded">Responded</span>
        <% else %>
          <span class="status-badge status-badge--default"><%= @inquiry.status.humanize %></span>
        <% end %>
      </div>

      <!-- Message Content -->
      <div class="content-section">
        <h3 class="section-title">Message</h3>
        <div class="message-content">
          <%= simple_format(@inquiry.message) %>
        </div>
      </div>
    </div>

    <div class="sidebar-section">
      <!-- Contact Information -->
      <div class="info-card">
        <h3 class="card-title">Contact Information</h3>
        
        <div class="info-list">
          <div class="info-item">
            <dt class="info-label">Name</dt>
            <dd class="info-value"><%= @inquiry.name %></dd>
          </div>
          
          <div class="info-item">
            <dt class="info-label">Email</dt>
            <dd class="info-value">
              <%= mail_to @inquiry.email, @inquiry.email, class: "link" %>
            </dd>
          </div>
          
          <div class="info-item">
            <dt class="info-label">Phone</dt>
            <dd class="info-value">
              <% if @inquiry.phone.present? %>
                <%= link_to @inquiry.phone, "tel:#{@inquiry.phone}", class: "link" %>
              <% else %>
                <span class="text-muted">Not provided</span>
              <% end %>
            </dd>
          </div>
          
          <div class="info-item">
            <dt class="info-label">Children Count</dt>
            <dd class="info-value"><%= pluralize(@inquiry.children_count, 'child') %></dd>
          </div>
          
          <div class="info-item">
            <dt class="info-label">Lead Source</dt>
            <dd class="info-value"><%= @inquiry.lead_source %></dd>
          </div>
        </div>
      </div>

      <!-- School Information -->
      <div class="info-card">
        <h3 class="card-title">School</h3>
        
        <div class="school-info">
          <h4 class="school-name"><%= @inquiry.school.name %></h4>
          <p class="school-address"><%= @inquiry.school.display_address %></p>
          
          <div class="school-actions">
            <%= link_to "View School", admin_school_path(@inquiry.school), class: "link" %>
            <%= link_to "Public Page", school_path(@inquiry.school), target: "_blank", class: "link" %>
          </div>
        </div>
      </div>

      <!-- Status Management -->
      <div class="info-card">
        <h3 class="card-title">Update Status</h3>
        
        <%= form_with model: @inquiry, url: admin_inquiry_path(@inquiry), method: :patch, local: true, class: "status-form" do |form| %>
          <div class="form-group">
            <%= form.label :status, "Status", class: "form-label" %>
            <%= form.select :status, 
                           options_for_select([
                             ['New', 'new'],
                             ['Read', 'read'],
                             ['Responded', 'responded'],
                             ['Closed', 'closed']
                           ], @inquiry.status), 
                           {}, 
                           { class: "form-select" } %>
          </div>
          
          <div class="form-group">
            <%= form.submit "Update Status", class: "btn btn--primary btn--full" %>
          </div>
        <% end %>
      </div>

      <!-- Admin Note -->
      <div class="admin-note">
        <div class="note-header">
          <span class="note-icon">⚠️</span>
          <strong>Admin Access Note</strong>
        </div>
        <p class="note-text">
          Status changes made here affect what school owners see. The "New" status indicates unread inquiries for school owners.
        </p>
      </div>

      <!-- Quick Actions -->
      <div class="info-card">
        <h3 class="card-title">Quick Actions</h3>
        
        <div class="action-buttons">
          <%= mail_to @inquiry.email, "Send Email", 
              subject: "Re: Inquiry about #{@inquiry.school.name}",
              class: "btn btn--secondary btn--full" %>
          
          <% if @inquiry.phone.present? %>
            <%= link_to "Call Now", "tel:#{@inquiry.phone}", 
                class: "btn btn--secondary btn--full" %>
          <% end %>
          
          <%= link_to "Back to Inquiries", admin_inquiries_path, 
              class: "btn btn--secondary btn--full" %>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.main-content__page-subtitle {
  color: #6c757d;
  margin-top: 0.5rem;
  font-size: 0.9rem;
}

.breadcrumb {
  margin-bottom: 1.5rem;
  font-size: 0.9rem;
  color: #6c757d;
}

.breadcrumb a {
  color: #007bff;
  text-decoration: none;
}

.breadcrumb a:hover {
  text-decoration: underline;
}

.inquiry-details {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 2rem;
}

.main-section {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.inquiry-status-header {
  display: flex;
  justify-content: flex-start;
}

.status-badge {
  padding: 0.5rem 1rem;
  border-radius: 16px;
  font-size: 0.8rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.status-badge--new {
  background: #f8d7da;
  color: #721c24;
}

.status-badge--read {
  background: #fff3cd;
  color: #856404;
}

.status-badge--responded {
  background: #d4edda;
  color: #155724;
}

.status-badge--default {
  background: #e9ecef;
  color: #495057;
}

.content-section {
  background: white;
  border: 1px solid #e1e5e9;
  border-radius: 8px;
  padding: 1.5rem;
}

.section-title {
  font-size: 1.1rem;
  font-weight: 600;
  color: #2c3e50;
  margin: 0 0 1rem 0;
}

.message-content {
  line-height: 1.6;
  color: #495057;
}

.sidebar-section {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.info-card {
  background: white;
  border: 1px solid #e1e5e9;
  border-radius: 8px;
  padding: 1.5rem;
}

.card-title {
  font-size: 1rem;
  font-weight: 600;
  color: #2c3e50;
  margin: 0 0 1rem 0;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.info-item {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.info-label {
  font-size: 0.8rem;
  font-weight: 600;
  color: #6c757d;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.info-value {
  color: #2c3e50;
  font-size: 0.9rem;
}

.link {
  color: #007bff;
  text-decoration: none;
}

.link:hover {
  text-decoration: underline;
}

.text-muted {
  color: #6c757d;
  font-style: italic;
}

.school-info {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.school-name {
  font-size: 1rem;
  font-weight: 600;
  color: #2c3e50;
  margin: 0;
}

.school-address {
  font-size: 0.9rem;
  color: #6c757d;
  margin: 0;
}

.school-actions {
  display: flex;
  gap: 1rem;
  margin-top: 0.5rem;
}

.status-form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.form-label {
  font-size: 0.9rem;
  font-weight: 600;
  color: #495057;
}

.form-select {
  padding: 0.5rem;
  border: 1px solid #ced4da;
  border-radius: 4px;
  background: white;
  font-size: 0.9rem;
}

.form-select:focus {
  outline: none;
  border-color: #007bff;
  box-shadow: 0 0 0 2px rgba(0, 123, 255, 0.25);
}

.btn {
  padding: 0.5rem 1rem;
  border: none;
  border-radius: 4px;
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
  display: inline-block;
  font-size: 0.9rem;
  transition: all 0.2s ease;
  text-align: center;
}

.btn--primary {
  background: #007bff;
  color: white;
}

.btn--primary:hover {
  background: #0056b3;
  transform: translateY(-1px);
  text-decoration: none;
  color: white;
}

.btn--secondary {
  background: #f8f9fa;
  color: #495057;
  border: 1px solid #ced4da;
}

.btn--secondary:hover {
  background: #e9ecef;
  text-decoration: none;
  color: #495057;
}

.btn--full {
  width: 100%;
}

.admin-note {
  background: #fff3cd;
  border: 1px solid #ffeaa7;
  border-radius: 8px;
  padding: 1rem;
}

.note-header {
  font-weight: 600;
  color: #856404;
  margin-bottom: 0.5rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.note-icon {
  font-size: 1.1rem;
}

.note-text {
  color: #856404;
  font-size: 0.85rem;
  margin: 0;
  line-height: 1.4;
}

.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

@media (max-width: 1024px) {
  .inquiry-details {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 768px) {
  .main-content__body {
    padding: 1rem;
  }
  
  .content-section,
  .info-card {
    padding: 1rem;
  }
}
</style>
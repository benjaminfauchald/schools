<% content_for :title, "Inquiry from #{@inquiry.name}" %>


<!-- Main Content -->
  <div class="mx-auto py-8 px-6 sm:px-8 lg:px-12 max-w-none">
    <div class="space-y-8">
      <!-- Breadcrumb -->
      <nav class="flex" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <li class="inline-flex items-center">
            <%= link_to admin_root_path, class: "inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600" do %>
              <svg class="w-3 h-3 mr-2.5" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20">
                <path d="m19.707 9.293-2-2-7-7a1 1 0 0 0-1.414 0l-7 7-2 2a1 1 0 0 0 1.414 1.414L2 10.414V18a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-7.586l.293.293a1 1 0 0 0 1.414-1.414Z"/>
              </svg>
              Admin Dashboard
            <% end %>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
              </svg>
              <%= link_to "Inquiries", admin_inquiries_path, class: "ml-1 text-sm font-medium text-gray-700 hover:text-blue-600 md:ml-2" %>
            </div>
          </li>
          <li aria-current="page">
            <div class="flex items-center">
              <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
              </svg>
              <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2">Inquiry from <%= @inquiry.name %></span>
            </div>
          </li>
        </ol>
      </nav>

      <!-- Admin Notice -->
      <div class="flex items-center p-4 mb-4 text-sm text-yellow-800 border border-yellow-300 rounded-lg bg-yellow-50" role="alert">
        <svg class="flex-shrink-0 inline w-4 h-4 mr-3" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>
        </svg>
        <span class="sr-only">Info</span>
        <div>
          <span class="font-medium">Admin Access Note:</span> Status changes made here affect what school owners see. The "New" status indicates unread inquiries for school owners.
        </div>
      </div>

      <!-- Main Content -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Left Column - Main Content -->
        <div class="lg:col-span-2 space-y-6">
          <!-- Header -->
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <h1 class="text-3xl font-bold text-gray-900 mb-2">Inquiry from <%= @inquiry.name %></h1>
                  <div class="text-sm text-gray-600">
                    Received <%= time_ago_in_words(@inquiry.created_at) %> ago for <%= @inquiry.school.name %>
                  </div>
                </div>
                <div class="flex items-center ml-4">
                  <% if @inquiry.status_new? %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                      New
                    </span>
                  <% elsif @inquiry.status_read? %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                      Read
                    </span>
                  <% elsif @inquiry.status_responded? %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                      Responded
                    </span>
                  <% else %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                      <%= @inquiry.status.humanize %>
                    </span>
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <!-- Message Content -->
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <h3 class="text-lg font-semibold text-gray-900 mb-4">Message</h3>
              <div class="text-gray-700 leading-relaxed">
                <%= simple_format(@inquiry.message) %>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column - Sidebar -->
        <div class="lg:col-span-1 space-y-6">
          <!-- Contact Information -->
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <div class="flex items-center mb-6">
                <div class="flex-shrink-0 w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                  </svg>
                </div>
                <h3 class="ml-4 text-xl font-semibold text-gray-900">Contact Information</h3>
              </div>
              
              <div class="space-y-5">
                <div class="flex items-center space-x-3">
                  <div class="flex-shrink-0 w-5 h-5 text-gray-400">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                  </div>
                  <div>
                    <div class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">NAME</div>
                    <div class="text-base text-gray-900 font-medium"><%= @inquiry.name %></div>
                  </div>
                </div>
                
                <div class="flex items-center space-x-3">
                  <div class="flex-shrink-0 w-5 h-5 text-gray-400">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"/>
                    </svg>
                  </div>
                  <div>
                    <div class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">EMAIL</div>
                    <div class="text-base">
                      <%= mail_to @inquiry.email, @inquiry.email, class: "text-blue-600 hover:text-blue-700 font-medium" %>
                    </div>
                  </div>
                </div>
                
                <div class="flex items-center space-x-3">
                  <div class="flex-shrink-0 w-5 h-5 text-gray-400">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                  </div>
                  <div>
                    <div class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">PHONE</div>
                    <div class="text-base">
                      <% if @inquiry.phone.present? %>
                        <%= link_to @inquiry.phone, "tel:#{@inquiry.phone}", class: "text-blue-600 hover:text-blue-700 font-medium" %>
                      <% else %>
                        <span class="text-gray-400 italic">Not provided</span>
                      <% end %>
                    </div>
                  </div>
                </div>
                
                <div class="flex items-center space-x-3">
                  <div class="flex-shrink-0 w-5 h-5 text-gray-400">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                  </div>
                  <div>
                    <div class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">CHILDREN</div>
                    <div class="text-base text-gray-900 font-medium"><%= pluralize(@inquiry.children_count, 'child') %></div>
                  </div>
                </div>
                
                <div class="flex items-center space-x-3">
                  <div class="flex-shrink-0 w-5 h-5 text-gray-400">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                    </svg>
                  </div>
                  <div>
                    <div class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">LEAD SOURCE</div>
                    <div class="text-base text-gray-900"><%= @inquiry.lead_source %></div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- School Information -->
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <div class="flex items-center mb-6">
                <div class="flex-shrink-0 w-10 h-10 bg-indigo-100 rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                  </svg>
                </div>
                <h3 class="ml-4 text-xl font-semibold text-gray-900">School</h3>
              </div>
              
              <div class="space-y-4">
                <div>
                  <h4 class="text-base font-semibold text-gray-900"><%= @inquiry.school.name %></h4>
                  <p class="text-sm text-gray-600 mt-1"><%= @inquiry.school.display_address %></p>
                </div>
                
                <div class="flex flex-wrap gap-3">
                  <%= link_to admin_school_path(@inquiry.school), 
                      class: "inline-flex items-center px-3 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-lg hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 transition-colors" do %>
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    Admin View
                  <% end %>
                  
                  <%= link_to school_path(@inquiry.school), target: "_blank", 
                      class: "inline-flex items-center px-3 py-2 text-sm font-medium text-gray-900 bg-white border border-gray-200 rounded-lg hover:bg-gray-100 hover:text-blue-700 focus:ring-4 focus:ring-gray-200 transition-colors" do %>
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                    </svg>
                    Public Page
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <!-- Status Management -->
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <div class="flex items-center mb-6">
                <div class="flex-shrink-0 w-10 h-10 bg-orange-100 rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                  </svg>
                </div>
                <h3 class="ml-4 text-xl font-semibold text-gray-900">Update Status</h3>
              </div>
              
              <%= form_with model: @inquiry, url: admin_inquiry_path(@inquiry), method: :patch, local: true, class: "space-y-4" do |form| %>
                <div>
                  <%= form.label :status, "Status", class: "block text-sm font-medium text-gray-700 mb-2" %>
                  <%= form.select :status, 
                                 options_for_select([
                                   ['New', 'new'],
                                   ['Read', 'read'],
                                   ['Responded', 'responded'],
                                   ['Closed', 'closed']
                                 ], @inquiry.status), 
                                 {}, 
                                 { class: "block w-full pl-3 pr-10 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" } %>
                </div>
                
                <div>
                  <%= form.submit "Update Status", 
                      class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" %>
                </div>
              <% end %>
            </div>
          </div>

          <!-- Quick Actions -->
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <div class="flex items-center mb-6">
                <div class="flex-shrink-0 w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                  </svg>
                </div>
                <h3 class="ml-4 text-xl font-semibold text-gray-900">Quick Actions</h3>
              </div>
              
              <div class="space-y-3">
                <%= mail_to @inquiry.email, "Send Email", 
                    subject: "Re: Inquiry about #{@inquiry.school.name}",
                    class: "w-full flex justify-center items-center py-3 px-4 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                  Send Email
                <% end %>
                
                <% if @inquiry.phone.present? %>
                  <%= link_to "tel:#{@inquiry.phone}", 
                      class: "w-full flex justify-center items-center py-3 px-4 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                    Call <%= @inquiry.phone %>
                  <% end %>
                <% end %>
                
                <%= link_to admin_inquiries_path, 
                    class: "w-full flex justify-center items-center py-3 px-4 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                  </svg>
                  Back to Inquiries
                <% end %>
              </div>
            </div>
        </div>
      </div>
    </div>
  </div>
</div>
<% content_for :title, "Audit Log Details" %>

<!-- Main Content -->
<div class="w-full py-8">
  <div class="space-y-8 px-4 sm:px-6 lg:px-8">

      <!-- Page Header -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-6">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6">
            <div>
              <h1 class="text-3xl font-bold text-gray-900">
                <%= @audit_log.action_description %>
              </h1>
              <p class="mt-2 text-sm text-gray-600">View detailed audit log information and related changes</p>
            </div>
            <div class="mt-4 sm:mt-0 flex space-x-3">
              <%= link_to admin_audit_logs_path, 
                  class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors" do %>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"/>
                </svg>
                Back to Audit Logs
              <% end %>
              <% if @audit_log.auditable %>
                <% begin %>
                  <%= link_to polymorphic_path([:admin, @audit_log.auditable]), 
                      class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors" do %>
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                    </svg>
                    View Record
                  <% end %>
                <% rescue NoMethodError, ActionController::UrlGenerationError %>
                <% end %>
              <% end %>
            </div>
          </div>
          
          <!-- Inline Statistics -->
          <div class="flex flex-wrap items-center gap-6 text-sm">
            <!-- Log ID -->
            <div class="flex items-center">
              <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center mr-3">
                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <span class="font-semibold text-gray-900">Log #<%= @audit_log.id %></span>
                <span class="text-gray-500">Audit ID</span>
              </div>
            </div>

            <!-- Timestamp -->
            <div class="flex items-center">
              <div class="w-2 h-2 bg-green-500 rounded-full mr-2"></div>
              <span class="text-gray-900 font-medium"><%= @audit_log.created_at.strftime("%m/%d/%Y") %></span>
              <span class="text-gray-500 ml-1">Date</span>
            </div>

            <!-- Action Type -->
            <div class="flex items-center">
              <div class="w-2 h-2 bg-purple-500 rounded-full mr-2"></div>
              <span class="text-gray-900 font-medium"><%= @audit_log.action.humanize %></span>
              <span class="text-gray-500 ml-1">Action</span>
            </div>

            <!-- Model Type -->
            <div class="flex items-center">
              <div class="w-2 h-2 bg-indigo-500 rounded-full mr-2"></div>
              <span class="text-gray-900 font-medium"><%= @audit_log.auditable_type %></span>
              <span class="text-gray-500 ml-1">Model</span>
            </div>

            <!-- Time Ago -->
            <div class="flex items-center">
              <svg class="w-4 h-4 text-gray-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <span class="text-gray-900 font-medium"><%= time_ago_in_words(@audit_log.created_at) %> ago</span>
              <span class="text-gray-500 ml-1">Recorded</span>
            </div>

            <!-- Significance -->
            <% if @audit_log.significant_change? %>
              <div class="flex items-center">
                <svg class="w-4 h-4 text-red-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                </svg>
                <span class="text-gray-900 font-medium">Significant Change</span>
                <span class="text-gray-500 ml-1">Impact</span>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Left Column -->
        <div class="space-y-8">
          <!-- Basic Information -->
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <h3 class="text-lg font-medium text-gray-900 mb-6">Log Information</h3>
              
              <dl class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <dt class="text-sm font-medium text-gray-500 mb-2">Log ID</dt>
                  <dd class="text-lg font-mono text-gray-900">
                    #<%= @audit_log.id %>
                  </dd>
                </div>
                
                <div>
                  <dt class="text-sm font-medium text-gray-500 mb-2">Timestamp</dt>
                  <dd class="text-sm text-gray-900">
                    <%= @audit_log.created_at.strftime("%B %d, %Y at %I:%M:%S %p") %>
                  </dd>
                </div>
                
                <div>
                  <dt class="text-sm font-medium text-gray-500 mb-2">Action</dt>
                  <dd class="text-sm text-gray-900">
                    <%= @audit_log.action_description %>
                  </dd>
                </div>
                
                <div>
                  <dt class="text-sm font-medium text-gray-500 mb-2">User ID</dt>
                  <dd class="text-sm text-gray-900">
                    <% if @audit_log.user_id %>
                      <%= @audit_log.user_id %>
                    <% else %>
                      <span class="text-gray-400 italic">System/Anonymous</span>
                    <% end %>
                  </dd>
                </div>
                
                <div class="md:col-span-2">
                  <dt class="text-sm font-medium text-gray-500 mb-2">Time Since Event</dt>
                  <dd class="text-sm text-gray-900">
                    <%= time_ago_in_words(@audit_log.created_at) %> ago
                  </dd>
                </div>
              </dl>
            </div>
          </div>

          <!-- Affected Record -->
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <h3 class="text-lg font-medium text-gray-900 mb-6">Affected Record</h3>
              
              <div class="flex items-start">
                <div class="flex-shrink-0 w-12 h-12">
                  <div class="w-12 h-12 bg-indigo-100 rounded-full flex items-center justify-center">
                    <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                  </div>
                </div>
                <div class="ml-4 flex-1">
                  <h4 class="text-lg font-medium text-gray-900">
                    <%= @audit_log.auditable_type %> 
                    <span class="text-gray-500">#<%= @audit_log.auditable_id %></span>
                  </h4>
                  <% if @audit_log.auditable.try(:name) || @audit_log.auditable.try(:label) %>
                    <p class="mt-1 text-sm text-gray-600">
                      Name: <span class="font-medium"><%= @audit_log.auditable.try(:name) || @audit_log.auditable.try(:label) %></span>
                    </p>
                  <% end %>
                  <div class="mt-3">
                    <% if @audit_log.auditable %>
                      <% begin %>
                        <%= link_to "View Record", 
                            polymorphic_path([:admin, @audit_log.auditable]), 
                            class: "inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
                      <% rescue NoMethodError, ActionController::UrlGenerationError %>
                        <span class="text-gray-500 text-sm">
                          <%= @audit_log.auditable_type %> #<%= @audit_log.auditable_id %> 
                          <span class="text-xs">(No admin view available)</span>
                        </span>
                      <% end %>
                    <% else %>
                      <span class="text-red-600 text-sm">Record has been deleted</span>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Field Changes -->
          <% if @audit_log.changed_fields.present? && @audit_log.changed_fields.any? %>
            <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
              <div class="px-6 py-6">
                <h3 class="text-lg font-medium text-gray-900 mb-6">Field Changes</h3>
                
                <div class="space-y-6">
                  <% @audit_log.changed_fields.each do |field, changes| %>
                    <div class="border border-gray-200 rounded-lg p-4">
                      <h4 class="text-sm font-medium text-gray-900 mb-3">
                        <%= field.humanize %>
                      </h4>
                      
                      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                          <dt class="text-xs font-medium text-gray-500 mb-2">Previous Value</dt>
                          <dd class="text-sm text-gray-900 bg-red-50 border border-red-200 rounded p-3">
                            <% if changes[0].nil? %>
                              <span class="text-gray-400 italic">(empty)</span>
                            <% elsif changes[0].is_a?(String) && changes[0].length > 100 %>
                              <div class="font-mono text-xs break-all">
                                <%= truncate(changes[0], length: 100) %>
                                <button onclick="this.style.display='none'; this.nextElementSibling.style.display='block'" 
                                        class="text-blue-600 hover:text-blue-800 ml-2">Show more</button>
                                <div style="display:none" class="mt-2"><%= changes[0] %></div>
                              </div>
                            <% else %>
                              <span class="font-mono text-xs"><%= changes[0].inspect %></span>
                            <% end %>
                          </dd>
                        </div>
                        
                        <div>
                          <dt class="text-xs font-medium text-gray-500 mb-2">New Value</dt>
                          <dd class="text-sm text-gray-900 bg-green-50 border border-green-200 rounded p-3">
                            <% if changes[1].nil? %>
                              <span class="text-gray-400 italic">(empty)</span>
                            <% elsif changes[1].is_a?(String) && changes[1].length > 100 %>
                              <div class="font-mono text-xs break-all">
                                <%= truncate(changes[1], length: 100) %>
                                <button onclick="this.style.display='none'; this.nextElementSibling.style.display='block'" 
                                        class="text-blue-600 hover:text-blue-800 ml-2">Show more</button>
                                <div style="display:none" class="mt-2"><%= changes[1] %></div>
                              </div>
                            <% else %>
                              <span class="font-mono text-xs"><%= changes[1].inspect %></span>
                            <% end %>
                          </dd>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Right Column -->
        <div class="space-y-8">
          <!-- Actions -->
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <h3 class="text-lg font-medium text-gray-900 mb-4">Actions</h3>
              <div class="space-y-3">
                <%= link_to admin_audit_logs_path,
                    class: "w-full inline-flex justify-center items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"/>
                  </svg>
                  Back to Audit Logs
                <% end %>
                
                <% if @audit_log.auditable %>
                  <% begin %>
                    <%= link_to polymorphic_path([:admin, @audit_log.auditable]),
                      class: "w-full inline-flex justify-center items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                    </svg>
                    View Affected Record
                    <% end %>
                  <% rescue NoMethodError, ActionController::UrlGenerationError %>
                    <div class="w-full inline-flex justify-center items-center px-4 py-2 border border-gray-200 text-sm font-medium rounded-lg text-gray-400 bg-gray-50 cursor-not-allowed">
                      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.878 9.878L3 3m6.878 6.878L21 21"/>
                      </svg>
                      No Admin View Available
                    </div>
                  <% end %>
                <% end %>
                
                <!-- Filter to Similar -->
                <%= link_to admin_audit_logs_path(model_filter: @audit_log.auditable_type),
                    class: "w-full inline-flex justify-center items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.414A1 1 0 013 6.707V4z"/>
                  </svg>
                  View <%= @audit_log.auditable_type %> Logs
                <% end %>
              </div>
            </div>
          </div>

          <!-- Statistics -->
          <div class="bg-gray-50 border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <h3 class="text-lg font-medium text-gray-900 mb-4">Related Activity</h3>
              <dl class="space-y-3">
                <div>
                  <dt class="text-sm font-medium text-gray-500">Record History</dt>
                  <dd class="text-sm text-gray-900">
                    <% if @audit_log.auditable %>
                      <%= link_to admin_audit_logs_path(model_filter: @audit_log.auditable_type, search: @audit_log.auditable_id),
                          class: "text-blue-600 hover:text-blue-700" do %>
                        View all changes to this record
                      <% end %>
                    <% else %>
                      N/A - Record deleted
                    <% end %>
                  </dd>
                </div>
                
                <div>
                  <dt class="text-sm font-medium text-gray-500">Action Frequency</dt>
                  <dd class="text-sm text-gray-900">
                    <%= link_to admin_audit_logs_path(action_filter: @audit_log.action),
                        class: "text-blue-600 hover:text-blue-700" do %>
                      View all <%= @audit_log.action %> actions
                    <% end %>
                  </dd>
                </div>
                
                <div>
                  <dt class="text-sm font-medium text-gray-500">Model Activity</dt>
                  <dd class="text-sm text-gray-900">
                    <%= link_to admin_audit_logs_path(model_filter: @audit_log.auditable_type),
                        class: "text-blue-600 hover:text-blue-700" do %>
                      All <%= @audit_log.auditable_type %> changes
                    <% end %>
                  </dd>
                </div>
                
                <div>
                  <dt class="text-sm font-medium text-gray-500">Change Type</dt>
                  <dd class="text-sm font-medium <%= @audit_log.significant_change? ? 'text-red-600' : 'text-green-600' %>">
                    <%= @audit_log.significant_change? ? 'Significant' : 'Minor' %>
                  </dd>
                </div>
              </dl>
            </div>
          </div>
        </div>
      </div>
  </div>
</div>
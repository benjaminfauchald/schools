<% content_for :title, "Audit Logs" %>

<!-- Main Content -->
<div class="w-full py-8">
  <div class="space-y-8 px-4 sm:px-6 lg:px-8">
      <!-- Page Header with Inline Stats -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-6">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6">
            <div>
              <h1 class="text-3xl font-bold text-gray-900">Audit Logs</h1>
              <p class="mt-2 text-sm text-gray-600">Monitor system activity and track changes across all models</p>
            </div>
          </div>
          
          <!-- Inline Statistics -->
          <div class="flex flex-wrap items-center gap-6 text-sm">
            <!-- Total Logs -->
            <div class="flex items-center">
              <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center mr-3">
                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
              </div>
              <div>
                <span class="font-semibold text-gray-900"><%= number_with_delimiter(@total_logs || 0) %></span>
                <span class="text-gray-500">Total Logs</span>
              </div>
            </div>

            <!-- Time-based Breakdown -->
            <div class="flex items-center">
              <div class="w-2 h-2 bg-green-500 rounded-full mr-2"></div>
              <span class="text-gray-900 font-medium"><%= number_with_delimiter(@today_logs || 0) %></span>
              <span class="text-gray-500 ml-1">Today</span>
            </div>

            <div class="flex items-center">
              <div class="w-2 h-2 bg-yellow-500 rounded-full mr-2"></div>
              <span class="text-gray-900 font-medium"><%= number_with_delimiter(@week_logs || 0) %></span>
              <span class="text-gray-500 ml-1">This Week</span>
            </div>

            <div class="flex items-center">
              <div class="w-2 h-2 bg-purple-500 rounded-full mr-2"></div>
              <span class="text-gray-900 font-medium"><%= number_with_delimiter(@significant_changes || 0) %></span>
              <span class="text-gray-500 ml-1">Significant</span>
            </div>

            <!-- Top Model Activity -->
            <div class="flex items-center">
              <div class="w-8 h-8 bg-indigo-100 rounded-lg flex items-center justify-center mr-3">
                <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                </svg>
              </div>
              <div>
                <span class="font-semibold text-gray-900">
                  <%= @model_counts.sort_by { |_, count| -count }.first&.first || "N/A" %>
                </span>
                <span class="text-gray-500">Top Model</span>
              </div>
            </div>

            <!-- Top Action Activity -->
            <div class="flex items-center">
              <div class="w-8 h-8 bg-emerald-100 rounded-lg flex items-center justify-center mr-3">
                <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
              </div>
              <div>
                <span class="font-semibold text-gray-900">
                  <%= (@action_counts.sort_by { |_, count| -count }.first&.first || "N/A").humanize %>
                </span>
                <span class="text-gray-500">Top Action</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Search and Filters Section -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-6">
          <%= form_with url: admin_audit_logs_path, method: :get, local: true, class: "space-y-4" do |f| %>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
              <div>
                <%= f.label :search, "Search Logs", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= f.text_field :search, 
                    value: params[:search], 
                    placeholder: "Search by school name, user email, or status...",
                    class: "block w-full pl-3 pr-10 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" %>
              </div>
              
              <div>
                <%= f.label :action_filter, "Filter by Action", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= f.select :action_filter, 
                    options_for_select([['All Actions', '']] + @available_actions.map { |a| [a.humanize, a] }, params[:action_filter]),
                    {},
                    { class: "block w-full pl-3 pr-10 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" } %>
              </div>

              <div>
                <%= f.label :date_filter, "Time Period", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= f.select :date_filter, 
                    options_for_select([
                      ['All Time', ''],
                      ['Today', 'today'],
                      ['This Week', 'week'],
                      ['This Month', 'month']
                    ], params[:date_filter]),
                    {},
                    { class: "block w-full pl-3 pr-10 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" } %>
              </div>
              
              <div class="flex items-end">
                <%= f.submit "Search", 
                    class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Audit Logs List -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
          <h3 class="text-lg font-medium text-gray-900">Activity Log</h3>
          <p class="mt-1 text-sm text-gray-600">Showing <%= @audit_logs.count %> of <%= @total_logs %> logs</p>
        </div>
        
        <% if @audit_logs.any? %>
          <div class="overflow-x-auto">
            <table class="w-full min-w-full divide-y divide-gray-200 table-fixed">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="w-16 px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Action
                  </th>
                  <th scope="col" class="w-32 px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Type & Model
                  </th>
                  <th scope="col" class="w-1/3 px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Description & Target
                  </th>
                  <th scope="col" class="w-1/4 px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Changes
                  </th>
                  <th scope="col" class="w-24 px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    When
                  </th>
                  <th scope="col" class="w-20 px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Actions
                  </th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @audit_logs.each do |log| %>
                  <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="flex-shrink-0">
                        <div class="w-8 h-8 <%= 
                          case log.action
                          when 'create'
                            'bg-green-100 text-green-600'
                          when 'update'
                            'bg-blue-100 text-blue-600'
                          when 'delete'
                            'bg-red-100 text-red-600'
                          when 'publish', 'approve'
                            'bg-emerald-100 text-emerald-600'
                          when 'unpublish', 'reject', 'suspend'
                            'bg-orange-100 text-orange-600'
                          when 'submit'
                            'bg-yellow-100 text-yellow-600'
                          else
                            'bg-gray-100 text-gray-600'
                          end
                        %> rounded-lg flex items-center justify-center">
                          <% case log.action %>
                          <% when 'create' %>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                            </svg>
                          <% when 'update' %>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                            </svg>
                          <% when 'delete' %>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                            </svg>
                          <% when 'publish', 'approve' %>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                          <% when 'unpublish', 'reject', 'suspend' %>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                          <% else %>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                            </svg>
                          <% end %>
                        </div>
                      </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="text-sm font-medium text-gray-900">
                        <%= log.action.humanize %>
                      </div>
                      <div class="text-sm text-gray-500">
                        <%= log.auditable_type %>
                      </div>
                    </td>
                    <td class="px-6 py-4">
                      <div class="text-sm font-medium text-gray-900">
                        <%= log.action_description %>
                      </div>
                      <% if log.auditable.try(:name) || log.auditable.try(:label) %>
                        <div class="text-sm text-blue-600 mt-1">
                          <% begin %>
                            <%= link_to (log.auditable.try(:name) || log.auditable.try(:label)), 
                                polymorphic_path([:admin, log.auditable]), 
                                class: "hover:text-blue-700" %>
                          <% rescue NoMethodError, ActionController::UrlGenerationError %>
                            <%= log.auditable.try(:name) || log.auditable.try(:label) %>
                          <% end %>
                        </div>
                      <% end %>
                      <% if log.change_summary.present? %>
                        <div class="text-sm text-gray-500 mt-1">
                          <%= truncate(log.change_summary, length: 100) %>
                        </div>
                      <% end %>
                    </td>
                    <td class="px-6 py-4">
                      <% if log.changed_fields.present? && log.changed_fields.any? %>
                        <div class="flex flex-wrap gap-1">
                          <% log.changed_fields.keys.first(3).each do |field| %>
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                              <%= field.humanize %>
                            </span>
                          <% end %>
                          <% if log.changed_fields.keys.size > 3 %>
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                              +<%= log.changed_fields.keys.size - 3 %> more
                            </span>
                          <% end %>
                        </div>
                      <% else %>
                        <span class="text-sm text-gray-400">No changes tracked</span>
                      <% end %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="text-sm text-gray-900">
                        <%= time_ago_in_words(log.created_at) %> ago
                      </div>
                      <time class="text-xs text-gray-500" datetime="<%= log.created_at.iso8601 %>">
                        <%= log.created_at.strftime("%m/%d/%Y") %>
                      </time>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                      <%= link_to admin_audit_log_path(log), 
                          class: "inline-flex items-center px-2.5 py-1.5 border border-gray-300 shadow-sm text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
                        <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                        </svg>
                        View
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          
          <!-- Results Info -->
          <div class="bg-white px-4 py-3 border-t border-gray-200 sm:px-6">
            <div class="flex-1 flex justify-between sm:hidden">
              <p class="text-sm text-gray-700">
                Showing <%= @audit_logs.count %> of <%= @total_logs %> logs
              </p>
            </div>
            <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
              <div>
                <p class="text-sm text-gray-700">
                  Showing <span class="font-medium"><%= @audit_logs.count %></span> logs
                  <% if @audit_logs.count >= 100 %>
                    (limited to first 100 results - use filters to narrow down)
                  <% end %>
                </p>
              </div>
            </div>
          </div>
        <% else %>
          <div class="text-center py-12">
            <div class="mx-auto h-24 w-24 text-gray-400 mb-4">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
            </div>
            <h3 class="mt-2 text-lg font-medium text-gray-900">No audit logs found</h3>
            <p class="mt-2 text-sm text-gray-500 max-w-sm mx-auto">
              <% if params[:search].present? || params[:action_filter].present? || params[:model_filter].present? || params[:date_filter].present? %>
                Try adjusting your search criteria or filters to see more results.
              <% else %>
                No audit logs have been recorded yet.
              <% end %>
            </p>
          </div>
        <% end %>
    </div>
  </div>
</div>

<% content_for :javascript do %>
<script>
// Helper function to determine admin path for different model types
function admin_path_for_model(modelType) {
  const paths = {
    'School': (resource) => `/admin/schools/${resource.id}`,
    'Place': (resource) => `/admin/places/${resource.id}`,
    'Term': (resource) => `/admin/terms/${resource.slug || resource.id}`,
    'Vocabulary': (resource) => `/admin/vocabularies/${resource.code || resource.id}`
  };
  return paths[modelType] || ((resource) => '#');
}
</script>
<% end %>
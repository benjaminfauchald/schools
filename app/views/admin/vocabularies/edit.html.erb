<% content_for :title, "Edit Vocabulary: #{@vocabulary.label}" %>

<!-- Main Content -->
<div class="w-full py-8">
  <div class="space-y-8 px-4 sm:px-6 lg:px-8">

      <!-- Page Header -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-6">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6">
            <div>
              <h1 class="text-3xl font-bold text-gray-900">Edit Vocabulary</h1>
              <p class="mt-2 text-sm text-gray-600">Update vocabulary information and settings</p>
            </div>
            <div class="mt-4 sm:mt-0 flex space-x-3">
              <%= link_to admin_vocabulary_path(@vocabulary), 
                  class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors" do %>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                </svg>
                View Vocabulary
              <% end %>
              <%= link_to admin_vocabularies_path, 
                  class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors" do %>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                Back to Vocabularies
              <% end %>
            </div>
          </div>
          
          <!-- Inline Statistics -->
          <div class="flex flex-wrap items-center gap-6 text-sm">
            <!-- Vocabulary Label -->
            <div class="flex items-center">
              <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center mr-3">
                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                </svg>
              </div>
              <div>
                <span class="font-semibold text-gray-900"><%= @vocabulary.label %></span>
                <span class="text-gray-500">Label</span>
              </div>
            </div>

            <!-- Code -->
            <div class="flex items-center">
              <div class="w-2 h-2 bg-green-500 rounded-full mr-2"></div>
              <span class="text-gray-900 font-medium font-mono"><%= @vocabulary.code %></span>
              <span class="text-gray-500 ml-1">Code</span>
            </div>

            <!-- Terms Count -->
            <div class="flex items-center">
              <div class="w-2 h-2 bg-purple-500 rounded-full mr-2"></div>
              <span class="text-gray-900 font-medium"><%= @vocabulary.terms_count %> terms</span>
              <span class="text-gray-500 ml-1">Total Terms</span>
            </div>

            <!-- Usage Count -->
            <div class="flex items-center">
              <div class="w-2 h-2 bg-orange-500 rounded-full mr-2"></div>
              <span class="text-gray-900 font-medium"><%= @vocabulary.usage_count %> usages</span>
              <span class="text-gray-500 ml-1">In Use</span>
            </div>

            <!-- Created -->
            <div class="flex items-center">
              <svg class="w-4 h-4 text-gray-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <span class="text-gray-900 font-medium"><%= time_ago_in_words(@vocabulary.created_at) %> ago</span>
              <span class="text-gray-500 ml-1">Created</span>
            </div>

            <!-- Status Warning -->
            <% if @vocabulary.usage_count > 0 %>
              <div class="flex items-center">
                <svg class="w-4 h-4 text-amber-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
                <span class="text-gray-900 font-medium">In Use</span>
                <span class="text-gray-500 ml-1">Code cannot be changed</span>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Form -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-6">
          <%= form_with model: [:admin, @vocabulary], local: true, class: "space-y-6" do |form| %>
            <% if @vocabulary.errors.any? %>
              <div class="bg-red-50 border border-red-200 rounded-lg p-4">
                <div class="flex">
                  <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                    </svg>
                  </div>
                  <div class="ml-3">
                    <h3 class="text-sm font-medium text-red-800">
                      <%= pluralize(@vocabulary.errors.count, "error") %> prohibited this vocabulary from being saved:
                    </h3>
                    <div class="mt-2 text-sm text-red-700">
                      <ul class="list-disc pl-5 space-y-1">
                        <% @vocabulary.errors.full_messages.each do |message| %>
                          <li><%= message %></li>
                        <% end %>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>

            <!-- Basic Information -->
            <div class="space-y-6">
              <div>
                <h3 class="text-lg font-medium text-gray-900 mb-4">Basic Information</h3>
                <div class="grid grid-cols-1 gap-6">
                  <div>
                    <%= form.label :label, "Label", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <%= form.text_field :label, 
                        class: "block w-full px-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm",
                        placeholder: "Enter vocabulary label (e.g., 'Curriculum Types')" %>
                    <p class="mt-1 text-xs text-gray-500">A human-readable name for this vocabulary</p>
                  </div>

                  <div>
                    <%= form.label :code, "Code", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <% if @vocabulary.usage_count > 0 %>
                      <%= form.text_field :code, 
                          class: "block w-full px-3 py-3 border border-gray-300 rounded-lg bg-gray-50 text-gray-500 text-sm font-mono",
                          readonly: true %>
                      <p class="mt-1 text-xs text-orange-600">
                        <svg class="inline w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"/>
                        </svg>
                        Code cannot be changed because this vocabulary is in use
                      </p>
                    <% else %>
                      <%= form.text_field :code, 
                          class: "block w-full px-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm font-mono",
                          placeholder: "Enter unique code (e.g., 'curriculum_type')",
                          pattern: "[a-z_]+",
                          title: "Use lowercase letters and underscores only" %>
                      <p class="mt-1 text-xs text-gray-500">Unique identifier using lowercase letters and underscores only</p>
                    <% end %>
                  </div>

                  <div>
                    <%= form.label :description, "Description (Optional)", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <%= form.text_area :description, 
                        rows: 4,
                        class: "block w-full px-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm",
                        placeholder: "Describe the purpose and use of this vocabulary..." %>
                    <p class="mt-1 text-xs text-gray-500">Explain what this vocabulary is used for and what types of terms it contains</p>
                  </div>
                </div>
              </div>

            </div>

            <!-- Form Actions -->
            <div class="flex items-center justify-between pt-6 border-t border-gray-200">
              <div class="flex items-center space-x-4">
                <%= link_to admin_vocabulary_path(@vocabulary), 
                    class: "inline-flex justify-center py-3 px-6 border border-gray-300 shadow-sm text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                  Cancel
                <% end %>
              </div>
              <div class="flex items-center space-x-4">
                <% if @vocabulary.usage_count == 0 %>
                  <%= link_to admin_vocabulary_path(@vocabulary), 
                      method: :delete,
                      data: { 
                        confirm: "Are you sure you want to delete this vocabulary? All associated terms will also be deleted. This action cannot be undone.",
                        turbo_method: :delete 
                      },
                      class: "inline-flex justify-center py-3 px-6 border border-red-300 shadow-sm text-sm font-medium rounded-lg text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors" do %>
                    Delete Vocabulary
                  <% end %>
                <% end %>
                <%= form.submit "Update Vocabulary", 
                    class: "inline-flex justify-center py-3 px-6 border border-transparent shadow-sm text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
  </div>
</div>
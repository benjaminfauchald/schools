<% content_for :title, "Edit Vocabulary: #{@vocabulary.label}" %>


<!-- Main Content -->
  <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
    <div class="space-y-8">
      <!-- Breadcrumb -->
      <nav class="flex" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <li class="inline-flex items-center">
            <%= link_to admin_root_path, class: "inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600" do %>
              <svg class="w-3 h-3 mr-2.5" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20">
                <path d="m19.707 9.293-2-2-7-7a1 1 0 0 0-1.414 0l-7 7-2 2a1 1 0 0 0 1.414 1.414L2 10.414V18a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-7.586l.293.293a1 1 0 0 0 1.414-1.414Z"/>
              </svg>
              Admin Dashboard
            <% end %>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
              </svg>
              <%= link_to "Vocabularies", admin_vocabularies_path, class: "ml-1 text-sm font-medium text-gray-700 hover:text-blue-600 md:ml-2" %>
            </div>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
              </svg>
              <%= link_to truncate(@vocabulary.label, length: 30), admin_vocabulary_path(@vocabulary), class: "ml-1 text-sm font-medium text-gray-700 hover:text-blue-600 md:ml-2" %>
            </div>
          </li>
          <li aria-current="page">
            <div class="flex items-center">
              <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
              </svg>
              <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2">Edit</span>
            </div>
          </li>
        </ol>
      </nav>

      <!-- Header -->
      <div class="text-center">
        <h1 class="text-3xl font-bold text-gray-900">Edit Vocabulary</h1>
        <p class="mt-2 text-lg text-gray-600">Update vocabulary information and settings</p>
      </div>

      <!-- Form -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-6">
          <%= form_with model: [:admin, @vocabulary], local: true, class: "space-y-6" do |form| %>
            <% if @vocabulary.errors.any? %>
              <div class="bg-red-50 border border-red-200 rounded-lg p-4">
                <div class="flex">
                  <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                    </svg>
                  </div>
                  <div class="ml-3">
                    <h3 class="text-sm font-medium text-red-800">
                      <%= pluralize(@vocabulary.errors.count, "error") %> prohibited this vocabulary from being saved:
                    </h3>
                    <div class="mt-2 text-sm text-red-700">
                      <ul class="list-disc pl-5 space-y-1">
                        <% @vocabulary.errors.full_messages.each do |message| %>
                          <li><%= message %></li>
                        <% end %>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>

            <!-- Basic Information -->
            <div class="space-y-6">
              <div>
                <h3 class="text-lg font-medium text-gray-900 mb-4">Basic Information</h3>
                <div class="grid grid-cols-1 gap-6">
                  <div>
                    <%= form.label :label, "Label", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <%= form.text_field :label, 
                        class: "block w-full px-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm",
                        placeholder: "Enter vocabulary label (e.g., 'Curriculum Types')" %>
                    <p class="mt-1 text-xs text-gray-500">A human-readable name for this vocabulary</p>
                  </div>

                  <div>
                    <%= form.label :code, "Code", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <% if @vocabulary.usage_count > 0 %>
                      <%= form.text_field :code, 
                          class: "block w-full px-3 py-3 border border-gray-300 rounded-lg bg-gray-50 text-gray-500 text-sm font-mono",
                          readonly: true %>
                      <p class="mt-1 text-xs text-orange-600">
                        <svg class="inline w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"/>
                        </svg>
                        Code cannot be changed because this vocabulary is in use
                      </p>
                    <% else %>
                      <%= form.text_field :code, 
                          class: "block w-full px-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm font-mono",
                          placeholder: "Enter unique code (e.g., 'curriculum_type')",
                          pattern: "[a-z_]+",
                          title: "Use lowercase letters and underscores only" %>
                      <p class="mt-1 text-xs text-gray-500">Unique identifier using lowercase letters and underscores only</p>
                    <% end %>
                  </div>

                  <div>
                    <%= form.label :description, "Description (Optional)", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <%= form.text_area :description, 
                        rows: 4,
                        class: "block w-full px-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm",
                        placeholder: "Describe the purpose and use of this vocabulary..." %>
                    <p class="mt-1 text-xs text-gray-500">Explain what this vocabulary is used for and what types of terms it contains</p>
                  </div>
                </div>
              </div>

              <!-- Statistics Panel -->
              <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
                <div class="flex">
                  <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M3 3a1 1 0 000 2v8a2 2 0 002 2h2.586l-1.293 1.293a1 1 0 101.414 1.414L10 15.414l2.293 2.293a1 1 0 001.414-1.414L12.414 15H15a2 2 0 002-2V5a1 1 0 100-2H3zm11.707 4.707a1 1 0 00-1.414-1.414L10 9.586 8.707 8.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                  </div>
                  <div class="ml-3">
                    <h3 class="text-sm font-medium text-gray-800">Current Statistics</h3>
                    <div class="mt-2 text-sm text-gray-600">
                      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                        <div>
                          <span class="font-medium"><%= @vocabulary.terms_count %></span>
                          <span class="text-gray-500">terms</span>
                        </div>
                        <div>
                          <span class="font-medium"><%= @vocabulary.usage_count %></span>
                          <span class="text-gray-500">usages</span>
                        </div>
                        <div class="col-span-2 md:col-span-1">
                          <span class="text-xs text-gray-500">
                            Created <%= time_ago_in_words(@vocabulary.created_at) %> ago
                          </span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Form Actions -->
            <div class="flex items-center justify-between pt-6 border-t border-gray-200">
              <div class="flex items-center space-x-4">
                <%= link_to admin_vocabulary_path(@vocabulary), 
                    class: "inline-flex justify-center py-3 px-6 border border-gray-300 shadow-sm text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                  Cancel
                <% end %>
                <%= link_to admin_vocabularies_path, 
                    class: "inline-flex justify-center py-3 px-6 border border-gray-300 shadow-sm text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                  Back to Vocabularies
                <% end %>
              </div>
              <div class="flex items-center space-x-4">
                <% if @vocabulary.usage_count == 0 %>
                  <%= link_to admin_vocabulary_path(@vocabulary), 
                      method: :delete,
                      data: { 
                        confirm: "Are you sure you want to delete this vocabulary? All associated terms will also be deleted. This action cannot be undone.",
                        turbo_method: :delete 
                      },
                      class: "inline-flex justify-center py-3 px-6 border border-red-300 shadow-sm text-sm font-medium rounded-lg text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors" do %>
                    Delete Vocabulary
                  <% end %>
                <% end %>
                <%= form.submit "Update Vocabulary", 
                    class: "inline-flex justify-center py-3 px-6 border border-transparent shadow-sm text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
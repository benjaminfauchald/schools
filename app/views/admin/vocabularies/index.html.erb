<% content_for :title, "Vocabulary Management" %>


<!-- Main Content -->
  <div class="w-full py-8 px-4 sm:px-6 lg:px-8">
    <div class="space-y-8">
      <!-- Page Header with Inline Stats -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-6">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6">
            <div>
              <h1 class="text-3xl font-bold text-gray-900">Vocabulary Management</h1>
              <p class="mt-2 text-sm text-gray-600">Manage taxonomy vocabularies and categories</p>
            </div>
            <div class="mt-4 sm:mt-0">
              <%= link_to new_admin_vocabulary_path, 
                  class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors" do %>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                </svg>
                Add New Vocabulary
              <% end %>
            </div>
          </div>
          
          <!-- Inline Statistics -->
          <div class="flex flex-wrap items-center gap-6 text-sm">
            <!-- Total Vocabularies -->
            <div class="flex items-center">
              <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center mr-3">
                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                </svg>
              </div>
              <div>
                <span class="font-semibold text-gray-900"><%= number_with_delimiter(@total_vocabularies || 0) %></span>
                <span class="text-gray-500">Total Vocabularies</span>
              </div>
            </div>

            <!-- Usage Breakdown -->
            <div class="flex items-center">
              <div class="w-2 h-2 bg-green-500 rounded-full mr-2"></div>
              <span class="text-gray-900 font-medium"><%= number_with_delimiter(@used_vocabularies || 0) %></span>
              <span class="text-gray-500 ml-1">In Use</span>
            </div>

            <div class="flex items-center">
              <div class="w-2 h-2 bg-gray-500 rounded-full mr-2"></div>
              <span class="text-gray-900 font-medium"><%= number_with_delimiter(@unused_vocabularies || 0) %></span>
              <span class="text-gray-500 ml-1">Unused</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Search and Filters -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
        <%= form_with url: admin_vocabularies_path, method: :get, local: true, class: "space-y-4 md:space-y-0 md:flex md:items-center md:space-x-4" do |form| %>
          <div class="flex-1">
            <%= form.text_field :search, 
                placeholder: "Search vocabularies by code, label, or description...", 
                value: params[:search],
                class: "block w-full pl-4 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm" %>
          </div>
          <div class="min-w-0 flex-1 md:max-w-xs">
            <%= form.select :usage, 
                options_for_select([
                  ['All Vocabularies', ''],
                  ['In Use', 'used'],
                  ['Unused', 'unused']
                ], params[:usage]), 
                {},
                { class: "block w-full pl-3 pr-10 py-3 text-base border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" } %>
          </div>
          <div class="flex space-x-3">
            <%= form.submit "Search", 
                class: "inline-flex justify-center py-3 px-4 border border-transparent shadow-sm text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" %>
            <%= link_to "Clear", admin_vocabularies_path, 
                class: "inline-flex justify-center py-3 px-4 border border-gray-300 shadow-sm text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" %>
          </div>
        <% end %>
      </div>

      <!-- Vocabularies Table -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-semibold text-gray-900">Vocabularies List</h3>
          <p class="mt-1 text-sm text-gray-600">Showing <%= @vocabularies.count %> of <%= @total_vocabularies %> vocabularies</p>
        </div>
        
        <% if @vocabularies.any? %>
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Icon
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Vocabulary
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Code
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Terms
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Usage
                  </th>
                  <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Actions
                  </th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @vocabularies.each do |vocabulary| %>
                  <tr class="hover:bg-gray-50">
                    <!-- Icon -->
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
                        <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                        </svg>
                      </div>
                    </td>
                    
                    <!-- Vocabulary -->
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="text-sm font-medium text-gray-900"><%= vocabulary.label %></div>
                      <% if vocabulary.description.present? %>
                        <div class="text-sm text-gray-500"><%= truncate(vocabulary.description, length: 60) %></div>
                      <% end %>
                    </td>
                    
                    <!-- Code -->
                    <td class="px-6 py-4 whitespace-nowrap">
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                        <%= vocabulary.code %>
                      </span>
                    </td>
                    
                    <!-- Terms -->
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="text-sm text-gray-900">
                        <%= pluralize(vocabulary.terms_count, 'term') %>
                      </div>
                      <% if vocabulary.terms_count > 0 %>
                        <div class="text-sm text-gray-500">
                          <%= link_to "View terms →", admin_terms_path(vocabulary_id: vocabulary.id), 
                              class: "text-blue-600 hover:text-blue-700" %>
                        </div>
                      <% end %>
                    </td>
                    
                    <!-- Usage -->
                    <td class="px-6 py-4 whitespace-nowrap">
                      <% usage_count = vocabulary.usage_count %>
                      <% if usage_count > 0 %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                          <%= pluralize(usage_count, 'usage') %>
                        </span>
                      <% else %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                          Unused
                        </span>
                      <% end %>
                    </td>
                    
                    <!-- Actions -->
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                      <div class="flex items-center justify-end space-x-2">
                        <%= link_to admin_vocabulary_path(vocabulary), 
                            class: "inline-flex items-center px-3 py-1 border border-gray-300 text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50 transition-colors",
                            title: "View Vocabulary" do %>
                          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                          </svg>
                          View
                        <% end %>
                        <%= link_to edit_admin_vocabulary_path(vocabulary), 
                            class: "inline-flex items-center px-3 py-1 border border-gray-300 text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50 transition-colors",
                            title: "Edit Vocabulary" do %>
                          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                          </svg>
                          Edit
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="px-6 py-12 text-center">
            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
            <h3 class="mt-2 text-sm font-medium text-gray-900">No vocabularies found</h3>
            <p class="mt-1 text-sm text-gray-500">
              <% if params[:search].present? || params[:usage].present? %>
                No vocabularies match your current search criteria.
              <% else %>
                Get started by creating a new vocabulary.
              <% end %>
            </p>
            <% unless params[:search].present? || params[:usage].present? %>
              <div class="mt-6">
                <%= link_to new_admin_vocabulary_path, 
                    class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                  </svg>
                  Add New Vocabulary
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
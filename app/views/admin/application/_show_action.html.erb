<%#
Override for Administrate's show action button to display generic "Show School" 
instead of "Show [Resource Name]" to avoid long button text
%>

<% if defined?(resource) && resource.respond_to?(:school) %>
  <%= link_to(
    "Show School",
    [namespace, resource], 
    class: "inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
  ) %>
<% else %>
  <%= link_to(
    "Show #{resource.class.name.demodulize}",
    [namespace, resource], 
    class: "inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
  ) %>
<% end %>
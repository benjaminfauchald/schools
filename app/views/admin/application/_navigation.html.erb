<nav class="flex items-center justify-between h-16" role="navigation">
  <div class="flex items-center">
    <div class="flex-shrink-0">
      <h1 class="text-xl font-semibold text-gray-900">Admin Panel</h1>
    </div>
    <% if current_user && current_user.school_claims.approved.any? %>
      <div class="ml-6">
        <%= link_to school_owner_schools_path, class: "px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
          My Schools
        <% end %>
      </div>
    <% end %>
  </div>
  
  <div class="hidden md:block">
    <div class="ml-10 flex items-baseline space-x-4">
      <%= link_to admin_root_path, class: "px-3 py-2 rounded-md text-sm font-medium #{current_page?(admin_root_path) ? 'bg-blue-100 text-blue-700' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50'}" do %>
        Dashboard
      <% end %>

      <%= link_to admin_school_claims_path, class: "px-3 py-2 rounded-md text-sm font-medium flex items-center #{controller_name == 'school_claims' ? 'bg-blue-100 text-blue-700' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50'}" do %>
        School Claims
        <% begin
             pending_count = SchoolClaim.pending.count 
             if pending_count > 0 %>
          <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800"><%= pending_count %></span>
        <%   end
           rescue => e
             # Silently ignore if model not available
           end %>
      <% end %>

      <%= link_to admin_inquiries_path, class: "px-3 py-2 rounded-md text-sm font-medium flex items-center #{controller_name == 'inquiries' ? 'bg-blue-100 text-blue-700' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50'}" do %>
        Inquiries
        <% begin
             new_count = SchoolInquiry.where(status: 'new').count
             if new_count > 0 %>
          <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800"><%= new_count %></span>
        <%   end
           rescue => e
             # Silently ignore if model not available
           end %>
      <% end %>

      <%= link_to admin_schools_path, class: "px-3 py-2 rounded-md text-sm font-medium #{controller_name == 'schools' ? 'bg-blue-100 text-blue-700' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50'}" do %>
        Schools
      <% end %>

      <%= link_to admin_users_path, class: "px-3 py-2 rounded-md text-sm font-medium #{controller_name == 'users' ? 'bg-blue-100 text-blue-700' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50'}" do %>
        Users
      <% end %>

      <!-- Dropdown for More Options -->
      <div class="relative" data-controller="dropdown">
        <button type="button" data-action="click->dropdown#toggle" class="px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50 flex items-center">
          More
          <svg class="-mr-1 ml-2 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </button>
        
        <div data-dropdown-target="menu" class="hidden origin-top-right absolute right-0 mt-2 w-56 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 z-10">
          <div class="py-1" role="menu">
            <%= link_to admin_places_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", role: "menuitem" do %>
              Places
            <% end %>
            
            <%= link_to admin_points_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", role: "menuitem" do %>
              Points
            <% end %>
            
            <%= link_to new_admin_google_map_import_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", role: "menuitem" do %>
              Import Google Map Entry
            <% end %>
            
            <div class="border-t border-gray-100"></div>
            
            <%= link_to admin_media_items_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", role: "menuitem" do %>
              Media Items
            <% end %>
            
            <%= link_to admin_events_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", role: "menuitem" do %>
              Events
            <% end %>
            
            <%= link_to admin_travel_times_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", role: "menuitem" do %>
              Travel Times
            <% end %>
            
            <div class="border-t border-gray-100"></div>
            
            <%= link_to admin_vocabularies_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", role: "menuitem" do %>
              Vocabularies
            <% end %>
            
            <%= link_to admin_terms_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", role: "menuitem" do %>
              Terms
            <% end %>
            
            <%= link_to admin_taggings_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", role: "menuitem" do %>
              Taggings
            <% end %>
            
            <div class="border-t border-gray-100"></div>
            
            <%= link_to admin_audit_logs_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", role: "menuitem" do %>
              Audit Logs
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <div class="hidden md:block">
    <div class="ml-4 flex items-center md:ml-6">
      <!-- Sign out link -->
      <%= link_to admin_destroy_session_path, data: { turbo_method: :delete }, class: "px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50" do %>
        Sign Out
      <% end %>
    </div>
  </div>
  
  <!-- Mobile menu button -->
  <div class="-mr-2 flex md:hidden">
    <button type="button" data-controller="mobile-menu" data-action="click->mobile-menu#toggle" class="bg-gray-50 inline-flex items-center justify-center p-2 rounded-md text-gray-400 hover:text-gray-500 hover:bg-gray-100">
      <span class="sr-only">Open main menu</span>
      <svg class="block h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
</nav>

<!-- Mobile menu -->
<div class="md:hidden" id="mobile-menu" data-mobile-menu-target="menu" style="display: none;">
  <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
    <% if current_user && current_user.school_claims.approved.any? %>
      <%= link_to school_owner_schools_path, class: "block px-3 py-2 rounded-md text-base font-medium text-white bg-blue-600 hover:bg-blue-700" do %>
        My Schools
      <% end %>
    <% end %>
    
    <%= link_to admin_root_path, class: "block px-3 py-2 rounded-md text-base font-medium #{current_page?(admin_root_path) ? 'bg-blue-100 text-blue-700' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50'}" do %>
      Dashboard
    <% end %>
    
    <%= link_to admin_school_claims_path, class: "block px-3 py-2 rounded-md text-base font-medium #{controller_name == 'school_claims' ? 'bg-blue-100 text-blue-700' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50'}" do %>
      School Claims
    <% end %>
    
    <%= link_to admin_inquiries_path, class: "block px-3 py-2 rounded-md text-base font-medium #{controller_name == 'inquiries' ? 'bg-blue-100 text-blue-700' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50'}" do %>
      Inquiries
    <% end %>
    
    <%= link_to admin_schools_path, class: "block px-3 py-2 rounded-md text-base font-medium #{controller_name == 'schools' ? 'bg-blue-100 text-blue-700' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50'}" do %>
      Schools
    <% end %>
    
    <%= link_to admin_users_path, class: "block px-3 py-2 rounded-md text-base font-medium #{controller_name == 'users' ? 'bg-blue-100 text-blue-700' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50'}" do %>
      Users
    <% end %>
    
    <div class="border-t border-gray-200 mt-2 pt-2">
      <%= link_to admin_destroy_session_path, data: { turbo_method: :delete }, class: "block px-3 py-2 rounded-md text-base font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50" do %>
        Sign Out
      <% end %>
    </div>
  </div>
</div>
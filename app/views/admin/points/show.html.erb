<% content_for :title, "Point Details - #{@point.name || "Point ##{@point.id}"}" %>

<% layout = "application" %>

<!-- Main Content -->
<div class="w-full py-8 px-4 sm:px-6 lg:px-8">
  <div class="space-y-8">
    <!-- Breadcrumb -->
    <nav class="flex" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
          <%= link_to admin_root_path, class: "inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600" do %>
            <svg class="w-3 h-3 mr-2.5" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20">
              <path d="m19.707 9.293-2-2-7-7a1 1 0 0 0-1.414 0l-7 7-2 2a1 1 0 0 0 1.414 1.414L2 10.414V18a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-7.586l.293.293a1 1 0 0 0 1.414-1.414Z"/>
            </svg>
            Admin Dashboard
          <% end %>
        </li>
        <li>
          <div class="flex items-center">
            <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" fill="none" viewBox="0 0 6 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
            </svg>
            <%= link_to "Points", admin_points_path, class: "ml-1 text-sm font-medium text-gray-700 hover:text-blue-600 md:ml-2" %>
          </div>
        </li>
        <li aria-current="page">
          <div class="flex items-center">
            <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" fill="none" viewBox="0 0 6 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
            </svg>
            <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2">Point Details</span>
          </div>
        </li>
      </ol>
    </nav>

    <!-- Page Header with Inline Stats -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
      <div class="px-6 py-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6">
          <div>
            <h1 class="text-3xl font-bold text-gray-900"><%= @point.name.presence || "Point ##{@point.id}" %></h1>
            <p class="mt-2 text-sm text-gray-600">View detailed OpenStreetMap point information and linked places</p>
          </div>
          <div class="mt-4 sm:mt-0 flex space-x-3">
            <%= link_to edit_admin_point_path(@point),
                class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
              </svg>
              Edit Point
            <% end %>
            
            <% if @point.lat.present? && @point.lon.present? %>
              <%= link_to "https://www.openstreetmap.org/?mlat=#{@point.lat}&mlon=#{@point.lon}&zoom=18", target: "_blank",
                  class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors" do %>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
                View on OSM
              <% end %>
            <% end %>
            
            <%= link_to admin_points_path,
                class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
              </svg>
              Back to Points
            <% end %>
          </div>
        </div>
        
        <!-- Inline Statistics -->
        <div class="flex flex-wrap items-center gap-6 text-sm">
          <!-- Point Type -->
          <div class="flex items-center">
            <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center mr-3">
              <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <span class="font-semibold text-gray-900">
                <% if @point.amenity.present? %>
                  <%= @point.amenity.humanize %>
                <% elsif @point.school_type.present? %>
                  <%= @point.school_type.humanize %>
                <% else %>
                  General Point
                <% end %>
              </span>
              <span class="text-gray-500">Type</span>
            </div>
          </div>

          <!-- OSM ID -->
          <div class="flex items-center">
            <div class="w-2 h-2 bg-green-500 rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium"><%= @point.osm_id || @point.id %></span>
            <span class="text-gray-500 ml-1">OSM ID</span>
          </div>

          <!-- Coordinates Status -->
          <div class="flex items-center">
            <div class="w-2 h-2 bg-<%= @point.lat.present? && @point.lon.present? ? 'green' : 'red' %>-500 rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium">
              <%= @point.lat.present? && @point.lon.present? ? 'Available' : 'Missing' %>
            </span>
            <span class="text-gray-500 ml-1">Coordinates</span>
          </div>

          <!-- Linked Places -->
          <div class="flex items-center">
            <div class="w-2 h-2 bg-orange-500 rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium"><%= @point.places.count %></span>
            <span class="text-gray-500 ml-1">Linked Places</span>
          </div>

          <!-- Address Status -->
          <div class="flex items-center">
            <div class="w-2 h-2 bg-<%= @point.address.present? || [@point.addr_street, @point.addr_city].any?(&:present?) ? 'green' : 'yellow' %>-500 rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium">
              <%= @point.address.present? || [@point.addr_street, @point.addr_city].any?(&:present?) ? 'Available' : 'Partial' %>
            </span>
            <span class="text-gray-500 ml-1">Address</span>
          </div>

          <!-- Contact Info Status -->
          <div class="flex items-center">
            <div class="w-2 h-2 bg-<%= [@point.phone, @point.website, @point.email].any?(&:present?) ? 'green' : 'gray' %>-500 rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium">
              <%= [@point.phone, @point.website, @point.email].any?(&:present?) ? 'Available' : 'None' %>
            </span>
            <span class="text-gray-500 ml-1">Contact Info</span>
          </div>

          <!-- Last Updated -->
          <div class="flex items-center">
            <svg class="w-4 h-4 text-gray-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span class="text-gray-900 font-medium">
              <% if @point.respond_to?(:updated_at) %>
                <%= time_ago_in_words(@point.updated_at) %> ago
              <% else %>
                Unknown
              <% end %>
            </span>
            <span class="text-gray-500 ml-1">Updated</span>
          </div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Main Content -->
      <div class="lg:col-span-2 space-y-8">
        <!-- Basic Information -->
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
          <div class="px-6 py-6">
            <h3 class="text-lg font-medium text-gray-900 mb-6">Basic Information</h3>
            
            <dl class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <dt class="text-sm font-medium text-gray-500 mb-2">Name</dt>
                <dd class="text-lg font-medium text-gray-900">
                  <%= @point.name.presence || "No name provided" %>
                </dd>
              </div>
              
              <div>
                <dt class="text-sm font-medium text-gray-500 mb-2">OSM ID</dt>
                <dd class="text-sm font-mono text-gray-900 bg-gray-50 px-3 py-2 rounded">
                  <%= @point.osm_id || @point.id %>
                </dd>
              </div>
              
              <div class="md:col-span-2">
                <dt class="text-sm font-medium text-gray-500 mb-2">Address</dt>
                <dd class="text-sm text-gray-900">
                  <% if @point.address.present? %>
                    <%= @point.address %>
                  <% else %>
                    <div class="space-y-1">
                      <% if @point.addr_street.present? %>
                        <div><%= @point.addr_street %></div>
                      <% end %>
                      <% if [@point.addr_district, @point.addr_city, @point.addr_province].any?(&:present?) %>
                        <div><%= [@point.addr_district, @point.addr_city, @point.addr_province].compact.join(', ') %></div>
                      <% end %>
                      <% if @point.addr_postcode.present? %>
                        <div><%= @point.addr_postcode %> <%= @point.addr_country %></div>
                      <% end %>
                      <% unless [@point.addr_street, @point.addr_city, @point.addr_province].any?(&:present?) %>
                        <span class="text-gray-400 italic">No address provided</span>
                      <% end %>
                    </div>
                  <% end %>
                </dd>
              </div>
              
              <div>
                <dt class="text-sm font-medium text-gray-500 mb-2">Coordinates</dt>
                <dd class="text-sm text-gray-900">
                  <% if @point.lat.present? && @point.lon.present? %>
                    <div class="flex items-center space-x-2">
                      <span class="font-mono"><%= @point.lat %>, <%= @point.lon %></span>
                      <a href="https://www.openstreetmap.org/?mlat=<%= @point.lat %>&mlon=<%= @point.lon %>&zoom=18" 
                         target="_blank" 
                         class="inline-flex items-center text-blue-600 hover:text-blue-700">
                        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                        </svg>
                        View on OSM
                      </a>
                    </div>
                  <% else %>
                    <span class="text-gray-400 italic">No coordinates</span>
                  <% end %>
                </dd>
              </div>

              <div>
                <dt class="text-sm font-medium text-gray-500 mb-2">Operator</dt>
                <dd class="text-sm text-gray-900">
                  <%= @point.operator.presence || "No operator information" %>
                </dd>
              </div>
            </dl>
          </div>
        </div>

        <!-- Contact Information -->
        <% if [@point.phone, @point.website, @point.email].any?(&:present?) %>
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <h3 class="text-lg font-medium text-gray-900 mb-6">Contact Information</h3>
              
              <dl class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <% if @point.phone.present? %>
                  <div>
                    <dt class="text-sm font-medium text-gray-500 mb-2">Phone</dt>
                    <dd class="text-sm text-gray-900">
                      <div class="flex items-center">
                        <svg class="w-4 h-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                        </svg>
                        <a href="tel:<%= @point.phone %>" class="text-blue-600 hover:text-blue-700">
                          <%= @point.phone %>
                        </a>
                      </div>
                    </dd>
                  </div>
                <% end %>

                <% if @point.email.present? %>
                  <div>
                    <dt class="text-sm font-medium text-gray-500 mb-2">Email</dt>
                    <dd class="text-sm text-gray-900">
                      <div class="flex items-center">
                        <svg class="w-4 h-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"/>
                        </svg>
                        <a href="mailto:<%= @point.email %>" class="text-blue-600 hover:text-blue-700">
                          <%= @point.email %>
                        </a>
                      </div>
                    </dd>
                  </div>
                <% end %>

                <% if @point.website.present? %>
                  <div class="md:col-span-2">
                    <dt class="text-sm font-medium text-gray-500 mb-2">Website</dt>
                    <dd class="text-sm text-gray-900">
                      <div class="flex items-center">
                        <svg class="w-4 h-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                        </svg>
                        <a href="<%= @point.website %>" target="_blank" class="text-blue-600 hover:text-blue-700 break-all">
                          <%= @point.website %>
                        </a>
                      </div>
                    </dd>
                  </div>
                <% end %>
              </dl>
            </div>
          </div>
        <% end %>

        <!-- Linked Places -->
        <% if @point.places.any? %>
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <h3 class="text-lg font-medium text-gray-900 mb-6">Linked Places</h3>
              
              <div class="space-y-4">
                <% @point.places.includes(:school).each do |place| %>
                  <div class="flex items-start p-4 bg-gray-50 rounded-lg">
                    <div class="flex-shrink-0 w-10 h-10">
                      <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                        <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                        </svg>
                      </div>
                    </div>
                    <div class="ml-3 flex-1">
                      <div class="flex items-center justify-between">
                        <h4 class="text-sm font-medium text-gray-900">
                          <%= link_to place.name, admin_place_path(place), class: "text-blue-600 hover:text-blue-700" %>
                        </h4>
                        <div class="flex items-center space-x-2">
                          <% if place.school %>
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
                              School
                            </span>
                          <% end %>
                          <% if place.rating.present? %>
                            <span class="text-xs text-yellow-600">
                              ★ <%= place.rating %>
                            </span>
                          <% end %>
                        </div>
                      </div>
                      <% if place.formatted_address.present? %>
                        <p class="mt-1 text-xs text-gray-500"><%= place.formatted_address %></p>
                      <% end %>
                      <% if place.google_place_id.present? %>
                        <p class="mt-2 text-xs text-gray-400">Google Place ID: <%= place.google_place_id %></p>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Sidebar -->
      <div class="space-y-8">
        <!-- Actions -->
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
          <div class="px-6 py-6">
            <h3 class="text-lg font-medium text-gray-900 mb-4">Actions</h3>
            <div class="space-y-3">
              <%= link_to edit_admin_point_path(@point),
                  class: "w-full inline-flex justify-center items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
                Edit Point
              <% end %>
              
              <hr class="border-gray-200">
              
              <%= link_to admin_point_path(@point),
                  method: :delete,
                  data: { confirm: "Are you sure you want to delete this point? This action cannot be undone." },
                  class: "w-full inline-flex justify-center items-center px-4 py-2 border border-red-300 text-sm font-medium rounded-lg text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors" do %>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                </svg>
                Delete Point
              <% end %>
            </div>
          </div>
        </div>

        <!-- Statistics -->
        <div class="bg-gray-50 border border-gray-200 rounded-xl shadow-sm">
          <div class="px-6 py-6">
            <h3 class="text-lg font-medium text-gray-900 mb-4">Statistics</h3>
            <dl class="space-y-3">
              <div>
                <dt class="text-sm font-medium text-gray-500">Record ID</dt>
                <dd class="text-sm font-mono text-gray-900">
                  <%= @point.id %>
                </dd>
              </div>
              
              <div>
                <dt class="text-sm font-medium text-gray-500">Created</dt>
                <dd class="text-sm text-gray-900">
                  <%= @point.created_at.strftime("%B %d, %Y at %I:%M %p") if @point.respond_to?(:created_at) %>
                </dd>
              </div>
              
              <div>
                <dt class="text-sm font-medium text-gray-500">Last Updated</dt>
                <dd class="text-sm text-gray-900">
                  <%= @point.updated_at.strftime("%B %d, %Y at %I:%M %p") if @point.respond_to?(:updated_at) %>
                </dd>
              </div>
              
              <div>
                <dt class="text-sm font-medium text-gray-500">Linked Places</dt>
                <dd class="text-sm text-gray-900">
                  <%= pluralize(@point.places.count, 'place') %>
                </dd>
              </div>
            </dl>
          </div>
        </div>

        <!-- External Links -->
        <% if @point.lat.present? && @point.lon.present? %>
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <h3 class="text-lg font-medium text-gray-900 mb-4">External Links</h3>
              <div class="space-y-3">
                <a href="https://www.openstreetmap.org/?mlat=<%= @point.lat %>&mlon=<%= @point.lon %>&zoom=18" 
                   target="_blank"
                   class="w-full inline-flex justify-center items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                  View on OpenStreetMap
                </a>
                
                <a href="https://www.google.com/maps/search/?api=1&query=<%= @point.lat %>,<%= @point.lon %>" 
                   target="_blank"
                   class="w-full inline-flex justify-center items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                  View on Google Maps
                </a>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
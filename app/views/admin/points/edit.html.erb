<% content_for :title, "Edit Point - #{@point.name || "Point ##{@point.id}"}" %>

<!-- Main Content -->
<div class="w-full py-8 px-4 sm:px-6 lg:px-8">
  <div class="space-y-8">
    <!-- Page Header -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
      <div class="px-6 py-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6">
          <div>
            <h1 class="text-3xl font-bold text-gray-900">Edit Point</h1>
            <p class="mt-2 text-sm text-gray-600">Update OpenStreetMap point information</p>
          </div>
        </div>
      </div>
    </div>

      <!-- Form -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-6">
          <%= form_with model: [:admin, @point], local: true, class: "space-y-6" do |form| %>
            <% if @point.errors.any? %>
              <div class="bg-red-50 border border-red-200 rounded-lg p-4">
                <div class="flex">
                  <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                    </svg>
                  </div>
                  <div class="ml-3">
                    <h3 class="text-sm font-medium text-red-800">
                      <%= pluralize(@point.errors.count, "error") %> prohibited this point from being saved:
                    </h3>
                    <div class="mt-2 text-sm text-red-700">
                      <ul class="list-disc pl-5 space-y-1">
                        <% @point.errors.full_messages.each do |message| %>
                          <li><%= message %></li>
                        <% end %>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>

            <!-- Basic Information -->
            <div class="space-y-6">
              <div>
                <h3 class="text-lg font-medium text-gray-900 mb-4">Basic Information</h3>
                <div class="grid grid-cols-1 gap-6">
                  <div>
                    <%= form.label :name, "Name", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <%= form.text_field :name, 
                        class: "block w-full px-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm",
                        placeholder: "Enter point name" %>
                  </div>

                  <div>
                    <%= form.label :amenity, "Amenity Type", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <%= form.text_field :amenity, 
                        class: "block w-full px-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm",
                        placeholder: "e.g., school, restaurant, shop" %>
                  </div>
                </div>
              </div>

              <!-- Location Information -->
              <div>
                <h3 class="text-lg font-medium text-gray-900 mb-4">Location Information</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div>
                    <%= form.label :lat, "Latitude", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <%= form.number_field :lat, 
                        step: :any,
                        class: "block w-full px-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm",
                        placeholder: "13.7563" %>
                  </div>

                  <div>
                    <%= form.label :lon, "Longitude", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <%= form.number_field :lon, 
                        step: :any,
                        class: "block w-full px-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm",
                        placeholder: "100.5018" %>
                  </div>
                </div>
              </div>

              <!-- Address Information -->
              <div>
                <h3 class="text-lg font-medium text-gray-900 mb-4">Address Information</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div>
                    <%= form.label :addr_housenumber, "House Number", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <%= form.text_field :addr_housenumber, 
                        class: "block w-full px-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm",
                        placeholder: "123" %>
                  </div>

                  <div>
                    <%= form.label :addr_street, "Street", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <%= form.text_field :addr_street, 
                        class: "block w-full px-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm",
                        placeholder: "Sukhumvit Road" %>
                  </div>

                  <div>
                    <%= form.label :addr_district, "District", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <%= form.text_field :addr_district, 
                        class: "block w-full px-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm",
                        placeholder: "Watthana" %>
                  </div>

                  <div>
                    <%= form.label :addr_subdistrict, "Subdistrict", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <%= form.text_field :addr_subdistrict, 
                        class: "block w-full px-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm",
                        placeholder: "Khlong Toei" %>
                  </div>
                </div>
              </div>

              <!-- Contact Information -->
              <div>
                <h3 class="text-lg font-medium text-gray-900 mb-4">Contact Information</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div>
                    <%= form.label :phone, "Phone", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <%= form.text_field :phone, 
                        class: "block w-full px-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm",
                        placeholder: "+66 2 123 4567" %>
                  </div>

                  <div>
                    <%= form.label :website, "Website", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <%= form.url_field :website, 
                        class: "block w-full px-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm",
                        placeholder: "https://example.com" %>
                  </div>
                </div>
              </div>

              <!-- Information Panel -->
              <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                <div class="flex">
                  <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-blue-400" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                    </svg>
                  </div>
                  <div class="ml-3">
                    <h3 class="text-sm font-medium text-blue-800">About Points</h3>
                    <div class="mt-2 text-sm text-blue-700">
                      <p>Points represent OpenStreetMap point-of-interest data including schools, restaurants, shops, and other establishments. They contain geographic coordinates and detailed address information for Bangkok locations.</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Form Actions -->
            <div class="flex items-center justify-end space-x-4 pt-6 border-t border-gray-200">
              <%= link_to admin_points_path, 
                  class: "inline-flex justify-center py-3 px-6 border border-gray-300 shadow-sm text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                Cancel
              <% end %>
              <%= form.submit "Update Point", 
                  class: "inline-flex items-center px-6 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
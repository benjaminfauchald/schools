<% content_for :title, "Create New Point" %>

<!-- Main Content -->
<div class="w-full py-8">
  <div class="space-y-8 px-4 sm:px-6 lg:px-8">
    <!-- Page Header -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
      <div class="px-6 py-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6">
          <div>
            <h1 class="text-3xl font-bold text-gray-900">Create New Point</h1>
            <p class="mt-2 text-sm text-gray-600">Add a new geographic data point to the system</p>
          </div>
          <div class="mt-4 sm:mt-0 flex space-x-3">
            <%= link_to admin_points_path, 
                class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
              </svg>
              Back to Points
            <% end %>
          </div>
        </div>
        
        <!-- Inline Statistics -->
        <div class="flex flex-wrap items-center gap-6 text-sm">
          <!-- Location Icon -->
          <div class="flex items-center">
            <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center mr-3">
              <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <span class="font-semibold text-gray-900">Geographic Point</span>
              <span class="text-gray-500">New Location</span>
            </div>
          </div>

          <!-- Form Type -->
          <div class="flex items-center">
            <div class="w-2 h-2 bg-green-500 rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium">Creation Form</span>
            <span class="text-gray-500 ml-1">Point Data</span>
          </div>

          <!-- Required Fields -->
          <div class="flex items-center">
            <div class="w-2 h-2 bg-orange-500 rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium">Required</span>
            <span class="text-gray-500 ml-1">Name & Location</span>
          </div>

          <!-- Optional Fields -->
          <div class="flex items-center">
            <div class="w-2 h-2 bg-gray-400 rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium">Optional</span>
            <span class="text-gray-500 ml-1">Contact & Details</span>
          </div>

          <!-- Form Status -->
          <div class="flex items-center">
            <svg class="w-4 h-4 text-gray-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <span class="text-gray-900 font-medium">Draft Mode</span>
            <span class="text-gray-500 ml-1">Ready for Input</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Form -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
      <div class="px-6 py-6">
        <%= form_with model: [:admin, @point], local: true, class: "space-y-6" do |form| %>
          <% if @point.errors.any? %>
            <div class="p-4 bg-red-50 border border-red-200 rounded-lg">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <div class="ml-3">
                  <h3 class="text-sm font-medium text-red-800">There were <%= pluralize(@point.errors.count, "error") %> with your submission:</h3>
                  <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
                    <% @point.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          <% end %>

          <!-- Basic Information -->
          <div>
            <h3 class="text-lg font-medium text-gray-900 mb-4">Basic Information</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <!-- Name -->
              <div>
                <%= form.label :name, "Name", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= form.text_field :name, 
                    placeholder: "Enter point name...",
                    class: "block w-full px-3 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" %>
                <p class="mt-1 text-sm text-gray-500">The display name for this geographic point</p>
              </div>

              <!-- OSM ID -->
              <div>
                <%= form.label :osm_id, "OSM ID", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= form.text_field :osm_id, 
                    placeholder: "OpenStreetMap ID...",
                    class: "block w-full px-3 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" %>
                <p class="mt-1 text-sm text-gray-500">OpenStreetMap identifier (if available)</p>
              </div>

              <!-- Amenity -->
              <div>
                <%= form.label :amenity, "Amenity Type", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= form.select :amenity, 
                    options_for_select([
                      ['Select amenity type...', ''],
                      ['School', 'school'],
                      ['University', 'university'],
                      ['College', 'college'],
                      ['Kindergarten', 'kindergarten'],
                      ['Library', 'library'],
                      ['Hospital', 'hospital'],
                      ['Restaurant', 'restaurant'],
                      ['Other', 'other']
                    ], @point.amenity),
                    {},
                    { class: "block w-full pl-3 pr-10 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" } %>
                <p class="mt-1 text-sm text-gray-500">Primary function or type of this location</p>
              </div>

              <!-- School Type -->
              <div>
                <%= form.label :school_type, "School Type", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= form.select :school_type, 
                    options_for_select([
                      ['Select school type...', ''],
                      ['Primary', 'primary'],
                      ['Secondary', 'secondary'],
                      ['Higher', 'higher'],
                      ['Vocational', 'vocational'],
                      ['Special', 'special']
                    ], @point.school_type),
                    {},
                    { class: "block w-full pl-3 pr-10 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" } %>
                <p class="mt-1 text-sm text-gray-500">Educational level (if this is a school)</p>
              </div>

              <!-- Operator -->
              <div class="md:col-span-2">
                <%= form.label :operator, "Operator", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= form.text_field :operator, 
                    placeholder: "Organization or entity that operates this location...",
                    class: "block w-full px-3 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" %>
                <p class="mt-1 text-sm text-gray-500">The organization responsible for operating this location</p>
              </div>
            </div>
          </div>

          <!-- Location Information -->
          <div>
            <h3 class="text-lg font-medium text-gray-900 mb-4">Location Information</h3>
            
            <!-- Full Address -->
            <div class="mb-6">
              <%= form.label :address, "Full Address", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.text_area :address, 
                  placeholder: "Complete address (if available)...",
                  rows: 3,
                  class: "block w-full px-3 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" %>
              <p class="mt-1 text-sm text-gray-500">Complete formatted address or leave blank to use component fields below</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <!-- Street -->
              <div>
                <%= form.label :addr_street, "Street", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= form.text_field :addr_street, 
                    placeholder: "Street address...",
                    class: "block w-full px-3 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" %>
              </div>

              <!-- City -->
              <div>
                <%= form.label :addr_city, "City", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= form.text_field :addr_city, 
                    placeholder: "City name...",
                    class: "block w-full px-3 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" %>
              </div>

              <!-- District -->
              <div>
                <%= form.label :addr_district, "District", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= form.text_field :addr_district, 
                    placeholder: "District or area...",
                    class: "block w-full px-3 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" %>
              </div>

              <!-- Province -->
              <div>
                <%= form.label :addr_province, "Province/State", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= form.text_field :addr_province, 
                    placeholder: "Province or state...",
                    class: "block w-full px-3 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" %>
              </div>

              <!-- Postcode -->
              <div>
                <%= form.label :addr_postcode, "Postal Code", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= form.text_field :addr_postcode, 
                    placeholder: "Postal code...",
                    class: "block w-full px-3 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" %>
              </div>

              <!-- Country -->
              <div>
                <%= form.label :addr_country, "Country", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= form.text_field :addr_country, 
                    placeholder: "Country name...",
                    class: "block w-full px-3 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" %>
              </div>

              <!-- Coordinates -->
              <div>
                <%= form.label :lat, "Latitude", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= form.number_field :lat, 
                    step: :any,
                    placeholder: "13.7563",
                    class: "block w-full px-3 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" %>
              </div>

              <div>
                <%= form.label :lon, "Longitude", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= form.number_field :lon, 
                    step: :any,
                    placeholder: "100.5018",
                    class: "block w-full px-3 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" %>
              </div>
            </div>
          </div>

          <!-- Contact Information -->
          <div>
            <h3 class="text-lg font-medium text-gray-900 mb-4">Contact Information</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <!-- Phone -->
              <div>
                <%= form.label :phone, "Phone", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= form.telephone_field :phone, 
                    placeholder: "+66-2-555-0123",
                    class: "block w-full px-3 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" %>
                <p class="mt-1 text-sm text-gray-500">Contact phone number</p>
              </div>

              <!-- Email -->
              <div>
                <%= form.label :email, "Email", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= form.email_field :email, 
                    placeholder: "contact@example.com",
                    class: "block w-full px-3 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" %>
                <p class="mt-1 text-sm text-gray-500">Contact email address</p>
              </div>

              <!-- Website -->
              <div class="md:col-span-2">
                <%= form.label :website, "Website", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= form.url_field :website, 
                    placeholder: "https://www.example.com",
                    class: "block w-full px-3 py-3 text-base border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg" %>
                <p class="mt-1 text-sm text-gray-500">Official website URL</p>
              </div>
            </div>
          </div>

          <!-- Form Actions -->
          <div class="flex items-center justify-between pt-6 border-t border-gray-200">
            <div class="flex items-center space-x-4">
              <%= link_to admin_points_path,
                  class: "inline-flex justify-center py-3 px-6 border border-gray-300 shadow-sm text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                Cancel
              <% end %>
            </div>
            <div class="flex items-center space-x-4">
              <%= form.submit "Create Point",
                  class: "inline-flex justify-center py-3 px-6 border border-transparent shadow-sm text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
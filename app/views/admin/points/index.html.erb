<% content_for :title, "Points Management" %>

<% layout = "application" %>


<!-- Main Content -->
<div class="w-full py-8 px-4 sm:px-6 lg:px-8">
  <div class="space-y-8">
    <!-- Page Header with Inline Stats -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
      <div class="px-6 py-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6">
          <div>
            <h1 class="text-3xl font-bold text-gray-900">Points Management</h1>
            <p class="mt-2 text-sm text-gray-600">Manage OpenStreetMap geographic data points and location information</p>
          </div>
          <div class="mt-4 sm:mt-0">
            <%= link_to new_admin_point_path, 
                class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
              </svg>
              Add New Point
            <% end %>
          </div>
        </div>
        
        <!-- Inline Statistics -->
        <div class="flex flex-wrap items-center gap-6 text-sm">
          <!-- Total Points -->
          <div class="flex items-center">
            <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center mr-3">
              <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <span class="font-semibold text-gray-900"><%= number_with_delimiter(@total_points || 0) %></span>
              <span class="text-gray-500">Total Points</span>
            </div>
          </div>

          <!-- Type Breakdown -->
          <div class="flex items-center">
            <div class="w-2 h-2 bg-green-500 rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium"><%= number_with_delimiter(@points_with_amenity || 0) %></span>
            <span class="text-gray-500 ml-1">With Amenity</span>
          </div>

          <div class="flex items-center">
            <div class="w-2 h-2 bg-blue-500 rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium"><%= number_with_delimiter(@named_points || 0) %></span>
            <span class="text-gray-500 ml-1">Named</span>
          </div>

          <div class="flex items-center">
            <div class="w-2 h-2 bg-purple-500 rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium"><%= number_with_delimiter(@points_with_contact || 0) %></span>
            <span class="text-gray-500 ml-1">With Contact</span>
          </div>

          <!-- Data Source Info -->
          <div class="flex items-center">
            <div class="w-8 h-8 bg-orange-100 rounded-lg flex items-center justify-center mr-3">
              <svg class="w-4 h-4 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <span class="font-semibold text-gray-900">OSM Data</span>
              <span class="text-gray-500">Geographic points</span>
            </div>
          </div>

          <!-- Places Connection -->
          <div class="flex items-center">
            <svg class="w-4 h-4 text-indigo-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
            </svg>
            <span class="text-gray-900 font-medium"><%= number_with_delimiter(@points_with_places || 0) %></span>
            <span class="text-gray-500 ml-1">Linked to Places</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Compact Search & Filters -->
    <div class="bg-white rounded-lg border border-gray-200 p-4">
      <%= form_with url: admin_points_path, method: :get, local: true, class: "flex flex-wrap items-end gap-3" do |f| %>
        <div class="flex-1 min-w-64">
          <%= f.text_field :search, 
              value: params[:search], 
              placeholder: "Search points...",
              class: "block w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>
        
        <div class="min-w-40">
          <%= f.select :amenity, 
              options_for_select([
                ['All Types', ''],
                ['School', 'school'],
                ['University', 'university'],
                ['College', 'college'],
                ['Kindergarten', 'kindergarten']
              ], params[:amenity]),
              {},
              { class: "block w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" } %>
        </div>

        <div class="min-w-32">
          <%= f.select :has_coordinates, 
              options_for_select([
                ['All Coords', ''],
                ['With Coords', 'true'],
                ['No Coords', 'false']
              ], params[:has_coordinates]),
              {},
              { class: "block w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" } %>
        </div>

        <div class="min-w-28">
          <%= f.select :has_places, 
              options_for_select([
                ['All Places', ''],
                ['With Places', 'true'],
                ['No Places', 'false']
              ], params[:has_places]),
              {},
              { class: "block w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" } %>
        </div>
        
        <%= f.submit "Search", 
            class: "px-4 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors" %>
      <% end %>
    </div>

    <!-- Compact Points List -->
    <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
      <div class="px-4 py-3 bg-gray-50 border-b border-gray-200 flex items-center justify-between">
        <h3 class="text-sm font-medium text-gray-900">OpenStreetMap Points</h3>
        <span class="text-xs text-gray-500">Showing <%= @points.count %> geographic data points</span>
      </div>
      
      <% if @points.any? %>
        <div class="divide-y divide-gray-200">
          <% @points.each do |point| %>
            <div class="p-4 hover:bg-gray-50 transition-colors">
              <div class="flex items-start justify-between">
                <!-- Point Info -->
                <div class="flex items-start space-x-3 flex-1">
                  <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                  </div>
                  
                  <div class="flex-1 min-w-0">
                    <!-- Name & ID -->
                    <div class="flex items-center space-x-2">
                      <%= link_to point.name.presence || "Point ##{point.id}", admin_point_path(id: point.id), 
                          class: "text-sm font-medium text-gray-900 hover:text-blue-600 truncate" %>
                      <span class="text-xs text-gray-400">OSM ID: <%= point.osm_id || point.id %></span>
                    </div>
                    
                    <!-- Address -->
                    <% address = point.address.presence || [point.addr_street, point.addr_city].compact.join(', ').presence %>
                    <% if address.present? %>
                      <p class="text-xs text-gray-500 mt-1 truncate">
                        <%= address %>
                      </p>
                    <% else %>
                      <p class="text-xs text-gray-500 mt-1">No address</p>
                    <% end %>
                    
                    <!-- Coordinates -->
                    <% if point.lat.present? && point.lon.present? %>
                      <p class="text-xs text-gray-400 mt-1">
                        <%= point.lat %>, <%= point.lon %>
                      </p>
                    <% end %>
                    
                    <!-- Status Tags & Info Row -->
                    <div class="flex items-center space-x-2 mt-2">
                      <!-- Amenity Type -->
                      <% if point.amenity.present? %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
                          <div class="w-1.5 h-1.5 bg-green-500 rounded-full mr-1"></div>
                          <%= point.amenity.humanize %>
                        </span>
                      <% elsif point.school_type.present? %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
                          <div class="w-1.5 h-1.5 bg-blue-500 rounded-full mr-1"></div>
                          <%= point.school_type.humanize %>
                        </span>
                      <% end %>
                      
                      <!-- Coordinates Status -->
                      <% if point.lat.present? && point.lon.present? %>
                        <span class="text-xs text-green-600 font-medium">Coords ✓</span>
                      <% else %>
                        <span class="text-xs text-red-600 font-medium">Coords ✗</span>
                      <% end %>
                      
                      <!-- Places Count -->
                      <% places_count = point.places&.count || 0 %>
                      <% if places_count > 0 %>
                        <div class="flex items-center text-xs">
                          <svg class="w-3 h-3 text-orange-400 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                          </svg>
                          <span class="text-gray-700 font-medium"><%= pluralize(places_count, 'place') %></span>
                        </div>
                      <% end %>
                      
                      <!-- Contact Info -->
                      <% if point.phone.present? %>
                        <div class="flex items-center text-xs text-blue-600">
                          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                          </svg>
                          Phone
                        </div>
                      <% elsif point.website.present? %>
                        <div class="flex items-center text-xs text-blue-600">
                          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                          </svg>
                          Website
                        </div>
                      <% elsif point.email.present? %>
                        <div class="flex items-center text-xs text-blue-600">
                          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"/>
                          </svg>
                          Email
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
                
                <!-- Actions -->
                <div class="flex items-center space-x-1 ml-4">
                  <%= link_to admin_point_path(id: point.id),
                      class: "inline-flex items-center justify-center w-8 h-8 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition-colors",
                      title: "View Details" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                    </svg>
                  <% end %>
                  
                  <%= link_to edit_admin_point_path(id: point.id),
                      class: "inline-flex items-center justify-center w-8 h-8 text-gray-400 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-colors",
                      title: "Edit Point" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
        
        <!-- Results Footer -->
        <% if @points.count >= 50 %>
          <div class="px-4 py-3 bg-gray-50 border-t border-gray-200">
            <p class="text-xs text-gray-500 text-center">
              Limited to first 50 results - use search to narrow down
            </p>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-8">
          <div class="w-12 h-12 mx-auto text-gray-400 mb-3">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            </svg>
          </div>
          <h3 class="text-sm font-medium text-gray-900">No points found</h3>
          <p class="text-xs text-gray-500 mt-1 max-w-sm mx-auto">
            <% if params[:search].present? || params[:amenity].present? || params[:has_coordinates].present? || params[:has_places].present? %>
              Try adjusting your search criteria or filters.
            <% else %>
              No points have been imported yet.
            <% end %>
          </p>
          <div class="mt-4">
            <%= link_to new_admin_point_path, 
                class: "inline-flex items-center px-3 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors" do %>
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
              </svg>
              Add Point
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
<% content_for :title, "Places Management" %>

<div class="w-full py-8 px-4 sm:px-6 lg:px-8">
  <div class="space-y-8">
    <!-- Page Header with Inline Stats -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
      <div class="px-6 py-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6">
          <div>
            <h1 class="text-3xl font-bold text-gray-900">Places Management</h1>
            <p class="mt-2 text-sm text-gray-600">Manage Google Places API data and business information</p>
          </div>
          <div class="mt-4 sm:mt-0">
            <%= link_to new_admin_place_path, 
                class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
              </svg>
              Add New Place
            <% end %>
          </div>
        </div>
        
        <!-- Inline Statistics -->
        <div class="flex flex-wrap items-center gap-6 text-sm">
          <!-- Total Places -->
          <div class="flex items-center">
            <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center mr-3">
              <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <span class="font-semibold text-gray-900"><%= number_with_delimiter(@total_places || 0) %></span>
              <span class="text-gray-500">Total Places</span>
            </div>
          </div>

          <!-- Status Breakdown -->
          <div class="flex items-center">
            <div class="w-2 h-2 bg-green-500 rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium"><%= number_with_delimiter(@operational_places || 0) %></span>
            <span class="text-gray-500 ml-1">Operational</span>
          </div>

          <div class="flex items-center">
            <div class="w-2 h-2 bg-red-500 rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium"><%= number_with_delimiter(@closed_places || 0) %></span>
            <span class="text-gray-500 ml-1">Closed</span>
          </div>

          <div class="flex items-center">
            <div class="w-2 h-2 bg-yellow-500 rounded-full mr-2"></div>
            <span class="text-gray-900 font-medium"><%= number_with_delimiter(@places_with_rating || 0) %></span>
            <span class="text-gray-500 ml-1">With Ratings</span>
            <% if @avg_rating.present? %>
              <span class="text-gray-400 ml-1">(avg: <%= @avg_rating %>⭐)</span>
            <% end %>
          </div>

          <!-- Additional Stats -->
          <div class="flex items-center">
            <div class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center mr-3">
              <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <span class="font-semibold text-gray-900"><%= number_with_delimiter(@places_with_photos || 0) %></span>
              <span class="text-gray-500">With Photos</span>
            </div>
          </div>

          <div class="flex items-center">
            <div class="w-8 h-8 bg-indigo-100 rounded-lg flex items-center justify-center mr-3">
              <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
              </svg>
            </div>
            <div>
              <span class="font-semibold text-gray-900"><%= ((@places_with_rating.to_f / @total_places) * 100).round(1) %>%</span>
              <span class="text-gray-500">Data Coverage</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Compact Search & Filters -->
    <div class="bg-white rounded-lg border border-gray-200 p-4">
      <%= form_with url: admin_places_path, method: :get, local: true, class: "flex flex-wrap items-end gap-3" do |f| %>
        <div class="flex-1 min-w-64">
          <%= f.text_field :search, 
              value: params[:search], 
              placeholder: "Search places...",
              class: "block w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>
        
        <div class="min-w-40">
          <%= f.select :business_status, 
              options_for_select([
                ['All Status', ''],
                ['Operational', 'OPERATIONAL'],
                ['Temp Closed', 'CLOSED_TEMPORARILY'],
                ['Closed', 'CLOSED_PERMANENTLY']
              ], params[:business_status]),
              {},
              { class: "block w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" } %>
        </div>

        <div class="min-w-32">
          <%= f.select :api_status, 
              options_for_select([
                ['All API', ''],
                ['OK', 'OK'],
                ['Zero', 'ZERO_RESULTS'],
                ['Limit', 'OVER_QUERY_LIMIT'],
                ['Denied', 'REQUEST_DENIED']
              ], params[:api_status]),
              {},
              { class: "block w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" } %>
        </div>

        <div class="min-w-28">
          <%= f.select :rating_min, 
              options_for_select([
                ['Any ★', ''],
                ['4.0+ ★', '4.0'],
                ['3.5+ ★', '3.5'],
                ['3.0+ ★', '3.0']
              ], params[:rating_min]),
              {},
              { class: "block w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" } %>
        </div>
        
        <%= f.submit "Search", 
            class: "px-4 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors" %>
      <% end %>
    </div>

    <!-- Compact Places List -->
    <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
      <div class="px-4 py-3 bg-gray-50 border-b border-gray-200 flex items-center justify-between">
        <h3 class="text-sm font-medium text-gray-900">Places</h3>
        <span class="text-xs text-gray-500">Showing <%= @places.count %> results</span>
      </div>
      
      <% if @places.any? %>
        <div class="divide-y divide-gray-200">
          <% @places.each do |place| %>
            <div class="p-4 hover:bg-gray-50 transition-colors">
              <div class="flex items-start justify-between">
                <!-- Place Info -->
                <div class="flex items-start space-x-3 flex-1">
                  <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    </svg>
                  </div>
                  
                  <div class="flex-1 min-w-0">
                    <!-- Name & ID -->
                    <div class="flex items-center space-x-2">
                      <%= link_to place.name.presence || "Unnamed Place", admin_place_path(id: place.id), 
                          class: "text-sm font-medium text-gray-900 hover:text-blue-600 truncate" %>
                      <span class="text-xs text-gray-400">#<%= place.id %></span>
                    </div>
                    
                    <!-- Address -->
                    <% if place.formatted_address.present? || place.vicinity.present? %>
                      <p class="text-xs text-gray-500 mt-1 truncate">
                        <%= place.formatted_address.presence || place.vicinity %>
                      </p>
                    <% end %>
                    
                    <!-- Status Tags & Info Row -->
                    <div class="flex items-center space-x-2 mt-2">
                      <!-- Business Status -->
                      <% case place.business_status %>
                      <% when 'OPERATIONAL' %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
                          <div class="w-1.5 h-1.5 bg-green-500 rounded-full mr-1"></div>
                          Open
                        </span>
                      <% when 'CLOSED_TEMPORARILY' %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-yellow-100 text-yellow-800">
                          <div class="w-1.5 h-1.5 bg-yellow-500 rounded-full mr-1"></div>
                          Temp
                        </span>
                      <% when 'CLOSED_PERMANENTLY' %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800">
                          <div class="w-1.5 h-1.5 bg-red-500 rounded-full mr-1"></div>
                          Closed
                        </span>
                      <% end %>
                      
                      <!-- API Status -->
                      <% case place.api_status %>
                      <% when 'OK' %>
                        <span class="text-xs text-green-600 font-medium">API ✓</span>
                      <% when 'ZERO_RESULTS' %>
                        <span class="text-xs text-yellow-600 font-medium">API ⚠</span>
                      <% when 'OVER_QUERY_LIMIT', 'REQUEST_DENIED' %>
                        <span class="text-xs text-red-600 font-medium">API ✗</span>
                      <% end %>
                      
                      <!-- Rating -->
                      <% if place.rating.present? %>
                        <div class="flex items-center text-xs">
                          <svg class="w-3 h-3 text-yellow-400 mr-1" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                          </svg>
                          <span class="text-gray-700 font-medium"><%= place.rating %></span>
                          <% if place.user_ratings_total.present? %>
                            <span class="text-gray-500 ml-1">(<%= number_with_delimiter(place.user_ratings_total) %>)</span>
                          <% end %>
                        </div>
                      <% end %>
                      
                      <!-- Contact Info -->
                      <% if place.formatted_phone_number.present? %>
                        <div class="flex items-center text-xs text-blue-600">
                          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                          </svg>
                          Phone
                        </div>
                      <% elsif place.website.present? %>
                        <div class="flex items-center text-xs text-blue-600">
                          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                          </svg>
                          Website
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
                
                <!-- Actions -->
                <div class="flex items-center space-x-1 ml-4">
                  <%= link_to admin_place_path(id: place.id),
                      class: "inline-flex items-center justify-center w-8 h-8 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition-colors",
                      title: "View Details" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                    </svg>
                  <% end %>
                  
                  <%= link_to edit_admin_place_path(id: place.id),
                      class: "inline-flex items-center justify-center w-8 h-8 text-gray-400 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-colors",
                      title: "Edit Place" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
        
        <!-- Results Footer -->
        <% if @places.count < @total_places %>
          <div class="px-4 py-3 bg-gray-50 border-t border-gray-200">
            <p class="text-xs text-gray-500 text-center">
              Limited to first 50 results - use search to narrow down
            </p>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-8">
          <div class="w-12 h-12 mx-auto text-gray-400 mb-3">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            </svg>
          </div>
          <h3 class="text-sm font-medium text-gray-900">No places found</h3>
          <p class="text-xs text-gray-500 mt-1 max-w-sm mx-auto">
            <% if params[:search].present? || params[:business_status].present? || params[:api_status].present? || params[:rating_min].present? %>
              Try adjusting your search criteria or filters.
            <% else %>
              No places have been created yet.
            <% end %>
          </p>
          <div class="mt-4">
            <%= link_to new_admin_place_path, 
                class: "inline-flex items-center px-3 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors" do %>
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
              </svg>
              Add Place
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
    </div>
  </div>
</div>
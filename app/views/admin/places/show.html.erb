<% content_for :title, "Place Details - #{@place.name}" %>


<!-- Main Content -->
  <div class="mx-auto py-8 px-6 sm:px-8 lg:px-12 max-w-none">
    <div class="space-y-8">
      <!-- Breadcrumb -->
      <nav class="flex" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <li class="inline-flex items-center">
            <%= link_to admin_root_path, class: "inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600" do %>
              <svg class="w-3 h-3 mr-2.5" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20">
                <path d="m19.707 9.293-2-2-7-7a1 1 0 0 0-1.414 0l-7 7-2 2a1 1 0 0 0 1.414 1.414L2 10.414V18a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-7.586l.293.293a1 1 0 0 0 1.414-1.414Z"/>
              </svg>
              Admin Dashboard
            <% end %>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
              </svg>
              <%= link_to "Places", admin_places_path, class: "ml-1 text-sm font-medium text-gray-700 hover:text-blue-600 md:ml-2" %>
            </div>
          </li>
          <li aria-current="page">
            <div class="flex items-center">
              <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
              </svg>
              <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2">Place Details</span>
            </div>
          </li>
        </ol>
      </nav>

      <!-- Page Header -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-6">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <div class="w-16 h-16 bg-gray-200 rounded-full flex items-center justify-center">
                  <svg class="w-8 h-8 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                </div>
              </div>
              <div class="ml-4">
                <h1 class="text-3xl font-bold text-gray-900"><%= @place.name.presence || "Unnamed Place" %></h1>
                <div class="mt-1 flex items-center space-x-4">
                  <!-- Business Status Badge -->
                  <% case @place.business_status %>
                  <% when 'OPERATIONAL' %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                      <svg class="w-2 h-2 mr-1.5 fill-current" viewBox="0 0 8 8">
                        <circle cx="4" cy="4" r="3"/>
                      </svg>
                      Operational
                    </span>
                  <% when 'CLOSED_TEMPORARILY' %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">
                      <svg class="w-2 h-2 mr-1.5 fill-current" viewBox="0 0 8 8">
                        <circle cx="4" cy="4" r="3"/>
                      </svg>
                      Temporarily Closed
                    </span>
                  <% when 'CLOSED_PERMANENTLY' %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
                      <svg class="w-2 h-2 mr-1.5 fill-current" viewBox="0 0 8 8">
                        <circle cx="4" cy="4" r="3"/>
                      </svg>
                      Permanently Closed
                    </span>
                  <% end %>
                  
                  <!-- API Status Badge -->
                  <% case @place.api_status %>
                  <% when 'OK' %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
                      <svg class="w-2 h-2 mr-1.5 fill-current" viewBox="0 0 8 8">
                        <circle cx="4" cy="4" r="3"/>
                      </svg>
                      API OK
                    </span>
                  <% else %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-800">
                      <svg class="w-2 h-2 mr-1.5 fill-current" viewBox="0 0 8 8">
                        <circle cx="4" cy="4" r="3"/>
                      </svg>
                      <%= @place.api_status.presence || 'Unknown' %>
                    </span>
                  <% end %>

                  <!-- Google Data Badge -->
                  <% if @has_google_data %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-emerald-100 text-emerald-800">
                      <svg class="w-2 h-2 mr-1.5 fill-current" viewBox="0 0 8 8">
                        <circle cx="4" cy="4" r="3"/>
                      </svg>
                      Google Places
                    </span>
                  <% end %>
                </div>
              </div>
            </div>
            <div class="mt-4 sm:mt-0 flex items-center space-x-3">
              <%= link_to edit_admin_place_path(@place),
                  class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
                Edit Place
              <% end %>
              
              <% if @place.website.present? %>
                <%= link_to @place.website, target: "_blank",
                    class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                  Visit Website
                <% end %>
              <% end %>
              
              <%= link_to admin_places_path,
                  class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                Back to Places
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Content Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Left Column - Place Details -->
        <div class="lg:col-span-2 space-y-6">
          <!-- Basic Information -->
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <div class="flex items-center mb-6">
                <div class="flex-shrink-0 w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <h2 class="ml-4 text-xl font-semibold text-gray-900">Basic Information</h2>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Place Name -->
                <div class="space-y-3">
                  <div>
                    <div class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">PLACE NAME</div>
                    <div class="text-base font-semibold text-gray-900">
                      <%= @place.name.presence || "Unnamed Place" %>
                    </div>
                  </div>
                </div>

                <!-- Place ID -->
                <div class="space-y-3">
                  <div>
                    <div class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">PLACE ID</div>
                    <div class="text-base text-gray-900"><%= @place.id %></div>
                  </div>
                </div>

                <!-- Google Place ID -->
                <div class="space-y-3">
                  <div>
                    <div class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">GOOGLE PLACE ID</div>
                    <div class="text-base text-gray-900">
                      <% if @place.google_place_id.present? %>
                        <span class="font-mono text-sm"><%= truncate(@place.google_place_id, length: 30) %></span>
                      <% else %>
                        <span class="text-gray-400 italic">Not available</span>
                      <% end %>
                    </div>
                  </div>
                </div>

                <!-- Price Level -->
                <div class="space-y-3">
                  <div>
                    <div class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">PRICE LEVEL</div>
                    <div class="text-base text-gray-900">
                      <% if @place.price_level.present? %>
                        <% price_symbols = "$" * [@place.price_level.to_i, 4].min %>
                        <span class="text-green-600 font-medium"><%= price_symbols %></span>
                      <% else %>
                        <span class="text-gray-400 italic">Not specified</span>
                      <% end %>
                    </div>
                  </div>
                </div>

                <!-- Coordinates -->
                <div class="space-y-3">
                  <div>
                    <div class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">COORDINATES</div>
                    <div class="text-base text-gray-900">
                      <% if @has_coordinates %>
                        <span class="font-mono text-sm">
                          <%= @place.lat.round(6) %>, <%= @place.lng.round(6) %>
                        </span>
                      <% else %>
                        <span class="text-gray-400 italic">Not available</span>
                      <% end %>
                    </div>
                  </div>
                </div>

                <!-- Last Fetched -->
                <div class="space-y-3">
                  <div>
                    <div class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">LAST UPDATED</div>
                    <div class="text-base text-gray-900">
                      <% if @place.last_fetched_at.present? %>
                        <%= @place.last_fetched_at.strftime("%B %d, %Y at %I:%M %p") %>
                        <div class="text-sm text-gray-600">
                          <%= time_ago_in_words(@place.last_fetched_at) %> ago
                        </div>
                      <% else %>
                        <span class="text-gray-400 italic">Never fetched</span>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Address Information -->
          <% if @place.formatted_address.present? || @place.vicinity.present? %>
            <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
              <div class="px-6 py-6">
                <div class="flex items-center mb-6">
                  <div class="flex-shrink-0 w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                    <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                  </div>
                  <h2 class="ml-4 text-xl font-semibold text-gray-900">Address & Location</h2>
                </div>

                <div class="space-y-4">
                  <% if @place.formatted_address.present? %>
                    <div>
                      <div class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">FORMATTED ADDRESS</div>
                      <div class="text-sm font-medium text-gray-900">
                        <%= @place.formatted_address %>
                      </div>
                    </div>
                  <% end %>

                  <% if @place.vicinity.present? && @place.vicinity != @place.formatted_address %>
                    <div>
                      <div class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">VICINITY</div>
                      <div class="text-sm text-gray-700">
                        <%= @place.vicinity %>
                      </div>
                    </div>
                  <% end %>

                  <% if @place.plus_code_compound_code.present? || @place.plus_code_global_code.present? %>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                      <% if @place.plus_code_compound_code.present? %>
                        <div>
                          <div class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">PLUS CODE</div>
                          <div class="text-sm text-gray-700 font-mono">
                            <%= @place.plus_code_compound_code %>
                          </div>
                        </div>
                      <% end %>
                      <% if @place.plus_code_global_code.present? %>
                        <div>
                          <div class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">GLOBAL CODE</div>
                          <div class="text-sm text-gray-700 font-mono">
                            <%= @place.plus_code_global_code %>
                          </div>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>

          <!-- Rating & Reviews -->
          <% if @place.rating.present? || @reviews.present? %>
            <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
              <div class="px-6 py-6">
                <div class="flex items-center mb-6">
                  <div class="flex-shrink-0 w-10 h-10 bg-yellow-100 rounded-full flex items-center justify-center">
                    <svg class="w-5 h-5 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                    </svg>
                  </div>
                  <h2 class="ml-4 text-xl font-semibold text-gray-900">Rating & Reviews</h2>
                </div>

                <% if @place.rating.present? %>
                  <div class="flex items-center mb-6">
                    <div class="flex items-center">
                      <span class="text-3xl font-bold text-gray-900"><%= @place.rating %></span>
                      <svg class="w-8 h-8 text-yellow-400 ml-2" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                      </svg>
                    </div>
                    <% if @place.user_ratings_total.present? %>
                      <div class="ml-4 text-sm text-gray-600">
                        Based on <%= number_with_delimiter(@place.user_ratings_total) %> reviews
                      </div>
                    <% end %>
                  </div>
                <% end %>

                <% if @reviews.present? && @reviews.is_a?(Array) %>
                  <div class="space-y-4">
                    <h3 class="text-lg font-medium text-gray-900">Recent Reviews</h3>
                    <% @reviews.first(3).each do |review| %>
                      <div class="border border-gray-200 rounded-lg p-4">
                        <div class="flex items-center justify-between mb-2">
                          <div class="font-medium text-gray-900">
                            <%= review['author_name'] || 'Anonymous' %>
                          </div>
                          <% if review['rating'] %>
                            <div class="flex items-center">
                              <span class="text-sm font-medium text-gray-900 mr-1"><%= review['rating'] %></span>
                              <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                              </svg>
                            </div>
                          <% end %>
                        </div>
                        <% if review['text'] %>
                          <p class="text-sm text-gray-700"><%= truncate(review['text'], length: 200) %></p>
                        <% end %>
                        <% if review['time'] %>
                          <div class="text-xs text-gray-500 mt-2">
                            <%= Time.at(review['time'].to_i).strftime("%B %d, %Y") rescue review['time'] %>
                          </div>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>

          <!-- Opening Hours -->
          <% if @opening_hours.present? %>
            <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
              <div class="px-6 py-6">
                <div class="flex items-center mb-6">
                  <div class="flex-shrink-0 w-10 h-10 bg-indigo-100 rounded-full flex items-center justify-center">
                    <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                  </div>
                  <h2 class="ml-4 text-xl font-semibold text-gray-900">Opening Hours</h2>
                </div>

                <% if @opening_hours['weekday_text'] %>
                  <div class="space-y-2">
                    <% @opening_hours['weekday_text'].each do |day_text| %>
                      <div class="text-sm text-gray-700">
                        <%= day_text %>
                      </div>
                    <% end %>
                  </div>
                <% else %>
                  <p class="text-gray-500 italic">Opening hours information not available</p>
                <% end %>
              </div>
            </div>
          <% end %>

          <!-- Editorial Summary -->
          <% if @place.editorial_summary.present? %>
            <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
              <div class="px-6 py-6">
                <div class="flex items-center mb-6">
                  <div class="flex-shrink-0 w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center">
                    <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                  </div>
                  <h2 class="ml-4 text-xl font-semibold text-gray-900">Editorial Summary</h2>
                </div>

                <div class="text-gray-700 leading-relaxed">
                  <%= simple_format(@place.editorial_summary) %>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Right Column - Actions & Contact -->
        <div class="lg:col-span-1 space-y-6">
          <!-- Place Actions -->
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <div class="flex items-center mb-6">
                <div class="flex-shrink-0 w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                  </svg>
                </div>
                <h3 class="ml-4 text-lg font-semibold text-gray-900">Actions</h3>
              </div>

              <div class="space-y-3">
                <%= link_to edit_admin_place_path(@place),
                    class: "w-full flex items-center justify-center py-2.5 px-4 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                  </svg>
                  Edit Place
                <% end %>

                <% if @place.website.present? %>
                  <%= link_to @place.website, target: "_blank",
                      class: "w-full flex items-center justify-center py-2.5 px-4 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                    </svg>
                    Visit Website
                  <% end %>
                <% end %>

                <% if @place.url.present? %>
                  <%= link_to @place.url, target: "_blank",
                      class: "w-full flex items-center justify-center py-2.5 px-4 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
                    </svg>
                    Google Maps
                  <% end %>
                <% end %>

                <% unless @place.point.present? %>
                  <%= link_to admin_place_path(@place), method: :delete,
                      data: { confirm: "Are you sure you want to delete this place? This action cannot be undone." },
                      class: "w-full flex items-center justify-center py-2.5 px-4 border border-red-300 rounded-lg shadow-sm text-sm font-medium text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors" do %>
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                    Delete Place
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Contact Information -->
          <% if @place.formatted_phone_number.present? || @place.international_phone_number.present? || @place.website.present? %>
            <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
              <div class="px-6 py-6">
                <div class="flex items-center mb-6">
                  <div class="flex-shrink-0 w-10 h-10 bg-emerald-100 rounded-full flex items-center justify-center">
                    <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                  </div>
                  <h3 class="ml-4 text-lg font-semibold text-gray-900">Contact Information</h3>
                </div>

                <div class="space-y-3">
                  <% if @place.formatted_phone_number.present? %>
                    <div class="flex items-center justify-between p-3 bg-blue-50 border border-blue-200 rounded-lg">
                      <div class="text-sm font-medium text-blue-800">Phone</div>
                      <div class="text-sm text-blue-600">
                        <%= link_to @place.formatted_phone_number, "tel:#{@place.formatted_phone_number}", class: "hover:text-blue-700" %>
                      </div>
                    </div>
                  <% end %>

                  <% if @place.international_phone_number.present? && @place.international_phone_number != @place.formatted_phone_number %>
                    <div class="flex items-center justify-between p-3 bg-green-50 border border-green-200 rounded-lg">
                      <div class="text-sm font-medium text-green-800">International</div>
                      <div class="text-sm text-green-600">
                        <%= link_to @place.international_phone_number, "tel:#{@place.international_phone_number}", class: "hover:text-green-700" %>
                      </div>
                    </div>
                  <% end %>

                  <% if @place.website.present? %>
                    <div class="flex items-center justify-between p-3 bg-purple-50 border border-purple-200 rounded-lg">
                      <div class="text-sm font-medium text-purple-800">Website</div>
                      <div class="text-sm text-purple-600">
                        <%= link_to "Visit Site", @place.website, target: "_blank", class: "hover:text-purple-700" %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>

          <!-- Technical Information -->
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <div class="flex items-center mb-6">
                <div class="flex-shrink-0 w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                </div>
                <h3 class="ml-4 text-lg font-semibold text-gray-900">Technical Details</h3>
              </div>

              <div class="space-y-3">
                <div class="flex items-center justify-between p-3 bg-blue-50 border border-blue-200 rounded-lg">
                  <div class="text-sm font-medium text-blue-800">API Status</div>
                  <div class="text-sm text-blue-600">
                    <%= @place.api_status.presence || 'Unknown' %>
                  </div>
                </div>

                <div class="flex items-center justify-between p-3 bg-green-50 border border-green-200 rounded-lg">
                  <div class="text-sm font-medium text-green-800">Has Google Data</div>
                  <div class="text-sm text-green-600">
                    <%= @has_google_data ? 'Yes' : 'No' %>
                  </div>
                </div>

                <div class="flex items-center justify-between p-3 bg-yellow-50 border border-yellow-200 rounded-lg">
                  <div class="text-sm font-medium text-yellow-800">Has Coordinates</div>
                  <div class="text-sm text-yellow-600">
                    <%= @has_coordinates ? 'Yes' : 'No' %>
                  </div>
                </div>

                <% if @place.point.present? %>
                  <div class="flex items-center justify-between p-3 bg-purple-50 border border-purple-200 rounded-lg">
                    <div class="text-sm font-medium text-purple-800">Linked Point</div>
                    <div class="text-sm text-purple-600">
                      <%= link_to "Point ##{@place.point.id}", admin_point_path(@place.point), class: "hover:text-purple-700" if defined?(admin_point_path) %>
                    </div>
                  </div>
                <% end %>

                <div class="text-xs text-gray-500 mt-4">
                  Created <%= @place.created_at.strftime("%B %Y") %>
                </div>
              </div>
            </div>
          </div>

          <!-- Quick Links -->
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
            <div class="px-6 py-6">
              <div class="flex items-center mb-6">
                <div class="flex-shrink-0 w-10 h-10 bg-teal-100 rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                  </svg>
                </div>
                <h3 class="ml-4 text-lg font-semibold text-gray-900">Quick Links</h3>
              </div>

              <div class="space-y-3">
                <%= link_to admin_places_path,
                    class: "w-full flex items-center justify-center py-2.5 px-4 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                  </svg>
                  Back to Places
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
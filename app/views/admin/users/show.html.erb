<% content_for :title, "User Details - #{@user.email}" %>


<!-- Main Content -->
  <div class="w-full py-8 px-4 sm:px-6 lg:px-8">
    <div class="space-y-8">
      <!-- Breadcrumb -->
      <nav class="flex" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <li class="inline-flex items-center">
            <%= link_to admin_root_path, class: "inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600" do %>
              <svg class="w-3 h-3 mr-2.5" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20">
                <path d="m19.707 9.293-2-2-7-7a1 1 0 0 0-1.414 0l-7 7-2 2a1 1 0 0 0 1.414 1.414L2 10.414V18a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-7.586l.293.293a1 1 0 0 0 1.414-1.414Z"/>
              </svg>
              Admin Dashboard
            <% end %>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
              </svg>
              <%= link_to "Users", admin_users_path, class: "ml-1 text-sm font-medium text-gray-700 hover:text-blue-600 md:ml-2" %>
            </div>
          </li>
          <li aria-current="page">
            <div class="flex items-center">
              <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
              </svg>
              <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2">User Details</span>
            </div>
          </li>
        </ol>
      </nav>

      <!-- Page Header -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-6">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6">
            <div>
              <%= link_to admin_users_path, class: "inline-flex items-center text-blue-600 hover:text-blue-800 mb-4" do %>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                </svg>
                Back to Users
              <% end %>
              
              <h1 class="text-3xl font-bold text-gray-900"><%= @user.email %></h1>
              <p class="mt-2 text-sm text-gray-600">User profile and account management</p>
              
              <div class="mt-3 flex items-center space-x-3">
                <!-- Role Badge -->
                <% case @user.role %>
                <% when 'admin' %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                    <svg class="w-2 h-2 mr-1 fill-current" viewBox="0 0 8 8">
                      <circle cx="4" cy="4" r="3"/>
                    </svg>
                    Admin
                  </span>
                <% when 'school_owner' %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                    <svg class="w-2 h-2 mr-1 fill-current" viewBox="0 0 8 8">
                      <circle cx="4" cy="4" r="3"/>
                    </svg>
                    School Owner
                  </span>
                <% else %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                    <svg class="w-2 h-2 mr-1 fill-current" viewBox="0 0 8 8">
                      <circle cx="4" cy="4" r="3"/>
                    </svg>
                    User
                  </span>
                <% end %>
                
                <!-- Status Badge -->
                <% if @user.confirmed_at.present? %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                    <svg class="w-2 h-2 mr-1 fill-current" viewBox="0 0 8 8">
                      <circle cx="4" cy="4" r="3"/>
                    </svg>
                    Confirmed
                  </span>
                <% else %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                    <svg class="w-2 h-2 mr-1 fill-current" viewBox="0 0 8 8">
                      <circle cx="4" cy="4" r="3"/>
                    </svg>
                    Unconfirmed
                  </span>
                <% end %>
              </div>
            </div>
            
            <div class="mt-4 sm:mt-0">
              <%= link_to edit_admin_user_path(id: @user.id),
                  class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors" do %>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
                Edit User
              <% end %>
            </div>
          </div>
          
          <!-- Inline Statistics -->
          <div class="flex flex-wrap items-center gap-6 text-sm">
            <!-- User ID -->
            <div class="flex items-center">
              <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center mr-3">
                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a1.994 1.994 0 01-1.414.586H7a1 1 0 01-1-1V3a1 1 0 011-1z"/>
                </svg>
              </div>
              <div>
                <span class="font-semibold text-gray-900">ID: <%= @user.id %></span>
                <span class="text-gray-500">User Identifier</span>
              </div>
            </div>

            <!-- School Claims -->
            <div class="flex items-center">
              <div class="w-2 h-2 bg-green-500 rounded-full mr-2"></div>
              <span class="text-gray-900 font-medium"><%= @user.school_claims.count %></span>
              <span class="text-gray-500 ml-1">Total Claims</span>
            </div>

            <!-- Approved Claims -->
            <div class="flex items-center">
              <div class="w-2 h-2 bg-emerald-500 rounded-full mr-2"></div>
              <span class="text-gray-900 font-medium"><%= @user.school_claims.where(status: 'approved').count %></span>
              <span class="text-gray-500 ml-1">Approved</span>
            </div>

            <!-- Pending Claims -->
            <div class="flex items-center">
              <div class="w-2 h-2 bg-yellow-500 rounded-full mr-2"></div>
              <span class="text-gray-900 font-medium"><%= @user.school_claims.where(status: 'pending').count %></span>
              <span class="text-gray-500 ml-1">Pending</span>
            </div>

            <!-- Member Since -->
            <div class="flex items-center">
              <div class="w-2 h-2 bg-gray-500 rounded-full mr-2"></div>
              <span class="text-gray-900 font-medium"><%= @user.created_at.strftime("%B %Y") %></span>
              <span class="text-gray-500 ml-1">Member Since</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Basic Information -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-6">
          <h2 class="text-xl font-semibold text-gray-900 mb-6">Basic Information</h2>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Email -->
            <div>
              <label class="block text-sm font-medium text-gray-700">Email Address</label>
              <p class="mt-1 text-sm text-gray-900"><%= @user.email %></p>
            </div>
            
            <!-- User ID -->
            <div>
              <label class="block text-sm font-medium text-gray-700">User ID</label>
              <p class="mt-1 text-sm text-gray-900"><%= @user.id %></p>
            </div>

            <!-- Role -->
            <div>
              <label class="block text-sm font-medium text-gray-700">Role</label>
              <p class="mt-1 text-sm text-gray-900"><%= @user.role.humanize %></p>
            </div>

            <!-- Confirmation Status -->
            <div>
              <label class="block text-sm font-medium text-gray-700">Account Status</label>
              <% if @user.confirmed_at.present? %>
                <p class="mt-1 text-sm text-gray-900">
                  Confirmed on <%= @user.confirmed_at.strftime("%B %d, %Y") %>
                </p>
              <% else %>
                <p class="mt-1 text-sm text-amber-600 font-medium">Not confirmed</p>
                <% if @user.confirmation_sent_at.present? %>
                  <p class="text-xs text-gray-500">
                    Confirmation sent <%= time_ago_in_words(@user.confirmation_sent_at) %> ago
                  </p>
                <% end %>
              <% end %>
            </div>

            <!-- Created At -->
            <div>
              <label class="block text-sm font-medium text-gray-700">Joined</label>
              <p class="mt-1 text-sm text-gray-900">
                <%= @user.created_at.strftime("%B %d, %Y") %>
              </p>
              <p class="text-xs text-gray-500">
                <%= time_ago_in_words(@user.created_at) %> ago
              </p>
            </div>

            <!-- Last Updated -->
            <div>
              <label class="block text-sm font-medium text-gray-700">Last Updated</label>
              <p class="mt-1 text-sm text-gray-900">
                <%= @user.updated_at.strftime("%B %d, %Y") %>
              </p>
              <p class="text-xs text-gray-500">
                <%= time_ago_in_words(@user.updated_at) %> ago
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- School Claims -->
      <% if @school_claims.any? %>
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
          <div class="px-6 py-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-6">School Claims</h2>

            <div class="space-y-4">
              <% @school_claims.each do |claim| %>
                <div class="border border-gray-200 rounded-lg p-4">
                  <div class="flex items-center justify-between">
                    <div class="flex-1">
                      <div class="flex items-center space-x-3">
                        <h3 class="text-base font-medium text-gray-900">
                          <%= link_to claim.school.name, admin_school_path(id: claim.school.id), 
                              class: "text-blue-600 hover:text-blue-700" %>
                        </h3>
                        <% case claim.status %>
                        <% when 'pending' %>
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                            Pending
                          </span>
                        <% when 'approved' %>
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                            Approved
                          </span>
                        <% when 'rejected' %>
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                            Rejected
                          </span>
                        <% when 'revoked' %>
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                            Revoked
                          </span>
                        <% end %>
                      </div>
                      <div class="mt-1 text-sm text-gray-500">
                        Submitted <%= time_ago_in_words(claim.created_at) %> ago
                        <% if claim.school.respond_to?(:display_address) && claim.school.display_address.present? %>
                          • <%= claim.school.display_address %>
                        <% end %>
                      </div>
                    </div>
                    <div class="flex-shrink-0">
                      <%= link_to admin_school_claim_path(id: claim.id),
                          class: "inline-flex items-center px-3 py-1.5 border border-gray-300 shadow-sm text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
                        <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                        </svg>
                        View Claim
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
<% content_for :title, "Import from Google Maps" %>


<!-- Main Content -->
  <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
    <div class="space-y-8">
      <!-- Breadcrumb -->
      <nav class="flex" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <li class="inline-flex items-center">
            <%= link_to admin_root_path, class: "inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600" do %>
              <svg class="w-3 h-3 mr-2.5" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20">
                <path d="m19.707 9.293-2-2-7-7a1 1 0 0 0-1.414 0l-7 7-2 2a1 1 0 0 0 1.414 1.414L2 10.414V18a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-7.586l.293.293a1 1 0 0 0 1.414-1.414Z"/>
              </svg>
              Admin Dashboard
            <% end %>
          </li>
          <li aria-current="page">
            <div class="flex items-center">
              <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
              </svg>
              <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2">Import from Google Maps</span>
            </div>
          </li>
        </ol>
      </nav>

      <!-- Page Header -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-6">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center">
                <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
                </svg>
              </div>
            </div>
            <div class="ml-4">
              <h1 class="text-3xl font-bold text-gray-900">Import from Google Maps</h1>
              <p class="mt-2 text-sm text-gray-600">Convert Google Maps locations into school entries automatically</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Flash Messages -->
      <% if flash[:notice] %>
        <div class="rounded-md bg-green-50 p-4 border border-green-200">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div class="ml-3">
              <p class="text-sm font-medium text-green-800"><%= flash[:notice] %></p>
            </div>
          </div>
        </div>
      <% end %>

      <% if flash[:alert] %>
        <div class="rounded-md bg-red-50 p-4 border border-red-200">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div class="ml-3">
              <p class="text-sm font-medium text-red-800"><%= flash[:alert] %></p>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Instructions Card -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-6">
          <div class="flex items-start">
            <div class="flex-shrink-0">
              <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
            </div>
            <div class="ml-4 flex-1">
              <h3 class="text-lg font-medium text-gray-900 mb-3">Supported URL Formats</h3>
              <div class="space-y-4">
                <div class="border border-gray-200 rounded-lg p-4 bg-gray-50">
                  <div class="font-medium text-gray-900 mb-1">Place URLs</div>
                  <code class="text-sm text-blue-600 bg-blue-50 px-2 py-1 rounded break-all">https://www.google.com/maps/place/School+Name/@14.123,100.456,17z/...</code>
                  <p class="text-sm text-gray-600 mt-2">Direct links to specific places from Google Maps</p>
                </div>
                
                <div class="border border-gray-200 rounded-lg p-4 bg-gray-50">
                  <div class="font-medium text-gray-900 mb-1">Search URLs</div>
                  <code class="text-sm text-blue-600 bg-blue-50 px-2 py-1 rounded break-all">https://www.google.com/maps/search/school+name/@14.123,100.456,15z/...</code>
                  <p class="text-sm text-gray-600 mt-2">Search result URLs with location data</p>
                </div>
                
                <div class="border border-gray-200 rounded-lg p-4 bg-gray-50">
                  <div class="font-medium text-gray-900 mb-1">Share URLs</div>
                  <code class="text-sm text-blue-600 bg-blue-50 px-2 py-1 rounded break-all">https://maps.app.goo.gl/ABC123...</code>
                  <p class="text-sm text-gray-600 mt-2">Shortened URLs from the Google Maps share feature</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Import Form -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-6">
          <h3 class="text-lg font-medium text-gray-900 mb-6">Import Location</h3>
          
          <%= form_with url: admin_google_map_imports_path, method: :post, local: true, class: "space-y-6" do |form| %>
            <div>
              <%= form.label :google_maps_url, "Google Maps URL", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.text_field :google_maps_url, 
                  value: params[:google_maps_url],
                  placeholder: "https://www.google.com/maps/search/school+name/@14.1234,100.5678,15z/...",
                  class: "block w-full px-3 py-3 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-base",
                  required: true %>
              <p class="mt-2 text-sm text-gray-600">
                Paste the complete Google Maps URL here. The system will extract the place ID and import all available information.
              </p>
            </div>

            <div class="flex items-center justify-between pt-6 border-t border-gray-200">
              <div class="flex space-x-3">
                <%= form.submit "Import Place", 
                    class: "inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" %>
                <%= link_to admin_root_path, 
                    class: "inline-flex items-center px-6 py-3 border border-gray-300 text-base font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                  Cancel
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Import Process Info -->
      <div class="bg-amber-50 border border-amber-200 rounded-xl shadow-sm">
        <div class="px-6 py-6">
          <div class="flex items-start">
            <div class="flex-shrink-0">
              <div class="w-10 h-10 bg-amber-100 rounded-full flex items-center justify-center">
                <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                </svg>
              </div>
            </div>
            <div class="ml-4 flex-1">
              <h3 class="text-lg font-medium text-amber-800 mb-4">Import Process</h3>
              <div class="space-y-3">
                <div class="flex items-start">
                  <div class="flex-shrink-0 w-6 h-6 bg-amber-100 rounded-full flex items-center justify-center mr-3 mt-0.5">
                    <span class="text-xs font-medium text-amber-700">1</span>
                  </div>
                  <div>
                    <div class="font-medium text-amber-800">Extract Place ID</div>
                    <p class="text-sm text-amber-700">Parse the Google Maps URL to find the unique place identifier</p>
                  </div>
                </div>
                
                <div class="flex items-start">
                  <div class="flex-shrink-0 w-6 h-6 bg-amber-100 rounded-full flex items-center justify-center mr-3 mt-0.5">
                    <span class="text-xs font-medium text-amber-700">2</span>
                  </div>
                  <div>
                    <div class="font-medium text-amber-800">Fetch Place Data</div>
                    <p class="text-sm text-amber-700">Contact Google Places API to get complete information</p>
                  </div>
                </div>
                
                <div class="flex items-start">
                  <div class="flex-shrink-0 w-6 h-6 bg-amber-100 rounded-full flex items-center justify-center mr-3 mt-0.5">
                    <span class="text-xs font-medium text-amber-700">3</span>
                  </div>
                  <div>
                    <div class="font-medium text-amber-800">Create Place Record</div>
                    <p class="text-sm text-amber-700">Store location data, ratings, photos, and reviews</p>
                  </div>
                </div>
                
                <div class="flex items-start">
                  <div class="flex-shrink-0 w-6 h-6 bg-amber-100 rounded-full flex items-center justify-center mr-3 mt-0.5">
                    <span class="text-xs font-medium text-amber-700">4</span>
                  </div>
                  <div>
                    <div class="font-medium text-amber-800">Generate School</div>
                    <p class="text-sm text-amber-700">Convert place data into a school entry with proper address structure</p>
                  </div>
                </div>
                
                <div class="flex items-start">
                  <div class="flex-shrink-0 w-6 h-6 bg-amber-100 rounded-full flex items-center justify-center mr-3 mt-0.5">
                    <span class="text-xs font-medium text-amber-700">5</span>
                  </div>
                  <div>
                    <div class="font-medium text-amber-800">Ready for Review</div>
                    <p class="text-sm text-amber-700">New school starts in 'draft' status for admin review and editing</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<% content_for :title, "Import from Google Maps" %>

<!-- Main Content -->
<div class="w-full py-8">
  <div class="space-y-8 px-4 sm:px-6 lg:px-8">

      <!-- Page Header with Inline Info -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-6">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6">
            <div>
              <h1 class="text-3xl font-bold text-gray-900">Import from Google Maps</h1>
              <p class="mt-2 text-sm text-gray-600">Convert Google Maps locations into school entries automatically</p>
            </div>
          </div>
          
          <!-- Inline Process Info -->
          <div class="flex flex-wrap items-center gap-6 text-sm">
            <!-- Process Steps -->
            <div class="flex items-center">
              <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center mr-3">
                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
                </svg>
              </div>
              <div>
                <span class="font-semibold text-gray-900">5-Step Process</span>
                <span class="text-gray-500">Automated Import</span>
              </div>
            </div>

            <!-- Supported Formats -->
            <div class="flex items-center">
              <div class="w-2 h-2 bg-green-500 rounded-full mr-2"></div>
              <span class="text-gray-900 font-medium">Place URLs</span>
              <span class="text-gray-500 ml-1">Direct links</span>
            </div>

            <div class="flex items-center">
              <div class="w-2 h-2 bg-blue-500 rounded-full mr-2"></div>
              <span class="text-gray-900 font-medium">Search URLs</span>
              <span class="text-gray-500 ml-1">With location data</span>
            </div>

            <div class="flex items-center">
              <div class="w-2 h-2 bg-purple-500 rounded-full mr-2"></div>
              <span class="text-gray-900 font-medium">Share URLs</span>
              <span class="text-gray-500 ml-1">Shortened links</span>
            </div>

            <!-- Result Info -->
            <div class="flex items-center">
              <svg class="w-4 h-4 text-amber-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
              </svg>
              <span class="text-gray-700 font-medium">Creates draft school</span>
              <span class="text-gray-600 ml-1">for review</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Flash Messages -->
      <% if flash[:notice] %>
        <div class="rounded-md bg-green-50 p-4 border border-green-200">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div class="ml-3">
              <p class="text-sm font-medium text-green-800"><%= flash[:notice] %></p>
            </div>
          </div>
        </div>
      <% end %>

      <% if flash[:alert] %>
        <div class="rounded-md bg-red-50 p-4 border border-red-200">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div class="ml-3">
              <p class="text-sm font-medium text-red-800"><%= flash[:alert] %></p>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Import Form -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-6">
          <h3 class="text-lg font-medium text-gray-900 mb-6">Import Location</h3>
          
          <%= form_with url: admin_google_map_imports_path, method: :post, local: true, class: "space-y-6" do |form| %>
            <div>
              <%= form.label :google_maps_url, "Google Maps URL", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.text_field :google_maps_url, 
                  value: params[:google_maps_url],
                  placeholder: "https://www.google.com/maps/search/school+name/@14.1234,100.5678,15z/...",
                  class: "block w-full px-3 py-3 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-base",
                  required: true %>
              <p class="mt-2 text-sm text-gray-600">
                Paste any Google Maps URL (place, search, or share link). The system will extract place data and create a school entry for review.
              </p>
            </div>

            <div class="flex items-center justify-between pt-6 border-t border-gray-200">
              <div class="flex space-x-3">
                <%= form.submit "Import Place", 
                    class: "inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" %>
                <%= link_to admin_root_path, 
                    class: "inline-flex items-center px-6 py-3 border border-gray-300 text-base font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
                  Cancel
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- URL Format Examples -->
      <div class="bg-gray-50 border border-gray-200 rounded-xl shadow-sm">
        <div class="px-6 py-6">
          <h3 class="text-lg font-medium text-gray-900 mb-4">Supported URL Formats</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="text-center p-4 bg-white rounded-lg border border-gray-200">
              <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center mx-auto mb-3">
                <div class="w-2 h-2 bg-green-500 rounded-full"></div>
              </div>
              <div class="font-medium text-gray-900 mb-2">Place URLs</div>
              <code class="text-xs text-gray-600 break-all">.../place/School+Name/@...</code>
            </div>
            
            <div class="text-center p-4 bg-white rounded-lg border border-gray-200">
              <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center mx-auto mb-3">
                <div class="w-2 h-2 bg-blue-500 rounded-full"></div>
              </div>
              <div class="font-medium text-gray-900 mb-2">Search URLs</div>
              <code class="text-xs text-gray-600 break-all">.../search/school+name/@...</code>
            </div>
            
            <div class="text-center p-4 bg-white rounded-lg border border-gray-200">
              <div class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center mx-auto mb-3">
                <div class="w-2 h-2 bg-purple-500 rounded-full"></div>
              </div>
              <div class="font-medium text-gray-900 mb-2">Share URLs</div>
              <code class="text-xs text-gray-600 break-all">maps.app.goo.gl/ABC123</code>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
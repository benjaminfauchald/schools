<% content_for :title, "Claim Submitted - #{@temp_claim.school.name}" %>

<div class="max-w-2xl mx-auto">
  <!-- Success Header -->
  <div class="text-center mb-8">
    <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-green-100 mb-4">
      <svg class="h-6 w-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
    </div>
    <h1 class="text-3xl font-bold text-gray-900 mb-2">Claim Submitted!</h1>
    <p class="text-lg text-gray-600">
      Your claim for <strong><%= @temp_claim.school.name %></strong> has been received.
    </p>
  </div>

  <!-- Next Steps Card -->
  <div class="bg-white border border-gray-200 rounded-lg p-6 mb-8">
    <h2 class="text-lg font-medium text-gray-900 mb-4">Next Steps</h2>
    
    <div class="space-y-4">
      <div class="flex items-start">
        <div class="flex-shrink-0 w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
          <span class="text-sm font-medium text-blue-600">1</span>
        </div>
        <div class="ml-4">
          <h3 class="text-sm font-medium text-gray-900">Complete Your Registration</h3>
          <p class="text-sm text-gray-600">Create your account to proceed with the claim process.</p>
        </div>
      </div>
      
      <div class="flex items-start">
        <div class="flex-shrink-0 w-8 h-8 bg-gray-100 rounded-full flex items-center justify-center">
          <span class="text-sm font-medium text-gray-600">2</span>
        </div>
        <div class="ml-4">
          <h3 class="text-sm font-medium text-gray-900">Verify Your Email</h3>
          <p class="text-sm text-gray-600">Confirm your email address to activate your account.</p>
        </div>
      </div>
      
      <div class="flex items-start">
        <div class="flex-shrink-0 w-8 h-8 bg-gray-100 rounded-full flex items-center justify-center">
          <span class="text-sm font-medium text-gray-600">3</span>
        </div>
        <div class="ml-4">
          <h3 class="text-sm font-medium text-gray-900">Wait for Approval</h3>
          <p class="text-sm text-gray-600">Our team will review your claim within 3-5 business days.</p>
        </div>
      </div>
      
      <div class="flex items-start">
        <div class="flex-shrink-0 w-8 h-8 bg-gray-100 rounded-full flex items-center justify-center">
          <span class="text-sm font-medium text-gray-600">4</span>
        </div>
        <div class="ml-4">
          <h3 class="text-sm font-medium text-gray-900">Start Managing</h3>
          <p class="text-sm text-gray-600">Once approved, you can update your school's information.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Claim Details -->
  <div class="bg-white border border-gray-200 rounded-lg p-6 mb-8">
    <h3 class="text-lg font-medium text-gray-900 mb-4">Claim Details</h3>
    
    <div class="space-y-3">
      <div class="flex justify-between">
        <span class="text-sm font-medium text-gray-500">School:</span>
        <span class="text-sm text-gray-900"><%= @temp_claim.school.name %></span>
      </div>
      
      <div class="flex justify-between">
        <span class="text-sm font-medium text-gray-500">Email:</span>
        <span class="text-sm text-gray-900"><%= @temp_claim.email %></span>
      </div>
      
      <div class="flex justify-between">
        <span class="text-sm font-medium text-gray-500">Submitted:</span>
        <span class="text-sm text-gray-900"><%= @temp_claim.created_at.strftime("%B %d, %Y at %I:%M %p") %></span>
      </div>
      
      <div class="flex justify-between">
        <span class="text-sm font-medium text-gray-500">Expires:</span>
        <span class="text-sm text-gray-900"><%= @temp_claim.expires_at.strftime("%B %d, %Y at %I:%M %p") %></span>
      </div>
    </div>
  </div>

  <!-- Registration CTA -->
  <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 rounded-lg p-6 mb-8">
    <div class="text-center">
      <h3 class="text-lg font-medium text-blue-900 mb-2">Ready to Continue?</h3>
      <p class="text-blue-700 mb-4">
        Create your account now to proceed with your school claim.
      </p>
      <%= form_with url: complete_anonymous_claim_path(@temp_claim.token), method: :post, local: true do |form| %>
        <%= form.submit "Create Account", 
            class: "inline-flex items-center px-6 py-3 border border-transparent rounded-md shadow-sm text-base font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
      <% end %>
    </div>
  </div>

  <!-- Important Notes -->
  <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
    <div class="flex">
      <div class="flex-shrink-0">
        <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
      </div>
      <div class="ml-3">
        <h3 class="text-sm font-medium text-yellow-800">Important</h3>
        <div class="mt-2 text-sm text-yellow-700">
          <ul class="list-disc space-y-1 pl-5">
            <li>This claim will expire in 24 hours if you don't complete registration</li>
            <li>Save this page URL or bookmark it to return later</li>
            <li>You'll receive email updates about your claim status</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer Links -->
  <div class="text-center mt-8">
    <div class="space-x-4">
      <%= link_to "Back to School", school_path(@temp_claim.school), 
          class: "text-sm text-blue-600 hover:text-blue-800" %>
      <span class="text-gray-300">|</span>
      <%= link_to "Browse Schools", root_path, 
          class: "text-sm text-blue-600 hover:text-blue-800" %>
    </div>
  </div>
</div>
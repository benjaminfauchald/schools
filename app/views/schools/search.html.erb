<% content_for :title, "Search Results for '#{@query}' - Schools Listing" %>

<% content_for :head do %>
  <meta name="description" content="Search results for '#{@query}' in Bangkok international schools. Find schools matching your search criteria with detailed information.">
  <meta name="robots" content="noindex, follow">
  
  <!-- Canonical URL -->
  <link rel="canonical" href="<%= request.base_url + request.path %>">
<% end %>

<!-- Search Results Page -->
<div class="w-full">
  
  <!-- Header Section -->
  <div class="mb-8">
    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">Search Results</h1>
      <p class="text-lg text-gray-600 dark:text-gray-300">
        <% if @search_results.any? %>
          Found <%= @search_results.count %> schools matching "<%= @query %>"
        <% else %>
          No schools found matching "<%= @query %>"
        <% end %>
      </p>
    </div>
  </div>

  <!-- Search Form -->
  <div class="mb-8">
    <div class="max-w-2xl mx-auto">
      <%= form_with url: search_schools_path, method: :get, local: true, class: "flex gap-4" do |form| %>
        <%= form.text_field :q, value: @query, placeholder: "Search for schools...", 
            class: "flex-1 px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
        <%= form.hidden_field :home_lat, value: params[:home_lat] %>
        <%= form.hidden_field :home_lng, value: params[:home_lng] %>
        <%= form.submit "Search", 
            class: "px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 focus:ring-2 focus:ring-blue-500 transition-colors" %>
      <% end %>
    </div>
  </div>

  <!-- Results -->
  <% if @search_results.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
      <% @search_results.each do |school_data| %>
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300">
          <div class="p-6">
            <div class="flex items-start justify-between mb-4">
              <h2 class="text-lg font-bold text-gray-900 dark:text-white leading-tight">
                <%= link_to school_data[:name], school_data[:url], 
                    class: "text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 transition-colors" %>
              </h2>
              <span class="inline-flex items-center px-2 py-1 bg-green-100 text-green-800 text-xs font-medium rounded-full">
                <%= school_data[:distance_km] %>km
              </span>
            </div>
            
            <% if school_data[:address].present? %>
              <div class="flex items-start mb-4">
                <svg class="w-4 h-4 text-gray-400 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                </svg>
                <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
                  <%= school_data[:address] %>
                </p>
              </div>
            <% end %>
            
            <div class="flex items-center justify-between pt-4 border-t border-gray-100 dark:border-gray-700">
              <%= link_to school_data[:url], 
                  class: "inline-flex items-center text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 transition-colors" do %>
                View Details
                <svg class="w-4 h-4 ml-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                </svg>
              <% end %>
              
              <span class="text-xs text-gray-500">
                <%= school_data[:distance_km] %> km away
              </span>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- No Results -->
    <div class="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg p-8 text-center">
      <svg class="mx-auto h-12 w-12 text-yellow-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z" />
      </svg>
      <h2 class="text-lg font-medium text-yellow-900 dark:text-yellow-100 mb-2">
        No schools found
      </h2>
      <p class="text-yellow-700 dark:text-yellow-200 mb-4">
        We couldn't find any schools matching "<%= @query %>". Try adjusting your search terms or browse all schools.
      </p>
      <%= link_to "Browse All Schools", root_path, 
          class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-yellow-600 hover:bg-yellow-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-yellow-500 transition-colors" %>
    </div>
  <% end %>

  <!-- Back to Home -->
  <div class="mt-8 text-center">
    <%= link_to root_path, class: "inline-flex items-center text-blue-600 hover:text-blue-800 transition-colors" do %>
      <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"></path>
      </svg>
      Back to All Schools
    <% end %>
  </div>
  
</div>
<div class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden">
  <%= render Schools::SectionHeaderComponent.new(
        title: "Video Gallery",
        icon: "play",
        subtitle: "Campus videos and virtual tours"
      ) %>

  <div class="px-6 pb-6">
    
    <!-- Video Count Summary -->
    <div class="mb-6 p-4 bg-gradient-to-r from-blue-50 to-cyan-50 dark:from-blue-900/20 dark:to-cyan-900/20 rounded-lg border border-blue-200 dark:border-blue-800">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-lg font-semibold text-blue-800 dark:text-blue-200">
            Campus Videos
          </h3>
          <p class="text-sm text-blue-600 dark:text-blue-400 mt-1">
            Explore our facilities and campus life through video
          </p>
        </div>
        <div class="text-right">
          <div class="text-2xl font-bold text-blue-700 dark:text-blue-300">
            <%= video_count %>
          </div>
          <div class="text-sm text-blue-600 dark:text-blue-400">
            <%= video_count == 1 ? 'video' : 'videos' %>
          </div>
        </div>
      </div>
    </div>

    <!-- Video Grid or Error Message -->
    <% if videos.any? %>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        <% videos.each_with_index do |video, index| %>
          <div class="group relative aspect-video overflow-hidden rounded-lg bg-gray-100 dark:bg-gray-700 cursor-pointer hover:ring-2 hover:ring-blue-500 hover:ring-offset-2 transition-all duration-200"
               onclick="openVideoModal(<%= index %>)">
          
          <!-- Video Thumbnail -->
          <img src="<%= youtube_thumbnail_url(video) %>" 
               alt="<%= video_title(video) %>"
               class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
               loading="<%= index < 4 ? 'eager' : 'lazy' %>">
          
          <!-- Play Button Overlay -->
          <div class="absolute inset-0 bg-black bg-opacity-20 group-hover:bg-opacity-30 transition-opacity duration-200 flex items-center justify-center">
            <div class="bg-red-600 hover:bg-red-700 rounded-full p-3 group-hover:scale-110 transition-transform duration-200 shadow-lg">
              <%= helpers.heroicon('play', css_class: 'w-6 h-6 text-white fill-current') %>
            </div>
          </div>
          
          <!-- Video number badge -->
          <div class="absolute top-2 left-2 bg-black bg-opacity-60 text-white text-xs px-2 py-1 rounded">
            <%= index + 1 %>
          </div>
          
          <!-- Video duration badge (if available) -->
          <% if video[:duration] || video['duration'] %>
            <div class="absolute bottom-2 right-2 bg-black bg-opacity-80 text-white text-xs px-2 py-1 rounded">
              <%= video[:duration] || video['duration'] %>
            </div>
          <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <!-- No Videos Available Message -->
      <div class="text-center py-12 bg-gray-50 rounded-lg border-2 border-dashed border-gray-300">
        <div class="mx-auto max-w-md">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">Videos temporarily unavailable</h3>
          <p class="mt-1 text-sm text-gray-500">
            We're working to restore access to our video content. Please check back later.
          </p>
        </div>
      </div>
    <% end %>

    <!-- View All Button -->
    <% if videos.count > 8 %>
      <div class="mt-6 text-center">
        <button onclick="openVideoModal(0)" 
                class="inline-flex items-center px-6 py-3 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors duration-200">
          <%= helpers.heroicon('play', css_class: 'w-4 h-4 mr-2') %>
          View All <%= videos.count %> Videos
        </button>
      </div>
    <% end %>

  </div>
</div>

<!-- Video Modal -->
<div id="<%= modal_id %>" class="fixed inset-0 z-[9999] hidden bg-black bg-opacity-90" role="dialog" aria-modal="true">
  
  <!-- Backdrop -->
  <div class="absolute inset-0" onclick="closeVideoModal()"></div>

  <!-- Modal Content -->
  <div class="absolute inset-0 overflow-y-auto">
    <div class="flex min-h-full items-center justify-center p-6 sm:p-8">
      
      <div class="relative w-full max-w-6xl bg-gray-900 rounded-lg shadow-xl" onclick="event.stopPropagation()" style="width: 75vw; max-width: 1050px;">
        
        <!-- Header -->
        <div class="flex items-center justify-between p-4 border-b border-gray-700">
          <!-- Video Counter -->
          <div class="flex items-center text-white">
            <svg class="w-5 h-5 mr-2 text-blue-400" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"/>
            </svg>
            <span class="text-sm font-medium">
              Video <span id="current-video-number">1</span> of <%= videos.count %>
            </span>
          </div>
          
          <!-- Close Button -->
          <button onclick="closeVideoModal()" 
                  class="rounded-md bg-gray-800 p-2 text-gray-400 hover:bg-gray-700 hover:text-white transition-colors"
                  aria-label="Close modal">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Video Container -->
        <div class="relative bg-black rounded-lg overflow-hidden">
          <!-- Navigation Buttons -->
          <% if videos.count > 1 %>
            <button onclick="previousVideo()" 
                    class="absolute left-6 top-1/2 z-10 transform -translate-y-1/2 bg-black bg-opacity-70 hover:bg-opacity-90 rounded-full p-4 text-white transition-all shadow-lg"
                    aria-label="Previous video">
              <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
              </svg>
            </button>
            
            <button onclick="nextVideo()" 
                    class="absolute right-6 top-1/2 z-10 transform -translate-y-1/2 bg-black bg-opacity-70 hover:bg-opacity-90 rounded-full p-4 text-white transition-all shadow-lg"
                    aria-label="Next video">
              <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
              </svg>
            </button>
          <% end %>
          
          <!-- Video Player - Full Width -->
          <div class="w-full" style="aspect-ratio: 16/9; min-height: 450px;">
            <iframe id="modal-video" 
                    src="" 
                    class="w-full h-full"
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen>
            </iframe>
          </div>
        </div>

        <!-- Video Information -->
        <div class="p-6 border-t border-gray-700">
          <h3 id="modal-video-title" class="text-xl font-semibold text-white mb-3"></h3>
          <p id="modal-video-description" class="text-gray-300 text-base mb-4 leading-relaxed"></p>
          
          <!-- Keyboard Shortcuts -->
          <div class="flex items-center space-x-6 text-sm text-gray-400">
            <div class="flex items-center">
              <kbd class="px-3 py-2 bg-gray-800 rounded text-sm font-medium">ESC</kbd>
              <span class="ml-2">Close</span>
            </div>
            <% if videos.count > 1 %>
              <div class="flex items-center">
                <kbd class="px-3 py-2 bg-gray-800 rounded text-sm font-medium">←</kbd>
                <span class="ml-2">Previous</span>
              </div>
              <div class="flex items-center">
                <kbd class="px-3 py-2 bg-gray-800 rounded text-sm font-medium">→</kbd>
                <span class="ml-2">Next</span>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- JavaScript for Video Modal -->
<script>
  const videos = <%= raw videos.to_json %>;
  let currentVideoIndex = 0;
  
  function openVideoModal(index) {
    currentVideoIndex = index;
    updateModalVideo();
    document.getElementById('<%= modal_id %>').classList.remove('hidden');
    document.body.classList.add('overflow-hidden');
  }
  
  function closeVideoModal() {
    // Stop the video by clearing the iframe src
    document.getElementById('modal-video').src = '';
    document.getElementById('<%= modal_id %>').classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
  }
  
  function nextVideo() {
    currentVideoIndex = (currentVideoIndex + 1) % videos.length;
    updateModalVideo();
  }
  
  function previousVideo() {
    currentVideoIndex = (currentVideoIndex - 1 + videos.length) % videos.length;
    updateModalVideo();
  }
  
  function updateModalVideo() {
    const video = videos[currentVideoIndex];
    const videoId = video.video_id || video['video_id'];
    const embedUrl = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
    
    document.getElementById('modal-video').src = embedUrl;
    document.getElementById('modal-video-title').textContent = video.title || video['title'] || 'Video';
    document.getElementById('modal-video-description').textContent = video.description || video['description'] || '';
    document.getElementById('current-video-number').textContent = currentVideoIndex + 1;
  }
  
  // Keyboard navigation
  document.addEventListener('keydown', function(e) {
    const modal = document.getElementById('<%= modal_id %>');
    if (modal && !modal.classList.contains('hidden')) {
      e.preventDefault();
      if (e.key === 'Escape') {
        closeVideoModal();
      } else if (e.key === 'ArrowRight') {
        nextVideo();
      } else if (e.key === 'ArrowLeft') {
        previousVideo();
      }
    }
  });
</script>
<div class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden h-full flex flex-col">
  <%= render Schools::SectionHeaderComponent.new(
        title: "Academic Programs",
        icon: "academic-cap",
        subtitle: "Curriculum, accreditations, and educational offerings"
      ) %>

  <div class="px-6 pb-6 flex-1">
    <div class="space-y-8">
      
      <!-- Curriculum Section with Grouping -->
      <% if curricula.any? %>
        <div>
          <div class="flex items-center mb-4">
            <%= section_icon_svg('academic-cap') %>
            <h3 class="ml-2 text-lg font-medium text-gray-900 dark:text-white">
              Curriculum Programs
            </h3>
          </div>
          
          <% curriculum_groups.each do |group_name, group_curricula| %>
            <div class="mb-4 last:mb-0">
              <h4 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                <%= group_name %>
              </h4>
              <div class="flex flex-wrap gap-2">
                <% group_curricula.each do |curriculum| %>
                  <%= render Schools::TagBadgeComponent.new(term: curriculum, variant: :curriculum) %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

      <!-- Other Program Sections -->
      <% program_sections.reject { |s| s[:title] == 'Curriculum' }.each do |section| %>
        <div>
          <div class="flex items-center mb-4">
            <%= section_icon_svg(section[:icon]) %>
            <div class="ml-2">
              <h3 class="text-lg font-medium text-gray-900 dark:text-white">
                <%= section[:title] %>
              </h3>
              <% if section[:description] %>
                <p class="text-sm text-gray-600 dark:text-gray-400">
                  <%= section[:description] %>
                </p>
              <% end %>
            </div>
          </div>

          <div class="flex flex-wrap gap-2">
            <% section[:items].each do |item| %>
              <%= render Schools::TagBadgeComponent.new(term: item, variant: section[:variant]) %>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Summary Stats -->
      <% if has_any_programs? %>
        <div class="bg-blue-50 dark:bg-blue-900/20 rounded-lg p-4 border border-blue-200 dark:border-blue-800">
          <div class="flex flex-wrap justify-center gap-4 text-center">
            <% if curricula.any? %>
              <div class="w-32 p-3">
                <div class="text-2xl font-bold text-blue-600 dark:text-blue-400">
                  <%= curricula.count %>
                </div>
                <div class="text-xs text-blue-600 dark:text-blue-400 uppercase tracking-wider">
                  Curriculum Programs
                </div>
              </div>
            <% end %>

            <% if accreditations.any? %>
              <div class="w-32 p-3">
                <div class="text-2xl font-bold text-green-600 dark:text-green-400">
                  <%= accreditations.count %>
                </div>
                <div class="text-xs text-green-600 dark:text-green-400 uppercase tracking-wider">
                  Accreditations
                </div>
              </div>
            <% end %>

            <% if languages.any? %>
              <div class="w-32 p-3">
                <div class="text-2xl font-bold text-pink-600 dark:text-pink-400">
                  <%= languages.count %>
                </div>
                <div class="text-xs text-pink-600 dark:text-pink-400 uppercase tracking-wider">
                  Languages
                </div>
              </div>
            <% end %>

            <% if programs.any? %>
              <div class="w-32 p-3">
                <div class="text-2xl font-bold text-yellow-600 dark:text-yellow-400">
                  <%= programs.count %>
                </div>
                <div class="text-xs text-yellow-600 dark:text-yellow-400 uppercase tracking-wider">
                  Special Programs
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

    </div>
  </div>
</div>
<div class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden h-full flex flex-col">
  <%= render Schools::SectionHeaderComponent.new(
        title: "Map & Directions",
        icon: "map",
        subtitle: "Interactive map with live routing and travel times"
      ) %>

  <div class="px-6 pb-6 flex-1 flex flex-col">
    
    <!-- Travel Info Summary -->
    <div id="<%= travel_info_id %>" class="mb-4 p-4 bg-gradient-to-r from-green-50 to-blue-50 dark:from-green-900/20 dark:to-blue-900/20 rounded-lg border border-green-200 dark:border-green-800">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-lg font-semibold text-green-800 dark:text-green-200">
            <span id="travel-status">Getting your location...</span>
          </h3>
          <p class="text-sm text-green-600 dark:text-green-400 mt-1">
            <span id="travel-details">Allow location access for directions and travel time</span>
          </p>
        </div>
        <div class="text-right">
          <div id="travel-time" class="text-2xl font-bold text-green-700 dark:text-green-300">
            --
          </div>
          <div class="text-sm text-green-600 dark:text-green-400">
            <span id="travel-distance">calculating...</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Map Container -->
    <div class="relative">
      <div id="<%= map_id %>" class="w-full h-96 rounded-lg border-2 border-gray-200 dark:border-gray-600"></div>
      
      <!-- Map Controls -->
      <div class="absolute top-4 right-4 space-y-2">
        <button onclick="centerOnSchool()" 
                class="bg-white dark:bg-gray-800 shadow-lg rounded-lg p-2 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
                title="Center on School">
          <%= helpers.heroicon('academic-cap', css_class: 'w-5 h-5 text-blue-600 dark:text-blue-400') %>
        </button>
        <button onclick="centerOnUser()" 
                class="bg-white dark:bg-gray-800 shadow-lg rounded-lg p-2 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
                title="Center on My Location">
          <%= helpers.heroicon('map-pin', css_class: 'w-5 h-5 text-green-600 dark:text-green-400') %>
        </button>
        <button onclick="showDirections()" 
                class="bg-blue-600 hover:bg-blue-700 shadow-lg rounded-lg p-2 text-white transition-colors"
                title="Get Directions">
          <%= helpers.heroicon('arrow-top-right-on-square', css_class: 'w-5 h-5') %>
        </button>
      </div>
      
      <!-- Loading Indicator -->
      <div id="map-loading" class="absolute inset-0 bg-white bg-opacity-90 flex items-center justify-center rounded-lg">
        <div class="text-center">
          <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mx-auto mb-2"></div>
          <p class="text-sm text-gray-600">Loading map...</p>
        </div>
      </div>
    </div>
    <!-- Route Panel is disabled for now
    <div id="<%= directions_panel_id %>" class="hidden mt-4 p-4 bg-gray-50 dark:bg-gray-900 rounded-lg">
      <h4 class="font-semibold text-gray-900 dark:text-white mb-2 flex items-center">
        <%= helpers.heroicon('map', css_class: 'w-4 h-4 mr-2') %>
        Route
      </h4>
      <div class="text-sm text-gray-700 dark:text-gray-300">
        <p>Route is displayed on the map above.</p>
      </div>
    </div>
    -->
    <!-- Address and Links -->
    <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="p-4 bg-gray-50 dark:bg-gray-900 rounded-lg">
        <h4 class="font-semibold text-gray-900 dark:text-white mb-2">Address</h4>
        <p class="text-sm text-gray-700 dark:text-gray-300">
          <%= school_address %>
        </p>
      </div>
      
      <div class="p-4 bg-gray-50 dark:bg-gray-900 rounded-lg">
        <h4 class="font-semibold text-gray-900 dark:text-white mb-2">Quick Actions</h4>
        <div class="space-y-2">
          <a href="https://www.google.com/maps?q=<%= school_lat %>,<%= school_lng %>" 
             target="_blank" 
             class="inline-flex items-center text-sm text-blue-600 hover:text-blue-800 dark:text-blue-400">
            <%= helpers.heroicon('external-link', css_class: 'w-4 h-4 mr-1') %>
            Open in Google Maps
          </a>
          <br>
          <a href="https://www.google.com/maps/dir/?api=1&destination=<%= school_lat %>,<%= school_lng %>" 
             target="_blank" 
             class="inline-flex items-center text-sm text-blue-600 hover:text-blue-800 dark:text-blue-400">
            <%= helpers.heroicon('arrow-top-right-on-square', css_class: 'w-4 h-4 mr-1') %>
            Get Directions in Google Maps
          </a>
        </div>
      </div>
    </div>

    <!-- Contact Information Display -->
    <% if contact_info.any? %>
      <div class="mt-6 pt-6 border-t border-gray-200 dark:border-gray-700">
        <h4 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-3">Direct Contact Information</h4>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm text-gray-600 dark:text-gray-400">
          <% if contact_info[:phone] %>
            <div class="flex items-center">
              <%= helpers.heroicon('phone', css_class: 'w-4 h-4 mr-2 text-gray-400 dark:text-gray-500') %>
              <span><%= contact_info[:phone] %></span>
            </div>
          <% end %>
          
          <% if contact_info[:email] %>
            <div class="flex items-center">
              <%= helpers.heroicon('envelope', css_class: 'w-4 h-4 mr-2 text-gray-400 dark:text-gray-500') %>
              <span><%= contact_info[:email] %></span>
            </div>
          <% end %>
          
          <% if contact_info[:website] %>
            <div class="flex items-center">
              <%= helpers.heroicon('globe', css_class: 'w-4 h-4 mr-2 text-gray-400 dark:text-gray-500') %>
              <%= link_to contact_info[:website], contact_info[:website], target: '_blank', class: 'text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300' %>
            </div>
          <% end %>
        </div>
        
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-3 italic">
          For the best service and faster response, we recommend using the contact form.
        </p>
      </div>
    <% end %>

  </div>
</div>

<!-- Google Maps JavaScript -->
<script>
  // Create unique namespace for this map instance
  const mapInstance_<%= map_id.gsub('-', '_') %> = {
    map: null,
    schoolMarker: null,
    userMarker: null,
    directionsService: null,
    directionsRenderer: null,
    userPosition: null,
    initialized: false,
    
    schoolPosition: { lat: <%= school_lat %>, lng: <%= school_lng %> },
    schoolName: '<%= j school_name %>',
    schoolAddress: '<%= j school_address %>',
    mapId: '<%= map_id %>',
    travelInfoId: '<%= travel_info_id %>',
    directionsPanelId: '<%= directions_panel_id %>'
  };
  
  function initMap_<%= map_id.gsub('-', '_') %>() {
    const instance = mapInstance_<%= map_id.gsub('-', '_') %>;
    
    if (instance.initialized) {
      return;
    }
    instance.initialized = true;
    
    // Hide loading indicator
    const loadingElement = document.getElementById('map-loading');
    if (loadingElement) {
      loadingElement.style.display = 'none';
    }
    
    // Initialize map
    try {
      const mapElement = document.getElementById(instance.mapId);
      if (!mapElement) {
        throw new Error(`Map container element not found: ${instance.mapId}`);
      }
      
      instance.map = new google.maps.Map(mapElement, {
        zoom: 13,
        center: instance.schoolPosition,
        mapTypeControl: true,
        streetViewControl: true,
        fullscreenControl: true,
        <% if ENV['GOOGLE_MAPS_MAP_ID'].present? %>
        mapId: '<%= ENV['GOOGLE_MAPS_MAP_ID'] %>'
        <% else %>
        styles: [
          {
            featureType: 'poi.school',
            stylers: [{ visibility: 'on' }, { color: '#4285f4' }]
          }
        ]
        <% end %>
      });
    } catch (error) {
      console.error('Error creating map:', error);
      return;
    }
    
    // Initialize directions service
    instance.directionsService = new google.maps.DirectionsService();
    instance.directionsRenderer = new google.maps.DirectionsRenderer();
    instance.directionsRenderer.setMap(instance.map);
    
    // Create school marker - use advanced markers if Map ID is available, otherwise legacy markers
    <% if ENV['GOOGLE_MAPS_MAP_ID'].present? %>
    const schoolPin = new google.maps.marker.PinElement({
      background: '#2563eb',
      borderColor: '#ffffff',
      glyphColor: '#ffffff',
      glyph: '🎓',
      scale: 1.2
    });
    
    instance.schoolMarker = new google.maps.marker.AdvancedMarkerElement({
      position: instance.schoolPosition,
      map: instance.map,
      title: instance.schoolName,
      content: schoolPin.element
    });
    <% else %>
    instance.schoolMarker = new google.maps.Marker({
      position: instance.schoolPosition,
      map: instance.map,
      title: instance.schoolName,
      icon: {
        url: 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(`
          <svg width="32" height="32" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
            <circle cx="16" cy="16" r="16" fill="#2563eb" stroke="white" stroke-width="2"/>
            <text x="16" y="20" text-anchor="middle" font-size="16" fill="white">🎓</text>
          </svg>
        `),
        scaledSize: new google.maps.Size(32, 32),
        anchor: new google.maps.Point(16, 16)
      }
    });
    <% end %>
    
    // School info window
    const schoolInfoWindow = new google.maps.InfoWindow({
      content: `
        <div class="p-2">
          <h3 class="font-bold text-lg mb-2">${instance.schoolName}</h3>
          <p class="text-sm text-gray-600 mb-2">${instance.schoolAddress}</p>
          <button onclick="calculateRoute_${instance.mapId.replace('-', '_')}()" class="bg-blue-600 text-white px-3 py-1 rounded text-sm hover:bg-blue-700">
            Get Directions
          </button>
        </div>
      `
    });
    
    // Add click listener with error protection
    try {
      instance.schoolMarker.addListener('click', () => {
        try {
          schoolInfoWindow.open(instance.map, instance.schoolMarker);
        } catch (error) {
          console.log('Info window error:', error.message);
        }
      });
    } catch (error) {
      console.log('Event listener error:', error.message);
    }
    
    // Show basic map functionality first
    updateTravelInfo('Map ready', 'Click "Get Directions" to calculate travel time', '--', 'ready');
    
    // Try to get user's location in background
    getUserLocation_<%= map_id.gsub('-', '_') %>();
  }
  
  function getUserLocation_<%= map_id.gsub('-', '_') %>() {
    const instance = mapInstance_<%= map_id.gsub('-', '_') %>;
    
    // Check if location is in cookie first (works in all environments)
    const locationCookie = getCookie('user_location');
    if (locationCookie) {
      try {
        const location = JSON.parse(decodeURIComponent(locationCookie));
        instance.userPosition = {
          lat: parseFloat(location.lat),
          lng: parseFloat(location.lng)
        };
        addUserMarker_<%= map_id.gsub('-', '_') %>();
        updateTravelInfo('Location ready', 'Click "Get Directions" for route details', '--', 'ready');
        // Automatically calculate route when location is available from cookie
        setTimeout(() => calculateRoute_<%= map_id.gsub('-', '_') %>(), 500);
        return;
      } catch (e) {
        console.log('Error parsing location cookie:', e);
      }
    }
    
    // Fall back to browser geolocation if available
    if (navigator.geolocation) {
      
      // Fall back to browser geolocation
      updateTravelInfo('Getting location...', 'Allow location access for directions', '--', 'loading');
      
      navigator.geolocation.getCurrentPosition(
        function(position) {
          instance.userPosition = {
            lat: position.coords.latitude,
            lng: position.coords.longitude
          };
          addUserMarker_<%= map_id.gsub('-', '_') %>();
          updateTravelInfo('Location ready', 'Click "Get Directions" for route details', '--', 'ready');
          // Automatically calculate route when location is available from geolocation
          setTimeout(() => calculateRoute_<%= map_id.gsub('-', '_') %>(), 500);
        },
        function(error) {
          // Handle geolocation errors gracefully without console noise
          let errorMessage = 'Location access needed';
          let errorDetails = 'Enable location to see directions and travel time';
          
          // Only log actual errors, not user permission denials or timeouts
          if (error.code !== error.PERMISSION_DENIED && error.code !== error.TIMEOUT) {
            console.log('Geolocation error:', error.code, error.message);
          }
          
          switch(error.code) {
            case error.PERMISSION_DENIED:
              errorMessage = 'Location access denied';
              errorDetails = 'Please allow location access for directions';
              break;
            case error.POSITION_UNAVAILABLE:
              errorMessage = 'Location unavailable';
              errorDetails = 'Unable to determine your location';
              break;
            case error.TIMEOUT:
              errorMessage = 'Map ready';
              errorDetails = 'Click "Get Directions" button for route calculations';
              break;
            default:
              errorMessage = 'Location error';
              errorDetails = 'Unable to get your location';
              break;
          }
          
          // Don't show timeout as an error - just show ready state
          const state = error.code === error.TIMEOUT ? 'ready' : 'error';
          updateTravelInfo(errorMessage, errorDetails, '--', state);
        },
        {
          timeout: 10000,
          maximumAge: 300000
        }
      );
    } else {
      updateTravelInfo('Location not supported', 'Your browser doesn\'t support geolocation', '--', 'error');
    }
  }
  
  function addUserMarker_<%= map_id.gsub('-', '_') %>() {
    const instance = mapInstance_<%= map_id.gsub('-', '_') %>;
    
    if (!instance.userPosition) return;
    
    // Create user marker - use advanced markers if Map ID is available, otherwise legacy markers
    <% if ENV['GOOGLE_MAPS_MAP_ID'].present? %>
    const userPin = new google.maps.marker.PinElement({
      background: '#10b981',
      borderColor: '#ffffff',
      glyphColor: '#ffffff',
      glyph: '📍',
      scale: 1.0
    });
    
    instance.userMarker = new google.maps.marker.AdvancedMarkerElement({
      position: instance.userPosition,
      map: instance.map,
      title: 'Your Location',
      content: userPin.element
    });
    <% else %>
    instance.userMarker = new google.maps.Marker({
      position: instance.userPosition,
      map: instance.map,
      title: 'Your Location',
      icon: {
        url: 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(`
          <svg width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <circle cx="12" cy="12" r="12" fill="#10b981" stroke="white" stroke-width="2"/>
            <text x="12" y="16" text-anchor="middle" font-size="12" fill="white">📍</text>
          </svg>
        `),
        scaledSize: new google.maps.Size(24, 24),
        anchor: new google.maps.Point(12, 12)
      }
    });
    <% end %>
    
    // Fit map to show both locations
    const bounds = new google.maps.LatLngBounds();
    bounds.extend(instance.schoolPosition);
    bounds.extend(instance.userPosition);
    instance.map.fitBounds(bounds);
  }
  
  function updateTravelInfo(status, details, time, state) {
    try {
      const statusEl = document.getElementById('travel-status');
      const detailsEl = document.getElementById('travel-details');
      const timeEl = document.getElementById('travel-time');
      
      if (statusEl) statusEl.textContent = status;
      if (detailsEl) detailsEl.textContent = details;
      if (timeEl) timeEl.textContent = time;
    } catch (error) {
      // Silently handle DOM access errors
      console.log('Travel info update error:', error.message);
    }
  }
  
  function calculateRoute_<%= map_id.gsub('-', '_') %>() {
    const instance = mapInstance_<%= map_id.gsub('-', '_') %>;
    
    if (!instance.userPosition) {
      alert('Location not available. Please enable location access or enter your address manually.');
      return;
    }
    
    updateTravelInfo('Calculating route...', 'Getting directions and travel time', '--', 'loading');
    
    // Add timeout protection for directions request
    const directionsTimeout = setTimeout(() => {
      updateTravelInfo('Route timeout', 'Unable to calculate route - service timeout', '--', 'error');
    }, 15000);
    
    instance.directionsService.route({
      origin: instance.userPosition,
      destination: instance.schoolPosition,
      travelMode: google.maps.TravelMode.DRIVING,
      avoidTolls: false,
      avoidHighways: false
    }, function(result, status) {
      // Clear the timeout
      clearTimeout(directionsTimeout);
      try {
        if (status === 'OK' && result && result.routes && result.routes.length > 0) {
          instance.directionsRenderer.setDirections(result);
          
          const route = result.routes[0];
          const leg = route.legs[0];
          
          if (leg && leg.distance && leg.duration) {
            // Update travel info
            updateTravelInfo('Ready to navigate', `${leg.distance.text} via ${route.summary || 'suggested route'}`, leg.duration.text, 'success');
            
            // Update travel distance display safely
            const travelDistanceEl = document.getElementById('travel-distance');
            if (travelDistanceEl) {
              travelDistanceEl.textContent = leg.distance.text;
            }
            
            // Show route panel (without detailed directions) - only if it exists
            const directionsPanel = document.getElementById(instance.directionsPanelId);
            if (directionsPanel) {
              directionsPanel.classList.remove('hidden');
            }
          } else {
            updateTravelInfo('Route incomplete', 'Route data is missing some information', '--', 'error');
          }
        } else {
          // Handle specific direction service errors
          let errorMessage = 'Route calculation failed';
          switch(status) {
            case 'NOT_FOUND':
              errorMessage = 'Location not found';
              break;
            case 'ZERO_RESULTS':
              errorMessage = 'No route available';
              break;
            case 'MAX_WAYPOINTS_EXCEEDED':
              errorMessage = 'Too many waypoints';
              break;
            case 'INVALID_REQUEST':
              errorMessage = 'Invalid route request';
              break;
            case 'OVER_QUERY_LIMIT':
              errorMessage = 'Query limit exceeded';
              break;
            case 'REQUEST_DENIED':
              errorMessage = 'Route request denied';
              break;
            case 'UNKNOWN_ERROR':
            default:
              errorMessage = 'Route calculation failed';
              break;
          }
          updateTravelInfo(errorMessage, 'Unable to calculate route at this time', '--', 'error');
        }
      } catch (error) {
        console.error('Error processing directions result:', error);
        updateTravelInfo('Route processing error', 'An error occurred while processing the route', '--', 'error');
      }
    });
  }
  
  function centerOnSchool() {
    const instance = mapInstance_<%= map_id.gsub('-', '_') %>;
    instance.map.setCenter(instance.schoolPosition);
    instance.map.setZoom(17);
  }
  
  function centerOnUser() {
    const instance = mapInstance_<%= map_id.gsub('-', '_') %>;
    if (instance.userPosition) {
      instance.map.setCenter(instance.userPosition);
      instance.map.setZoom(17);
    } else {
      alert('User location not available');
    }
  }
  
  function showDirections() {
    calculateRoute_<%= map_id.gsub('-', '_') %>();
  }
  
  function getCookie(name) {
    const value = `; ${document.cookie}`;
    const parts = value.split(`; ${name}=`);
    if (parts.length === 2) return parts.pop().split(';').shift();
    return null;
  }
  
  // Make init function available globally for Google Maps callback
  window.initMap_<%= map_id.gsub('-', '_') %> = initMap_<%= map_id.gsub('-', '_') %>;
  
  // Initialize immediately if Google Maps is already loaded
  try {
    if (typeof google !== 'undefined' && google.maps) {
      setTimeout(() => {
        try {
          initMap_<%= map_id.gsub('-', '_') %>();
        } catch (error) {
          console.error('Map initialization error:', error);
          updateTravelInfo('Map error', 'Unable to initialize map', '--', 'error');
        }
      }, 100);
    }
  } catch (error) {
    console.error('Google Maps check error:', error);
    updateTravelInfo('Map loading error', 'Error checking Google Maps availability', '--', 'error');
  }
</script>

<!-- Load Google Maps API -->
<script async defer 
        src="https://maps.googleapis.com/maps/api/js?key=<%= ENV['GOOGLE_PLACES_API_KEY'] %>&callback=initMap_<%= map_id.gsub('-', '_') %>&libraries=geometry,places<%= ENV['GOOGLE_MAPS_MAP_ID'].present? ? ',marker' : '' %>&loading=async">
</script>
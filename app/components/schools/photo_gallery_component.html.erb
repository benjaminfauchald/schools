<div class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden">
  <%= render Schools::SectionHeaderComponent.new(
        title: "Photo Gallery",
        icon: "photo",
        subtitle: "Campus photos and facilities"
      ) %>

  <div class="px-6 pb-6">
    
    <!-- Photo Count Summary -->
    <div class="mb-6 p-4 bg-gray-50 dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">
            Campus Photos
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
            View detailed images of facilities and campus life
          </p>
        </div>
        <div class="text-right">
          <div class="text-2xl font-bold text-blue-600 dark:text-blue-400">
            <%= photos.count %>
          </div>
          <div class="text-sm text-gray-600 dark:text-gray-400">
            <%= photos.count == 1 ? 'photo' : 'photos' %>
          </div>
        </div>
      </div>
    </div>

    <!-- Photo Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
      <% photos.each_with_index do |photo, index| %>
        <div class="group relative aspect-square overflow-hidden rounded-lg bg-gray-100 dark:bg-gray-700 cursor-pointer hover:ring-2 hover:ring-blue-500 hover:ring-offset-2 transition-all duration-200"
             onclick="openPhotoModal_<%= object_id %>(<%= index %>)">
          <img src="<%= photo.url %>" 
               alt="<%= photo.alt_text || 'Campus photo' %>"
               class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
               loading="<%= index < 4 ? 'eager' : 'lazy' %>">
          
          <!-- Photo overlay -->
          <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-20 transition-opacity duration-200 flex items-center justify-center">
            <div class="opacity-0 group-hover:opacity-100 transition-opacity duration-200 bg-white/90 backdrop-blur-sm rounded-full p-3 shadow-lg">
              <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
              </svg>
            </div>
          </div>
          
          <!-- Photo number badge -->
          <div class="absolute top-2 left-2 bg-black bg-opacity-60 text-white text-xs px-2 py-1 rounded">
            <%= index + 1 %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- View All Button -->
    <% if photos.count > 8 %>
      <div class="mt-6 text-center">
        <button onclick="openPhotoModal_<%= object_id %>(0)" 
                class="inline-flex items-center px-6 py-3 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors duration-200">
          <%= helpers.heroicon('photo', css_class: 'w-4 h-4 mr-2') %>
          View All <%= photos.count %> Photos
        </button>
      </div>
    <% end %>

  </div>
</div>

<!-- Photo Modal -->
<div id="<%= modal_id %>" class="fixed inset-0 z-50 hidden bg-black/90" onclick="closePhotoModal_<%= object_id %>()">
  
  <!-- Main Photo Display Container -->
  <div class="w-full h-full flex items-center justify-center px-20 py-20" onclick="event.stopPropagation()">
    <div class="relative max-w-full max-h-full">
      <!-- Close Button -->
      <button onclick="event.stopPropagation(); closePhotoModal_<%= object_id %>();" 
              class="absolute -top-12 -right-4 z-[60] bg-gray-900/90 hover:bg-gray-900 backdrop-blur-sm rounded-full p-3 text-white hover:text-gray-200 shadow-xl transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-white/50"
              title="Close photo gallery"
              aria-label="Close photo gallery">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      
      <!-- Photo Counter -->
      <div class="absolute -top-12 -left-4 z-[60] bg-gray-900/90 backdrop-blur-sm text-white px-4 py-2 rounded-lg text-sm font-medium shadow-xl">
        <span id="current-photo-number">1</span> of <%= photos.count %>
      </div>
      
      <!-- Left Navigation Arrow (Previous) -->
      <% if photos.count > 1 %>
        <button onclick="event.stopPropagation(); previousPhoto_<%= object_id %>();" 
                class="absolute -left-16 top-1/2 transform -translate-y-1/2 z-[60] bg-gray-900/90 hover:bg-gray-900 backdrop-blur-sm rounded-full p-4 text-white hover:text-gray-200 shadow-xl transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-white/50"
                title="Previous photo"
                aria-label="Previous photo">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 12H5M12 5l-7 7 7 7" />
          </svg>
        </button>
        
        <!-- Right Navigation Arrow (Next) -->
        <button onclick="event.stopPropagation(); nextPhoto_<%= object_id %>();" 
                class="absolute -right-16 top-1/2 transform -translate-y-1/2 z-[60] bg-gray-900/90 hover:bg-gray-900 backdrop-blur-sm rounded-full p-4 text-white hover:text-gray-200 shadow-xl transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-white/50"
                title="Next photo"
                aria-label="Next photo">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </button>
      <% end %>
      
      <!-- The Photo -->
      <img id="modal-photo" 
           src="" 
           alt="" 
           class="max-w-full max-h-full object-contain rounded-lg shadow-2xl">
      
      <!-- Photo Info -->
      <div class="absolute -bottom-16 left-0 right-0 z-[60] bg-gray-900/90 backdrop-blur-sm text-white p-4 rounded-lg shadow-xl">
        <p id="modal-photo-alt" class="text-sm font-medium text-center"></p>
      </div>
    </div>
  </div>
</div>

<!-- JavaScript for Photo Modal -->
<script>
  (function() {
    const photos_<%= object_id %> = <%= raw photos.map { |p| { url: p.url, alt: p.alt_text } }.to_json %>;
    let currentPhotoIndex_<%= object_id %> = 0;
    
    window.openPhotoModal_<%= object_id %> = function(index) {
      currentPhotoIndex_<%= object_id %> = index;
      updateModalPhoto_<%= object_id %>();
      document.getElementById('<%= modal_id %>').classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
    };
    
    window.closePhotoModal_<%= object_id %> = function() {
      document.getElementById('<%= modal_id %>').classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    };
    
    window.nextPhoto_<%= object_id %> = function() {
      currentPhotoIndex_<%= object_id %> = (currentPhotoIndex_<%= object_id %> + 1) % photos_<%= object_id %>.length;
      updateModalPhoto_<%= object_id %>();
    };
    
    window.previousPhoto_<%= object_id %> = function() {
      currentPhotoIndex_<%= object_id %> = (currentPhotoIndex_<%= object_id %> - 1 + photos_<%= object_id %>.length) % photos_<%= object_id %>.length;
      updateModalPhoto_<%= object_id %>();
    };
    
    function updateModalPhoto_<%= object_id %>() {
      const photo = photos_<%= object_id %>[currentPhotoIndex_<%= object_id %>];
      document.getElementById('modal-photo').src = photo.url;
      document.getElementById('modal-photo').alt = photo.alt;
      document.getElementById('modal-photo-alt').textContent = photo.alt || 'Campus photo';
      document.getElementById('current-photo-number').textContent = currentPhotoIndex_<%= object_id %> + 1;
    }
    
    // Keyboard navigation
    document.addEventListener('keydown', function(e) {
      if (!document.getElementById('<%= modal_id %>').classList.contains('hidden')) {
        if (e.key === 'Escape') window.closePhotoModal_<%= object_id %>();
        else if (e.key === 'ArrowRight') window.nextPhoto_<%= object_id %>();
        else if (e.key === 'ArrowLeft') window.previousPhoto_<%= object_id %>();
      }
    });
  })();
</script>
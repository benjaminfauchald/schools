<div class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden">
  <%= render Schools::SectionHeaderComponent.new(
        title: "Tuition & Fees",
        icon: "currency-dollar",
        subtitle: "Academic year pricing and fee structures"
      ) %>

  <div class="px-6 pb-6">
    
    <!-- Fee Range Summary -->
    <% if fee_range_summary %>
      <div class="mb-6 p-4 bg-gradient-to-r from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20 rounded-lg border border-green-200 dark:border-green-800">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="text-lg font-semibold text-green-800 dark:text-green-200">
              Tuition Range
            </h3>
            <p class="text-sm text-green-600 dark:text-green-400 mt-1">
              Annual tuition fees across all grade levels
            </p>
          </div>
          <div class="text-right">
            <div class="text-2xl font-bold text-green-700 dark:text-green-300">
              <%= format_fee_range(fee_range_summary[:min], fee_range_summary[:max], fee_range_summary[:currency]) %>
            </div>
            <div class="text-sm text-green-600 dark:text-green-400">
              per year
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Detailed Fee Structure -->
    <% if organized_fees.any? %>
      <div class="space-y-6">
        <% organized_fees.each do |grade_fees| %>
          <div class="border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden">
            
            <!-- Grade Level Header -->
            <div class="bg-gray-50 dark:bg-gray-900 px-4 py-3 border-b border-gray-200 dark:border-gray-700">
              <div class="flex items-center justify-between">
                <h4 class="font-semibold text-gray-900 dark:text-white">
                  <%= grade_fees[:grade] %>
                </h4>
                <% if grade_fees[:total_range] %>
                  <div class="text-right">
                    <div class="text-lg font-bold text-gray-900 dark:text-white">
                      <%= format_fee_range(
                            grade_fees[:total_range][:min],
                            grade_fees[:total_range][:max],
                            grade_fees[:total_range][:currency]
                          ) %>
                    </div>
                    <div class="text-xs text-gray-500 dark:text-gray-400">
                      <%= grade_fees[:total_range][:frequency] %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>

            <!-- Fee Items -->
            <% if grade_fees[:items].any? %>
              <div class="divide-y divide-gray-200 dark:divide-gray-700">
                <% grade_fees[:items].each do |fee_item| %>
                  <div class="px-4 py-4">
                    <div class="flex items-center justify-between">
                      <div class="flex-1">
                        <div class="flex items-center space-x-3">
                          <div>
                            <h5 class="text-sm font-medium text-gray-900 dark:text-white">
                              <%= fee_item[:description] %>
                            </h5>
                            <% if fee_item[:notes].present? %>
                              <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                                <%= fee_item[:notes] %>
                              </p>
                            <% end %>
                          </div>
                          <% if fee_item[:frequency] %>
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium <%= frequency_badge_class(fee_item[:frequency]) %>">
                              <%= fee_item[:frequency] %>
                            </span>
                          <% end %>
                        </div>
                      </div>
                      <div class="text-right ml-4">
                        <div class="text-lg font-semibold text-gray-900 dark:text-white">
                          <%= format_fee_amount(fee_item[:amount], fee_item[:currency]) %>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>

          </div>
        <% end %>
      </div>
    <% end %>

    <!-- Additional Information -->
    <div class="mt-6 p-4 bg-blue-50 dark:bg-blue-900/20 rounded-lg border border-blue-200 dark:border-blue-800">
      <div class="flex items-start space-x-3">
        <%= section_icon_svg('information-circle') %>
        <div class="flex-1">
          <h4 class="text-sm font-semibold text-blue-900 dark:text-blue-100 mb-2">
            Important Fee Information
          </h4>
          <ul class="text-sm text-blue-800 dark:text-blue-200 space-y-1">
            <li>• Fees shown are indicative and may vary by academic year</li>
            <li>• Additional fees may apply for activities, materials, and services</li>
            <li>• Payment plans and scholarship programs may be available</li>
            <li>• Contact the school directly for the most current fee schedule</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Contact for Fees CTA -->
    <div class="mt-4 text-center">
      <div class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600">
        <%= section_icon_svg('phone') %>
        <span class="ml-2">Contact for Detailed Fee Schedule</span>
      </div>
    </div>

  </div>
</div>
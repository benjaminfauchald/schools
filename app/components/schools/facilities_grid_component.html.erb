<div class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden h-full flex flex-col">
  <%= render Schools::SectionHeaderComponent.new(
        title: "Campus Facilities",
        icon: "building-office-2",
        subtitle: "Modern facilities supporting student learning and development"
      ) %>

  <div class="px-6 pb-6 flex-1">
    <div class="space-y-8">
      
      <% facility_groups.each do |group_name, group_data| %>
        <div>
          <div class="flex items-center mb-4">
            <%= section_icon_svg(group_data[:icon]) %>
            <div class="ml-2">
              <h3 class="text-lg font-medium text-gray-900 dark:text-white">
                <%= group_name %>
              </h3>
              <p class="text-sm text-gray-600 dark:text-gray-400">
                <%= pluralize(group_data[:items].count, 'facility') %>
              </p>
            </div>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3">
            <% group_data[:items].each do |facility| %>
              <div class="group relative">
                <%= render Schools::TagBadgeComponent.new(
                      term: facility,
                      variant: :facility,
                      size: :small
                    ) %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Facilities Overview Stats -->
      <% if total_facilities_count > 0 %>
        <div class="bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 rounded-lg p-6 border border-blue-200 dark:border-blue-800">
          <div class="text-center">
            <div class="text-3xl font-bold text-blue-600 dark:text-blue-400 mb-2">
              <%= total_facilities_count %>
            </div>
            <div class="text-sm text-blue-600 dark:text-blue-400 uppercase tracking-wider font-medium">
              Total Campus Facilities
            </div>
            <p class="text-xs text-blue-600/80 dark:text-blue-400/80 mt-1">
              Modern facilities designed to enhance student learning experience
            </p>
          </div>
          
          <!-- Quick Stats Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-6 pt-4 border-t border-blue-200/50 dark:border-blue-700/50">
            <% if facility_groups['Academic Facilities'] %>
              <div class="text-center">
                <div class="text-lg font-semibold text-blue-600 dark:text-blue-400">
                  <%= facility_groups['Academic Facilities'][:items].count %>
                </div>
                <div class="text-xs text-blue-600/80 dark:text-blue-400/80">
                  Academic
                </div>
              </div>
            <% end %>
            
            <% if facility_groups['Sports & Recreation'] %>
              <div class="text-center">
                <div class="text-lg font-semibold text-green-600 dark:text-green-400">
                  <%= facility_groups['Sports & Recreation'][:items].count %>
                </div>
                <div class="text-xs text-green-600/80 dark:text-green-400/80">
                  Sports
                </div>
              </div>
            <% end %>
            
            <% if facility_groups['Technology & Innovation'] %>
              <div class="text-center">
                <div class="text-lg font-semibold text-purple-600 dark:text-purple-400">
                  <%= facility_groups['Technology & Innovation'][:items].count %>
                </div>
                <div class="text-xs text-purple-600/80 dark:text-purple-400/80">
                  Technology
                </div>
              </div>
            <% end %>
            
            <% if facility_groups['Arts & Culture'] %>
              <div class="text-center">
                <div class="text-lg font-semibold text-pink-600 dark:text-pink-400">
                  <%= facility_groups['Arts & Culture'][:items].count %>
                </div>
                <div class="text-xs text-pink-600/80 dark:text-pink-400/80">
                  Arts
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

    </div>
  </div>
</div>
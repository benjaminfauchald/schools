<div class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden h-full flex flex-col">
  <%= render Schools::SectionHeaderComponent.new(
        title: "Campus Facilities",
        icon: "building-office-2",
        subtitle: "Modern facilities supporting student learning and development"
      ) %>

  <div class="px-6 pb-6 flex-1">
    <div class="space-y-8">
      
      <% facility_groups.each do |group_name, group_data| %>
        <div>
          <div class="flex items-center mb-4">
            <%= section_icon_svg(group_data[:icon]) %>
            <div class="ml-2">
              <h3 class="text-lg font-medium text-gray-900 dark:text-white">
                <%= group_name %>
              </h3>
              <p class="text-sm text-gray-600 dark:text-gray-400">
                <%= pluralize(group_data[:items].count, 'facility') %>
              </p>
            </div>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3">
            <% group_data[:items].each do |facility| %>
              <div class="group relative">
                <%= render Schools::TagBadgeComponent.new(
                      term: facility,
                      variant: :facility,
                      size: :small
                    ) %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Summary Stats -->
      <% if total_facilities_count > 0 %>
        <div class="bg-blue-50 dark:bg-blue-900/20 rounded-lg p-4 border border-blue-200 dark:border-blue-800">
          <div class="flex flex-wrap justify-center gap-4 text-center">
            <div class="w-32 p-3">
              <div class="text-2xl font-bold text-blue-600 dark:text-blue-400">
                <%= total_facilities_count %>
              </div>
              <div class="text-xs text-blue-600 dark:text-blue-400 uppercase tracking-wider">
                Total Facilities
              </div>
            </div>
            
            <% if facility_groups['Academic Facilities'] %>
              <div class="w-32 p-3">
                <div class="text-2xl font-bold text-green-600 dark:text-green-400">
                  <%= facility_groups['Academic Facilities'][:items].count %>
                </div>
                <div class="text-xs text-green-600 dark:text-green-400 uppercase tracking-wider">
                  Academic
                </div>
              </div>
            <% end %>
            
            <% if facility_groups['Sports & Recreation'] %>
              <div class="w-32 p-3">
                <div class="text-2xl font-bold text-orange-600 dark:text-orange-400">
                  <%= facility_groups['Sports & Recreation'][:items].count %>
                </div>
                <div class="text-xs text-orange-600 dark:text-orange-400 uppercase tracking-wider">
                  Sports
                </div>
              </div>
            <% end %>
            
            <% if facility_groups['Technology & Innovation'] %>
              <div class="w-32 p-3">
                <div class="text-2xl font-bold text-purple-600 dark:text-purple-400">
                  <%= facility_groups['Technology & Innovation'][:items].count %>
                </div>
                <div class="text-xs text-purple-600 dark:text-purple-400 uppercase tracking-wider">
                  Technology
                </div>
              </div>
            <% end %>
            
            <% if facility_groups['Arts & Culture'] %>
              <div class="w-32 p-3">
                <div class="text-2xl font-bold text-pink-600 dark:text-pink-400">
                  <%= facility_groups['Arts & Culture'][:items].count %>
                </div>
                <div class="text-xs text-pink-600 dark:text-pink-400 uppercase tracking-wider">
                  Arts & Culture
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

    </div>
  </div>
</div>
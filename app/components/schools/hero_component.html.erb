<!-- School Hero Section -->
<section class="relative bg-gradient-to-r from-gray-900 via-gray-800 to-gray-900 min-h-[500px] flex items-center">
  <!-- Background Image -->
  <% if hero_image_url %>
    <div class="absolute inset-0">
      <img class="w-full h-full object-cover" 
           src="<%= hero_image_url %>" 
           alt="<%= school_name %>"
           style="filter: brightness(0.4) contrast(0.9);">
      <div class="absolute inset-0 bg-black/70"></div>
    </div>
  <% end %>

  <!-- Content -->
  <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <!-- School Name -->
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-8">
      <%= school_name %>
    </h1>

    <!-- Rating -->
    <% if rating_display %>
      <div class="mb-8">
        <div class="flex items-center text-white">
          <span class="text-2xl mr-3"><%= rating_display[:stars] %></span>
          <span class="text-xl font-semibold"><%= rating_display[:value] %></span>
          <span class="ml-3 text-gray-300">
            (<%= rating_display[:count] %> reviews)
          </span>
        </div>
      </div>
    <% end %>

    <!-- Key Stats -->
    <% if key_stats.any? %>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-12">
        <% key_stats.each do |stat| %>
          <div class="bg-white rounded-xl p-3 shadow-lg">
            <div class="flex items-center mb-2">
              <%= stat_icon_svg(stat[:icon]) if stat[:icon] %>
              <span class="ml-2 text-xs font-medium text-gray-600 uppercase tracking-wide">
                <%= stat[:label] %>
              </span>
            </div>
            <div class="text-lg font-bold text-gray-900">
              <%= stat[:value] %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- AI Chat Input and Contact Actions -->
    <div class="mt-8" data-controller="school-ai-chat" 
         data-school-ai-chat-school-id-value="<%= school.id %>"
         data-school-ai-chat-school-name-value="<%= school_name %>">
      
      <!-- Row with AI input and claim button - matching stats grid width -->
      <div class="flex flex-col md:flex-row gap-6">
        
        <!-- AI Chat Input - takes full available width -->
        <div class="flex-1">
          <div class="relative">
            <input type="text"
                   data-school-ai-chat-target="input"
                   data-action="keypress->school-ai-chat#handleKeyPress"
                   class="w-full px-4 py-3 pr-24 text-gray-900 placeholder-gray-500 bg-white/90 backdrop-blur-sm border border-gray-300 rounded-lg shadow-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                   placeholder="What kind of facilities does this school have?"
                   maxlength="200">
            <button type="button"
                    data-action="click->school-ai-chat#openModal"
                    class="absolute right-2 top-1/2 -translate-y-1/2 inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              Ask AI About this school
            </button>
          </div>
        </div>

        <!-- Contact Actions - positioned to the right -->
        <% if contact_actions.any? %>
          <div class="flex justify-start md:justify-end">
            <% contact_actions.each do |action| %>
              <% if action[:modal] %>
                <button type="button"
                        data-controller="school-contact-modal"
                        data-action="click->school-contact-modal#openModal"
                        class="inline-flex items-center px-6 py-3 text-base font-medium rounded-lg transition-colors <%= action_button_classes(action) %>">
                  <%= action_icon_svg(action[:icon]) if action[:icon] %>
                  <%= action[:label] %>
                </button>
              <% else %>
                <%= link_to action[:url], 
                            class: "inline-flex items-center px-6 py-3 text-base font-medium rounded-lg transition-colors #{action_button_classes(action)}",
                            target: (action[:external] ? '_blank' : nil),
                            rel: (action[:external] ? 'noopener noreferrer' : nil) do %>
                  <%= action_icon_svg(action[:icon]) if action[:icon] %>
                  <%= action[:label] %>
                <% end %>
              <% end %>
              <% break %> <!-- Only show first action in this layout -->
            <% end %>
          </div>
        <% end %>
        
      </div>

      <!-- AI Chat Modal -->
      <div data-school-ai-chat-target="modal" class="hidden fixed inset-0 z-50 overflow-y-auto" style="background-color: rgba(0, 0, 0, 0.75);">
        <div class="flex items-center justify-center min-h-screen p-4 pt-24 pb-8">
          <!-- Background overlay -->
          <div class="fixed inset-0" data-action="click->school-ai-chat#closeModal"></div>
          
          <!-- Modal panel -->
          <div class="relative bg-white rounded-lg shadow-xl w-full max-w-2xl max-h-[80vh] flex flex-col">
            <!-- Modal Header -->
            <div class="flex items-center justify-between p-6 border-b border-gray-200">
              <div class="flex items-center">
                <div class="flex-shrink-0 w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <div class="ml-3">
                  <h3 class="text-lg font-semibold text-gray-900">Ask About <%= school_name %></h3>
                  <p class="text-sm text-gray-500">Get instant answers about this school</p>
                </div>
              </div>
              <button type="button" 
                      class="text-gray-400 hover:text-gray-600 transition-colors"
                      data-action="click->school-ai-chat#closeModal">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
            </div>

            <!-- Messages Container -->
            <div data-school-ai-chat-target="messages" 
                 class="flex-1 p-6 space-y-4 overflow-y-auto min-h-[300px] max-h-[400px]">
              <!-- Messages will be populated here -->
            </div>

            <!-- Input Section -->
            <div class="p-6 border-t border-gray-200">
              <form data-action="submit->school-ai-chat#sendMessage" class="flex space-x-3">
                <input type="text"
                       data-school-ai-chat-target="inputField"
                       data-action="keypress->school-ai-chat#handleKeyPress"
                       class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                       placeholder="Ask about curriculum, fees, facilities..."
                       maxlength="200">
                <button type="submit"
                        data-school-ai-chat-target="sendButton"
                        class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                  </svg>
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>